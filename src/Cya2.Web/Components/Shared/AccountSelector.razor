@typeparam TItem
@typeparam TValue

<RadzenDropDown TValue="TValue"
                Data="@OrderedData"
                TextProperty="@TextProperty"
                ValueProperty="@ValueProperty"
                Value="@Value"
                ValueChanged="@ValueChanged"
                Change="@Change"
                Placeholder="@Placeholder"
                Disabled="@Disabled"
                AllowFiltering="@AllowFiltering"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                FilterOperator="StringFilterOperator.Contains"
                AllowClear="@AllowClear"
                Class="@(string.IsNullOrWhiteSpace(Class) ? "account-selector-dropdown" : $"account-selector-dropdown {Class}")"
                Style="@Style"
                 PopupStyle="box-sizing: border-box;">
    <ValueTemplate Context="item">
        <span class="account-selector-value">@GetText(item)</span>
    </ValueTemplate>
    <Template Context="item">
        <span class="account-selector-option">@GetText(item)</span>
    </Template>
</RadzenDropDown>

@code {
    [Parameter] public IEnumerable<TItem>? Data { get; set; }
    [Parameter] public string TextProperty { get; set; } = string.Empty;
    [Parameter] public string ValueProperty { get; set; } = string.Empty;
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public EventCallback<object> Change { get; set; }
    [Parameter] public Func<TItem, string>? TextSelector { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowFiltering { get; set; } = true;
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private IEnumerable<TItem> OrderedData => (Data ?? Enumerable.Empty<TItem>())
        .OrderBy(item => IsPlaceholder(item) ? 0 : 1)
        .ThenBy(GetText, StringComparer.OrdinalIgnoreCase);

    private string GetText(TItem item)
    {
        if (TextSelector is not null)
        {
            return TextSelector(item);
        }

        var property = typeof(TItem).GetProperty(TextProperty);
        return property?.GetValue(item)?.ToString() ?? string.Empty;
    }

    private static bool IsPlaceholder(TItem item)
    {
        var accountId = typeof(TItem).GetProperty("AccountId")?.GetValue(item);
        return accountId is int id && id == 0;
    }
}
