@using Cya2.Application.DTOs
@using Cya2.Application.Interfaces
@using Cya2.Application.Services
@inject IStringLocalizer<Resource> Localizer
@inject IAdminPreloadService AdminPreloadService
@inject IJSRuntime JS

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-3" Style="overflow:auto;">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled">
            @errorMessage
        </RadzenAlert>
    }

    <RadzenCard>
        <RadzenDataGrid TItem="FundReferenceDto"
                        Data="@accounts"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="false"
                        EmptyText="@Localizer["NoAccountFound"]">
            <Columns>
                <RadzenDataGridColumn TItem="FundReferenceDto" Property="AccountNumber" Title="Fund Num" Width="170px" />
                <RadzenDataGridColumn TItem="FundReferenceDto" Property="Fund" Title="@Localizer["Fund"]" Width="280px">
                    <Template Context="account">@account.Fund</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FundReferenceDto" Property="AccountingClass" Title="@Localizer["Class"]" Width="170px" />
                <RadzenDataGridColumn TItem="FundReferenceDto" Property="Overhead" Title="@Localizer["Overhead"]" Width="120px" TextAlign="TextAlign.Right">
                    <Template Context="a">
                        @a.Overhead.ToString("N0")
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>

    <div style="display:flex; justify-content:flex-end;">
        <RadzenButton Text="@Localizer["CopyTable"]"
                      Icon="content_copy"
                      ButtonStyle="ButtonStyle.Primary"
                      Style="background-color: #0a3b6b; border-color: #0a3b6b;"
                      Click="CopyTableAsync" />
    </div>
</RadzenStack>

@code {
    private string errorMessage = string.Empty;
    private IReadOnlyList<FundReferenceDto> accounts = Array.Empty<FundReferenceDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var primaryAccounts = await AdminPreloadService.GetAccountsAsync();
            var subAccounts = await AdminPreloadService.GetSubAccountsAsync();
            accounts = FundReferenceTableService.BuildRows(primaryAccounts, subAccounts);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading accounts: {ex.Message}";
        }
    }

    private async Task CopyTableAsync()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"{Localizer["Fund"].Value.ToLowerInvariant()}\t{Localizer["Overhead"].Value.ToLowerInvariant()}\tfund#\t{Localizer["Class"].Value.ToLowerInvariant()}");
            foreach (var a in accounts)
            {
                sb.AppendLine($"{a.Fund}\t{a.Overhead:N0}\t{a.AccountNumber}\t{a.AccountingClass}");
            }

            await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        }
        catch (Exception ex)
        {
            errorMessage = $"Error copying table: {ex.Message}";
        }
    }
}
