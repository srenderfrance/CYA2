@page "/database-error"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Database Connection Error</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    <i class="bi bi-database-x text-danger" style="font-size: 4rem;"></i>
                    <h1 class="mt-3">Database Connection Error</h1>
                    <p class="lead mt-3">We're unable to connect to our database at the moment.</p>
                    <p>This is required for the application to function properly.</p>
                    
                    <hr class="my-4">
                    
                    <div class="d-grid gap-3">
                        <a href="/" class="btn btn-primary">
                            <i class="bi bi-arrow-clockwise me-2"></i> Try Again
                        </a>
                        
                        <div class="text-muted">
                            <p class="mb-0">If this problem persists, please contact the administrator.</p>
                            <p class="mb-0"><small>Support: admin@example.com</small></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>