@inherits LayoutComponentBase
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject Cya2.Application.Interfaces.ISessionUserStateService SessionUserStateService
@inject Cya2.Application.Interfaces.IUserIdResolver UserIdResolver
@inject Cya2.Application.Interfaces.IUserAuthorizationService UserAuthorizationService
@implements IDisposable

<HeadContent>
    <!-- Viewport meta tag for proper positioning -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Radzen & app styles — load order matters -->
    <link rel="stylesheet" href="/_content/Radzen.Blazor/css/default-base.css" />
    <link rel="stylesheet" href="/_content/Radzen.Blazor/css/default.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <!-- Bootstrap CSS - Re-enabled with Radzen dropdown fixes in place -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Radzen token + component overrides (must come after Radzen & Bootstrap) -->
    <link rel="stylesheet" href="/css/radzen-overrides.css" />
    <link rel="stylesheet" href="/app.css" />
    <!-- Responsive utilities (after app.css, before scoped component styles) -->
    <link rel="stylesheet" href="/css/responsive.css" />
    <link rel="stylesheet" href="/cya2.styles.css" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script src="/js/blazorCulture.js"></script>
</HeadContent>

<div class="layout-root">
    <header class="app-header">
        <NavMenu />
    </header>

    <main class="main-content">
        <article class="content px-4">
            @Body
        </article>

        <DatabaseStatus />
    </main>
</div>

<!-- Keep these if you want static (SSR) placeholders; they won't handle DialogService -->
<RadzenDialog @rendermode="InteractiveServer" />
<RadzenNotification @rendermode="InteractiveServer" />
<RadzenContextMenu @rendermode="InteractiveServer" />
<RadzenTooltip @rendermode="InteractiveServer" />

<!-- Radzen & Blazor scripts -->
<script src="/_content/Radzen.Blazor/Radzen.Blazor.js"></script>
<script src="/_framework/blazor.server.js"></script>
<script src="/js/scroll-utils.js?v=1"></script>
<script src="/js/radzen-dropdown-fix.js"></script>
<script src="/js/radzen-tooltip-fix.js"></script>
<script src="/js/custom-dropdown.js"></script>
<script src="/js/auth-redirect.js"></script>
<script type="module" src="/js/autocomplete-tab.js"></script>

@code {
    private bool resumeProcessed;
    private bool wasAuthenticated;
    private bool wasAdmin;
    private CancellationTokenSource? revalidationCancellation;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || resumeProcessed)
        {
            return;
        }

        resumeProcessed = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        wasAuthenticated = true;
        wasAdmin = authState.User.IsInRole("Admin");
        revalidationCancellation = new CancellationTokenSource();
        _ = RevalidateSessionAsync(revalidationCancellation.Token);

        var resume = await JS.InvokeAsync<BrowserResumeState?>("authHelpers.consumeResumeState");
        if (resume is null)
        {
            await SaveResumeStateAsync();
            return;
        }

        if (!string.IsNullOrWhiteSpace(resume.Account))
        {
            SessionUserStateService.SelectedAccountFund = resume.Account;
        }

        if (DateTime.TryParse(resume.StartDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out var startDate))
        {
            SessionUserStateService.SelectedStartDate = startDate;
        }

        if (DateTime.TryParse(resume.EndDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out var endDate))
        {
            SessionUserStateService.SelectedEndDate = endDate;
        }

        SessionUserStateService.SelectedDatePreset = resume.Preset ?? string.Empty;
        var currentRoute = new Uri(Navigation.Uri).PathAndQuery;
        if (!string.Equals(currentRoute, resume.Route, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(resume.Route, replace: true);
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await SaveResumeStateAsync();
    }

    private async Task RevalidateSessionAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                if (user.Identity?.IsAuthenticated != true)
                    return;

                var userId = UserIdResolver.ResolveUserId(user, SessionUserStateService.CurrentUserId);
                var authorization = await UserAuthorizationService.ValidateUserAsync(userId);
                if (!authorization.IsAuthorized || (wasAdmin && !authorization.IsAdmin))
                {
                    await JS.InvokeVoidAsync("authHelpers.clearResumeState");
                    Navigation.NavigateTo("/api/login", forceLoad: true);
                    return;
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        var authState = await authenticationStateTask;
        if (wasAuthenticated && authState.User.Identity?.IsAuthenticated != true)
        {
            await SaveResumeStateAsync();
            var returnUrl = Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery);
            Navigation.NavigateTo($"/api/login?returnUrl={returnUrl}", forceLoad: true);
        }
    }

    private async Task SaveResumeStateAsync()
    {
        var uri = new Uri(Navigation.Uri);
        await JS.InvokeVoidAsync("authHelpers.saveResumeState", new BrowserResumeState
        {
            Route = uri.PathAndQuery,
            Account = SessionUserStateService.SelectedAccountFund,
            StartDate = SessionUserStateService.SelectedStartDate?.ToString("O", CultureInfo.InvariantCulture),
            EndDate = SessionUserStateService.SelectedEndDate?.ToString("O", CultureInfo.InvariantCulture),
            Preset = SessionUserStateService.SelectedDatePreset
        });
    }

    public void Dispose()
    {
        revalidationCancellation?.Cancel();
        revalidationCancellation?.Dispose();
        Navigation.LocationChanged -= OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private sealed class BrowserResumeState
    {
        public string Route { get; set; } = "/";
        public string Account { get; set; } = string.Empty;
        public string? StartDate { get; set; }
        public string? EndDate { get; set; }
        public string? Preset { get; set; }
    }
}

