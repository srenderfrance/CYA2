@page "/donations-hybrid"
@using Cya2.Application.Interfaces
@using Cya2.Application.Services
@using Cya2.Core.Entities
@using Cya2.Shared.Utilities
@inject IDonationAnalyticsService DonationAnalyticsService
@inject IDataProcessingService DataProcessingService

<h3>Hybrid Client/Server Calculations Example</h3>

<!-- Display results -->
<div>
    <p>Total Donations (Client-side): @clientTotal.ToString("C2")</p>
    <p>Server Calculation Status: @serverCalculationStatus</p>
    <p>Pivot Rows: @pivotRows.Count</p>
</div>

<!-- Data grid would go here -->

@code {
    private decimal clientTotal = 0m;
    private string serverCalculationStatus = "";
    private List<DonationPivotRow> pivotRows = new();
    private List<Donation> loadedDonations = new();

    protected override async Task OnInitializedAsync()
    {
        // Example: Load data once, then use client-side calculations for UI updates
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        try
        {
            // Server-side: Load data once
            // In real implementation, this would load from your existing cache/service
            loadedDonations = await LoadDonationsFromCache();
            
            serverCalculationStatus = "Data loaded from server";
            
            // Client-side: Calculate totals immediately
            await UpdateClientCalculations();
        }
        catch (Exception ex)
        {
            serverCalculationStatus = $"Error: {ex.Message}";
        }
    }

    private async Task OnDateRangeChanged(DateTime startDate, DateTime endDate)
    {
        // Client-side: Filter and recalculate without server round-trip
        var filteredDonations = DataProcessingService.FilterByDateRange(loadedDonations, startDate, endDate);
        
        // Client-side: Quick calculations
        clientTotal = ClientCalculations.CalculateDonationTotal(filteredDonations);
        
        // Client-side: Build pivot table
        var pivotResult = await DonationAnalyticsService.BuildDonationPivotAsync(filteredDonations, startDate, endDate);
        pivotRows = pivotResult.PivotRows;
        
        // UI updates immediately - no server round-trip needed!
        StateHasChanged();
    }

    private async Task OnAccountChanged(Account account)
    {
        // Client-side: Filter by account without server call
        var accountDonations = DataProcessingService.FilterBySubAccount(loadedDonations, account);
        
        // Client-side: Recalculate
        clientTotal = ClientCalculations.CalculateDonationTotal(accountDonations);
        
        StateHasChanged();
    }

    private async Task RefreshFromServer()
    {
        // Server-side: When user explicitly requests fresh data
        serverCalculationStatus = "Refreshing from server...";
        
        await LoadInitialData();
        
        serverCalculationStatus = "Refreshed from server";
    }

    private async Task<List<Donation>> LoadDonationsFromCache()
    {
        // This would integrate with your existing PageAccountCache pattern
        // For demo purposes, return empty list
        return new List<Donation>();
    }

    private async Task UpdateClientCalculations()
    {
        // Client-side calculations when data changes
        clientTotal = ClientCalculations.CalculateDonationTotal(loadedDonations);
        
        // More client-side calculations...
        var overhead = FinancialCalculations.CalculateOverhead(clientTotal, 12m); // 12% overhead
        
        StateHasChanged();
    }
}

<style>
    .calculation-status {
        background-color: #e3f2fd;
        padding: 0.5rem;
        border-radius: 4px;
        margin: 1rem 0;
    }
</style>