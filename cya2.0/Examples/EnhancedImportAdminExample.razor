@* Example of enhanced Admin.razor import section using new orchestration services *@
@page "/admin-enhanced-imports"
@using Cya2.Application.Interfaces
@using Cya2.Application.Services
@inject EnhancedImportFacade ImportFacade
@inject NotificationService NotificationService

<h3>Enhanced Import Management</h3>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    
    <!-- Import Type Selection -->
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Subtitle1">Import Type</RadzenText>
            
            <RadzenRadioButtonList @bind-Value="selectedImportType" TValue="ImportType">
                <Items>
                    <RadzenRadioButtonListItem Text="Donation Data" Value="ImportType.Donations" />
                    <RadzenRadioButtonListItem Text="Accounting Data" Value="ImportType.Accounting" />
                </Items>
            </RadzenRadioButtonList>
        </RadzenStack>
    </RadzenCard>

    <!-- Import Options -->
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Subtitle1">Import Options</RadzenText>
            
            <RadzenCheckBox @bind-Value="importOptions.RunPostImportAnalysis" />
            <RadzenLabel Text="Run post-import analysis" />
            
            <RadzenCheckBox @bind-Value="importOptions.UpdateDonorProfiles" />
            <RadzenLabel Text="Update donor profiles (donation imports only)" />
            
            <RadzenCheckBox @bind-Value="importOptions.RecalculateAccountBalances" />
            <RadzenLabel Text="Recalculate account balances" />
            
            <RadzenCheckBox @bind-Value="importOptions.WarmAnalyticsCache" />
            <RadzenLabel Text="Warm up analytics cache" />
        </RadzenStack>
    </RadzenCard>

    <!-- Import Mode Selection -->
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Subtitle1">Import Mode</RadzenText>
            
            <RadzenRadioButtonList @bind-Value="importMode" TValue="ImportMode">
                <Items>
                    <RadzenRadioButtonListItem Text="Legacy Import (existing behavior)" Value="ImportMode.Legacy" />
                    <RadzenRadioButtonListItem Text="Enhanced Import (with analytics)" Value="ImportMode.Enhanced" />
                    <RadzenRadioButtonListItem Text="Two-Phase Import (analyze first)" Value="ImportMode.TwoPhase" />
                </Items>
            </RadzenRadioButtonList>
        </RadzenStack>
    </RadzenCard>

    <!-- File Upload -->
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Subtitle1">File Upload</RadzenText>
            
            <InputFile OnChange="OnFileSelected" accept=".xlsx,.xls" />
            
            @if (selectedFile != null)
            {
                <RadzenText TextStyle="TextStyle.Body2">
                    Selected: @selectedFile.Name (@(selectedFile.Size / 1024 / 1024:F1) MB)
                </RadzenText>
            }
            
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                @if (importMode == ImportMode.TwoPhase)
                {
                    <RadzenButton Text="Analyze File" 
                                ButtonStyle="ButtonStyle.Info" 
                                Click="AnalyzeFile" 
                                Disabled="selectedFile == null || isProcessing" />
                                
                    <RadzenButton Text="Execute Import" 
                                ButtonStyle="ButtonStyle.Primary" 
                                Click="ExecuteFromAnalysis" 
                                Disabled="string.IsNullOrEmpty(currentAnalysisId) || isProcessing" />
                }
                else
                {
                    <RadzenButton Text="Start Import" 
                                ButtonStyle="ButtonStyle.Primary" 
                                Click="StartImport" 
                                Disabled="selectedFile == null || isProcessing" />
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <!-- Analysis Results (Two-Phase Mode) -->
    @if (analysisResult != null && importMode == ImportMode.TwoPhase)
    {
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.Subtitle1">Import Analysis Results</RadzenText>
                
                @if (!analysisResult.IsValid)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled">
                        <strong>Validation Errors:</strong>
                        <ul>
                            @foreach (var error in analysisResult.ValidationErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </RadzenAlert>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled">
                        File analysis completed successfully!
                    </RadzenAlert>
                    
                    <div class="analysis-summary">
                        <p><strong>Estimated Rows:</strong> @analysisResult.EstimatedRows.ToString("N0")</p>
                        <p><strong>Date Range:</strong> @analysisResult.EarliestDate?.ToString("yyyy-MM-dd") to @analysisResult.LatestDate?.ToString("yyyy-MM-dd")</p>
                        <p><strong>Affected Accounts:</strong> @analysisResult.DetectedAccounts.Count</p>
                        <p><strong>Estimated Volume:</strong> @analysisResult.EstimatedDataVolume.ToString("C0")</p>
                        
                        @if (analysisResult.Warnings.Any())
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Filled">
                                <strong>Warnings:</strong>
                                <ul>
                                    @foreach (var warning in analysisResult.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </RadzenAlert>
                        }
                    </div>
                }
            </RadzenStack>
        </RadzenCard>
    }

    <!-- Import Results -->
    @if (importResult != null)
    {
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.Subtitle1">Import Results</RadzenText>
                
                @if (importResult.IsSuccess)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled">
                        Import completed successfully!
                    </RadzenAlert>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled">
                        Import failed. See errors below.
                    </RadzenAlert>
                }
                
                <div class="import-summary">
                    <p><strong>Duration:</strong> @importResult.Duration.TotalSeconds.ToString("F1") seconds</p>
                    <p><strong>Total Rows:</strong> @importResult.TotalRows.ToString("N0")</p>
                    <p><strong>Inserted:</strong> @importResult.InsertedRows.ToString("N0")</p>
                    <p><strong>Failed:</strong> @importResult.FailedRows.ToString("N0")</p>
                    
                    @if (importResult.Analytics != null)
                    {
                        <h4>Analytics Summary</h4>
                        <p><strong>Total Amount:</strong> @importResult.Analytics.TotalAmount.ToString("C0")</p>
                        <p><strong>Average Amount:</strong> @importResult.Analytics.AverageAmount.ToString("C2")</p>
                        <p><strong>Unique Accounts:</strong> @importResult.Analytics.UniqueAccounts</p>
                        @if (selectedImportType == ImportType.Donations)
                        {
                            <p><strong>Unique Donors:</strong> @importResult.Analytics.UniqueDonors</p>
                        }
                    }
                    
                    @if (importResult.DonorImpacts?.Any() == true)
                    {
                        <h4>Donor Impact Analysis</h4>
                        <RadzenDataGrid Data="@importResult.DonorImpacts" TItem="DonorProfileImpact" Dense="true">
                            <Columns>
                                <RadzenDataGridColumn TItem="DonorProfileImpact" Property="DonorName" Title="Donor" />
                                <RadzenDataGridColumn TItem="DonorProfileImpact" Property="IsNewDonor" Title="New?" />
                                <RadzenDataGridColumn TItem="DonorProfileImpact" Property="PreviousFrequency" Title="Previous Frequency" />
                                <RadzenDataGridColumn TItem="DonorProfileImpact" Property="NewFrequency" Title="New Frequency" />
                                <RadzenDataGridColumn TItem="DonorProfileImpact" Property="NewDonationTotal" Title="New Total" FormatString="{0:C2}" />
                            </Columns>
                        </RadzenDataGrid>
                    }
                    
                    @if (importResult.AccountImpacts?.Any() == true)
                    {
                        <h4>Account Balance Impact</h4>
                        <RadzenDataGrid Data="@importResult.AccountImpacts" TItem="AccountBalanceImpact" Dense="true">
                            <Columns>
                                <RadzenDataGridColumn TItem="AccountBalanceImpact" Property="AccountName" Title="Account" />
                                <RadzenDataGridColumn TItem="AccountBalanceImpact" Property="PreviousBalance" Title="Previous Balance" FormatString="{0:C2}" />
                                <RadzenDataGridColumn TItem="AccountBalanceImpact" Property="NewBalance" Title="New Balance" FormatString="{0:C2}" />
                                <RadzenDataGridColumn TItem="AccountBalanceImpact" Property="BalanceChange" Title="Change" FormatString="{0:C2}" />
                                <RadzenDataGridColumn TItem="AccountBalanceImpact" Property="TransactionCount" Title="Transactions" />
                            </Columns>
                        </RadzenDataGrid>
                    }
                </div>
                
                @if (importResult.Warnings.Any())
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Filled">
                        <strong>Warnings:</strong>
                        <ul>
                            @foreach (var warning in importResult.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </RadzenAlert>
                }
                
                @if (importResult.Errors.Any())
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled">
                        <strong>Errors:</strong>
                        <ul>
                            @foreach (var error in importResult.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </RadzenAlert>
                }
            </RadzenStack>
        </RadzenCard>
    }

    <!-- Processing Indicator -->
    @if (isProcessing)
    {
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                <RadzenText>@processingMessage</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    // ✅ CLEAN STATE MANAGEMENT
    private ImportType selectedImportType = ImportType.Donations;
    private ImportMode importMode = ImportMode.Enhanced;
    private ImportOptions importOptions = new();
    
    private IBrowserFile? selectedFile;
    private bool isProcessing = false;
    private string processingMessage = string.Empty;
    
    // Analysis and result state
    private ImportAnalysisResult? analysisResult;
    private EnhancedImportResult? importResult;
    private string currentAnalysisId = string.Empty;

    private enum ImportMode
    {
        Legacy,
        Enhanced,
        TwoPhase
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        analysisResult = null;
        importResult = null;
        currentAnalysisId = string.Empty;
        StateHasChanged();
    }

    // ✅ SIMPLIFIED: Analyze file before import
    private async Task AnalyzeFile()
    {
        if (selectedFile == null) return;

        try
        {
            isProcessing = true;
            processingMessage = "Analyzing file structure and content...";
            StateHasChanged();

            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024); // 100MB limit
            analysisResult = await ImportFacade.AnalyzeImportAsync(stream, selectedFile.Name, selectedImportType);
            currentAnalysisId = analysisResult.AnalysisId;

            if (analysisResult.IsValid)
            {
                ShowNotification(NotificationSeverity.Success, "Analysis Complete", 
                    $"File analyzed successfully. {analysisResult.EstimatedRows:N0} rows estimated.");
            }
            else
            {
                ShowNotification(NotificationSeverity.Error, "Analysis Failed", 
                    "File analysis failed. See errors above.");
            }
        }
        catch (Exception ex)
        {
            ShowNotification(NotificationSeverity.Error, "Analysis Error", ex.Message);
            analysisResult = new ImportAnalysisResult
            {
                IsValid = false,
                ValidationErrors = { ex.Message }
            };
        }
        finally
        {
            isProcessing = false;
            processingMessage = string.Empty;
            StateHasChanged();
        }
    }

    // ✅ SIMPLIFIED: Execute import from analysis
    private async Task ExecuteFromAnalysis()
    {
        if (string.IsNullOrEmpty(currentAnalysisId)) return;

        try
        {
            isProcessing = true;
            processingMessage = "Executing import from analysis...";
            StateHasChanged();

            importResult = await ImportFacade.ExecuteFromAnalysisAsync(currentAnalysisId, importOptions);

            if (importResult.IsSuccess)
            {
                ShowNotification(NotificationSeverity.Success, "Import Complete", 
                    $"Import completed successfully. {importResult.InsertedRows:N0} rows imported.");
            }
            else
            {
                ShowNotification(NotificationSeverity.Error, "Import Failed", 
                    "Import failed. See errors above.");
            }
        }
        catch (Exception ex)
        {
            ShowNotification(NotificationSeverity.Error, "Import Error", ex.Message);
            importResult = new EnhancedImportResult
            {
                IsSuccess = false,
                Errors = { ex.Message },
                ImportStarted = DateTime.UtcNow,
                ImportCompleted = DateTime.UtcNow
            };
        }
        finally
        {
            isProcessing = false;
            processingMessage = string.Empty;
            StateHasChanged();
        }
    }

    // ✅ SIMPLIFIED: Direct import (legacy or enhanced)
    private async Task StartImport()
    {
        if (selectedFile == null) return;

        try
        {
            isProcessing = true;
            processingMessage = $"Starting {importMode} import...";
            StateHasChanged();

            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);

            importResult = importMode switch
            {
                ImportMode.Legacy => await ImportLegacyWithWrapperAsync(stream),
                ImportMode.Enhanced => await ImportEnhancedAsync(stream),
                _ => throw new InvalidOperationException($"Unsupported import mode: {importMode}")
            };

            if (importResult.IsSuccess)
            {
                ShowNotification(NotificationSeverity.Success, "Import Complete", 
                    $"{importMode} import completed. {importResult.InsertedRows:N0} rows imported.");
            }
            else
            {
                ShowNotification(NotificationSeverity.Error, "Import Failed", 
                    "Import failed. See errors above.");
            }
        }
        catch (Exception ex)
        {
            ShowNotification(NotificationSeverity.Error, "Import Error", ex.Message);
            importResult = new EnhancedImportResult
            {
                IsSuccess = false,
                Errors = { ex.Message },
                ImportStarted = DateTime.UtcNow,
                ImportCompleted = DateTime.UtcNow
            };
        }
        finally
        {
            isProcessing = false;
            processingMessage = string.Empty;
            StateHasChanged();
        }
    }

    // ✅ HELPER METHODS: Different import approaches
    private async Task<EnhancedImportResult> ImportLegacyWithWrapperAsync(Stream stream)
    {
        processingMessage = "Running legacy import with analytics wrapper...";
        
        return selectedImportType switch
        {
            ImportType.Donations => await ImportFacade.ImportDonationsWithAnalyticsAsync(stream, selectedFile!.Name, true),
            ImportType.Accounting => await ImportFacade.ImportAccountingWithBalanceAnalysisAsync(stream, selectedFile!.Name, true),
            _ => throw new InvalidOperationException($"Unsupported import type: {selectedImportType}")
        };
    }

    private async Task<EnhancedImportResult> ImportEnhancedAsync(Stream stream)
    {
        processingMessage = "Running enhanced import with full orchestration...";
        
        return selectedImportType switch
        {
            ImportType.Donations => await ImportFacade.ImportDonationsEnhancedAsync(stream, selectedFile!.Name, importOptions),
            ImportType.Accounting => await ImportFacade.ImportAccountingEnhancedAsync(stream, selectedFile!.Name, importOptions),
            _ => throw new InvalidOperationException($"Unsupported import type: {selectedImportType}")
        };
    }

    private void ShowNotification(NotificationSeverity severity, string summary, string detail)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 5000
        });
    }

    // ✅ COMPARISON: Before vs After
    // 
    // BEFORE (current Admin.razor import handling):
    // - Basic file upload and import call
    // - No pre-import validation or analysis
    // - No post-import analytics or insights
    // - No donor frequency analysis integration
    // - No balance impact analysis
    // - Limited error handling and feedback
    //
    // AFTER (with enhanced import services):
    // - Three import modes: Legacy, Enhanced, Two-Phase
    // - Pre-import file analysis and validation
    // - Post-import donor profile and balance analytics
    // - Rich import results with insights and warnings
    // - Backward compatibility with existing imports
    // - Comprehensive error handling and user feedback
    // - Integration with all our clean architecture services
}

@* 
    🎯 Enhanced Import Benefits:

    1. 📊 RICH ANALYTICS: Donor frequency changes, balance impacts, trend analysis
    2. 🛡️ SMART VALIDATION: Pre-import analysis catches issues before processing
    3. 🔄 FLEXIBLE MODES: Legacy (existing), Enhanced (analytics), Two-Phase (analyze first)
    4. 🎯 BUSINESS INTEGRATION: Uses AccountCalculationService, DonorAnalyticsService, etc.
    5. ⚡ PERFORMANCE INSIGHTS: Import timing, cache warming, optimization suggestions
    6. 🚨 PROACTIVE ALERTS: Donor frequency changes, balance warnings, data anomalies
    7. 🔧 BACKWARD COMPATIBLE: Existing import code continues to work unchanged

    Your existing import services remain fully functional while gaining powerful new capabilities!
*@