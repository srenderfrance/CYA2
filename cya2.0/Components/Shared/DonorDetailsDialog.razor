@using Cya2.Shared.Utilities
@using cya2.Components.Shared
@inject DialogService DialogService
@inject IStringLocalizer<Resource> Localizer
@inject IJSRuntime JS

<RadzenCard Class="donor-details-dialog-card" Style="padding: 1rem; min-width: 0; max-width: 100%; box-sizing: border-box;">
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
        <!-- Use the shared DonorInfoDisplay component for contact information only -->
        <DonorInfoDisplay DonorName="@DonorName"
                         DonorEmail="@DonorEmail"
                         DonorPhoneMobile="@DonorPhoneMobile"
                         DonorPhoneFixed="@DonorPhoneFixed"
                         DonorAddress="@DonorAddress"
                         DonorCity="@DonorCity"
                         DonorState="@DonorState"
                         DonorPostal="@DonorPostal"
                         DonorCountry="@DonorCountry"
                         AllowTextSelection="true" />

        <!-- Copy button moved to the bottom right -->
        <div style="display: flex; justify-content: flex-end; margin-top: 0.5rem;">
            <RadzenButton Icon="content_copy" 
                          Size="ButtonSize.Small" 
                          ButtonStyle="ButtonStyle.Light" 
                          Click="@(async () => await CopyDonorInfo())" 
                          Text="@Localizer["Copy"]" />
        </div>
    </RadzenStack>
</RadzenCard>

<style>
    .donor-details-dialog-card {
        width: 100%;
    }

    @@media (max-width: 640px) {
        .donor-details-dialog-card {
            padding: 0.75rem !important;
        }
    }
</style>

@code {
    [Parameter] public string DonorName { get; set; } = string.Empty;
    [Parameter] public string DonorEmail { get; set; } = string.Empty;
    [Parameter] public string DonorPhoneMobile { get; set; } = string.Empty;
    [Parameter] public string DonorPhoneFixed { get; set; } = string.Empty;
    [Parameter] public string DonorAddress { get; set; } = string.Empty;
    [Parameter] public string DonorCity { get; set; } = string.Empty;
    [Parameter] public string DonorState { get; set; } = string.Empty;
    [Parameter] public string DonorPostal { get; set; } = string.Empty;
    [Parameter] public string DonorCountry { get; set; } = string.Empty;

    private async Task CopyDonorInfo()
    {
        try
        {
            var lines = new List<string>
            {
                $"{Localizer["Name"]}: {(string.IsNullOrWhiteSpace(DonorName) ? Localizer["Unknown"] : DonorName)}",
                $"{Localizer["Email"]}: {(string.IsNullOrWhiteSpace(DonorEmail) ? Localizer["None"].Value : DonorEmail)}"
            };

            // Add phone information
            var phoneLines = new List<string>();
            if (!string.IsNullOrWhiteSpace(DonorPhoneMobile))
                phoneLines.Add($"Cell: {DisplayFormatter.FormatPhone(DonorPhoneMobile)}");
            if (!string.IsNullOrWhiteSpace(DonorPhoneFixed))
                phoneLines.Add($"Primary: {DisplayFormatter.FormatPhone(DonorPhoneFixed)}");
            
            if (phoneLines.Any())
                lines.Add($"{Localizer["Phone"]}: {string.Join("; ", phoneLines)}");
            else
                lines.Add($"{Localizer["Phone"]}: {Localizer["None"]}");

            // Add address information
            if (!string.IsNullOrWhiteSpace(DonorAddress))
            {
                lines.Add($"{Localizer["Address"]}:");
                lines.Add($"  {DonorAddress}");
                var cityStatePostal = string.Join(" ", new[] { DonorCity, DonorState, DonorPostal }.Where(s => !string.IsNullOrWhiteSpace(s)));
                if (!string.IsNullOrWhiteSpace(cityStatePostal))
                    lines.Add($"  {cityStatePostal}");
                if (!string.IsNullOrWhiteSpace(DonorCountry))
                    lines.Add($"  {DonorCountry}");
            }
            else
            {
                lines.Add($"{Localizer["Address"]}: {Localizer["None"]}");
            }

            var payload = string.Join("\n", lines);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", payload);
            
            // Optional: Show a brief success message (you could add a notification service call here)
            Console.WriteLine("Donor information copied to clipboard");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error copying to clipboard: {ex.Message}");
        }
    }
}