@* Components/Shared/ConfirmDialog.razor *@
@inject IStringLocalizer<Resource> Localizer
<div class="modal-overlay @(Show ? "show" : "")">
    <div class="modal-content">
        <h3>@DisplayTitle</h3>
        <p>@DisplayMessage</p>
        <div class="button-row">
            <RadzenButton Text="@DisplayCancelText"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@OnCancel"
                          Style="margin-right: 1rem;" />
            <RadzenButton Text="@DisplayConfirmText"
                          ButtonStyle="@ConfirmButtonStyle"
                          Click="@OnConfirm" />
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? ConfirmText { get; set; }
    [Parameter] public string? CancelText { get; set; }
    [Parameter] public ButtonStyle ConfirmButtonStyle { get; set; } = ButtonStyle.Danger;
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string DisplayTitle => string.IsNullOrWhiteSpace(Title) ? Localizer["Confirm"] : Title;
    private string DisplayMessage => string.IsNullOrWhiteSpace(Message) ? Localizer["AreYouSure"] : Message;
    private string DisplayConfirmText => string.IsNullOrWhiteSpace(ConfirmText) ? Localizer["Yes"] : ConfirmText;
    private string DisplayCancelText => string.IsNullOrWhiteSpace(CancelText) ? Localizer["No"] : CancelText;
}
