@using Radzen.Blazor
@using Cya2.Application.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject IStringLocalizer<Resource> Localizer
@inject AuthenticationStateProvider AuthStateProvider
@inject IAdminPreloadService AdminPreloadService
@inject IJSRuntime JS

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-3 accounts-overview-root" Style="overflow:auto;">
    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="1rem"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween"
                 Class="accounts-overview-toolbar">
        <!-- Left: current view label -->
        <RadzenText TextStyle="TextStyle.Subtitle1">
            @(showDonations12m ? Localizer["TotalDonationsLTM"] : Localizer["CurrentBalance"])
        </RadzenText>

        <!-- Right: actions -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Class="accounts-overview-actions">
            <RadzenButton Text="@(showDonations12m ? Localizer["CurrentBalance"] : Localizer["TotalDonationsLTM"])"
                          ButtonStyle="ButtonStyle.Primary"
                          Class="accounts-overview-btn"
                          title="@(!showDonations12m ? "Total Donations over the last twelve months." : null)"
                          Click="@(() => { showDonations12m = !showDonations12m; })" />
        </RadzenStack>
    </RadzenStack>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled">
            @errorMessage
        </RadzenAlert>
    }

    @if (isLoading)
    {
        <PageLoadingIndicator IsLoading="true" LoadingText="@Localizer["Loading"]" />
    }
    else
    {
    <RadzenCard>
        <RadzenDataGrid TItem="FundBalanceRow"
                        Data="@fundBalances"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="false"
                        EmptyText="@Localizer["NoBalancesFound"]">
            <Columns>
                <RadzenDataGridColumn TItem="FundBalanceRow" Property="Fund" Title="@Localizer["Account"]" />
                @if (!showDonations12m)
                {
                    <RadzenDataGridColumn TItem="FundBalanceRow" Property="CurrentBalance" Title="@Localizer["CurrentBalance"]" FormatString="{0:C2}" TextAlign="TextAlign.Right" />
                }
                else
                {
                    <RadzenDataGridColumn TItem="FundBalanceRow" Property="Last12MonthsDonations" Title="@Localizer["TotalDonationsLTM"]" FormatString="{0:C2}" TextAlign="TextAlign.Right" />
                }
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
    }
    <div class="text-muted mt-2 accounts-overview-footer" style="font-size:.85rem">
        <div>
            @if (!financialsLoaded)
            {
                <span>@Localizer["CalculatingDonations"]…</span>
            }
        </div>
        <div class="accounts-overview-footer-actions">
            <RadzenButton Text="@Localizer["CopyTable"]"
                          Icon="content_copy"
                          ButtonStyle="ButtonStyle.Primary"
                          Class="accounts-overview-btn"
                          Style="background-color: #0a3b6b; border-color: #0a3b6b;"
                          Click="CopyTableAsync" />
        </div>
    </div>
</RadzenStack>

<style>
    .accounts-overview-root {
        max-height: 100%;
    }

    .accounts-overview-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .accounts-overview-footer-actions {
        margin-left: auto;
        display: flex;
        justify-content: flex-end;
    }

    @@media (max-width: 768px) {
        .accounts-overview-toolbar {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 0.5rem !important;
        }

        .accounts-overview-actions {
            width: 100%;
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 0.5rem !important;
        }

        .accounts-overview-btn {
            width: 100%;
            justify-content: center;
            white-space: normal;
            text-align: center;
            height: auto;
            line-height: 1.2;
        }

        .accounts-overview-footer {
            flex-wrap: wrap;
            align-items: center;
        }

        .accounts-overview-footer-actions {
            margin-left: auto;
            width: auto;
        }
    }
</style>

@code {
    private string errorMessage = string.Empty;
    private List<FundBalanceRow> fundBalances = new();
    private bool showDonations12m = false; // default to balance view
    private bool financialsLoaded = false;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var accounts = await AdminPreloadService.GetAccountsAsync();

            fundBalances = accounts
                .OrderBy(a => a.Fund)
                .Select(a => new FundBalanceRow { Fund = a.Fund })
                .ToList();

            var overview = await AdminPreloadService.GetAccountOverviewAsync();
            fundBalances = overview
                .OrderBy(a => a.Fund)
                .Select(a => new FundBalanceRow
                {
                    Fund = a.Fund,
                    CurrentBalance = a.CurrentBalance,
                    Last12MonthsDonations = a.Last12MonthsDonations
                })
                .ToList();
            financialsLoaded = true;
            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading accounts: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task CopyTableAsync()
    {
        try
        {
            var header = showDonations12m ? Localizer["TotalDonationsLTM"] : Localizer["CurrentBalance"];
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"{Localizer["Account"]}\t{header}");
            foreach (var row in fundBalances)
            {
                var value = showDonations12m ? row.Last12MonthsDonations : row.CurrentBalance;
                sb.AppendLine($"{row.Fund}\t{value}");
            }
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        }
        catch (Exception ex)
        {
            errorMessage = $"Error copying table: {ex.Message}";
        }
    }

    private sealed class FundBalanceRow
    {
        public string Fund { get; set; } = string.Empty;
        public decimal CurrentBalance { get; set; }
        public decimal Last12MonthsDonations { get; set; }
    }
}
