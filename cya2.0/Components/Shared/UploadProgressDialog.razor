@using System.Text.Json
@using Radzen
@inject Cya2.Application.Interfaces.ISessionImportProgressService SessionImportProgressService
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject cya2.Services.Imports.ImportProgressService ProgressService
@inject IStringLocalizer<Resource> Localizer

@code {
    [Parameter] public string ProgressId { get; set; } = string.Empty;

    private System.Threading.Timer? _timer;

    private class ProgressDto
    {
        public int TotalRows { get; set; }
        public int InsertedRows { get; set; }
        public int FailedRows { get; set; }
        public int ExpectedRows { get; set; }
        public string? Status { get; set; }
        public bool IsComplete { get; set; }
        public List<string> Errors { get; set; } = new();
        public List<ImportStepDto> Steps { get; set; } = new();
        public string ImportType { get; set; } = string.Empty; // "Donations" or "Accounting"
    }
    
    private class ImportStepDto
    {
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public bool IsCompleted { get; set; }
        public bool IsActive { get; set; }
        public string Details { get; set; } = string.Empty;
    }

    private ProgressDto _p = new() { Status = "Waiting for server..." };
    private int Percent => _p.ExpectedRows > 0 ? (int)(100L * _p.TotalRows / _p.ExpectedRows) : 0;
    private bool _waitingForId => string.IsNullOrWhiteSpace(ProgressId);

    protected override void OnInitialized()
    {
        SessionImportProgressService.ImportProgressIdChanged += OnProgressIdChanged;
        // If session service already has an id (was set before dialog initialized), pick it up now
        if (!string.IsNullOrWhiteSpace(SessionImportProgressService.ImportProgressId))
        {
            OnProgressIdChanged(SessionImportProgressService.ImportProgressId!);
        }
        _timer = new System.Threading.Timer(async _ => await Poll(), null, 250, 750);
    }

    private void OnProgressIdChanged(string id)
    {
        ProgressId = id;
        _p.Status = "Starting...";
    }

    private async Task Poll()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(ProgressId))
            {
                _p.Status = "Waiting for ProgressId...";
                await InvokeAsync(StateHasChanged);
                return;
            }

            var srv = ProgressService.Get(ProgressId);
            if (srv == null)
            {
                _p.Status = "Initializing import...";
                await InvokeAsync(StateHasChanged);
                return;
            }

            _p.TotalRows = srv.TotalRows;
            _p.InsertedRows = srv.InsertedRows;
            _p.FailedRows = srv.FailedRows;
            _p.ExpectedRows = srv.ExpectedRows;
            _p.Status = string.IsNullOrWhiteSpace(srv.Status) ? "Processing..." : srv.Status;
            _p.Errors = srv.Errors?.ToList() ?? new List<string>();
            _p.IsComplete = srv.IsComplete;
            _p.ImportType = srv.ImportType ?? string.Empty;

            // Map steps
            _p.Steps = srv.Steps?.Select(s => new ImportStepDto
            {
                Name = s.Name,
                Status = s.Status,
                IsCompleted = s.IsCompleted,
                IsActive = s.IsActive,
                Details = s.Details
            }).ToList() ?? new List<ImportStepDto>();

            // If import is complete, stop polling and update status
            if (_p.IsComplete)
            {
                _timer?.Dispose();
                _timer = null;
                
                // Set final status without repeating row count
                if (_p.FailedRows > 0)
                {
                    _p.Status = $"{GetLocalizedString("Completed", "Completed")} - {_p.FailedRows} failed rows";
                }
                else
                {
                    _p.Status = GetLocalizedString("Completed", "Completed");
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _p.Status = $"Error polling progress: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        SessionImportProgressService.ImportProgressIdChanged -= OnProgressIdChanged;
        _timer?.Dispose();
        _timer = null;
    }
}

<div style="padding:1rem; min-width: 420px;">
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.Subtitle2">@GetDialogTitle()</RadzenText>
        
        @* Always reserve space for progress bar to prevent size changes *@
        <div style="min-height: 60px;">
            @if (_p.ExpectedRows > 0 && _p.Steps.Any(s => s.Name == "Data Import" && s.IsActive))
            {
                <RadzenProgressBar Value="@Percent" Max="100" ShowValue="true" />
                <div style="display: flex; justify-content: space-between; font-size: 0.9em; margin-top: 0.5rem;">
                    <span>@GetLocalizedString("Rows", "Rows"): @_p.TotalRows / @_p.ExpectedRows</span>
                    <span>@GetLocalizedString("Inserted", "Inserted"): @_p.InsertedRows</span>
                    <span>@GetLocalizedString("Failed", "Failed"): @_p.FailedRows</span>
                </div>
            }
            else
            {
                @* Invisible spacer to maintain consistent height *@
                <div style="height: 40px;"></div>
            }
        </div>

        @* Step-by-step progress - Each step gets its own permanent box *@
        <RadzenCard Style="background-color: #f8f9fa; padding: 0.75rem; min-height: 280px;">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                @* Define all possible steps with permanent display boxes *@
                
                @* Step 1: File Validation *@
                <div style="border: 1px solid @GetStepBorderColor("File Validation"); border-radius: 0.375rem; padding: 0.5rem; background-color: @GetStepBackgroundColor("File Validation"); min-height: 50px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        @GetStepIcon("File Validation")
                        <div style="flex: 1;">
                            <div style="font-weight: 600; color: #212529; font-size: 0.9em;">1. @GetLocalizedStepName("File Validation")</div>
                            <div style="font-size: 0.8em; color: #6c757d; margin-top: 0.125rem;">
                                @GetStepStatus("File Validation")
                            </div>
                            @if (!string.IsNullOrEmpty(GetStepDetails("File Validation")))
                            {
                                <div style="font-size: 0.75em; color: #495057; margin-top: 0.125rem; font-style: italic;">
                                    @GetStepDetails("File Validation")
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Step 2: Legacy Backup (conditional) *@
                @{
                    var legacyBackupStep = GetStep("Legacy Backup");
                }
                @if (legacyBackupStep != null)
                {
                    <div style="border: 1px solid @GetStepBorderColor("Legacy Backup"); border-radius: 0.375rem; padding: 0.5rem; background-color: @GetStepBackgroundColor("Legacy Backup"); min-height: 50px;">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            @GetStepIcon("Legacy Backup")
                            <div style="flex: 1;">
                                <div style="font-weight: 600; color: #212529; font-size: 0.9em;">2. @GetLocalizedStepName("Legacy Backup")</div>
                                <div style="font-size: 0.8em; color: #6c757d; margin-top: 0.125rem;">
                                    @GetStepStatus("Legacy Backup")
                                </div>
                                @if (!string.IsNullOrEmpty(GetStepDetails("Legacy Backup")))
                                {
                                    <div style="font-size: 0.75em; color: #495057; margin-top: 0.125rem; font-style: italic;">
                                        @GetStepDetails("Legacy Backup")
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @* Step 3: Data Analysis *@
                <div style="border: 1px solid @GetStepBorderColor("Data Analysis"); border-radius: 0.375rem; padding: 0.5rem; background-color: @GetStepBackgroundColor("Data Analysis"); min-height: 50px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        @GetStepIcon("Data Analysis")
                        <div style="flex: 1;">
                            <div style="font-weight: 600; color: #212529; font-size: 0.9em;">@(legacyBackupStep != null ? "3" : "2"). @GetLocalizedStepName("Data Analysis")</div>
                            <div style="font-size: 0.8em; color: #6c757d; margin-top: 0.125rem;">
                                @GetStepStatus("Data Analysis")
                            </div>
                            @if (!string.IsNullOrEmpty(GetStepDetails("Data Analysis")))
                            {
                                <div style="font-size: 0.75em; color: #495057; margin-top: 0.125rem; font-style: italic;">
                                    @GetStepDetails("Data Analysis")
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Step 4: Database Backup *@
                <div style="border: 1px solid @GetStepBorderColor("Database Backup"); border-radius: 0.375rem; padding: 0.5rem; background-color: @GetStepBackgroundColor("Database Backup"); min-height: 50px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        @GetStepIcon("Database Backup")
                        <div style="flex: 1;">
                            <div style="font-weight: 600; color: #212529; font-size: 0.9em;">@(legacyBackupStep != null ? "4" : "3"). @GetLocalizedStepName("Database Backup")</div>
                            <div style="font-size: 0.8em; color: #6c757d; margin-top: 0.125rem;">
                                @GetStepStatus("Database Backup")
                            </div>
                            @if (!string.IsNullOrEmpty(GetStepDetails("Database Backup")))
                            {
                                <div style="font-size: 0.75em; color: #495057; margin-top: 0.125rem; font-style: italic;">
                                    @GetStepDetails("Database Backup")
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Step 5: Data Import *@
                <div style="border: 1px solid @GetStepBorderColor("Data Import"); border-radius: 0.375rem; padding: 0.5rem; background-color: @GetStepBackgroundColor("Data Import"); min-height: 50px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        @GetStepIcon("Data Import")
                        <div style="flex: 1;">
                            <div style="font-weight: 600; color: #212529; font-size: 0.9em;">@(legacyBackupStep != null ? "5" : "4"). @GetLocalizedStepName("Data Import")</div>
                            <div style="font-size: 0.8em; color: #6c757d; margin-top: 0.125rem;">
                                @GetStepStatus("Data Import")
                            </div>
                            @if (!string.IsNullOrEmpty(GetStepDetails("Data Import")))
                            {
                                <div style="font-size: 0.75em; color: #495057; margin-top: 0.125rem; font-style: italic;">
                                    @GetStepDetails("Data Import")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </RadzenStack>
        </RadzenCard>

        @if (_waitingForId)
        {
            <div style="text-align: center; color: #6c757d; font-style: italic;">@GetLocalizedString("UploadInProgress", "Upload in progress...")</div>
        }

        @* Overall status *@
        <div style="font-size: 0.9em; color: #495057; padding: 0.5rem; background-color: #e9ecef; border-radius: 0.25rem;">
            @GetLocalizedString("Status", "Status"): @_p.Status
        </div>
        
        @* Errors section - Reserve space to prevent size changes *@
        <div style="min-height: 40px;">
            @if (_p.Errors?.Count > 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Title="@GetLocalizedString("ImportWarnings", "Import Warnings")" Shade="Shade.Light">
                    <ul style="margin: 0; padding-left: 1rem;">
                        @foreach (var e in _p.Errors.Take(10))
                        {
                            <li style="font-size: 0.85em;">@e</li>
                        }
                        @if (_p.Errors.Count > 10)
                        {
                            <li style="font-size: 0.85em;"><em>... and @(_p.Errors.Count - 10) more errors</em></li>
                        }
                    </ul>
                </RadzenAlert>
            }
        </div>
        
        @* Action buttons *@
        <div style="display:flex; justify-content:flex-end; padding-top: .5rem;">
            @if (_p.IsComplete)
            {
                <RadzenButton Text="@GetLocalizedString("Done", "Done")" ButtonStyle="ButtonStyle.Success" Click="@(() => DialogService.Close(true))" />
            }
            else
            {
                <RadzenButton Text="@GetLocalizedString("Close", "Close")" ButtonStyle="ButtonStyle.Primary" Click="@(() => DialogService.Close(false))" />
            }
        </div>
    </RadzenStack>
</div>

@code {
    private ImportStepDto? GetStep(string stepName)
    {
        return _p.Steps.FirstOrDefault(s => s.Name == stepName);
    }
    
    private string GetStepStatus(string stepName)
    {
        var step = GetStep(stepName);
        if (step == null) return GetLocalizedString("NotStarted", "Not started");
        return step.Status;
    }
    
    private string GetStepDetails(string stepName)
    {
        var step = GetStep(stepName);
        return step?.Details ?? string.Empty;
    }
    
    private string GetLocalizedStepName(string stepName)
    {
        return stepName switch
        {
            "File Validation" => GetLocalizedString("FileValidation", "File Validation"),
            "Legacy Backup" => GetLocalizedString("LegacyBackup", "Legacy Backup"),
            "Data Analysis" => GetLocalizedString("DataAnalysis", "Data Analysis"),
            "Database Backup" => GetLocalizedString("DatabaseBackup", "Database Backup"),
            "Data Import" => GetLocalizedString("DataImport", "Data Import"),
            _ => stepName
        };
    }
    
    private string GetLocalizedString(string key, string fallback)
    {
        try
        {
            var localized = Localizer[key];
            return localized.ResourceNotFound ? fallback : localized.Value;
        }
        catch
        {
            return fallback;
        }
    }
    
    private string GetDialogTitle()
    {
        return _p.ImportType switch
        {
            "Donations" => GetLocalizedString("UpdatingDonationDataTable", "Updating Donation Data Table"),
            "Accounting" => GetLocalizedString("UpdatingAccountingDataTable", "Updating Accounting Data Table"),
            _ => GetLocalizedString("DatabaseUpdateProgress", "Database Update Progress")
        };
    }
    
    private string GetStepBackgroundColor(string stepName)
    {
        var step = GetStep(stepName);
        if (step == null) return "#f8f9fa"; // Light gray (not started)
        if (step.IsCompleted) return "rgba(3, 166, 150, 0.1)"; // Very light teal from navbar gradient (completed)
        if (step.IsActive) return "rgba(5, 39, 103, 0.05)"; // Very light navy from navbar gradient (active)
        return "#f8f9fa"; // Light gray (not started)
    }
    
    private string GetStepBorderColor(string stepName)
    {
        var step = GetStep(stepName);
        if (step == null) return "#dee2e6"; // Light gray border
        if (step.IsCompleted) return "rgb(3, 166, 150)"; // Teal from navbar gradient (completed)
        if (step.IsActive) return "rgb(5, 39, 103)"; // Navy from navbar gradient (active)
        return "#dee2e6"; // Light gray border
    }
    
    private RenderFragment GetStepIcon(string stepName)
    {
        var step = GetStep(stepName);
        if (step == null)
        {
            return @<i class="bi bi-circle" style="color: #6c757d; font-size: 1.2em;"></i>;
        }
        
        if (step.IsCompleted)
        {
            return @<i class="bi bi-check-circle-fill" style="color: rgb(3, 166, 150); font-size: 1.2em;"></i>;
        }
        
        if (step.IsActive)
        {
            return @<div class="spinner-border spinner-border-sm" role="status" style="width: 1.2em; height: 1.2em; color: rgb(5, 39, 103);">
                        <span class="visually-hidden">Loading...</span>
                   </div>;
        }
        
        return @<i class="bi bi-circle" style="color: #6c757d; font-size: 1.2em;"></i>;
    }
}
