@inject DialogService DialogService
@inject IStringLocalizer<Resource> Localizer

<RadzenCard Class="upload-confirm-dialog-card" Style="padding: 1rem; width:100%; max-width:100%; box-sizing:border-box;">
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
        <RadzenText TextStyle="TextStyle.H6">Confirm File Upload</RadzenText>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Style="background-color:#f8f9fa; padding:0.75rem; border-radius:4px;">
            <div><b>File name:</b> @Preview?.FileName</div>
            <div><b>Size:</b> @(Preview == null ? "" : FormatSize(Preview.FileSizeBytes))</div>
            @if (Preview != null && !IsLikelyExcelFile(Preview))
            {
                <div style="color:#910813; font-weight:600;">
                    @Localizer["UploadInvalidExcelFormatMessage"]
                </div>
            }
        </RadzenStack>

        <RadzenText TextStyle="TextStyle.Body2">
            This file will be used to update the database. Are you sure this is the correct file?
        </RadzenText>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem" Class="upload-confirm-actions">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
            <RadzenButton Text="Confirm"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => DialogService.Close(true))"
                          Disabled="@(Preview == null || !IsLikelyExcelFile(Preview))" />
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

<style>
    .upload-confirm-dialog-card {
        min-width: 0 !important;
    }

    @@media (max-width: 768px) {
        .upload-confirm-actions {
            flex-direction: column !important;
            align-items: stretch !important;
        }

        .upload-confirm-actions .rz-button {
            width: 100%;
            justify-content: center;
            white-space: normal;
            text-align: center;
        }
    }
</style>

@code {
    [Parameter] public Cya2.Application.Interfaces.FilePreviewResult? Preview { get; set; }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        double kb = bytes / 1024d;
        if (kb < 1024) return $"{kb:F1} KB";
        double mb = kb / 1024d;
        if (mb < 1024) return $"{mb:F1} MB";
        double gb = mb / 1024d;
        return $"{gb:F1} GB";
    }

    private static bool IsLikelyExcelFile(Cya2.Application.Interfaces.FilePreviewResult preview)
    {
        var ext = Path.GetExtension(preview.FileName ?? string.Empty);
        var hasXlsxExtension = string.Equals(ext, ".xlsx", StringComparison.OrdinalIgnoreCase);

        var ct = (preview.ContentType ?? string.Empty).Trim();
        var knownExcelType = string.Equals(ct, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", StringComparison.OrdinalIgnoreCase)
                             || string.Equals(ct, "application/vnd.ms-excel", StringComparison.OrdinalIgnoreCase)
                             || string.Equals(ct, "application/octet-stream", StringComparison.OrdinalIgnoreCase)
                             || string.IsNullOrWhiteSpace(ct);

        return hasXlsxExtension && knownExcelType;
    }
}
