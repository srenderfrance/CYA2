@page "/donors"
@using Cya2.Shared.Utilities
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using cya2.Components.Shared
@using Cya2.Application.Interfaces
@using Cya2.Application.DTOs
@using Cya2.Core.ValueObjects
@using Cya2.Core.Enums
@using System.Security.Claims
@using System.Diagnostics
@inject AuthenticationStateProvider AuthStateProvider
@inject ISessionUserStateService SessionUserStateService
@inject IDateRangeStateService DateRangeStateService
@inject Cya2.Application.Interfaces.IUserIdResolver UserIdResolver
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [StreamRendering]
@inject IStringLocalizer<Resource> Localizer
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject ILogger<Donors> Logger
@inject IDonorService DonorService
@inject IUserAccountContextService UserAccountContextService
@inject IUserSelectionService UserSelectionService
@inject IUserDateRangeSelectionService DateRangeSelectionService
@inject cya2.Services.UserSessionHydrationService SessionHydrationService
@inject cya2.Services.Diagnostics.PageLoadCorrelationContext PageLoadCorrelation
@inject Cya2.Application.Interfaces.IAccountSnapshotWarmupService AccountSnapshotWarmupService
@inject Cya2.Application.Interfaces.IAccountSelectionCoordinator AccountSelectionCoordinator

<PageTitle>@Localizer["Donors"]</PageTitle>

@implements IDisposable

<RadzenStack Orientation="Orientation.Vertical" Gap="15px" Class="rz-p-4" Style="padding-top:0.5rem;">

    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="2rem"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Start"
                 Wrap="FlexWrap.Wrap"
                 Style="width:100%;">

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.4rem" Style="flex:1;">
            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="0.5rem"
                         AlignItems="AlignItems.Center"
                         Wrap="FlexWrap.Wrap">
                <div class="date-range-toolbar-box" style="display:flex;align-items:center;gap:0.5rem;">
                    <RadzenLabel Text="@Localizer["CommonRanges"]" />
                    <RadzenDropDown TValue="Cya2.Application.DTOs.DateRangePreset"
                                Data="@presetOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="@dateRangeState.SelectedPreset"
                                Change="@OnPresetChanged"
                                Style="width: 180px;">
                    <ValueTemplate>
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                            @(presetOptions.FirstOrDefault(o => o.Value == dateRangeState.SelectedPreset)?.Text ?? "")
                        </span>
                    </ValueTemplate>
                    <Template Context="opt">
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%;">
                            @opt.Text
                        </span>
                    </Template>
                </RadzenDropDown>
                </div>
                <div class="date-range-apply-group" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                    <div class="date-range-start-end-row" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:nowrap;">
                    <div style="display:flex;align-items:center;gap:0.5rem;">
                        <RadzenLabel Text="@Localizer["StartDate"]" />
                        <RadzenDatePicker @bind-Value="@dateRangeState.PendingStartDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                                          Change="@OnDatePickerChanged" />
                    </div>
                    <div style="display:flex;align-items:center;gap:0.5rem;">
                        <RadzenLabel Text="@Localizer["EndDate"]" />
                        <RadzenDatePicker @bind-Value="@dateRangeState.PendingEndDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                                          Change="@OnDatePickerChanged" />
                    </div>
                    </div>
                    <RadzenButton Text="@Localizer["Apply"]"
                                  Click="@selectDateRange"
                                  Size="ButtonSize.Small"
                                  Style="height: 38px;"
                                  ButtonStyle="ButtonStyle.Primary" />
                </div>
            </RadzenStack>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.4rem" Style="flex:1; max-width:300px;">
            <div class="date-range-toolbar-box account-selector-box">
                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:nowrap;">
                    <RadzenLabel Text="@Localizer["Account"]" />
                    <RadzenDropDown TValue="string"
                                Data="@userAccounts"
                                TextProperty="Fund"
                                ValueProperty="Fund"
                                @bind-Value="selectedAccount"
                                Change="@(async (args) => await accountSelection(args?.ToString() ?? string.Empty))"
                                Placeholder="@Localizer["ChooseAccount"]"
                                Class="account-selector-dropdown-inline">
                    <ValueTemplate>
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                            @DisplayFormatter.FormatFundDisplay(selectedAccount)
                        </span>
                    </ValueTemplate>
                    <Template Context="acct">
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%;">
                            @DisplayFormatter.FormatFundDisplay(acct.Fund)
                        </span>
                    </Template>
                    </RadzenDropDown>
                </div>
            </div>
        </RadzenStack>

    </RadzenStack>

    <div class="rz-mt-3" style="width:100%;">
        <div class="donor-search-info-shell">
            <div class="donor-search-row" style="margin-bottom:0.75rem; width:100%;">
                <div id="donorAutoCompleteContainer" style="flex:1; min-width:280px;">
                    <RadzenAutoComplete TValue="string"
                                        Data="@donorNames"
                                        @bind-Value="searchText"
                                        Placeholder="@Localizer["SearchDonors"]"
                                        Change="@OnAutocompleteChanged"
                                        Style="width:100%;"
                                        @oninput="OnSearchInput"
                                        @onkeydown="OnSearchKeyDown" />

                    @{
                        var suggestions = GetSearchSuggestions();
                    }
                    @if (suggestions.Any() && !isRadzenSuggestionVisible)
                    {
                        <div class="donor-search-suggestions" role="listbox" aria-label="Donor suggestions">
                            @foreach (var suggestion in suggestions)
                            {
                                <button type="button" class="donor-search-suggestion-item" @onclick="async () => await SelectSearchSuggestionAsync(suggestion)">
                                    @suggestion
                                </button>
                            }
                        </div>
                    }
                </div>
                <RadzenButton Text="Clear" Click="@(()=> ClearDonorSelection())" ButtonStyle="ButtonStyle.Light" Style="margin-left:0.5rem;" />
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedDonor))
            {
                <RadzenCard id="donor-info-card" Style="padding:0.75rem; margin-bottom:0.75rem;">
                    <div style="display:grid; grid-template-columns: 1fr; row-gap:6px; align-items:start;">
                        <div style="font-weight:600;">
                            <DonorInfoDisplay DonorName="@(string.IsNullOrWhiteSpace(selectedDonor) ? string.Empty : selectedDonor)"
                                             DonorEmail="@donorEmail"
                                             DonorPhoneMobile="@donorPhoneMobile"
                                             DonorPhoneFixed="@donorPhoneFixed"
                                             DonorAddress="@donorAddress"
                                             DonorCity="@donorCity"
                                             DonorState="@donorState"
                                             DonorPostal="@donorPostal"
                                             DonorCountry="@donorCountry"
                                             AdditionalStyling=""
                                             BoldValues="true"
                                             AllowTextSelection="false" />
                        </div>
                        <div style="text-align:right; margin-top:0.5rem;">
                            <RadzenButton Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(async () => await CopySelectedDonor())" Style="margin-bottom:0.25rem;" Text="@Localizer["Copy"]" />
                        </div>
                    </div>
                </RadzenCard>
            }
        </div>

        <RadzenCard Style="padding:0.5rem; margin-top:0.75rem; width:100%;">
                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["SelectedDonors"]</RadzenText>

                <div style="margin-top:0.5rem; display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap; justify-content:space-between; width:100%;">
                    <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap; flex:1;">
                        <label style="font-weight:600; color:#666; margin-right:0.5rem;">@Localizer["ColumnSelection"]</label>
                        <div style="display:flex; gap:0.5rem; align-items:center;">
                            <RadzenCheckBox @bind-Value="showEmail" /> <span>@Localizer["Email"]</span>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items:center;">
                            <RadzenCheckBox @bind-Value="showPhone" /> <span>@Localizer["Phone"]</span>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items:center;">
                            <RadzenCheckBox @bind-Value="showAddress" /> <span>@Localizer["Address"]</span>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items:center;">
                            <RadzenCheckBox @bind-Value="showFrequency" /> <span>@Localizer["Frequency"]</span>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items:center;">
                            <RadzenCheckBox @bind-Value="showTotal" /> <span>@Localizer["TotalGiven"]</span>
                        </div>
                    </div>
                    <div style="display:flex; gap:0.5rem; align-items:center;">
                        <RadzenButton Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(async () => await CopyDonorsInRange())" Style="margin-bottom:0.25rem;">@Localizer["Copy"]</RadzenButton>
                        <RadzenButton Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click="@(async () => await DownloadDonorsExcel())" Style="margin-bottom:0.25rem;">@Localizer["DownloadExcel"]</RadzenButton>
                        <div style="display:flex; gap:0.4rem; align-items:center; margin-left:0.5rem;">
                            <RadzenLabel Text="@Localizer["CompactView"]" />
                            <RadzenCheckBox @bind-Value="useCompactView" />
                        </div>
                    </div>
                </div>

                <SectionLoadingBoundary IsLoading="isLoading && !hasDonorResults" LoadingText="@Localizer["Loading"]" MinHeight="260px" UseCardSurface="false">
                <div class="donors-grid-scroll">
                <RadzenDataGrid TItem="DonorSummaryDto" 
                                Data="@donorsInRange" 
                                Dense="@useCompactView" 
                                Class="@(useCompactView ? "donors-data-grid compact-data-grid" : "donors-data-grid")" 
                                Style="width:100%;"
                                AllowVirtualization="false"
                                RowSelect="@(async (args) => await OnDonorRowSelect(args))">
                    <Columns>
                        <RadzenDataGridColumn TItem="DonorSummaryDto" Property="DisplayName" Title="@Localizer["Donor"]" Width="280px" Frozen="true" />
                        @if (showEmail)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="Email" Title="@Localizer["Email"]" Width="260px" />
                        }
                        @if (showPhone)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="PhoneSummary" Title="@Localizer["Phone"]" Width="180px" />
                        }
                        @if (showAddress)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="DisplayAddress" Title="@Localizer["Address"]" Width="380px" />
                        }
                        @if (showFrequency)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="FrequencyLabel" Title="@Localizer["Frequency"]" Width="130px" />
                        }
                        @if (showTotal)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="Total" Title="@Localizer["TotalGiven"]" FormatString="{0:C2}" Width="140px" />
                        }
                    </Columns>
                </RadzenDataGrid>
                </div>
                </SectionLoadingBoundary>
            </RadzenCard>
    </div>

</RadzenStack>

<style>
    .donor-search-info-shell {
        width: 100%;
        max-width: 320px;
    }

    .donor-search-suggestions {
        margin-top: 0.25rem;
        border: 1px solid #d9dee5;
        border-radius: 6px;
        background: #fff;
        max-height: 220px;
        overflow-y: auto;
        z-index: 20;
        position: relative;
    }

    .donor-search-suggestion-item {
        display: block;
        width: 100%;
        text-align: left;
        border: 0;
        background: transparent;
        padding: 0.35rem 0.5rem;
        font-size: 0.95rem;
        cursor: pointer;
    }

    .donor-search-suggestion-item:hover {
        background: #dce6f0;
    }

    @@media (max-width: 992px) {
        .donors-data-grid .rz-datatable-scrollable-body {
            max-height: 65vh;
            overflow: auto !important;
            scrollbar-gutter: stable both-edges;
            scrollbar-width: auto;
        }

        .donors-data-grid .rz-datatable-scrollable-table-wrapper,
        .donors-data-grid .rz-grid-table,
        .donors-data-grid .rz-datatable-scrollable-table-wrapper > table,
        .donors-data-grid .rz-grid-table > table {
            width: auto !important;
            min-width: 100% !important;
            table-layout: auto !important;
        }
    }
</style>

@code {
    private Cya2.Application.DTOs.DateRangeStateDto dateRangeState = new();
    private List<Cya2.Application.DTOs.DateRangePresetOptionDto> presetOptions = new();

    private string selectedAccount = string.Empty;
    private AccountOptionDto? currentAccount = null;
    private List<AccountOptionDto> userAccounts = new();

    private List<string> donorNames = new();
    private string searchText = string.Empty;
    private string? selectedDonor;

    private string donorEmail = string.Empty;
    private string donorPhoneMobile = string.Empty;
    private string donorPhoneFixed = string.Empty;
    private string donorAddress = string.Empty;
    private string donorCity = string.Empty;
    private string donorState = string.Empty;
    private string donorPostal = string.Empty;
    private string donorCountry = string.Empty;
    private List<DonorSummaryDto> donorsInRange = new();
    private bool showTotal = false;
    private bool showEmail = true;
    private bool showPhone = true;
    private bool showAddress = true;
    private bool showCountry = false;
    private bool showPaymentMethod = false;
    private bool showFrequency = false;
    private bool useCompactView = false;
    private bool showSubAccountDropdown = false;
    private string selectedSubAccount = "All";
    private List<SubAccountOptionDto> subAccountOptions = new();
    private readonly Dictionary<int, List<Cya2.Core.Entities.SubAccount>> subAccountsByAccountId = new();
    private string? lastDonorLoadKey;

    private string userId = string.Empty;
    private bool isAdminOrViewer = false;
    private bool isLoading = false;
    private bool hasDonorResults = false;
    private bool isRadzenSuggestionVisible = false;

    protected override async Task OnInitializedAsync()
    {
        // using var operationScope = PageLoadCorrelation.BeginOperation(Logger, nameof(Donors), "Initialize");
        var initSw = Stopwatch.StartNew();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            userId = SessionHydrationService.HydrateForUser(user);

            var authLevel = user.FindFirstValue("AuthLevel") ?? string.Empty;
            isAdminOrViewer = user.IsInRole("Admin")
                      || string.Equals(authLevel, "Admin", StringComparison.OrdinalIgnoreCase)
                      || string.Equals(authLevel, "Viewer", StringComparison.OrdinalIgnoreCase);

            presetOptions = GetPresetOptions();
            dateRangeState = DateRangeStateService.InitializeDateRange(SessionUserStateService);
            Logger.LogInformation("[Donors] Init state user={UserId} preset={Preset} range={Start:yyyy-MM-dd}..{End:yyyy-MM-dd} sessionSelected='{SessionSelected}' sessionDefault='{SessionDefault}'",
                userId,
                dateRangeState.SelectedPreset,
                dateRangeState.StartDate,
                dateRangeState.EndDate,
                SessionUserStateService.SelectedAccountFund,
                SessionUserStateService.DefaultAccountFund);

            var userContext = await UserAccountContextService.GetContextAsync(userId, isAdminOrViewer);
            userAccounts = userContext?.Accounts.Select(account => new AccountOptionDto
            {
                AccountId = account.AccountId,
                Fund = account.Fund,
                AccountingClass = account.AccountingClass,
                AccountNumber = account.AccountNumber,
                Overhead = account.Overhead
            }).ToList() ?? new List<AccountOptionDto>();

            if (userAccounts.Any())
            {
                selectedAccount = !string.IsNullOrEmpty(SessionUserStateService.SelectedAccountFund)
                    ? SessionUserStateService.SelectedAccountFund
                    : (!string.IsNullOrEmpty(SessionUserStateService.DefaultAccountFund)
                        ? SessionUserStateService.DefaultAccountFund
                        : userAccounts.First().Fund);

                currentAccount = userAccounts.FirstOrDefault(a => a.Fund == selectedAccount) ?? userAccounts.FirstOrDefault();
                if (currentAccount != null)
                {
                    selectedAccount = currentAccount.Fund;
                    SessionUserStateService.SelectedAccountFund = selectedAccount;
                    if (!string.IsNullOrWhiteSpace(userId))
                    {
                        UserSelectionService.SetSelectedAccount(userId, selectedAccount);
                    }
                }

                if (string.IsNullOrWhiteSpace(SessionUserStateService.DefaultAccountFund))
                    SessionUserStateService.DefaultAccountFund = userAccounts.FirstOrDefault()?.Fund ?? string.Empty;

                if (currentAccount != null)
                {
                    await LoadSubAccountOptionsAsync(currentAccount.AccountId);
                    await BuildDonorsInRange(currentAccount);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Donors page");
        }
        finally
        {
            isLoading = false;
            // Logger.LogInformation("Donors init complete user={UserId} selectedAccount={SelectedAccount} accounts={AccountCount} donors={DonorCount} elapsedMs={ElapsedMs}",
            //     userId,
            //     selectedAccount,
            //     userAccounts?.Count ?? 0,
            //     donorsInRange?.Count ?? 0,
            //     initSw.ElapsedMilliseconds);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("import", "/js/autocomplete-tab.js");
                await JS.InvokeVoidAsync("enableAutocompleteTabBehavior", "donorAutoCompleteContainer");
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("console.error", ex.Message);
            }
        }
    }

    private async Task LoadSubAccountOptionsAsync(int accountId)
    {
        var subAccounts = await GetSubAccountsForAccountAsync(accountId);
        ConfigureSubAccountOptions(subAccounts);
    }

    private void ConfigureSubAccountOptions(List<Cya2.Core.Entities.SubAccount> subAccounts)
    {

        var separate = subAccounts
            .Where(sa => string.Equals(sa.Kind, "Separate", StringComparison.OrdinalIgnoreCase))
            .ToList();

            PrepareDonorRows(donorsInRange);

        showSubAccountDropdown = separate.Any();
        subAccountOptions = new List<SubAccountOptionDto>();
        selectedSubAccount = "All";

        if (!showSubAccountDropdown) return;

        subAccountOptions.Add(new SubAccountOptionDto { Value = "All", DisplayText = "All", IsAll = true });
        subAccountOptions.Add(new SubAccountOptionDto
        {
            Value = "Primary",
            DisplayText = DisplayFormatter.FormatFundDisplay(currentAccount?.Fund ?? string.Empty),
            IsPrimary = true,
            SubFund = currentAccount?.Fund
        });
        foreach (var sa in separate)
        {
            subAccountOptions.Add(new SubAccountOptionDto
            {
                Value = $"Sub_{sa.Id}",
                DisplayText = DisplayFormatter.FormatFundDisplay(sa.SubFund),
                SubAccountId = sa.Id,
                SubFund = sa.SubFund
            });
        }
    }

    private async Task<List<string>> ResolveFundNamesAsync(AccountOptionDto account, string selectedValue)
    {
        var subAccounts = await GetSubAccountsForAccountAsync(account.AccountId);

        var separate = subAccounts
            .Where(sa => string.Equals(sa.Kind, "Separate", StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (selectedValue == "Primary")
            return new List<string> { account.Fund };

        if (selectedValue == "All")
        {
            var funds = new List<string> { account.Fund };
            funds.AddRange(separate.Select(sa => sa.SubFund));
            return funds;
        }

        if (selectedValue.StartsWith("Sub_") && int.TryParse(selectedValue[4..], out int subId))
        {
            var target = separate.FirstOrDefault(sa => sa.Id == subId);
            if (target != null) return new List<string> { target.SubFund };
        }

        return new List<string> { account.Fund };
    }

    private async Task LoadDonorNamesForAccount(AccountOptionDto account)
    {
        if (showSubAccountDropdown)
        {
            var funds = await ResolveFundNamesAsync(account, selectedSubAccount);
            donorNames = await DonorService.GetDonorNamesAsync(funds.FirstOrDefault() ?? account.Fund);
        }
        else
        {
            donorNames = await DonorService.GetDonorNamesAsync(account.Fund);
        }
    }

    private async Task BuildDonorsInRange(AccountOptionDto? account)
    {
        var loadSw = Stopwatch.StartNew();
        donorsInRange = new List<DonorSummaryDto>();
        if (account is not { } currentAccount)
        {
            return;
        }

        var rangeKey = dateRangeState.SelectedPreset == Cya2.Application.DTOs.DateRangePreset.AllDates
            ? "all"
            : $"{dateRangeState.StartDate:yyyyMMdd}|{dateRangeState.EndDate:yyyyMMdd}";
        var requestKey = $"{userId}|{currentAccount.AccountId}|{selectedSubAccount}|{dateRangeState.SelectedPreset}|{rangeKey}";
        if (string.Equals(lastDonorLoadKey, requestKey, StringComparison.OrdinalIgnoreCase))
        {
            Logger.LogInformation("[Donors] Skipping duplicate in-memory load for request={RequestKey}", requestKey);
            return;
        }

        try
        {
            Logger.LogInformation("[Donors] BuildDonorsInRange start user={UserId} account='{Account}' accountId={AccountId} preset={Preset} subAccount='{SubAccount}' range={Start:yyyy-MM-dd}..{End:yyyy-MM-dd} showSubAccountDropdown={ShowSubAccountDropdown}",
                userId,
                currentAccount.Fund,
                currentAccount.AccountId,
                dateRangeState.SelectedPreset,
                selectedSubAccount,
                dateRangeState.StartDate,
                dateRangeState.EndDate,
                showSubAccountDropdown);

            var range = dateRangeState.SelectedPreset == Cya2.Application.DTOs.DateRangePreset.AllDates
                ? null
                : new DateRange(dateRangeState.StartDate, dateRangeState.EndDate);
            donorsInRange = await DonorService.GetDonorSummariesForSelectionAsync(
                currentAccount,
                selectedSubAccount,
                range);

            PrepareDonorRows(donorsInRange);
            donorNames = donorsInRange
                .Select(d => d.Name)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n)
                .ToList();
            hasDonorResults = true;

            SessionUserStateService.SelectedAccountFund = currentAccount.Fund;
            if (!string.IsNullOrWhiteSpace(userId))
                UserSelectionService.SetSelectedAccount(userId, currentAccount.Fund);

            Logger.LogInformation("Loaded {Count} donors for account '{Fund}'", donorsInRange.Count, currentAccount.Fund);
            // Logger.LogInformation("Donors data load complete user={UserId} account={Account} subAccount={SubAccount} preset={Preset} range={Start:yyyy-MM-dd}..{End:yyyy-MM-dd} rows={Rows} elapsedMs={ElapsedMs}",
            //     userId,
            //     currentAccount.Fund,
            //     selectedSubAccount,
            //     dateRangeState.SelectedPreset,
            //     dateRangeState.StartDate,
            //     dateRangeState.EndDate,
            //     donorsInRange.Count,
            //     loadSw.ElapsedMilliseconds);
            lastDonorLoadKey = requestKey;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error building donors in range");
        }
    }

    private async Task OnDonorSelected()
    {
        if (string.IsNullOrWhiteSpace(selectedDonor))
        {
            ClearDonorSelection();
            return;
        }

        ResetDonorContact();

        var selectedSummary = donorsInRange.FirstOrDefault(d => string.Equals(d.Name, selectedDonor, StringComparison.OrdinalIgnoreCase));
        if (selectedSummary != null)
        {
            donorEmail = selectedSummary.Email ?? string.Empty;
            donorPhoneMobile = selectedSummary.PhoneMobile ?? string.Empty;
            donorPhoneFixed = selectedSummary.PhoneFixed ?? string.Empty;
            donorAddress = selectedSummary.AddressSummary ?? string.Empty;
            donorCity = selectedSummary.City ?? string.Empty;
            donorState = selectedSummary.State ?? string.Empty;
            donorPostal = selectedSummary.PostalCode ?? string.Empty;
            donorCountry = selectedSummary.Country ?? string.Empty;
        }

        if (currentAccount != null && string.IsNullOrWhiteSpace(donorEmail) &&
            string.IsNullOrWhiteSpace(donorPhoneMobile) && string.IsNullOrWhiteSpace(donorPhoneFixed) &&
            string.IsNullOrWhiteSpace(donorAddress) && string.IsNullOrWhiteSpace(donorCity) &&
            string.IsNullOrWhiteSpace(donorState) && string.IsNullOrWhiteSpace(donorPostal) &&
            string.IsNullOrWhiteSpace(donorCountry))
        {
            var detail = await GetDonorDetailForCurrentSelectionAsync(selectedDonor);
            if (detail != null)
            {
                donorEmail = detail.Email;
                donorPhoneMobile = detail.PhoneMobile;
                donorPhoneFixed = detail.PhoneFixed;
                donorAddress = detail.Address;
                donorCity = detail.City;
                donorState = detail.State;
                donorPostal = detail.PostalCode;
                donorCountry = detail.Country;
            }
        }

        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("scrollToIfHidden", "donor-info-card");
    }

    private async Task<DonorDetailDto?> GetDonorDetailForCurrentSelectionAsync(string donorName)
    {
        if (currentAccount == null)
        {
            return null;
        }

        return await DonorService.GetDonorDetailForAccountAsync(donorName, currentAccount);
    }

    private async Task<List<Cya2.Core.Entities.SubAccount>> GetSubAccountsForAccountAsync(int accountId)
    {
        if (subAccountsByAccountId.TryGetValue(accountId, out var cached))
        {
            return cached;
        }

        var subAccounts = await DonorService.GetSubAccountsForAccountAsync(accountId);
        subAccountsByAccountId[accountId] = subAccounts;
        return subAccounts;
    }

    private async Task OnAutocompleteChanged(object? args)
    {
        searchText = args?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(searchText)) return;

        var typed = searchText.Trim();
        var resolved = donorNames.FirstOrDefault(d => string.Equals(d, typed, StringComparison.OrdinalIgnoreCase));
        if (string.IsNullOrWhiteSpace(resolved))
        {
            return;
        }

        selectedDonor = resolved;
        searchText = string.Empty;
        await OnDonorSelected();
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        searchText = args?.Value?.ToString() ?? string.Empty;
        await UpdateAutocompletePopupVisibilityAsync();
    }

    private List<string> GetSearchSuggestions()
    {
        if (string.IsNullOrWhiteSpace(searchText) || selectedDonor == searchText)
        {
            return new List<string>();
        }

        var typed = searchText.Trim();
        return donorNames
            .Where(d => d.StartsWith(typed, StringComparison.OrdinalIgnoreCase)
                     || d.IndexOf(typed, StringComparison.OrdinalIgnoreCase) >= 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();
    }

    private async Task SelectSearchSuggestionAsync(string donorName)
    {
        selectedDonor = donorName;
        searchText = string.Empty;
        isRadzenSuggestionVisible = false;
        await OnDonorSelected();
    }

    private async Task UpdateAutocompletePopupVisibilityAsync()
    {
        try
        {
            isRadzenSuggestionVisible = await JS.InvokeAsync<bool>("isAutocompletePopupVisible", "donorAutoCompleteContainer");
        }
        catch
        {
            isRadzenSuggestionVisible = false;
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Tab")
        {
            var text = searchText?.Trim() ?? string.Empty;
            if (!string.IsNullOrEmpty(text))
            {
                var exact = donorNames.FirstOrDefault(d => string.Equals(d, text, StringComparison.OrdinalIgnoreCase));
                if (!string.IsNullOrEmpty(exact))
                {
                    selectedDonor = exact;
                    searchText = string.Empty;
                    await OnDonorSelected();
                    return;
                }

                var partialMatches = donorNames
                    .Where(d => d.StartsWith(text, StringComparison.OrdinalIgnoreCase)
                             || d.IndexOf(text, StringComparison.OrdinalIgnoreCase) >= 0)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Take(10)
                    .ToList();

                if (partialMatches.Count == 1)
                {
                    selectedDonor = partialMatches[0];
                    searchText = string.Empty;
                    await OnDonorSelected();
                }
                else if (partialMatches.Count > 1)
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Summary = Localizer["SearchDonors"],
                        Detail = "Multiple matches found. Please choose a donor from the list.",
                        Duration = 3000
                    });
                }
            }
        }
    }

    private async Task OnDonorRowSelect(DonorSummaryDto summary)
    {
        if (summary == null) return;
        selectedDonor = summary.Name;
        searchText = string.Empty;
        await OnDonorSelected();
    }

    private void OnPresetChanged(object? args)
    {
        if (args is Cya2.Application.DTOs.DateRangePreset preset)
        {
            DateRangeStateService.ApplyPreset(dateRangeState, preset);
            if (preset != Cya2.Application.DTOs.DateRangePreset.Custom)
                _ = selectDateRange();
            else
                StateHasChanged();
        }
    }

    private void OnDatePickerChanged()
    {
        DateRangeStateService.ApplyPendingDates(dateRangeState);
        StateHasChanged();
    }

    private void ClearDonorSelection()
    {
        selectedDonor = null;
        searchText = string.Empty;
        ResetDonorContact();
        StateHasChanged();
    }

    private void ResetDonorContact()
    {
        donorEmail = string.Empty;
        donorPhoneMobile = string.Empty;
        donorPhoneFixed = string.Empty;
        donorAddress = string.Empty;
        donorCity = string.Empty;
        donorState = string.Empty;
        donorPostal = string.Empty;
        donorCountry = string.Empty;
    }

    private async Task selectDateRange()
    {
        isLoading = true;
        if (dateRangeState.SelectedPreset == Cya2.Application.DTOs.DateRangePreset.AllDates)
        {
            // All Donors uses a no-date-filter DB query — don't touch shared date range state.
            if (currentAccount != null)
                await BuildDonorsInRange(currentAccount);
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            DateRangeStateService.ApplyPendingDates(dateRangeState);
            DateRangeStateService.SaveDateRangeToSessionState(SessionUserStateService, dateRangeState);
            if (!string.IsNullOrWhiteSpace(userId))
            {
                DateRangeSelectionService.SetDateRange(userId, dateRangeState.StartDate, dateRangeState.EndDate, dateRangeState.SelectedPreset.ToString());
            }
            if (currentAccount != null)
                await BuildDonorsInRange(currentAccount);
        }
        finally
        {
            isLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() { }

    private List<Cya2.Application.DTOs.DateRangePresetOptionDto> GetPresetOptions()
    {
        return new List<Cya2.Application.DTOs.DateRangePresetOptionDto>
        {
            new() { Text = Localizer["AllDates"],        Value = Cya2.Application.DTOs.DateRangePreset.AllDates },
            new() { Text = Localizer["ThisYear"],         Value = Cya2.Application.DTOs.DateRangePreset.ThisYear },
            new() { Text = Localizer["Previous12Months"], Value = Cya2.Application.DTOs.DateRangePreset.Previous12Months },
            new() { Text = Localizer["LastYear"],         Value = Cya2.Application.DTOs.DateRangePreset.LastYear },
            new() { Text = Localizer["ThisMonth"],        Value = Cya2.Application.DTOs.DateRangePreset.ThisMonth },
            new() { Text = Localizer["LastMonth"],        Value = Cya2.Application.DTOs.DateRangePreset.LastMonth },
            new() { Text = Localizer["CustomRange"],      Value = Cya2.Application.DTOs.DateRangePreset.Custom }
        };
    }

    private static void PrepareDonorRows(IEnumerable<DonorSummaryDto> rows)
    {
        foreach (var donor in rows)
        {
            donor.DisplayName = string.IsNullOrWhiteSpace(donor.SourceSummary)
                ? donor.Name
                : $"{donor.Name} ({donor.SourceSummary})";
            donor.DisplayAddress = FormatMailingAddress(donor);
            donor.FrequencyLabel = GetFrequencyLabel(donor.Frequency);
        }
    }

    private DateRange? GetDonorSummaryWarmupRange()
    {
        return dateRangeState.SelectedPreset == Cya2.Application.DTOs.DateRangePreset.AllDates
            ? null
            : new DateRange(dateRangeState.StartDate, dateRangeState.EndDate);
    }

    private async Task accountSelection(string accountName)
    {
        if (string.IsNullOrEmpty(accountName)) return;

        isLoading = true;
        try
        {
            currentAccount = userAccounts.FirstOrDefault(a => a.Fund == accountName);
            if (currentAccount != null)
            {
                var account = new UserAccountContextAccount
                {
                    AccountId = currentAccount.AccountId,
                    Fund = currentAccount.Fund,
                    AccountingClass = currentAccount.AccountingClass,
                    AccountNumber = currentAccount.AccountNumber,
                    Overhead = currentAccount.Overhead
                };
                await AccountSelectionCoordinator.SelectAsync(account, userId, isAdminOrViewer, persistSelection: true, donorSummaryRange: GetDonorSummaryWarmupRange());
                selectedAccount = accountName;
                lastDonorLoadKey = null;
                await LoadSubAccountOptionsAsync(currentAccount.AccountId);
                await BuildDonorsInRange(currentAccount);
            }

            ClearDonorSelection();
        }
        finally
        {
            isLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopySelectedDonor()
    {
        if (string.IsNullOrWhiteSpace(selectedDonor))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["Copy"], Detail = Localizer["NoDonorSelected"], Duration = 3000 });
            return;
        }

        var payload = await DonorService.FormatDonorContactForCopyAsync(selectedDonor, currentAccount?.Fund ?? string.Empty);
        if (string.IsNullOrWhiteSpace(payload))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["Copy"], Detail = Localizer["NoDonorSelected"], Duration = 3000 });
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", payload);
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = Localizer["Copy"], Detail = Localizer["CopiedToClipboard"], Duration = 3000 });
    }

    private async Task CopyDonorsInRange()
    {
        if (donorsInRange == null || !donorsInRange.Any())
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["Copy"], Detail = Localizer["NoDonorsInRange"], Duration = 3000 });
            return;
        }

        var rows = donorsInRange.Select(d =>
        {
            var parts = new List<string> { d.Name };
            if (showTotal) parts.Add(d.Total.ToString("C2"));
            if (showPaymentMethod) parts.Add(d.PaymentMethod);
            parts.Add(GetFrequencyLabel(d.Frequency));
            if (showEmail) parts.Add(d.Email);
            if (showPhone) parts.Add(d.PhoneSummary);
            if (showAddress) parts.Add(d.DisplayAddress);
            return string.Join('\t', parts);
        });
        var payload = string.Join("\n", rows);

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", payload);
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = Localizer["Copy"], Detail = Localizer["CopiedToClipboard"], Duration = 3000 });
    }

    private async Task DownloadDonorsExcel()
    {
        if (currentAccount == null)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["DownloadExcel"], Detail = Localizer["NoAccountSelected"], Duration = 3000 });
            return;
        }

        var funds = await ResolveFundNamesAsync(currentAccount, selectedSubAccount);

        var req = new
        {
            Funds = funds,
            AllDates = dateRangeState.SelectedPreset == Cya2.Application.DTOs.DateRangePreset.AllDates,
            StartDate = dateRangeState.SelectedPreset == Cya2.Application.DTOs.DateRangePreset.AllDates ? (DateTime?)null : dateRangeState.StartDate,
            EndDate = dateRangeState.SelectedPreset == Cya2.Application.DTOs.DateRangePreset.AllDates ? (DateTime?)null : dateRangeState.EndDate,
            IncludeTotal = showTotal,
            IncludePaymentMethod = showPaymentMethod,
            IncludeEmail = showEmail,
            IncludePhone = showPhone,
            IncludeAddress = showAddress,
            IncludeFrequency = showFrequency
        };

        var payload = System.Text.Json.JsonSerializer.Serialize(req);
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/post-download-module.js?v=1");
        await module.InvokeVoidAsync("postJsonAndDownload", "/api/donors/export-data", payload);
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["DownloadExcel"], Detail = Localizer["DownloadStarted"], Duration = 3000 });
    }

    private static string GetFrequencyLabel(DonorFrequency frequency) => frequency switch
    {
        DonorFrequency.OneTime  => "One-time",
        DonorFrequency.Monthly  => "Monthly",
        DonorFrequency.Quarterly => "Quarterly",
        DonorFrequency.Yearly   => "Yearly",
        DonorFrequency.Sporadic => "Sporadic",
        _                       => ""
    };

    private static string FormatMailingAddress(DonorSummaryDto donor)
    {
        var cityStatePostal = string.Join(", ", new[]
        {
            donor.City,
            donor.State
        }.Where(v => !string.IsNullOrWhiteSpace(v)));

        if (!string.IsNullOrWhiteSpace(donor.PostalCode))
        {
            cityStatePostal = string.IsNullOrWhiteSpace(cityStatePostal)
                ? donor.PostalCode
                : $"{cityStatePostal} {donor.PostalCode}";
        }

        var parts = new List<string>
        {
            donor.AddressSummary,
            cityStatePostal
        };

        if (!string.IsNullOrWhiteSpace(donor.Country) &&
            !string.Equals(donor.Country.Trim(), "United States", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add(donor.Country);
        }

        return string.Join(", ", parts.Where(v => !string.IsNullOrWhiteSpace(v)));
    }
