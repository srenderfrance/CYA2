@page "/login-error"
@using Microsoft.AspNetCore.Authorization
@inject IStringLocalizer<Resource> Localizer
@attribute [AllowAnonymous]

<PageTitle>@Localizer["LoginError"]</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h3 class="text-center mb-0">@Localizer["CouldNotProcessSignIn"]</h3>
            </div>
            <div class="card-body text-center">
                <p>@Localizer["LoginAttemptNotCompleted"]</p>
                <p>@Localizer["TrySigningInAgain"]</p>
                <a href="/api/login" class="btn btn-primary mt-2">
                    <i class="bi bi-google me-2"></i> @Localizer["TrySignInAgain"]
                </a>
            </div>
        </div>
    </div>
</div>
