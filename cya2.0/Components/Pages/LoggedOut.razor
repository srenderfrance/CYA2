@page "/logged-out"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Localizer["LoggedOutTitle"]</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="bi bi-box-arrow-right" style="font-size: 3rem; color: #0d6efd;"></i>
                    </div>
                    <h2 class="card-title mb-3">@Localizer["LoggedOutHeader"]</h2>
                    <p class="card-text mb-4">@Localizer["LoggedOutMessage"]</p>
                    <a href="/" class="btn btn-primary btn-lg">
                        <i class="bi bi-google me-2"></i> @Localizer["SignInWithGoogle"]
                    </a>
                </div>
                <div class="card-footer text-center text-muted py-3">
                    <small>&copy; @DateTime.Now.Year - @Localizer["AppName"]</small>
                </div>
            </div>
        </div>
    </div>
</div>

