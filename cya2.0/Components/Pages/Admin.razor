    <!-- Rollback Dialog -->
    @if (showRollbackDialog)
    {
        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 10000; display: flex; align-items: center; justify-content: center;">
            <RadzenCard Class="admin-rollback-dialog" Style="width:min(96vw, 600px); min-width:0; max-width:96vw; padding: 1rem; background: white; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); box-sizing:border-box;">
