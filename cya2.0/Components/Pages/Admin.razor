        // Rollback functionality implementation
        private async Task OpenRollbackDialog()
        {
            try
            {
                rollbackError = string.Empty;
                rollbackStatus = string.Empty;
                rollbackTarget = string.Empty;
                rollbackAvailability = null;
                
                // Check what backups are available
                var availability = await RollbackService.GetRollbackAvailabilityAsync();
                rollbackAvailability = availability;
                
                if (!availability.CanRollback)
                {
                    if (!string.IsNullOrEmpty(availability.ErrorMessage))
                    {
                        rollbackError = availability.ErrorMessage;
                    }
                    else
                    {
                        rollbackError = "No recent backups are available for rollback.";
                    }
                    showRollbackDialog = true;
                    return;
                }
                
                // Show available rollback options
                showRollbackDialog = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                rollbackError = $"Error checking rollback availability: {ex.Message}";
                showRollbackDialog = true;
            }
        }

        private string GetRollbackOptionText(string target)
        {
            if (rollbackAvailability == null)
            {
                return target switch
                {
                    "donations" => GetLocalizedString("RollbackDonations", "Donation Data"),
                    "accounting" => GetLocalizedString("RollbackAccounting", "Accounting Data"),
                    "both" => GetLocalizedString("RollbackBoth", "Rollback Both Donation and Accounting Data"),
                    _ => target
                };
            }

            string FormatBackupInfo(BackupInfo? info)
                => info == null
                    ? GetLocalizedString("NoBackupAvailable", "No backup available")
                    : $"{info.BackupAt:yyyy-MM-dd HH:mm}, data through: {(info.MostRecentDataDate.HasValue ? info.MostRecentDataDate.Value.ToString("yyyy-MM-dd") : "n/a")} ({info.RecordCount:N0} rows)";

            return target switch
            {
                "donations" => $"{GetLocalizedString("RollbackDonations", "Donation Data")} - {FormatBackupInfo(rollbackAvailability.LatestDonationBackup)}",
                "accounting" => $"{GetLocalizedString("RollbackAccounting", "Accounting Data")} - {FormatBackupInfo(rollbackAvailability.LatestAccountingBackup)}",
                "both" => GetLocalizedString("RollbackBoth", "Rollback Both Donation and Accounting Data"),
                _ => target
            };
        }

