        private async Task LoadAllStaff()
        {
            try
            {
                _logger.LogInformation("Admin.LoadAllStaff: starting user load.");
                var users = await UserManagementService.GetAdminUsersAsync();
                _logger.LogInformation("Admin.LoadAllStaff: service returned {Count} users.", users?.Count ?? 0);

                staff = (users ?? new List<Cya2.Application.DTOs.AdminUserDto>())
                    .Select(u => new Cya2.Application.DTOs.AdminUserDto
                    {
                        Id = u.Id,
                        Email = u.Email ?? string.Empty,
                        Name = u.Name ?? string.Empty,
                        Language = u.Language ?? string.Empty,
                        AuthLevel = u.AuthLevel ?? string.Empty,
                        DefaultAccountId = u.DefaultAccountId
                    })
                    .ToList();

                _logger.LogInformation("Admin.LoadAllStaff: mapped {Count} users into dropdown data source.", staff.Count);

                if (staff.Count == 0)
                {
                    staffUpdateError = "Debug: user list returned empty from service.";
                    _logger.LogWarning("Admin.LoadAllStaff: mapped user list is empty.");
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error loading users: {ex.Message}";
                staffUpdateError = $"Debug: LoadAllStaff exception: {ex.Message}";
                _logger.LogError(ex, "Admin.LoadAllStaff failed.");
                staff = new List<Cya2.Application.DTOs.AdminUserDto>();
            }
        }

