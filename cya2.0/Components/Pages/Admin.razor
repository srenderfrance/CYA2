                var message = string.Format(GetLocalizedString("ConfirmDeleteUserMessage", "Are you sure you want to delete user '{0}'?"), userName);
                var confirmed = await DialogService.OpenAsync<RollbackConfirmDialog>(
                    GetLocalizedString("DeleteUser", "Delete User"),
                    new Dictionary<string, object?> { { "Message", message } },
                    BuildAdminDialogOptions(width: "420px", closeDialogOnOverlayClick: false));

                if (confirmed != true)
                    return;

                _logger.LogInformation("Confirming deletion of user: {User}", userName);

                var selectedUser = staff.FirstOrDefault(u => u.Name == userName);
                if (selectedUser == null)
                {
                    staffUpdateError = "Selected user not found";
                    StateHasChanged();
                    return;
                }

                var op = await UserManagementService.DeleteAdminUserAsync(selectedUser.Id);
                if (op.IsSuccess)
                {
                    _logger.LogInformation("Successfully deleted user {UserId}", selectedUser.Id);
                    staffUpdateSuccess = op.Message;

                    staffMember = string.Empty;
                    selectedStaff = string.Empty;
                    selectedStaffEmail = string.Empty;
                    selectedStaffAuthLevel = string.Empty;
                    newName = string.Empty;
                    newEmail = string.Empty;
                    newAuthLevel = string.Empty;
                    userAccounts.Clear();

                    await LoadAllStaff();
                }
                else
                {
                    _logger.LogWarning("Failed to delete user {UserId}: {Message}", selectedUser.Id, op.Message);
                    staffUpdateError = op.Message;
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error in ConfirmDelete");
                staffUpdateError = $"Error: {ex.Message}";
                StateHasChanged();
            }
        }

        private async Task ConfirmDeleteFund(string fundName)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(fundName))
                    return;

                var message = string.Format(GetLocalizedString("ConfirmDeleteFundMessage", "Are you sure you want to delete account '{0}'?"), fundName);
                var confirmed = await DialogService.OpenAsync<RollbackConfirmDialog>(
                    GetLocalizedString("DeleteAccount", "Delete Account"),
                    new Dictionary<string, object?> { { "Message", message } },
                    BuildAdminDialogOptions(width: "420px", closeDialogOnOverlayClick: false));

                if (confirmed != true)
                    return;

                var account = allFunds.FirstOrDefault(a => a.Fund == fundName);
                if (account == null) return;

                var op = await AdminFundWriteService.DeleteFundAsync(account.AccountId);
                if (!op.IsSuccess)
                {
                    fundUpdateError = op.Message;
                    return;
                }

                fundUpdateSuccess = op.Message;

                // Refresh funds and reset selection
                await LoadAllAccounts();
                allFunds = allAccounts;
                RefreshAccountsOptions();

                selectedFund = AddNewAccountLabel;
                await fundSelection(selectedFund);
            }
            catch (Exception ex)
            {
                fundUpdateError = $"Error deleting fund: {ex.Message}";
            }
        }

        private async Task UpdateFund()
        {
            fundUpdateError = string.Empty;
            fundUpdateSuccess = string.Empty;

            _logger.LogInformation("UpdateFund called. SelectedFund: {SelectedFund}, IsAddNewAccountSelected: {IsAddNewAccountSelected}", selectedFund, IsAddNewAccountSelected);

            if (IsAddNewAccountSelected)
            {
                fundUpdateError = "Please select 'Add New Fund' to add a fund";
                return;
            }

            if (string.IsNullOrEmpty(selectedFund) || !selectedAccountId.HasValue)
            {
                fundUpdateError = "Please select a fund to update";
                return;
            }

            try
            {
                var request = new Cya2.Application.DTOs.AdminFundUpsertDto
                {
                    Fund = newFundName.Trim(),
                    AccountingClass = fundClass.Trim(),
                    AccountNumber = accountNumber.Trim(),
                    SoftCredit = softCredit?.Trim() ?? string.Empty,
                    BalanceAdjustment = balanceAdjustment ?? 0.00m,
                    Overhead = overheadValue ?? 0.00m
                };

                var op = await AdminFundWriteService.UpdatePrimaryFundAsync(selectedAccountId.Value, request);
                if (!op.IsSuccess)
                {
                    fundUpdateError = op.Message;
                    return;
                }

                fundUpdateSuccess = op.Message;

                ClearFundInputFields();
                await LoadAllAccounts();
                allFunds = allAccounts;
                RefreshAccountsOptions();

                selectedFund = AddNewAccountLabel;
                await fundSelection(selectedFund);
            }
            catch (Exception ex)
            {
                fundUpdateError = $"Error updating fund: {ex.Message}";
                _logger.LogError(ex, "Error updating fund: {SelectedFund}", selectedFund);
            }
        }

        private async Task AddNewFund()
        {
            // Clear previous messages
            fundUpdateError = string.Empty;
            fundUpdateSuccess = string.Empty;

            if (createSubFund)
            {
                if (selectedPrincipleAccountId == 0)
                {
                    fundUpdateError = "Please select a principle fund";
                    return;
                }

                var principleAccountIdForRefresh = selectedPrincipleAccountId;

                if (string.IsNullOrWhiteSpace(subAccountNameEdit))
                {
                    fundUpdateError = "Sub Fund name is required";
                    return;
                }
                if (subAccountNameEdit.Length < 2 || subAccountNameEdit.Length > 255)
                {
                    fundUpdateError = "Sub Fund name must be between 2 and 255 characters";
                    return;
                }
                if (string.IsNullOrWhiteSpace(subAccountKindEdit))
                {
                    fundUpdateError = "Sub Fund type is required";
                    return;
                }

                try
                {
                    var op = await AdminFundWriteService.CreateSubFundAsync(
                        selectedPrincipleAccountId,
                        subAccountNameEdit,
                        subAccountKindEdit);

                    if (!op.IsSuccess)
                    {
                        fundUpdateError = op.Message;
                        return;
                    }

                    fundUpdateSuccess = op.Message;

                    subAccountNameEdit = string.Empty;
                    subAccountKindEdit = subFundKinds.FirstOrDefault() ?? "Merged";

                    await LoadSubAccounts(principleAccountIdForRefresh);
                    selectedPrincipleAccountId = principleAccountIdForRefresh;
                    RefreshFilteredSubAccounts();
                    selectedSubAccountId = 0;
                    selectedSubAccount = null;

                    RefreshAccountsOptions();
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    fundUpdateError = $"Error adding sub fund: {ex.Message}";
                    _logger.LogError(ex, "Error adding sub fund: {SubFundName}", subAccountNameEdit);
                }

                return;
            }

            if (!IsAddNewAccountSelected)
            {
                fundUpdateError = "Please select 'Add New Fund' to add a fund";
                return;
            }

            if (string.IsNullOrWhiteSpace(newFundName))
            {
                fundUpdateError = "Fund name is required";
                return;
            }
            if (newFundName.Length < 2 || newFundName.Length > 100)
            {
                fundUpdateError = "Fund name must be between 2 and 100 characters";
                return;
            }
            if (string.IsNullOrWhiteSpace(accountNumber))
            {
                fundUpdateError = "Account number is required";
                return;
            }
            if (string.IsNullOrWhiteSpace(fundClass))
            {
                fundUpdateError = "Account reference (Class) is required";
                return;
            }

            try
            {
                var request = new Cya2.Application.DTOs.AdminFundUpsertDto
                {
                    Fund = newFundName.Trim(),
                    AccountingClass = fundClass.Trim(),
                    AccountNumber = accountNumber.Trim(),
                    SoftCredit = softCredit?.Trim() ?? string.Empty,
                    BalanceAdjustment = balanceAdjustment ?? 0.00m,
                    Overhead = overheadValue ?? 0.00m
                };

                var op = await AdminFundWriteService.CreatePrimaryFundAsync(request);
                if (!op.IsSuccess)
                {
                    fundUpdateError = op.Message;
                    return;
                }

                fundUpdateSuccess = op.Message;

                ClearFundInputFields();
                await LoadAllAccounts();
                allFunds = allAccounts;
                RefreshAccountsOptions();

                selectedFund = AddNewAccountLabel;
                await fundSelection(selectedFund);
            }
            catch (Exception ex)
            {
                fundUpdateError = $"Error adding new fund: {ex.Message}";
                _logger.LogError(ex, "Error adding new fund: {FundName}", newFundName);
            }
        }
        
        private void ClearFundInputFields()
        {
            newFundName = string.Empty;
            accountNumber = string.Empty;
            overhead = string.Empty;
            fundClass = string.Empty;
            softCredit = string.Empty;
            newAccountingClass = string.Empty;
            balanceAdjustment = 0.00m;
