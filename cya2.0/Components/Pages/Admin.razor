        private async Task RemoveAccountLink()
        {
            // Clear previous messages
            accountLinkError = string.Empty;
            accountLinkSuccess = string.Empty;

            if (string.IsNullOrEmpty(staffMember))
            {
                accountLinkError = "Please select a user";
                return;
            }

            if (selectedLinkedAccountId == 0)
            {
                accountLinkError = "Please select an account to remove";
                return;
            }

            try
            {
                var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
                if (selectedUser == null)
                {
                    accountLinkError = "Selected user not found";
                    return;
                }

                var op = await UserManagementService.RevokeAccountAccessAsync(selectedUser.Id, selectedLinkedAccountId);
                if (op.IsSuccess)
                {
                    accountLinkSuccess = $"{op.Message} from {staffMember}";

                    // Reset the selected account
                    selectedLinkedAccountId = 0;

                    // Refresh the user's accounts list
                    await LoadUserAccounts(selectedUser.Id);
                }
                else
                {
                    accountLinkError = op.Message;
                }
            }
            catch (Exception ex)
            {
                accountLinkError = $"Error removing account link: {ex.Message}";
            }
        }

        private async Task AddNewStaffMember()
        {
            // Clear previous messages
            staffUpdateError = string.Empty;
            staffUpdateSuccess = string.Empty;

            if (!IsAddNewSelected)
            {
                staffUpdateError = "Please select 'Add New User' to add a user";
                return;
            }

            try
            {
                var levelToSet = string.IsNullOrWhiteSpace(newAuthLevel) ? "User" : newAuthLevel;
                var op = await UserManagementService.CreateAdminUserAsync(
                    newName,
                    newEmail,
                    levelToSet,
                    accountsToAssign);

                if (!op.IsSuccess)
                {
                    staffUpdateError = op.Message;
                    return;
                }

                staffUpdateSuccess = op.Message;

                // Clear inputs
                newName = string.Empty;
                newEmail = string.Empty;
                newAuthLevel = string.Empty;
                accountsToAssign = Array.Empty<int>();

                // Refresh staff list and reset selection
                await LoadAllStaff();
                staffMember = AddNewLabel;
                selectedStaff = string.Empty;
                selectedStaffEmail = string.Empty;
                selectedStaffAuthLevel = string.Empty;
            }
            catch (Exception ex)
            {
                staffUpdateError = $"Error: {ex.Message}";
            }
        }

        private async Task UpdateStaffMember()
        {
            // Clear previous messages
            staffUpdateError = string.Empty;
            staffUpdateSuccess = string.Empty;

            _logger.LogInformation("UpdateStaffMember called");

            if (IsAddNewSelected)
            {
                staffUpdateError = "Please use 'Add New User' to add a user";
                return;
            }

            if (string.IsNullOrEmpty(staffMember))
            {
                staffUpdateError = "Please select a user to update";
                return;
            }

            try
            {
                var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
                if (selectedUser == null)
                {
                    staffUpdateError = "Selected user not found";
                    return;
                }

                var request = new Cya2.Application.DTOs.AdminUserUpdateDto
                {
                    UserId = selectedUser.Id,
                    Name = string.IsNullOrWhiteSpace(newName) ? null : newName,
                    Email = string.IsNullOrWhiteSpace(newEmail) ? null : newEmail,
                    AuthLevel = string.IsNullOrWhiteSpace(newAuthLevel) ? null : newAuthLevel
                };

                var op = await UserManagementService.UpdateAdminUserAsync(request);
                if (op.IsSuccess)
                {
                    staffUpdateSuccess = op.Message;

                    newName = string.Empty;
                    newEmail = string.Empty;
                    newAuthLevel = string.Empty;

                    await LoadAllStaff();
                    await staffSelection(staffMember);
                }
                else
                {
                    staffUpdateError = op.Message;
                }
            }
            catch (Exception ex)
            {
                staffUpdateError = $"Error updating user: {ex.Message}";
            }
        }

        private async Task ConfirmDelete(string userName)
