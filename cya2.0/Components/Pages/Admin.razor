        private void RefreshFilteredSubAccounts()
        {
            if (selectedPrincipleAccountId > 0)
            {
                filteredSubAccounts = subAccounts.Where(sa => sa.AccountId == selectedPrincipleAccountId).ToList();
            }
            else
            {
                filteredSubAccounts = new List<SubAccount>(subAccounts);
            }

            if (selectedSubAccountId != 0 && filteredSubAccounts.All(sa => sa.Id != selectedSubAccountId))
            {
                ClearSelectedSubAccount();
            }
        }

        private void ClearSelectedSubAccount()
        {
            selectedSubAccountId = 0;
            selectedSubAccount = null;
            subAccountUpdateError = string.Empty;
            subAccountUpdateSuccess = string.Empty;
        }

        private void SelectSubAccount(int subAccountId)
        {
            selectedSubAccountId = subAccountId;
            selectedSubAccount = filteredSubAccounts.FirstOrDefault(sa => sa.Id == subAccountId);
            subAccountNameEdit = selectedSubAccount?.SubFund ?? string.Empty;
            subAccountKindEdit = selectedSubAccount?.Kind ?? "Merged";
            subAccountUpdateError = string.Empty;
            subAccountUpdateSuccess = string.Empty;
        }

        private async Task UpdateSubAccountAsync()
        {
            subAccountUpdateError = string.Empty;
            subAccountUpdateSuccess = string.Empty;

            if (IsAddNewSubAccountSelected || selectedSubAccount == null)
            {
                subAccountUpdateError = "Please select a subaccount to update";
                return;
            }

            if (string.IsNullOrWhiteSpace(subAccountNameEdit))
            {
                subAccountUpdateError = "Subaccount name is required";
                return;
            }

            var trimmedName = subAccountNameEdit.Trim();
            if (trimmedName.Length < 2 || trimmedName.Length > 255)
            {
                subAccountUpdateError = "Subaccount name must be between 2 and 255 characters";
                return;
            }

            if (string.IsNullOrWhiteSpace(subAccountKindEdit))
            {
                subAccountUpdateError = "Subaccount type is required";
                return;
            }

            try
            {
                var op = await AdminFundWriteService.UpdateSubFundAsync(
                    selectedSubAccount.Id,
                    subAccountNameEdit,
                    subAccountKindEdit);

                if (!op.IsSuccess)
                {
                    subAccountUpdateError = op.Message;
                    return;
                }

                subAccountUpdateSuccess = op.Message;
                await LoadSubAccounts(selectedSubAccount.AccountId);
                selectedPrincipleAccountId = selectedSubAccount.AccountId;
                RefreshFilteredSubAccounts();
                SelectSubAccount(selectedSubAccount.Id);
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                subAccountUpdateError = $"Error updating subaccount: {ex.Message}";
                _logger.LogError(ex, "Error updating subaccount {SubAccountId}", selectedSubAccount?.Id);
            }
        }

        private async Task DeleteSubAccountAsync()
        {
            subAccountUpdateError = string.Empty;
            subAccountUpdateSuccess = string.Empty;

            if (IsAddNewSubAccountSelected || selectedSubAccount == null)
            {
                subAccountUpdateError = "Please select a subaccount to delete";
                return;
            }

            try
            {
                var op = await AdminFundWriteService.DeleteSubFundAsync(selectedSubAccount.Id);

                if (!op.IsSuccess)
                {
                    subAccountUpdateError = op.Message;
                    return;
                }

                subAccountUpdateSuccess = op.Message;
                var accountId = selectedSubAccount.AccountId;
                await LoadSubAccounts(accountId);
                selectedPrincipleAccountId = accountId;
                RefreshFilteredSubAccounts();
                ClearSelectedSubAccount();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                subAccountUpdateError = $"Error deleting subaccount: {ex.Message}";
                _logger.LogError(ex, "Error deleting subaccount {SubAccountId}", selectedSubAccount?.Id);
            }
        }
    }

