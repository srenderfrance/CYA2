                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: #212529;">@GetLocalizedString("RollbackLastUpdate", "Rollback Last Update")</RadzenText>
                    </RadzenStack>

                    <RadzenText TextStyle="TextStyle.Body1" Style="color: #212529; margin: 0; font-weight: 700;">
                        @GetLocalizedString("RollbackDescription", "Select which data table or tables to rollback. This will undue the last upload to any selected table.")
                    </RadzenText>

                    <!-- Rollback Options -->
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem; background-color: #f8f9fa; border-radius: 6px;">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                            <RadzenRadioButtonList @bind-Value="rollbackTarget" Orientation="Orientation.Vertical" Gap="0.75rem">
                                <Items>
                                    <RadzenRadioButtonListItem Text="@GetRollbackOptionText("donations")" Value='"donations"' />
                                    <RadzenRadioButtonListItem Text="@GetRollbackOptionText("accounting")" Value='"accounting"' />
                                    <RadzenRadioButtonListItem Text="@GetRollbackOptionText("both")" Value='"both"' />
                                </Items>
                            </RadzenRadioButtonList>
                        </RadzenStack>
                    </RadzenStack>

                    <!-- Status and Error Messages -->
                    @if (!string.IsNullOrEmpty(rollbackStatus))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Filled">
                            @rollbackStatus
                        </RadzenAlert>
                    }

                    @if (!string.IsNullOrEmpty(rollbackError))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled">
                            @rollbackError
                        </RadzenAlert>
                    }

                    <!-- Action Buttons -->
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" Style="margin-top: 1rem;">
                        <RadzenButton Text="@GetLocalizedString("Cancel", "Cancel")" 
                                      ButtonStyle="ButtonStyle.Light" 
                                      Click="CancelRollback" 
                                      Disabled="@(!string.IsNullOrEmpty(rollbackStatus))" />
                        
