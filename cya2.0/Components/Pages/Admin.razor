        private class ImportResultTemp
        {
            public string? ProgressId { get; set; }
        }

        private string? currentProgressId;

        private async Task OnDonationPreviewComplete(UploadCompleteEventArgs args)
        {
            await HandlePreviewComplete(args, "donations");
        }

        private async Task OnAccountingPreviewComplete(UploadCompleteEventArgs args)
        {
            await HandlePreviewComplete(args, "accounting");
        }

        private async Task HandlePreviewComplete(UploadCompleteEventArgs args, string importType)
        {
            try
            {
                var raw = args?.RawResponse as string ?? string.Empty;
                _logger.LogInformation("Preview response for {Type}: length {Len}", importType, raw.Length);

                if (string.IsNullOrWhiteSpace(raw))
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Upload Error",
                        Detail = "No response from server for preview.",
                        Duration = 4000
                    });
                    return;
                }

                var preview = JsonSerializer.Deserialize<FilePreviewResult>(raw, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (preview == null || string.IsNullOrWhiteSpace(preview.PreviewId))
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Upload Error",
                        Detail = "Could not read preview information.",
                        Duration = 4000
                    });
                    return;
                }

                // Show confirmation dialog
                var confirmed = await DialogService.OpenAsync<UploadConfirmationDialog>(
                    title: Localizer["ConfirmUpload"],
                    parameters: new Dictionary<string, object?> { { "Preview", preview } },
                    options: BuildAdminDialogOptions(width: "520px", height: "auto", resizable: false, showClose: true));

                if (confirmed is bool b && b)
                {
                    await StartImportFromPreview(preview.PreviewId, importType);
                }
                else
                {
                    _logger.LogInformation("User cancelled {Type} upload for PreviewId {PreviewId}", importType, preview.PreviewId);
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "HandlePreviewComplete failed for {Type}", importType);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Upload Error",
                    Detail = ex.Message,
                    Duration = 4000
                });
            }
        }

        private async Task StartImportFromPreview(string previewId, string importType)
        {
            try
            {
                // Generate ProgressId
                string localProgressId = Guid.NewGuid().ToString("N");

                // Store ProgressId in session service so any listening component (including UploadProgressDialog)
                // receives it via the ImportProgressIdChanged event
                SessionImportProgressService.SetImportProgressId(localProgressId);

                // Open the progress dialog immediately
                DialogService.Open<UploadProgressDialog>(
                    title: Localizer["UploadInProgress"],
                    // Do not pass ProgressId here - the dialog will pick it up from SessionImportProgressService.ImportProgressIdChanged
                    parameters: new Dictionary<string, object?>(),
                    options: BuildAdminDialogOptions(width: "800px", height: "auto", resizable: false, showClose: false));
                // Let the UI render the dialog and let the dialog component initialize and start polling
                await InvokeAsync(StateHasChanged);

                // Call the import service directly
                ImportResult result;
                if (importType == "donations")
                {
                    result = await DonationImportService.StartImportFromPreviewAsync(previewId, localProgressId);
                }
                else if (importType == "accounting")
                {
                    result = await AccountingImportService.StartImportFromPreviewAsync(previewId, localProgressId);
                }
                else
                {
                    throw new ArgumentException("Invalid import type");
                }

                if (result == null || string.IsNullOrWhiteSpace(result.ProgressId))
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Import Error",
                        Detail = "Import did not return a progress id.",
                        Duration = 4000
                    });

                    // Clear the temporary progress id we set earlier
                    SessionImportProgressService.SetImportProgressId(string.Empty);
                    return;
                }

                // If the service generated its own ProgressId, update session service so the dialog polls the correct id
                if (!string.Equals(result.ProgressId, localProgressId, StringComparison.Ordinal))
                {
                    _logger.LogInformation("Replacing temporary ProgressId {Temp} with server ProgressId {Server}", localProgressId, result.ProgressId);
                    SessionImportProgressService.SetImportProgressId(result.ProgressId);
                }
                else
                {
                    // Ensure session service contains the final id
                    SessionImportProgressService.SetImportProgressId(localProgressId);
                }

                // Store locally as well
                currentProgressId = SessionImportProgressService.ImportProgressId;

                _logger.LogInformation("Import started with ProgressId {ProgressId}", currentProgressId);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "StartImportFromPreview failed for {Type}", importType);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Import Error",
                    Detail = ex.Message,
                    Duration = 4000
                });
            }
        }

        // New handlers for InputFile-based uploads (triggered by the styled label)

        private async Task OnDonationInputFileChange(InputFileChangeEventArgs e)
        {
            try
            {
                var file = e.File;
                if (file == null) return;

                const long maxAllowedBytes = 512L * 1024 * 1024;
                await using var stream = file.OpenReadStream(maxAllowedBytes);

                var preview = await DonationImportService.PreviewAsync(
                    stream, file.Name, file.ContentType ?? string.Empty, CancellationToken.None);

                var raw = System.Text.Json.JsonSerializer.Serialize(preview);
                var args = new UploadCompleteEventArgs { RawResponse = raw };
                await HandlePreviewComplete(args, "donations");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Donation file upload failed");
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Upload Error",
                    Detail = ex.Message,
                    Duration = 4000
                });
            }
        }

