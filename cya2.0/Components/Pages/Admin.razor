        public Task fundSelection(string displayText)
        {
            if (string.IsNullOrEmpty(displayText)) return Task.CompletedTask;

            selectedFund = displayText;

            // Clear previous messages
            fundUpdateError = string.Empty;
            fundUpdateSuccess = string.Empty;

            if (string.Equals(displayText, AddNewAccountLabel, StringComparison.Ordinal))
            {
                // Clear the selected account when adding new
                selectedFundAccount = null;
                selectedAccountId = null;
                // Clear input fields for new fund entry
                ClearFundInputFields();
                StateHasChanged(); // Trigger UI update for HasSecondaryFunds indicator
                return Task.CompletedTask;
            }

            // Find the FundDisplayItem by matching the display text
            var selectedItem = fundsWithAddOption.FirstOrDefault(f => f.DisplayText == displayText);
            if (selectedItem != null)
            {
                selectedFundAccount = selectedItem.Account;
                selectedAccountId = selectedItem.Account.AccountId;
                
                // Populate form fields with existing account data
                newFundName = selectedItem.Account.Fund;
                accountNumber = selectedItem.Account.AccountNumber;
                softCredit = selectedItem.Account.SoftCredit;
                balanceAdjustment = selectedItem.Account.BalanceAdjustment;
                


                 // Populate fundClass from AccountingClass
                 fundClass = selectedItem.Account.AccountingClass ?? string.Empty;
                 
                 // Populate Overhead numeric input from selected account (DB stores whole-number percent)
                 overheadValue = selectedItem.Account.Overhead;
            }
            else
            {
                selectedFundAccount = null;
                selectedAccountId = null;
                ClearFundInputFields();
            }

            StateHasChanged(); // Trigger UI update for HasSecondaryFunds indicator
            return Task.CompletedTask;
        }

