@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using cya2.Components.Shared
@attribute [Authorize(Roles = "Admin")]
@inject Cya2.Application.Interfaces.ISessionUserStateService SessionUserStateService
@inject Cya2.Application.Interfaces.ISessionImportProgressService SessionImportProgressService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject DialogService DialogService
@inject NotificationService NotificationService
@using Cya2.Core.Entities
@using System.ComponentModel.DataAnnotations
@inject ILogger<Admin> _logger
@rendermode InteractiveServer
@using Radzen.Blazor
@using Radzen
@using Cya2.Shared.Utilities
@inject IStringLocalizer<Resource> Localizer
@inject TooltipService tooltipService
@using System.Text.Json
@using cya2.Services.Imports
@using Cya2.Application.Interfaces
@inject IRollbackService RollbackService
@inject IAccountingImportService AccountingImportService
@using Microsoft.AspNetCore.Components.Forms
@inject IDonationImportService DonationImportService
@inject Cya2.Application.Services.UserManagementService UserManagementService
@inject Cya2.Application.Services.AdminFundReadService AdminFundReadService
@inject Cya2.Application.Services.AdminFundWriteService AdminFundWriteService
@using Cya2.Application.DTOs
@inject Cya2.Application.Interfaces.IUserIdResolver UserIdResolver

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-pt-0 rz-px-4 rz-pb-4">
    <!-- Top row: accounts buttons on the left, upload buttons on the right -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Class="rz-mb-3 admin-top-row">
        <RadzenButton Icon="menu"
                      ButtonStyle="ButtonStyle.Light"
                      Class="admin-toolbar-toggle"
                      Click="@(() => showAdminToolbarButtons = !showAdminToolbarButtons)"
                      title="Toggle admin actions" />

        <div class="admin-top-actions @(showAdminToolbarButtons ? "expanded" : "collapsed")">
        <!-- Left group: existing account dialogs -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Class="admin-top-left">
            <RadzenButton Text="@Localizer["AccountsOverview"]"
                          ButtonStyle="ButtonStyle.Primary"
                          Style="background-color: #0a3b6b; border-color: #0a3b6b;"
                          Click="@(async () => await OpenAccountsOverviewDialog())" />

            <RadzenButton Text="@Localizer["AccountSummaries"]"
                          ButtonStyle="ButtonStyle.Primary"
                          Style="background-color: #0a3b6b; border-color: #0a3b6b;"
                          Click="@(async () => await OpenAccountSummariesDialog())" />
        </RadzenStack>

        <!-- Right group: upload controls -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Class="admin-top-right">
            <!-- NOTE: No size limit for now. TODO: enforce a sensible max file size. -->
            <div style="display:flex; align-items:center; gap:0.5rem;">
                <InputFile id="donationFileInput" style="display:none" OnChange="OnDonationInputFileChange" accept=".xlsx" />
                <label for="donationFileInput" class="rz-button rz-button-primary" style="background-color:#0a3b6b; border-color:#0a3b6b; color: white; cursor: pointer; display:inline-flex; align-items:center; gap:0.5rem; padding:0 0.75rem; border-radius:4px; height:38px; font-size:14px;font-weight:600;">
                    @Localizer["UploadDonationData"]
                </label>
            </div>

            <div style="display:flex; align-items:center; gap:0.5rem;">
                <InputFile id="accountingFileInput" style="display:none" OnChange="OnAccountingInputFileChange" accept=".xlsx" />
                <label for="accountingFileInput" class="rz-button rz-button-primary" style="background-color:#0a3b6b; border-color:#0a3b6b; color: white; cursor: pointer; display:inline-flex; align-items:center; gap:0.5rem; padding:0 0.75rem; border-radius:4px; height:38px; font-size:14px;font-weight:600;">
                    @Localizer["UploadAccountingData"]
                </label>
            </div>

            <!-- Rollback button with danger styling (use ButtonStyle.Danger so it matches DeleteUser) -->
            <RadzenButton Text="@Localizer["RollbackLastUpdate"]"
                          ButtonStyle="ButtonStyle.Danger"
                          Icon="history"
                          Class="admin-rollback-btn"
                          Click="@(async () => await OpenRollbackDialog())" />

            @* <RadzenButton Text="@GetLocalizedString("RecategorizeDonations", "Recategorize Donations")"
                          ButtonStyle="ButtonStyle.Light"
                          Icon="cleaning_services"
                          Click="@(async () => await RecategorizeAllDonations())" /> *@
        </RadzenStack>
        </div>
    </RadzenStack>

    <!-- CSS Grid container for equal width cards -->
    <div class="admin-cards-grid">
        <!-- Manage Fundraising Accounts section -->
        <RadzenCard Style="overflow: visible;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Class="rz-mt-1 rz-mb-4" Style="padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
                <RadzenText TextStyle="TextStyle.H5" Style="font-weight: 800; color: #1f2937;">@Localizer["ManageFundraisingAccounts"]</RadzenText>
                <RadzenButton Text="@Localizer["FundRefrences"]"
                              ButtonStyle="ButtonStyle.Primary"
                              Style="background-color: #0a3b6b; border-color: #0a3b6b;"
                              Click="@(async () => await OpenFundReferencesDialog())" />
            </RadzenStack>

            <div class="admin-form-shell" style="width:100%; max-width:900px;">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                    <!-- Toggle row (no special bottom margin so it matches other rows) -->
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row admin-form-first-row">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width: 220px;" Class="admin-form-label">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold;">@(createSubFund ? Localizer["CreateSecondaryFund"] : Localizer["CreatePrimaryFund"])</RadzenText>
                        </RadzenStack>
                        <div style="flex: 1; display:flex; align-items:center;">
                            <RadzenSwitch @bind-Value="createSubFund" Class="admin-mode-switch" />
                        </div>
                    </RadzenStack>

                    @if (!createSubFund)
                    {
                        <!-- Fundraising Account selector -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width:220px;" Class="admin-form-label">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold; margin:0;">@Localizer["FundraisingAccount"]</RadzenText>
                            </RadzenStack>
                            <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                <CustomDropdown TItem="FundDisplayItem" TValue="string"
                                                Data="@fundsWithAddOption"
                                                TextSelector="@(f => f.DisplayText)"
                                                ValueSelector="@(f => f.DisplayText)"
                                                Value="@selectedFund"
                                                ValueChanged="@(async (string v) => await fundSelection(v))"
                                                Placeholder="@Localizer["SelectAccount"]" />
                            </RadzenFormField>
                        </RadzenStack>

                        <!-- Fund Number -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width: 220px;" Class="admin-form-label">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold;">@Localizer["AccountNumber"]</RadzenText>
                                <i @ref="accountNumberIcon" class="bi bi-exclamation-circle" style="cursor: help; color: #dc3545;" 
                                   @onmouseenter="@(() => ShowAccountNumberTooltip(accountNumberIcon))"
                                   @onmouseleave="@(() => tooltipService.Close())"></i>
                            </RadzenStack>
                            <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                <RadzenTextBox @bind-Value="@accountNumber" Placeholder="@Localizer["AccountNumber"]" />
                            </RadzenFormField>
                        </RadzenStack>

                        <!-- Fund Name -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width: 220px;" Class="admin-form-label">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold;">@Localizer["Fund"]</RadzenText>
                                <i @ref="fundIcon" class="bi bi-exclamation-circle" style="cursor: help; color: #dc3545;" 
                                   @onmouseenter="@(() => ShowFundTooltip(fundIcon))"
                                   @onmouseleave="@(() => tooltipService.Close())"></i>
                            </RadzenStack>
                            <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                <RadzenTextBox @bind-Value="@newFundName" Placeholder="@Localizer["Fund"]" />
                            </RadzenFormField>
                        </RadzenStack>

                        <!-- Account Reference -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width: 220px;" Class="admin-form-label">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold;">@Localizer["Class"]</RadzenText>
                                <i @ref="classIcon" class="bi bi-exclamation-circle" style="cursor: help; color: #dc3545;" 
                                   @onmouseenter="@(() => ShowClassTooltip(classIcon))"
                                   @onmouseleave="@(() => tooltipService.Close())"></i>
                            </RadzenStack>
                            <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                <RadzenTextBox @bind-Value="@fundClass" Placeholder="@Localizer["Class"]" />
                            </RadzenFormField>
                        </RadzenStack>

                        <!-- Overhead (stored as whole-number percent, e.g. 12.00 => 12%) -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold; width: 220px;">@Localizer["Overhead"]</RadzenText>
                            <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                <RadzenNumeric TValue="decimal?"
                                               @bind-Value="overheadValue"
                                               Placeholder="0"
                                               Format="n2"
                                               Suffix="%" />
                            </RadzenFormField>
                        </RadzenStack>

                        <!-- Soft Credit -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold; width: 220px;">@Localizer["SoftCredit"]</RadzenText>
                            <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                <RadzenTextBox @bind-Value="@softCredit" Placeholder="@Localizer["SoftCredit"]" />
                            </RadzenFormField>
                        </RadzenStack>

                        <!-- Balance Adjustment -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold; width: 220px;">@Localizer["BalanceAdjustment"]</RadzenText>
                            <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                <RadzenNumeric TValue="decimal?" @bind-Value="@balanceAdjustment" Placeholder="0.00" Format="C" />
                            </RadzenFormField>
                        </RadzenStack>

                        <!-- Has Secondary Fund indicator -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold; width: 220px;">@Localizer["HasSecondaryFund"]</RadzenText>
                            <div style="flex: 1; display: flex; align-items: center; padding: 0.5rem;">
                                @if (HasSecondaryFunds)
                                {
                                    <RadzenText TextStyle="TextStyle.Body1">@string.Join(", ", subAccounts.Where(sa => sa.AccountId == selectedAccountId!.Value).Select(sa => sa.SubFund))</RadzenText>
                                }
                                else
                                {
                                    <RadzenText TextStyle="TextStyle.Body1">@Localizer["None"]</RadzenText>
                                }
                            </div>
                        </RadzenStack>
                    }
                    else
                    {
                        <!-- Sub Fund creation UI -->
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                            <!-- Existing Secondary Funds selector + editor -->
                            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold; width: 220px;">@Localizer["SecondaryFunds"]</RadzenText>
                                    <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                        <CustomDropdown TItem="SubAccount" TValue="int"
                                                        Data="@filteredSubAccountsWithAdd"
                                                        TextSelector="@(sa => sa.Id == 0 ? Localizer["AddNewFund"].Value : sa.SubFund)"
                                                        ValueSelector="@(sa => sa.Id)"
                                                        Value="@selectedSubAccountId"
                                                        ValueChanged="@(async (int v) => { selectedSubAccountId = v; if (v == 0) { ClearSelectedSubAccount(); } else { SelectSubAccount(v); } })"
                                                        Placeholder="@Localizer["SelectAccount"]" />
                                    </RadzenFormField>
                                </RadzenStack>

                                <!-- Principle Fund Selection -->
                                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold; width: 220px;">@Localizer["PrimaryAccount"]</RadzenText>
                                        <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                            <CustomDropdown TItem="Account" TValue="int"
                                                            Data="@accountsOptions"
                                                            TextSelector="@(a => a.AccountId == 0 ? Localizer["SelectAccount"].Value : DisplayFormatter.FormatFundDisplay(a.Fund))"
                                                            ValueSelector="@(a => a.AccountId)"
                                                            Value="@selectedPrincipleAccountId"
                                                            ValueChanged="@(async (int v) => { selectedPrincipleAccountId = v; RefreshFilteredSubAccounts(); ClearSelectedSubAccount(); })"
                                                            Placeholder="@Localizer["SelectAccount"]" />
                                        </RadzenFormField>
                                    </RadzenStack>
                                </RadzenStack>

                                @if (!string.IsNullOrEmpty(subAccountUpdateError))
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled">@subAccountUpdateError</RadzenAlert>
                                }
                                @if (!string.IsNullOrEmpty(subAccountUpdateSuccess))
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled">@subAccountUpdateSuccess</RadzenAlert>
                                }
                            </RadzenStack>

                             <!-- Sub Fund Name -->
                             <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                                 <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold; width: 220px;">@Localizer["Fund"]</RadzenText>
                                 <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                    <RadzenTextBox @bind-Value="subAccountNameEdit" Placeholder="@Localizer["Fund"]" />
                                 </RadzenFormField>
                             </RadzenStack>

                             <!-- Type (Kind) -->
                             <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" Class="admin-form-row">
                                 <RadzenText TextStyle="TextStyle.Subtitle2" Class="admin-label" Style="font-weight: bold; width: 220px;">@Localizer["Type"]</RadzenText>
                                 <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                                     <div style="width:100%;">
                                         <CustomDropdown TItem="string" TValue="string"
                                                         Data="@subFundKinds"
                                                         TextSelector="@(s => s)"
                                                         ValueSelector="@(s => s)"
                                                        Value="@subAccountKindEdit"
                                                        ValueChanged="@(async (string v) => subAccountKindEdit = v)" />
                                     </div>
                                 </RadzenFormField>
                             </RadzenStack>

                             <!-- Add New Sub Account Button -->
                             <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Class="admin-fund-actions">
                                 <RadzenButton Text="@Localizer["AddNewFund"]" ButtonStyle="ButtonStyle.Primary" Click="@(async () => await AddNewFund())" />
                                 <RadzenButton Text="@Localizer["UpdateFund"]" ButtonStyle="ButtonStyle.Primary" Click="@(async () => await UpdateSubAccountAsync())" Disabled="@IsAddNewSubAccountSelected" />
                                 <RadzenButton Text="@Localizer["DeleteFund"]" ButtonStyle="ButtonStyle.Danger" Click="@(async () => await DeleteSubAccountAsync())" Disabled="@IsAddNewSubAccountSelected" />
                             </RadzenStack>
                         </RadzenStack>
                     }
                 </RadzenStack>
             </div>
            
            <!-- Fund update/create error/success messages -->
            @if (!string.IsNullOrEmpty(fundUpdateError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                    @fundUpdateError
                </RadzenAlert>
            }
            
            @if (!string.IsNullOrEmpty(fundUpdateSuccess))
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                    @fundUpdateSuccess
                </RadzenAlert>
            }

            @if (!createSubFund)
            {
                <!-- Primary Account Management Buttons -->
                <div class="admin-fund-actions admin-action-row">
                    <RadzenButton 
                        Text="@Localizer["UpdateAccount"]" 
                        ButtonStyle="ButtonStyle.Primary" 
                        Class="admin-action-btn"
                        Click="UpdateFund" 
                        Disabled="@(string.IsNullOrEmpty(selectedFund) || IsAddNewAccountSelected)" />
                        
                    <RadzenButton 
                        Text="@Localizer["AddNewAccount"]" 
                        ButtonStyle="ButtonStyle.Primary" 
                        Class="admin-action-btn"
                        Click="@(async () => await AddNewFund())" 
                        Disabled="@(!IsAddNewAccountSelected)" />
                        
                    <RadzenButton 
                        Text="@Localizer["DeleteAccount"]" 
                        ButtonStyle="ButtonStyle.Danger" 
                        Class="admin-action-btn"
                        Click="@(async () => await ConfirmDeleteFund(selectedFund ?? string.Empty))"
                        Disabled="@(string.IsNullOrEmpty(selectedFund) || IsAddNewAccountSelected)" />
                </div>
            }
        </RadzenCard>

        <!-- Manage Users section -->
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Class="rz-mt-1 rz-mb-4" Style="padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
                <RadzenText TextStyle="TextStyle.H5" Style="font-weight: 800; color: #1f2937;">@Localizer["ManageUsers"]</RadzenText>
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Class="rz-mb-2 admin-users-row">
                <!-- User + Name group -->
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 20%;" Class="admin-user-col">
                    <div style="border:1px solid #e0e0e0; border-radius:6px; padding:0.75rem; background:#fff;">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold; margin:0;">@Localizer["Name"]</RadzenText>
                            <div style="width:100%;">
                                <CustomDropdown TItem="Cya2.Application.DTOs.AdminUserDto" TValue="string"
                                                Data="@staffWithAddOption"
                                                TextSelector="@(u => u.Name)"
                                                ValueSelector="@(u => u.Name)"
                                                Value="@staffMember"
                                                ValueChanged="@(async (string val) => { staffMember = val; await staffSelection(val); })"
                                                Placeholder="@Localizer["SelectUser"]" />
                            </div>
                            <RadzenTextBox @bind-Value="@newName" Placeholder="@Localizer["EnterUpdateName"]" />
                        </RadzenStack>
                    </div>
                </RadzenStack>
                
                <!-- Email group  -->
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 20%;" Class="admin-user-col">
                    <div style="border:1px solid #e0e0e0; border-radius:6px; padding:0.75rem; background:#fff;">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold; margin:0;">@Localizer["Email"]</RadzenText>
                            <div class="rz-border-radius-1 rz-border-1" style="height: 38px; display: grid; align-items: center; justify-items: start; background-color: #f0f0f0; padding: 0 0.5rem;">
                                <RadzenText TextStyle="TextStyle.Body1" Style="margin:0;">@(string.IsNullOrEmpty(selectedStaffEmail) ? @Localizer["NoUserSelected"] : selectedStaffEmail)</RadzenText>
                            </div>
                            <RadzenTextBox @bind-Value="@newEmail" Placeholder="@Localizer["EnterUpdateEmail"]" />
                        </RadzenStack>
                    </div>
                </RadzenStack>

                <!-- Authorization Level group -->
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 20%;" Class="admin-user-col">
                    <div style="border:1px solid #e0e0e0; border-radius:6px; padding:0.75rem; background:#fff;">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold; margin:0;">@Localizer["AuthLevel"]</RadzenText>
                            <div class="rz-border-radius-1 rz-border-1" style="height: 38px; display: grid; align-items: center; justify-items: start; background-color: #f0f0f0; padding: 0 0.5rem;">
                                <RadzenText TextStyle="TextStyle.Body1" Style="margin:0;">@(string.IsNullOrEmpty(selectedStaffAuthLevel) ? @Localizer["NoUserSelected"] : selectedStaffAuthLevel)</RadzenText>
                            </div>
                            <div style="width:100%;">
                                <CustomDropdown TItem="string" TValue="string" Data="@authLevels" TextSelector="@(s => s)" ValueSelector="@(s => s)" Value="@newAuthLevel" ValueChanged="@(async (string v) => newAuthLevel = v)" Placeholder="@Localizer["SelectAuthLevel"]" />
                            </div>
                        </RadzenStack>
                    </div>
                </RadzenStack>
                
                <!-- Fund Access dropdowns group -->
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 20%;" Class="admin-user-col">
                    <div style="border:1px solid #e0e0e0; border-radius:6px; padding:0.75rem; background:#fff;">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold; margin:0;">@Localizer["FundAccess"]</RadzenText>
                            <div style="width:100%;">
                                <CustomDropdown TItem="Account" TValue="int" Data="@accountsOptions" TextSelector="@(a => a.AccountId == 0 ? Localizer["GrantFundAccess"].Value : DisplayFormatter.FormatFundDisplay(a.Fund))" ValueSelector="@(a => a.AccountId)" Value="@accountToAddId" ValueChanged="@(async (int v) => accountToAddId = v)" Placeholder="@Localizer["GrantFundAccess"]" />
                            </div>
                            <div style="width:100%;">
                                <CustomDropdown TItem="Account" TValue="int" Data="@userAccounts" TextSelector="@(a => a.AccountId == 0 ? Localizer["RemoveFundAccess"].Value : DisplayFormatter.FormatFundDisplay(a.Fund))" ValueSelector="@(a => a.AccountId)" Value="@selectedLinkedAccountId" ValueChanged="@(async (int v) => selectedLinkedAccountId = v)" Placeholder="@Localizer["RemoveFundAccess"]" />
                            </div>
                        </RadzenStack>
                    </div>
                </RadzenStack>
                
                <!-- Accessible Funds display group -->
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 20%;" Class="admin-user-col">
                    <div style="border:1px solid #e0e0e0; border-radius:6px; padding:0.75rem; background:#fff;">
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold; margin:0;">@Localizer["CurrentFundAccess"]</RadzenText>
                            <div style="border: 1px solid #ccc; border-radius: 4px; padding: 0.75rem; max-height: 200px; overflow-y: auto; background-color: #f0f0f0; min-height: 120px;">
                                @if (IsAddNewSelected)
                                {
                                    <RadzenText TextStyle="TextStyle.Body1">@Localizer["NoUserSelected"]</RadzenText>
                                }
                                else if (selectedStaffAuthLevel == "Admin")
                                {
                                    <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">User has admin privileges.</RadzenText>
                                }
                                else if (userAccounts.Any(a => a.AccountId != 0))
                                {
                                    <ul style="list-style-type: none; padding: 0; margin: 0;">
                                        @foreach (var account in userAccounts.Where(a => a.AccountId != 0))
                                        {
                                            <li style="padding: 0.25rem 0; border-bottom: 1px solid #eee;">
                                                <RadzenText TextStyle="TextStyle.Body1">@DisplayFormatter.FormatFundDisplay(account.Fund)</RadzenText>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <RadzenText TextStyle="TextStyle.Body1" Style="color: #666;">None</RadzenText>
                                }
                            </div>
                        </RadzenStack>
                    </div>
                </RadzenStack>
            </RadzenStack>
            
            <!-- Staff update error/success messages -->
            @if (!string.IsNullOrEmpty(staffUpdateError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                    @Localizer[staffUpdateError]
                </RadzenAlert>
