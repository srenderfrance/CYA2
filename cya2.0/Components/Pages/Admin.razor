        private async Task ExecuteRollbackWithConfirm()
        {
            try
            {
                if (string.IsNullOrEmpty(rollbackTarget))
                {
                    rollbackError = "Please select a rollback target";
                    StateHasChanged();
                    return;
                }

                var targetText = rollbackTarget switch
                {
                    "donations" => GetLocalizedString("RollbackDonations", "Donation Data"),
                    "accounting" => GetLocalizedString("RollbackAccounting", "Accounting Data"),
                    "both" => GetLocalizedString("RollbackBoth", "Rollback Both Donation and Accounting Data"),
                    _ => rollbackTarget
                };

                var title = GetLocalizedString("ConfirmRollback", "Confirm Rollback");
                var message = string.Format(GetLocalizedString("ConfirmRollbackMessage", "Are you sure you want to rollback: {0}?"), targetText);

                // Hide the rollback overlay to ensure the confirm dialog is visible above everything
                bool wasDialogShowing = showRollbackDialog;
                if (wasDialogShowing)
                {
                    showRollbackDialog = false;
                    StateHasChanged();
                    await Task.Yield();
                }

                var confirmed = await DialogService.OpenAsync<RollbackConfirmDialog>(
                    GetLocalizedString("ConfirmRollback", "Confirm Rollback"),
                    new Dictionary<string, object?> { { "Message", message } },
                    BuildAdminDialogOptions(width: "420px", closeDialogOnOverlayClick: false));

                // Restore the rollback overlay
                if (wasDialogShowing)
                {
                    showRollbackDialog = true;
                    StateHasChanged();
                }

                if (confirmed == true)
                {
                    await ExecuteRollback();
                }
            }
            catch (Exception ex)
            {
                rollbackError = $"Rollback failed: {ex.Message}";
                rollbackStatus = string.Empty;
                StateHasChanged();
            }
        }

        private async Task ExecuteRollback()
        {
            try
            {
                if (string.IsNullOrEmpty(rollbackTarget))
                {
                    rollbackError = "Please select a rollback target";
                    return;
                }

                rollbackError = string.Empty;
                rollbackStatus = "Executing rollback...";
                StateHasChanged();
                
                // Execute the rollback
                var result = await RollbackService.ExecuteRollbackAsync(rollbackTarget);
                
                if (result.Success)
                {
                    rollbackStatus = result.Message;
                    
                    // Auto-close dialog after success and show notification
                    await Task.Delay(3000);
                    showRollbackDialog = false;
                    
                    // Show success notification
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Rollback Complete",
                        Detail = result.Message,
                        Duration = 8000
                    });
                }
                else
                {
                    rollbackError = result.ErrorMessage;
                    rollbackStatus = string.Empty;
                }
                
            }
            catch (Exception ex)
            {
                rollbackError = $"Rollback failed: {ex.Message}";
                rollbackStatus = string.Empty;
            }
        }

        private void CancelRollback()
        {
            showRollbackDialog = false;
            rollbackTarget = string.Empty;
            rollbackError = string.Empty;
            rollbackStatus = string.Empty;
        }

