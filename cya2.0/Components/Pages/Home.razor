<style>
    .home-account-row {
        min-width: 0;
    }

    .home-account-dropdown-text {
        display: block;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .home-missing-gift-button {
        max-width: 100%;
        white-space: normal !important;
        text-align: left;
        line-height: 1.2;
        height: auto;
    }

    .home-missing-gift-title {
        white-space: normal;
        word-break: break-word;
    }

    @@media (max-width: 640px) {
        .home-account-row {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 0.35rem !important;
            width: 100%;
