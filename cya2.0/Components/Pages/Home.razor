@code {
[Parameter] public bool EmbedMode { get; set; }
[Parameter] public bool ShowWelcomeHeader { get; set; } = true;

private string userName = string.Empty;
private bool isLoading = true;
private string selectedAccount = string.Empty;
private bool isAdminUser;

private FinancialDashboardDto dashboardData = new();
private string debugMessage = string.Empty;

private const int MaxDashboardMemoryCacheItems = 15;

private bool cacheWarmupPending;
private string cachedUserId = string.Empty;
private List<string> pendingPrefetchFunds = new();

// Missing gift alert state
private List<Cya2.Application.DTOs.DonorSummaryDto> missingGiftDonors = new();
private bool showMissingGiftDialog = false;

    private async Task ComputeMissingGiftAlertsAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(selectedAccount)) return;

            var now = DateTime.Today;
            var rangeStart = now.AddMonths(-6);
            var range = new Cya2.Core.ValueObjects.DateRange(rangeStart, now);
            var summaries = await DonorService.GetDonorSummariesAsync(selectedAccount, range);

            // Determine the latest donation date in the DB for this account.
            // Use the cached donation data if available — it already covers a wide range.
            DateTime? latestDbDate = null;
            if (!string.IsNullOrWhiteSpace(cachedUserId) &&
                SessionDonationDataCacheService.TryGetDonationData(cachedUserId, selectedAccount, out var cached) &&
                cached?.Donations != null && cached.Donations.Count > 0)
            {
                latestDbDate = cached.Donations.Max(d => d.Date);
            }

            // If we can't determine the latest DB date, suppress all alerts.
            if (latestDbDate == null)
            {
                missingGiftDonors = new();
                return;
            }

            // Only alert for missing months that fall on or before the month of the latest DB record.
            // This prevents flagging months that simply haven't been uploaded yet.
            var dbCurrentMonth = new DateTime(latestDbDate.Value.Year, latestDbDate.Value.Month, 1);

            missingGiftDonors = summaries
                .Where(d => d.HasMissingGiftAlert &&
                            d.MissingMonths.Any(m =>
                            {
                                // Parse "MMMM yyyy" back to a date and check it is <= dbCurrentMonth.
                                return DateTime.TryParseExact(m, "MMMM yyyy",
                                    System.Globalization.CultureInfo.InvariantCulture,
                                    System.Globalization.DateTimeStyles.None, out var missingDate)
                                    && missingDate <= dbCurrentMonth;
                            }))
                .Select(d => new Cya2.Application.DTOs.DonorSummaryDto
                {
                    Name            = d.Name,
                    Frequency       = d.Frequency,
                    HasMissingGiftAlert = true,
                    MissingMonths   = d.MissingMonths
                        .Where(m =>
                        {
                            return DateTime.TryParseExact(m, "MMMM yyyy",
                                System.Globalization.CultureInfo.InvariantCulture,
                                System.Globalization.DateTimeStyles.None, out var missingDate)
                                && missingDate <= dbCurrentMonth;
                        })
                        .ToList()
                })
                .Where(d => d.MissingMonths.Count > 0)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Home: failed to compute missing gift alerts for {Account}", selectedAccount);
            missingGiftDonors = new();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                return;
            }

            var authLevel = user.FindFirstValue("AuthLevel") ?? string.Empty;
            isAdminUser = user.IsInRole("Admin") || string.Equals(authLevel, "Admin", StringComparison.OrdinalIgnoreCase);

            userName = user.FindFirstValue("UserName") ??
                      user.FindFirstValue(ClaimTypes.GivenName) ??
                      user.FindFirstValue(ClaimTypes.Name) ??
                      user.Identity?.Name ??
                      user.FindFirstValue(ClaimTypes.Email) ??
                      "User";

            cachedUserId = UserIdResolver.ResolveUserId(user, SessionUserStateService.CurrentUserId);

            if (!string.IsNullOrWhiteSpace(cachedUserId) &&
                !string.Equals(SessionUserStateService.CurrentUserId, cachedUserId, StringComparison.OrdinalIgnoreCase))
            {
                SessionUserStateService.ResetForUser(cachedUserId);
            }
            else if (string.IsNullOrWhiteSpace(SessionUserStateService.CurrentUserId))
            {
                SessionUserStateService.CurrentUserId = cachedUserId;
            }

            if (string.IsNullOrWhiteSpace(SessionUserStateService.SelectedAccountFund) &&
                !string.IsNullOrWhiteSpace(cachedUserId) &&
                UserSelectionService.TryGetSelectedAccount(cachedUserId, out var hydratedAccount) &&
                !string.IsNullOrWhiteSpace(hydratedAccount))
            {
                SessionUserStateService.SelectedAccountFund = hydratedAccount;
            }

            if ((!SessionUserStateService.SelectedStartDate.HasValue || !SessionUserStateService.SelectedEndDate.HasValue) &&
                !string.IsNullOrWhiteSpace(cachedUserId) &&
                DateRangeSelectionService.TryGetDateRange(cachedUserId, out var hydratedRange))
            {
                SessionUserStateService.SelectedStartDate = hydratedRange.StartDate;
                SessionUserStateService.SelectedEndDate = hydratedRange.EndDate;
                SessionUserStateService.SelectedDatePreset = string.IsNullOrWhiteSpace(hydratedRange.Preset) ? "ThisMonth" : hydratedRange.Preset;
            }

            var requestedFund = !string.IsNullOrWhiteSpace(SessionUserStateService.SelectedAccountFund)
                ? SessionUserStateService.SelectedAccountFund
                : SessionUserStateService.DefaultAccountFund;

            FinancialDashboardDto requestedCachedDashboard = new();
            var hasRequestedCache = !string.IsNullOrWhiteSpace(requestedFund) &&
                                    SessionDashboardDtoCacheService.TryGetDashboard(cachedUserId, requestedFund, out requestedCachedDashboard);

            if (hasRequestedCache)
            {
                dashboardData = requestedCachedDashboard;
                selectedAccount = ResolveSelectedAccount(dashboardData);
                BuildDebugMessage("session-dto-cache-hit-requested");
            }
            else
            {
                dashboardData = await DashboardService.GetDashboardDataAsync(requestedFund ?? string.Empty, cachedUserId);
                selectedAccount = ResolveSelectedAccount(dashboardData);
                CacheDashboard(selectedAccount, dashboardData, prioritize: true);
                BuildDebugMessage(string.IsNullOrWhiteSpace(requestedFund) ? "initial-load" : "initial-load-requested-fund");
            }

            var defaultFundFromDto = dashboardData.UserAccounts.FirstOrDefault(a => a.IsDefault)?.Fund;
            if (string.IsNullOrWhiteSpace(defaultFundFromDto))
            {
                defaultFundFromDto = dashboardData.UserAccounts.FirstOrDefault()?.Fund ?? string.Empty;
            }

            SessionUserStateService.SelectedAccountFund = selectedAccount;
            SessionUserStateService.DefaultAccountFund = defaultFundFromDto;

            if (!string.IsNullOrWhiteSpace(cachedUserId) && !string.IsNullOrWhiteSpace(selectedAccount))
            {
                try
                {
                    UserSelectionService.SetSelectedAccount(cachedUserId, selectedAccount);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Home: failed to persist initial selected account");
                }
            }

            // Prefetch donation DTOs synchronously for selectedAccount and defaultFundFromDto
            try
            {
                var now = DateTime.UtcNow;
                var startDate = new DateTime(now.Year - 2, 1, 1);
                var endDate = new DateTime(now.Year, 12, 31);

                // Ensure we have a resolved user id for caching
                var cacheUserId = string.IsNullOrWhiteSpace(cachedUserId) ? cachedUserId : cachedUserId;

                if (!string.IsNullOrWhiteSpace(cacheUserId))
                {
                    if (!string.IsNullOrWhiteSpace(selectedAccount))
                    {
                        try
                        {
                            if (!SessionDonationDataCacheService.TryGetDonationData(cacheUserId, selectedAccount, out var cachedSelected)
                                || !CacheCoversRange(cachedSelected, startDate, endDate))
                            {
                                var dto = await DonationService.GetDonationDataAsync(selectedAccount, "All", new Cya2.Core.ValueObjects.DateRange(startDate, endDate), cacheUserId);
                                SessionDonationDataCacheService.SetDonationData(cacheUserId, selectedAccount, dto, prioritize: true);
                                Logger.LogInformation("Home: preloaded donations cache for selectedAccount={Account}", selectedAccount);
                            }
                            else
                            {
                                Logger.LogInformation("Home: skipped donation preload for selectedAccount={Account} because cache already covers range", selectedAccount);
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Home: failed to preload donation cache for selectedAccount={Account}", selectedAccount);
                        }

                        try
                        {
                            var uiRange = ResolveActiveDateRange();
                            _ = await ExpenseService.GetExpenseDataAsync(selectedAccount, uiRange, cacheUserId, isAdminUser);
                            _ = await DonorService.GetDonorSummariesAsync(selectedAccount, uiRange);
                            Logger.LogInformation("Home: preloaded expense/donor DTOs for selectedAccount={Account} and range={Start:yyyy-MM-dd}..{End:yyyy-MM-dd}", selectedAccount, uiRange.StartDate, uiRange.EndDate);
                            await ComputeMissingGiftAlertsAsync();
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Home: failed to preload expense/donor DTOs for selectedAccount={Account}", selectedAccount);
                        }
                    }

                    if (!string.IsNullOrWhiteSpace(defaultFundFromDto) && !string.Equals(defaultFundFromDto, selectedAccount, StringComparison.OrdinalIgnoreCase))
                    {
                        try
                        {
                            if (!SessionDonationDataCacheService.TryGetDonationData(cacheUserId, defaultFundFromDto, out var cachedDefault)
                                || !CacheCoversRange(cachedDefault, startDate, endDate))
                            {
                                var dto2 = await DonationService.GetDonationDataAsync(defaultFundFromDto, "All", new Cya2.Core.ValueObjects.DateRange(startDate, endDate), cacheUserId);
                                SessionDonationDataCacheService.SetDonationData(cacheUserId, defaultFundFromDto, dto2, prioritize: false);
                                Logger.LogInformation("Home: preloaded donations cache for defaultAccount={Account}", defaultFundFromDto);
                            }
                            else
                            {
                                Logger.LogInformation("Home: skipped donation preload for defaultAccount={Account} because cache already covers range", defaultFundFromDto);
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Home: failed to preload donation cache for defaultAccount={Account}", defaultFundFromDto);
                        }

                        try
                        {
                            var uiRange = ResolveActiveDateRange();
                            _ = await ExpenseService.GetExpenseDataAsync(defaultFundFromDto, uiRange, cacheUserId, isAdminUser);
                            _ = await DonorService.GetDonorSummariesAsync(defaultFundFromDto, uiRange);
                            Logger.LogInformation("Home: preloaded expense/donor DTOs for defaultAccount={Account} and range={Start:yyyy-MM-dd}..{End:yyyy-MM-dd}", defaultFundFromDto, uiRange.StartDate, uiRange.EndDate);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Home: failed to preload expense/donor DTOs for defaultAccount={Account}", defaultFundFromDto);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Home: error during donation prefetching");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Home.OnInitializedAsync failed");
            BuildDebugMessage("initial-load-error", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!cacheWarmupPending || string.IsNullOrWhiteSpace(cachedUserId))
        {
            return;
        }

        cacheWarmupPending = false;

        try
        {
            await PrefetchDashboardsAsync(cachedUserId, pendingPrefetchFunds);
            BuildDebugMessage("prefetch-complete");
            
            // Also prefetch donation caches for those funds for a wide date range (current + 2 previous years)
            _ = Task.Run(async () =>
            {
                try
                {
                    var now = DateTime.UtcNow;
                    var start = new DateTime(now.Year - 2, 1, 1);
                    var end = new DateTime(now.Year, 12, 31);
                    foreach (var fund in pendingPrefetchFunds)
                    {
                        try
                        {
                            if (!SessionDonationDataCacheService.TryGetDonationData(cachedUserId, fund, out var cachedFund)
                                || !CacheCoversRange(cachedFund, start, end))
                            {
                                var dto = await DonationService.GetDonationDataAsync(fund, "All", new Cya2.Core.ValueObjects.DateRange(start, end), cachedUserId);
                                SessionDonationDataCacheService.SetDonationData(cachedUserId, fund, dto, prioritize: false);
                            }
                        }
                        catch { }
                    }
                }
                catch { }
            });
            
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Home.OnAfterRenderAsync prefetch failed");
            BuildDebugMessage("prefetch-error", ex.Message);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnAccountSelectionAsync(object args)
    {
        try
        {
            var accountName = args?.ToString() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(accountName) || string.Equals(accountName, selectedAccount, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            var hasImmediateCache = SessionDashboardDtoCacheService.TryGetDashboard(cachedUserId, accountName, out var cachedSelection);
            isLoading = !hasImmediateCache;
            StateHasChanged();

            selectedAccount = accountName;

            if (hasImmediateCache)
            {
                dashboardData = cachedSelection;
                SessionDashboardDtoCacheService.SetDashboard(cachedUserId, selectedAccount, dashboardData, prioritize: true);
                Logger.LogInformation("Home.accountSelection: used session DTO cache for {Account}", selectedAccount);
            }
            else
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                var userId = UserIdResolver.ResolveUserId(user, cachedUserId);

                if (string.IsNullOrWhiteSpace(cachedUserId))
                {
                    cachedUserId = userId;
                }

                dashboardData = await DashboardService.GetDashboardDataAsync(selectedAccount, userId);
                CacheDashboard(selectedAccount, dashboardData, prioritize: true);
                Logger.LogInformation("Home.accountSelection: fetched dashboard for {Account} from service", selectedAccount);

                // Also preload donation cache for this selected account (wide range: current year + 2 previous years)
                try
                {
                    var now2 = DateTime.UtcNow;
                    var startPrefetch = new DateTime(now2.Year - 2, 1, 1);
                    var endPrefetch = new DateTime(now2.Year, 12, 31);
                    if (!SessionDonationDataCacheService.TryGetDonationData(userId, selectedAccount, out var cachedPrefetch)
                        || !CacheCoversRange(cachedPrefetch, startPrefetch, endPrefetch))
                    {
                        var prefetchDto = await DonationService.GetDonationDataAsync(selectedAccount, "All", new Cya2.Core.ValueObjects.DateRange(startPrefetch, endPrefetch), userId);
                        SessionDonationDataCacheService.SetDonationData(userId, selectedAccount, prefetchDto, prioritize: true);
                        Logger.LogInformation("Home.accountSelection: preloaded donation cache for selectedAccount={Account}", selectedAccount);
                    }
                    else
                    {
                        Logger.LogInformation("Home.accountSelection: skipped donation preload for {Account} because cache already covers range", selectedAccount);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Home.accountSelection: failed to preload donation cache for {Account}", selectedAccount);
                }
            }

            selectedAccount = ResolveSelectedAccount(dashboardData);
            SessionUserStateService.SelectedAccountFund = selectedAccount;
            await ComputeMissingGiftAlertsAsync();
            try
            {
                // Persist server-side selection for initial page loads across circuits
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                // Prefer the cachedUserId computed during initialization to ensure the same key is used everywhere
                var userId = string.IsNullOrWhiteSpace(cachedUserId)
                    ? UserIdResolver.ResolveUserId(user, SessionUserStateService.CurrentUserId)
                    : cachedUserId;
                Logger.LogInformation("Home.accountSelection: resolved userId='{UserId}' (using cachedUserId when available) before persisting server-side selection", userId);
                if (UserSelectionService != null && !string.IsNullOrWhiteSpace(userId))
                {
                    UserSelectionService.SetSelectedAccount(userId, selectedAccount);
                    Logger.LogInformation("Home.accountSelection: persisted server-side selection for userId='{UserId}' -> '{Account}'", userId, selectedAccount);
                }
                else
                {
                    Logger.LogWarning("Home.accountSelection: skipping server-side persist because UserSelectionService is null or userId empty. serviceNull={ServiceNull}, userIdEmpty={UserIdEmpty}", UserSelectionService == null, string.IsNullOrWhiteSpace(userId));
                }
            }
            catch { }
            BuildDebugMessage("account-selection");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Home.accountSelection failed");
            BuildDebugMessage("account-selection-error", ex.Message);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PrefetchDashboardsAsync(string userId, List<string> accountsToPrefetch)
    {
        foreach (var fund in accountsToPrefetch)
        {
            try
            {
                if (SessionDashboardDtoCacheService.TryGetDashboard(userId, fund, out _))
                {
                    continue;
                }

                var dto = await DashboardService.GetDashboardSummaryDataAsync(fund, userId);
                CacheDashboard(fund, dto, prioritize: false);
                Logger.LogInformation("Home.prefetch: fetched summary DTO for {Fund}", fund);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Home.prefetch: failed for {Fund}", fund);
            }
        }
    }

    private void CacheDashboard(string fund, FinancialDashboardDto dto, bool prioritize)
    {
        if (string.IsNullOrWhiteSpace(cachedUserId) || string.IsNullOrWhiteSpace(fund) || dto == null)
        {
            return;
        }

        SessionDashboardDtoCacheService.SetDashboard(cachedUserId, fund, dto, prioritize);
    }

    private string ResolveSelectedAccount(FinancialDashboardDto data)
    {
        if (!string.IsNullOrWhiteSpace(data.SelectedAccount))
        {
            return data.SelectedAccount;
        }

        return data.UserAccounts.FirstOrDefault()?.Fund ?? string.Empty;
    }

    private static bool CacheCoversRange(DonationDataDto dto, DateTime startDate, DateTime endDate)
    {
        if (dto == null || dto.CachedStartDate == default || dto.CachedEndDate == default)
        {
            return false;
        }

        return dto.CachedStartDate.Date <= startDate.Date && dto.CachedEndDate.Date >= endDate.Date;
    }

    private Cya2.Core.ValueObjects.DateRange ResolveActiveDateRange()
    {
        if (SessionUserStateService.SelectedStartDate.HasValue && SessionUserStateService.SelectedEndDate.HasValue)
        {
            return new Cya2.Core.ValueObjects.DateRange(SessionUserStateService.SelectedStartDate.Value, SessionUserStateService.SelectedEndDate.Value);
        }

        var now = DateTime.Now;
        return new Cya2.Core.ValueObjects.DateRange(new DateTime(now.Year, now.Month, 1), now);
    }

    private void BuildDebugMessage(string source, string? note = null)
    {
        try
        {
            var sessionFunds = string.IsNullOrWhiteSpace(cachedUserId)
                ? Array.Empty<string>()
                : SessionDashboardDtoCacheService.GetFunds(cachedUserId);

            var lines = new List<string>
            {
                $"Source={source}",
                $"UserId={cachedUserId}",
                $"SelectedAccount={selectedAccount}",
                $"Dashboard.SelectedAccount={dashboardData.SelectedAccount}",
                $"HasAccountData={dashboardData.HasAccountData}",
                $"UserAccounts={dashboardData.UserAccounts?.Count ?? 0}",
                $"SessionDtoCacheCount={sessionFunds.Count}",
                $"SessionDtoCacheFunds={string.Join(",", sessionFunds)}",
                $"CurrentMonth: Donations={dashboardData.CurrentMonth?.TotalDonations:C2}, Expenses={dashboardData.CurrentMonth?.TotalExpenses:C2}, Overhead={dashboardData.CurrentMonth?.TotalOverhead:C2}, InternalTransfers={dashboardData.CurrentMonth?.InternalTransfers:C2}",
                $"PriorMonth: Donations={dashboardData.PriorMonth?.TotalDonations:C2}, Expenses={dashboardData.PriorMonth?.TotalExpenses:C2}",
                $"CurrentYear: Donations={dashboardData.CurrentYear?.TotalDonations:C2}, Expenses={dashboardData.CurrentYear?.TotalExpenses:C2}"
            };

            if (!string.IsNullOrWhiteSpace(note))
            {
                lines.Add($"Note={note}");
            }

            debugMessage = string.Join("\n", lines);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Home.BuildDebugMessage failed");
        }
    }

    private async Task CopyDebugMessageAsync()
    {
        if (string.IsNullOrEmpty(debugMessage))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", debugMessage);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "CopyDebugMessageAsync failed");
        }
    }
}