@page "/not-authorized"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Localizer["NotAuthorized"]</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h3 class="text-center">@Localizer["NotAuthorized"]</h3>
            </div>
            <div class="card-body text-center">
                <p>@Localizer["GoogleAccountNotRegistered"]</p>
                <p>@Localizer["ContactAdministratorForAccess"]</p>
                <p class="mt-4">@Localizer["TryDifferentGoogleAccount"]</p>
                <a href="/api/login" class="btn btn-primary">
                    <i class="bi bi-google me-2"></i> @Localizer["SignInWithDifferentAccount"]
                </a>
            </div>
        </div>
    </div>
</div>



