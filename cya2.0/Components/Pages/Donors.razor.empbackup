@page "/donors"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using ModelsLibrary
@using UtilityClasses
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using cya2.Components.Shared
@using Cya2.Application.Interfaces
@using Cya2.Application.DTOs
@using Cya2.Core.ValueObjects
@using Cya2.Core.Enums
@using DataLibrary
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject AppState AppState
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IStringLocalizer<Resource> Localizer
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject ILogger<Donors> Logger
@inject IDonorService DonorService
@inject IExpenseService ExpenseService
@inject UtilityClasses.SubAccountHelper SubAccountHelper
@inject DataLibrary.IDataAccess LowLevelDataAccess

<PageTitle>@Localizer["Donors"]</PageTitle>

<style>
    .donor-search-row { display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap; }
</style>

<RadzenStack Orientation="Orientation.Vertical" Gap="15px" Class="rz-p-4">

    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="2rem"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Start"
                 Style="width:100%;">

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.4rem" Style="flex:1;">
            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["DateRange"]</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="0.5rem"
                         AlignItems="AlignItems.Center"
                         Wrap="FlexWrap.Wrap">
                <RadzenLabel Text="@Localizer["StartDate"]" />
                <RadzenDatePicker @bind-Value="@dateRangeState.PendingStartDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                                  Change="@OnDatePickerChanged" />
                <RadzenLabel Text="@Localizer["EndDate"]" />
                <RadzenDatePicker @bind-Value="@dateRangeState.PendingEndDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                                  Change="@OnDatePickerChanged" />

                <RadzenDropDown TValue="DateRangeManager.DateRangePreset"
                                Data="@presetOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="@dateRangeState.SelectedPreset"
                                Change="@OnPresetChanged"
                                Style="width: 180px;">
                    <ValueTemplate>
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                            @(presetOptions.FirstOrDefault(o => o.Value == dateRangeState.SelectedPreset)?.Text ?? "")
                        </span>
                    </ValueTemplate>
                    <Template Context="opt">
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%;">
                            @opt.Text
                        </span>
                    </Template>
                </RadzenDropDown>

                <RadzenButton Text="@Localizer["ApplyFilter"]"
                              Icon="filter_alt"
                              Click="@selectDateRange"
                              Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.4rem" Style="flex:1; max-width:300px;">
            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["Account"]</RadzenText>
            <RadzenDropDown TValue="string"
                            Data="@userAccounts"
                            TextProperty="Fund"
                            ValueProperty="Fund"
                            @bind-Value="selectedAccount"
                            Change="@(async (args) => await accountSelection(args?.ToString() ?? string.Empty))"
                            Placeholder="@Localizer["ChooseAccount"]"
                            Style="width: 300px;">
                <ValueTemplate>
                    <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                        @FundDisplayHelper.GetDisplay(selectedAccount)
                    </span>
                </ValueTemplate>
                <Template Context="acct">
                    <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%;">
                        @FundDisplayHelper.GetDisplay(acct.Fund)
                    </span>
                </Template>
            </RadzenDropDown>
        </RadzenStack>

    </RadzenStack>

    <!-- Left column: donor details and search. Right column: donors list -->
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Class="rz-mt-3" Style="width:100%;">

        <!-- Left narrow column: search and selected donor details -->
        <div style="flex:0 0 28%; min-width:260px;">
            <div class="donor-search-row" style="margin-bottom:0.75rem;">
                <div id="donorAutoCompleteContainer">
                    <RadzenAutoComplete TValue="string"
                                        Data="@donorNames"
                                        @bind-Value="searchText"
                                        Placeholder="@Localizer["SearchDonors"]"
                                        Change="@OnAutocompleteChanged"
                                        Style="width:100%;"
                                        KeyDown="@OnSearchKeyDown" />
                </div>

                <RadzenButton Text="Clear" Click="@(()=> ClearDonorSelection())" ButtonStyle="ButtonStyle.Light" Style="margin-left:0.5rem;" />
            </div>

            <RadzenCard Style="padding:0.75rem;">
                 <div style="display:grid; grid-template-columns: 1fr; row-gap:6px; align-items:start;">
                    <div style="text-align:right; margin-bottom:0.5rem;">
                        <RadzenButton Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(async () => await CopySelectedDonor())" Style="margin-bottom:0.25rem;" Text="@Localizer["Copy"]" />
                    </div>
                    
                    <!-- Use the shared DonorInfoDisplay component for contact information only -->
                    <DonorInfoDisplay DonorName="@(string.IsNullOrWhiteSpace(selectedDonor) ? string.Empty : selectedDonor)"
                                     DonorEmail="@donorEmail"
                                     DonorPhoneMobile="@donorPhoneMobile"
                                     DonorPhoneFixed="@donorPhoneFixed"
                                     DonorAddress="@donorAddress"
                                     DonorCity="@donorCity"
                                     DonorState="@donorState"
                                     DonorPostal="@donorPostal"
                                     DonorCountry="@donorCountry"
                                     AdditionalStyling=""
                                     AllowTextSelection="false" />
                </div>
            </RadzenCard>
        </div>

        <!-- Right flexible column: donors list -->
        <div style="flex:1 1 0;">
            <RadzenCard Style="padding:0.5rem; margin-top:0.75rem;">
                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["SelectedDonors"]</RadzenText>

                <!-- Debug area -->
                @if (!string.IsNullOrEmpty(debugMessage))
                {
                    <div style="background:#fff3cd;border:1px solid #ffeeba;padding:0.5rem;margin-top:0.5rem;">DEBUG: @debugMessage</div>
                }

                <!-- Column selectors and action buttons on same row -->
                <div style="margin-top:0.5rem; display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap; justify-content:space-between; width:100%;">
                    <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap; flex:1;">
                        <label style="font-weight:600; color:#666; margin-right:0.5rem;">@Localizer["ColumnSelection"]</label>
                        <div style="display:flex; gap:0.5rem; align-items:center;">
                            <RadzenCheckBox @bind-Value="showTotal" /> <span>@Localizer["AmountGiven"]</span>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items-center;">
                            <RadzenCheckBox @bind-Value="showPaymentMethod" /> <span>@Localizer["PaymentMethod"]</span>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items-center;">
                            <RadzenCheckBox @bind-Value="showEmail" /> <span>@Localizer["Email"]</span>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items-center;">
                            <RadzenCheckBox @bind-Value="showPhone" /> <span>@Localizer["Phone"]</span>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items-center;">
                            <RadzenCheckBox @bind-Value="showAddress" /> <span>@Localizer["Address"]</span>
                        </div>
                    </div>

                    <div style="display:flex; gap:0.5rem; align-items-center;">
                        <RadzenButton Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(async () => await CopyDonorsInRange())" Style="margin-bottom:0.25rem;">@Localizer["Copy"]</RadzenButton>
                        <RadzenButton Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click="@(async () => await DownloadDonorsExcel())" Style="margin-bottom:0.25rem;">@Localizer["DownloadExcel"]</RadzenButton>
                    </div>
                </div>

                <RadzenDataGrid TItem="DonorSummaryDto" Data="@donorsInRange" Style="width:100%;" RowSelect="@(async (args) => await OnDonorRowSelect(args))">
                    <Columns>
                        <RadzenDataGridColumn TItem="DonorSummaryDto" Property="Name" Title="@Localizer["Donor"]" />
                        @if (showPaymentMethod)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="PaymentMethod" Title="@Localizer["PaymentMethod"]" />
                        }
                        @if (showEmail)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="Email" Title="@Localizer["Email"]" />
                        }
                        @if (showPhone)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="PhoneSummary" Title="@Localizer["Phone"]" />
                        }
                        @if (showAddress)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="AddressSummary" Title="@Localizer["Address"]" />
                        } 
                        @if (showTotal)
                        {
                            <RadzenDataGridColumn TItem="DonorSummaryDto" Property="Total" Title="@Localizer["TotalGiven"]" FormatString="{0:C2}" />
                        }
                        <RadzenDataGridColumn TItem="DonorSummaryDto" Title="@Localizer["Frequency"]">
                            <Template Context="d">@GetFrequencyLabel(d.Frequency)</Template>
                        </RadzenDataGridColumn>

                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        </div>

    </RadzenStack>

</RadzenStack>

@code {
    private DateRangeManager.DateRangeState dateRangeState = new();
    private List<DateRangeManager.PresetOption> presetOptions = new();

    private string selectedAccount = string.Empty;
    private Account? currentAccount = null;
    private List<Account> userAccounts = new();

    private List<string> donorNames = new();
    private string searchText = string.Empty;
    private string? selectedDonor;

    private string donorEmail = string.Empty;
    private string donorPhoneMobile = string.Empty;
    private string donorPhoneFixed = string.Empty;
    private string donorAddress = string.Empty;
    private string donorCity = string.Empty;
    private string donorState = string.Empty;
    private string donorPostal = string.Empty;
    private string donorCountry = string.Empty;
    private List<DonorSummaryDto> donorsInRange = new();
    private string debugMessage = string.Empty;

    private bool showTotal = true;
    private bool showEmail = false;
    private bool showPhone = false;
    private bool showAddress = false;
    private bool showPaymentMethod = false;
    private bool showSubAccountDropdown = false;
    private string selectedSubAccount = "All";
    private List<UtilityClasses.SubAccountOption> subAccountOptions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var userId = user.FindFirstValue("UserId")
                        ?? user.FindFirstValue(ClaimTypes.Email)
                        ?? user.Identity?.Name
                        ?? string.Empty;

            var authLevel = user.FindFirstValue("AuthLevel") ?? string.Empty;
            var isAdminOnlyHint = user.IsInRole("Admin")
                      || string.Equals(authLevel, "Admin", StringComparison.OrdinalIgnoreCase);

            presetOptions = DateRangeManager.GetPresetOptions(Localizer);
            dateRangeState = DateRangeManager.InitializeDateRange(AppState);

            userAccounts = await ExpenseService.GetUserAccountsAsync(userId, isAdminOnlyHint);

            if (userAccounts.Any())
            {
                selectedAccount = !string.IsNullOrEmpty(AppState.SelectedAccount)
                    ? AppState.SelectedAccount
                    : (!string.IsNullOrEmpty(AppState.DefaultAccount) ? AppState.DefaultAccount : userAccounts.First().Fund);

                currentAccount = userAccounts.FirstOrDefault(a => string.Equals(a.Fund, selectedAccount, StringComparison.OrdinalIgnoreCase))
                                 ?? userAccounts.FirstOrDefault();

                selectedAccount = currentAccount?.Fund ?? string.Empty;
                if (!string.IsNullOrEmpty(selectedAccount))
                {
                    AppState.SelectedAccount = selectedAccount;
                }

                if (currentAccount != null)
                {
                    showSubAccountDropdown = await SubAccountHelper.HasSeparateSubAccountsAsync(currentAccount.AccountId);
                    if (showSubAccountDropdown)
                    {
                        var opts = await SubAccountHelper.GetSubAccountOptionsAsync(currentAccount);
                        subAccountOptions = opts.Select(o => new UtilityClasses.SubAccountOption
                        {
                            Value = o.Value,
                            DisplayText = o.DisplayText,
                            IsAll = o.IsAll,
                            IsPrimary = o.IsPrimary,
                            SubAccountId = o.SubAccountId,
                            SubFund = o.SubFund
                        }).ToList();
                        selectedSubAccount = "All";
                    }

                    await LoadDonorNamesForAccount(currentAccount);
                    await BuildDonorsInRange(currentAccount);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Donors page");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
             try
             {
                await JS.InvokeVoidAsync("import", "/js/autocomplete-tab.js");
                await JS.InvokeVoidAsync("enableAutocompleteTabBehavior", "donorAutoCompleteContainer");
             }
             catch (Exception ex)
             {
                 await JS.InvokeVoidAsync("console.error", ex.Message);
             }
         }
    }

    private async Task LoadDonorNamesForAccount(Account account)
    {
        // If sub-account dropdown is in use, build fund list for current selection
        if (showSubAccountDropdown && !string.IsNullOrWhiteSpace(selectedSubAccount))
        {
            var funds = await SubAccountHelper.GetFundNamesForSelectionAsync(account, selectedSubAccount);
            // pick primary fund for names (use first)
            var fundForNames = funds.FirstOrDefault() ?? account.Fund;
            donorNames = await DonorService.GetDonorNamesAsync(fundForNames);
        }
        else
        {
            donorNames = await DonorService.GetDonorNamesAsync(account.Fund);
        }
    }

    private async Task BuildDonorsInRange(Account account)
    {
        donorsInRange = new List<DonorSummaryDto>();
        try
        {
            // Diagnostic: log which implementations are injected
            try
            {
                Logger.LogInformation("Diagnostic: IDonorService implementation: {Type}", DonorService?.GetType().FullName ?? "(null)");
            }
            catch { }
            try
            {
                Logger.LogInformation("Diagnostic: IDataAccess (LowLevelDataAccess) implementation: {Type}", LowLevelDataAccess?.GetType().FullName ?? "(null)");
            }
            catch { }

            try
            {
                // If the service exposes a last-query helper, attempt to call it via reflection
                var getLastMethod = DonorService?.GetType().GetMethod("GetLastQuery");
                if (getLastMethod != null)
                {
                    try
                    {
                        var qsObj = getLastMethod.Invoke(DonorService, null);
                        var qs = qsObj as string;
                        if (!string.IsNullOrWhiteSpace(qs)) Logger.LogInformation("Diagnostic: DonorService.GetLastQuery() BEFORE work: {Query}", qs);
                    }
                    catch { }
                }
             }
             catch { }

             // Determine fund selection
             List<string> funds = new();
             if (showSubAccountDropdown)
             {
                 // If user selected "All", use optimized account-level query to include primary + separate subfunds
                 if (string.Equals(selectedSubAccount, "All", StringComparison.OrdinalIgnoreCase))
                 {
                    debugMessage = $"Loading donors for account id {account.AccountId} (All subfunds) from {dateRangeState.StartDate:d} to {dateRangeState.EndDate:d}";
                    Logger.LogInformation(debugMessage);

                    // Build fund list for the account (primary + separate subfunds)
                    var fundsListRaw = await SubAccountHelper.GetFundNamesForSelectionAsync(account, "All") ?? new List<string>();
                    var fundsList = fundsListRaw
                        .Where(f => !string.IsNullOrWhiteSpace(f))
                        .Select(f => f!.Trim())
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    // If helper returned an empty list, fall back to the primary account fund to ensure we still query the DB
                    if (!fundsList.Any()) fundsList = new List<string> { account.Fund };

                    // Prefer using cached donation data if available (Donations page populates AppState.DonationData)
                    Logger.LogInformation("Building donors from in-memory DonationData cache for AccountId={AccountId} (funds={Funds})", account.AccountId, string.Join(", ", fundsList));
                    var acctResults = new List<DonorSummaryDto>();
                    var queryLogsAcct = new List<string>();
                    try
                    {
                        var cached = AppState.DonationData;
                        if (cached != null && cached.Any())
                        {
                            var rows = cached
                                .Where(r => r.Date >= dateRangeState.StartDate && r.Date <= dateRangeState.EndDate && fundsList.Contains(r.Fund, StringComparer.OrdinalIgnoreCase))
                                .ToList();

                            if (rows.Any())
                            {
                                acctResults = rows
                                    .Where(r => !string.IsNullOrWhiteSpace(r.AccountName))
                                    .GroupBy(r => r.AccountName!.Trim(), StringComparer.OrdinalIgnoreCase)
                                    .Select(g => new DonorSummaryDto
                                    {
                                        Name = g.Key,
                                        Total = g.Sum(x => Convert.ToDecimal(x.Amount)),
                                        Email = g.Select(x => x.Email).FirstOrDefault(e => !string.IsNullOrWhiteSpace(e)) ?? string.Empty,
                                        PhoneSummary = string.Join("; ", g.Select(x => !string.IsNullOrWhiteSpace(x.PhoneMobile) ? x.PhoneMobile : x.PhoneFixed).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct()),
                                        AddressSummary = g.Select(x => x.Address).FirstOrDefault(a => !string.IsNullOrWhiteSpace(a)) ?? string.Empty,
                                        Frequency = DonorFrequency.Sporadic
                                    })
                                    .OrderByDescending(d => d.Total).ThenBy(d => d.Name)
                                    .ToList();

                                debugMessage = $"Loaded {acctResults.Count} donors from cache for account '{account.Fund}' (Id={account.AccountId}).";
                                try
                                {
                                    var donationCacheCount = AppState.DonationData?.Count ?? 0;
                                    var accountingCount = AppState.AccountingData?.Count ?? 0;
                                    var sampleStr = BuildSample(acctResults);
                                    debugMessage += "\nSamples: " + sampleStr + $"\nAppState: DonationData={donationCacheCount}, AccountingData={accountingCount}";
                                    Logger.LogInformation(debugMessage);
                                    Logger.LogDebug("Donors cache sample: {Sample} (DonationDataCount={DonationCount}, AccountingDataCount={AccountingDataCount})", sampleStr, donationCacheCount, accountingCount);
                                }
                                catch (Exception ex)
                                {
                                    Logger.LogWarning(ex, "Failed to build donor debug sample from cache");
                                }
                                donorsInRange = acctResults;
                                return;
                            }
                            else
                            {
                                queryLogsAcct.Add("No matching rows in in-memory DonationData cache");
                            }
                        }
                        else
                        {
                            queryLogsAcct.Add("DonationData cache empty");
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Error building donors from cache, will fallback to service calls");
                    }

                    // Fallback: call per-fund service overload for each fund and aggregate results
                    try
                    {
                        Logger.LogInformation("Diagnostic: About to call per-fund DonorService for {Count} funds", fundsList.Count);
                        foreach (var f in fundsList)
                         {
                             try
                             {
                                Logger.LogInformation("Calling DonorService.GetDonorSummariesAsync for fund {Fund}", f);
                                 var part = await DonorService.GetDonorSummariesAsync(f, new DateRange(dateRangeState.StartDate, dateRangeState.EndDate));
                                 Logger.LogInformation("Fund {Fund} returned {Count} rows", f, part?.Count ?? 0);
                                 if (part != null) acctResults.AddRange(part);

                                 try
                                 {
                                     var getLast = DonorService?.GetType().GetMethod("GetLastQuery");
                                     if (getLast != null)
                                     {
                                         var qsObj = getLast.Invoke(DonorService, null);
                                         var qs = qsObj as string;
                                         if (!string.IsNullOrWhiteSpace(qs)) queryLogsAcct.Add($"Fund {f} query (service): {qs}");
                                     }
                                 }
                                 catch { }

                                 try { var qd = LowLevelDataAccess?.LastQuery; if (!string.IsNullOrWhiteSpace(qd)) queryLogsAcct.Add($"Fund {f} query (data): {qd}"); } catch { }
                             }
                             catch (Exception ex)
                             {
                                 Logger.LogError(ex, "Error loading donors for fund {Fund}", f);
                             }
                         }
                     }
                     catch (Exception ex)
                     {
                         Logger.LogError(ex, "Per-fund DonorService calls failed for AccountId={AccountId}", account.AccountId);
                     }

                    donorsInRange = acctResults.OrderByDescending(x => x.Total).ThenBy(x => x.Name).ToList();
                    debugMessage = $"Loaded {donorsInRange.Count} donors for account '{account.Fund}' (Id={account.AccountId}).";
                    try
                    {
                        var donationCacheCount = AppState.DonationData?.Count ?? 0;
                        var accountingCount = AppState.AccountingData?.Count ?? 0;
                        var sampleStr = BuildSample(donorsInRange);
                        if (queryLogsAcct.Any()) debugMessage += "\n" + string.Join("\n", queryLogsAcct);
                        debugMessage += "\nSamples: " + sampleStr + $"\nAppState: DonationData={donationCacheCount}, AccountingData={accountingCount}";
                        Logger.LogInformation(debugMessage);
                        Logger.LogDebug("Donors per-fund sample: {Sample} (DonationDataCount={DonationCount}, AccountingDataCount={AccountingDataCount})", sampleStr, donationCacheCount, accountingCount);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to build donor debug sample after per-fund aggregation");
                    }
                     return;
                }

                // Otherwise resolve specific fund names for the current selection (Primary or a single Sub_{id})
                funds = await SubAccountHelper.GetFundNamesForSelectionAsync(account, selectedSubAccount);
                if (funds == null || funds.Count == 0)
                {
                    funds = new List<string> { account.Fund };
                }
            }
            else
            {
                funds.Add(account.Fund);
            }

            debugMessage = $"Loading donors for funds: {string.Join(',', funds)} from {dateRangeState.StartDate:d} to {dateRangeState.EndDate:d} (AccountId={account.AccountId})";
            Logger.LogInformation(debugMessage);

            // Query each fund and merge by donor name (safe when interface doesn't expose multi-fund overload)
            var map = new Dictionary<string, DonorSummaryDto>(StringComparer.OrdinalIgnoreCase);
            var queryLogs = new List<string>();
            foreach (var f in funds)
            {
                // Diagnostic: log before each per-fund call
                try { Logger.LogInformation("Diagnostic: Calling DonorService for fund '{Fund}'", f); } catch { }

                var list = await DonorService.GetDonorSummariesAsync(f, new DateRange(dateRangeState.StartDate, dateRangeState.EndDate));

                // capture last query if available from DonorService dynamic method
                try
                {
                    var getLast = DonorService?.GetType().GetMethod("GetLastQuery");
                    if (getLast != null)
                    {
                        var qobj = getLast.Invoke(DonorService, null);
                        var q = qobj as string;
                        if (!string.IsNullOrWhiteSpace(q)) queryLogs.Add($"Fund {f} query (service): {q}");
                    }
                }
                catch { }

                // Also capture last query directly from IDataAccess implementation for reliability
                try
                {
                    var q2 = LowLevelDataAccess?.LastQuery;
                    if (!string.IsNullOrWhiteSpace(q2)) queryLogs.Add($"Fund {f} query (data): {q2}");
                }
                catch { }

                foreach (var d in list)
                {
                    if (string.IsNullOrWhiteSpace(d.Name)) continue;
                    if (!map.TryGetValue(d.Name, out var existing))
                    {
                        map[d.Name] = new DonorSummaryDto
                        {
                            Name = d.Name,
                            Total = d.Total,
                            Email = d.Email ?? string.Empty,
                            PhoneSummary = d.PhoneSummary ?? string.Empty,
                            AddressSummary = d.AddressSummary ?? string.Empty,
                            Frequency = d.Frequency
                        };
                    }
                    else
                    {
                        existing.Total += d.Total;
                        if (string.IsNullOrWhiteSpace(existing.Email) && !string.IsNullOrWhiteSpace(d.Email)) existing.Email = d.Email;
                        if (string.IsNullOrWhiteSpace(existing.PhoneSummary) && !string.IsNullOrWhiteSpace(d.PhoneSummary)) existing.PhoneSummary = d.PhoneSummary;
                        if (string.IsNullOrWhiteSpace(existing.AddressSummary) && !string.IsNullOrWhiteSpace(d.AddressSummary)) existing.AddressSummary = d.AddressSummary;
                    }
                }
            }

            donorsInRange = map.Values.OrderByDescending(x => x.Total).ThenBy(x => x.Name).ToList();
            debugMessage = $"Loaded {donorsInRange.Count} donors for funds: {string.Join(',', funds)}";
            try
            {
                var donationCacheCount = AppState.DonationData?.Count ?? 0;
                var accountingCount = AppState.AccountingData?.Count ?? 0;
                var sampleStr = BuildSample(donorsInRange);
                if (queryLogs.Any()) debugMessage += "\n" + string.Join("\n", queryLogs);
                debugMessage += "\nSamples: " + sampleStr + $"\nAppState: DonationData={donationCacheCount}, AccountingData={accountingCount}";
                Logger.LogInformation(debugMessage);
                Logger.LogDebug("Donors merged sample: {Sample} (DonationDataCount={DonationCount}, AccountingDataCount={AccountingDataCount})", sampleStr, donationCacheCount, accountingCount);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to build donor debug sample after merging funds");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error building donors in range");
            debugMessage = "Error building donors: " + ex.Message;
            donorsInRange = new List<DonorSummaryDto>();
        }
    }

    private async Task OnDonorSelected()
    {
        if (string.IsNullOrWhiteSpace(selectedDonor))
        {
            ClearDonorSelection();
            return;
        }

        ResetDonorContact();

        if (currentAccount != null)
        {
            var detail = await DonorService.GetDonorDetailAsync(selectedDonor, currentAccount.Fund);
            if (detail != null)
            {
                donorEmail = detail.Email;
                donorPhoneMobile = detail.PhoneMobile;
                donorPhoneFixed = detail.PhoneFixed;
                donorAddress = detail.Address;
                donorCity = detail.City;
                donorState = detail.State;
                donorPostal = detail.PostalCode;
                donorCountry = detail.Country;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnAutocompleteChanged(object? args)
    {
        searchText = args?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(searchText)) return;

        selectedDonor = searchText;
        await OnDonorSelected();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Tab")
        {
            var text = searchText?.Trim() ?? string.Empty;
            if (!string.IsNullOrEmpty(text))
            {
                var suggestion = donorNames.FirstOrDefault(d => string.Equals(d, text, StringComparison.OrdinalIgnoreCase))
                                 ?? donorNames.FirstOrDefault(d => d.StartsWith(text, StringComparison.OrdinalIgnoreCase))
                                 ?? donorNames.FirstOrDefault(d => d.IndexOf(text, StringComparison.OrdinalIgnoreCase) >= 0);

                if (!string.IsNullOrEmpty(suggestion))
                {
                    selectedDonor = suggestion;
                    searchText = string.Empty;
                    await OnDonorSelected();
                }
            }
        }
    }

    private async Task OnDonorRowSelect(DonorSummaryDto summary)
    {
        if (summary == null) return;

        selectedDonor = summary.Name;
        searchText = string.Empty;
        await OnDonorSelected();
    }

    private void OnPresetChanged(object? args)
    {
        if (args is DateRangeManager.DateRangePreset preset)
        {
            DateRangeManager.ApplyPreset(dateRangeState, preset);
            StateHasChanged();
        }
    }

    private void OnDatePickerChanged()
    {
        DateRangeManager.ApplyPendingDates(dateRangeState);
        StateHasChanged();
    }

    private void ClearDonorSelection()
    {
        selectedDonor = null;
        searchText = string.Empty;
        ResetDonorContact();
        StateHasChanged();
    }

    private void ResetDonorContact()
    {
        donorEmail = string.Empty;
        donorPhoneMobile = string.Empty;
        donorPhoneFixed = string.Empty;
        donorAddress = string.Empty;
        donorCity = string.Empty;
        donorState = string.Empty;
        donorPostal = string.Empty;
        donorCountry = string.Empty;
    }

    private async Task selectDateRange()
    {
        DateRangeManager.ApplyPendingDates(dateRangeState);
        DateRangeManager.SaveDateRangeToAppState(AppState, dateRangeState);

        if (currentAccount != null)
        {
            await BuildDonorsInRange(currentAccount);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task accountSelection(string accountName)
    {
        if (string.IsNullOrEmpty(accountName)) return;

        selectedAccount = accountName;
        AppState.SelectedAccount = accountName;

        currentAccount = userAccounts.FirstOrDefault(a => a.Fund == selectedAccount);
        if (currentAccount != null)
        {
            // Determine if account has separate sub-accounts
            showSubAccountDropdown = await SubAccountHelper.HasSeparateSubAccountsAsync(currentAccount.AccountId);
            if (showSubAccountDropdown)
            {
                var opts = await SubAccountHelper.GetSubAccountOptionsAsync(currentAccount);
                subAccountOptions = opts.Select(o => new UtilityClasses.SubAccountOption { Value = o.Value, DisplayText = o.DisplayText, IsAll = o.IsAll, IsPrimary = o.IsPrimary, SubAccountId = o.SubAccountId, SubFund = o.SubFund }).ToList();
                selectedSubAccount = "All";
            }

            await LoadDonorNamesForAccount(currentAccount);
            await BuildDonorsInRange(currentAccount);
        }

        ClearDonorSelection();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopySelectedDonor()
    {
        if (string.IsNullOrWhiteSpace(selectedDonor))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["Copy"], Detail = Localizer["NoDonorSelected"], Duration = 3000 });
            return;
        }

        var payload = await DonorService.FormatDonorContactForCopyAsync(selectedDonor, currentAccount?.Fund ?? string.Empty);
        if (string.IsNullOrWhiteSpace(payload))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["Copy"], Detail = Localizer["NoDonorSelected"], Duration = 3000 });
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", payload);
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = Localizer["Copy"], Detail = Localizer["CopiedToClipboard"], Duration = 3000 });
    }

    private async Task CopyDonorsInRange()
    {
        if (donorsInRange == null || !donorsInRange.Any())
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["Copy"], Detail = Localizer["NoDonorsInRange"], Duration = 3000 });
            return;
        }

        var rows = donorsInRange.Select(d =>
        {
            var parts = new List<string> { d.Name };
            if (showTotal) parts.Add(d.Total.ToString("C2"));
            if (showPaymentMethod) parts.Add(d.PaymentMethod);
            parts.Add(GetFrequencyLabel(d.Frequency));
            if (showEmail) parts.Add(d.Email);
            if (showPhone) parts.Add(d.PhoneSummary);
            if (showAddress) parts.Add(d.AddressSummary);
            return string.Join('\t', parts);
         });
         var payload = string.Join("\n", rows);

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", payload);
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = Localizer["Copy"], Detail = Localizer["CopiedToClipboard"], Duration = 3000 });
    }

    private async Task DownloadDonorsExcel()
    {
        if (currentAccount == null)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["DownloadExcel"], Detail = Localizer["NoAccountSelected"], Duration = 3000 });
            return;
        }

        var req = new
        {
            Fund = currentAccount.Fund,
            Rows = donorsInRange.Select(d => new {
                Name = d.Name,
                Total = d.Total,
                Email = d.Email,
                Phone = d.PhoneSummary,
                Address = d.AddressSummary,
                PaymentMethod = d.PaymentMethod,
                Frequency = GetFrequencyLabel(d.Frequency)
            }).ToList(),
            IncludeTotal = showTotal,
            IncludeLastDonation = true,
            IncludePaymentMethod = showPaymentMethod,
            IncludeEmail = showEmail,
            IncludePhone = showPhone,
            IncludeAddress = showAddress
        };

        var payload = System.Text.Json.JsonSerializer.Serialize(req);
        await JS.InvokeVoidAsync("postJsonAndDownload", "/api/donors/export-data", payload);

         NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["DownloadExcel"], Detail = Localizer["DownloadStarted"], Duration = 3000 });
     }

    private static string GetFrequencyLabel(DonorFrequency frequency)
    {
        return frequency switch
        {
            DonorFrequency.OneTime => "One-time",
            DonorFrequency.Sporadic => "Occasional",
            DonorFrequency.Monthly => "Frequent",
            DonorFrequency.Yearly => "Yearly",
            _ => "Unknown"
        };
    }

    private string BuildSample(IEnumerable<DonorSummaryDto> items)
    {
        try
        {
            var parts = items.Take(5).Select(d =>
                $"{d.Name}|Total={d.Total}|Email={(string.IsNullOrWhiteSpace(d.Email) ? "(empty)" : "OK")}|Phone={(string.IsNullOrWhiteSpace(d.PhoneSummary) ? "(empty)" : "OK")}|Addr={(string.IsNullOrWhiteSpace(d.AddressSummary) ? "(empty)" : "OK")}" );
            return string.Join(", ", parts);
        }
        catch
        {
            return string.Empty;
        }
    }

}
