    private void BuildPivot()
    {
        var pivot = DonationPresentationService.BuildPivot(selectedDonations, dateRangeState.StartDate, dateRangeState.EndDate, Localizer["Unknown"]);

        monthColumns.Clear();
        monthColumns.AddRange(pivot.MonthColumns);

        pivotRows.Clear();
        pivotRows.AddRange(pivot.Rows);

        monthTotals.Clear();
        foreach (var kv in pivot.MonthTotals)
        {
            monthTotals[kv.Key] = kv.Value;
        }

        grandTotal = pivot.GrandTotal;
        BuildMonthlyDonationSeries();
    }

    private void BuildMonthlyDonationSeries()
    {
        totalMonthlyDonationSeries.Clear();
        monthlyDonationSeriesByFrequency.Clear();

        foreach (var month in monthColumns)
        {
            var monthTotal = monthTotals.TryGetValue(month, out var total) ? total : 0m;
            var roundedMonthTotal = Math.Round(monthTotal, 0, MidpointRounding.AwayFromZero);

            totalMonthlyDonationSeries.Add(new MonthlyDonationChartPoint
            {
                MonthLabel = GetMonthHeader(month),
                Total = roundedMonthTotal
            });
        }

        if (!selectedDonations.Any())
        {
            return;
        }

        var groupedByFrequency = selectedDonations
            .GroupBy(d => CanonicalFrequencyLabel(d.Frequency))
            .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.OrdinalIgnoreCase);

        foreach (var frequencyGroup in groupedByFrequency.OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase))
        {
            var byMonth = frequencyGroup
                .Value
                .GroupBy(d => new DateTime(d.Date.Year, d.Date.Month, 1))
                .ToDictionary(
                    g => g.Key,
                    g => Math.Round(g.Sum(d => Convert.ToDecimal(d.Amount)), 0, MidpointRounding.AwayFromZero));

            var frequencySeries = new List<MonthlyDonationChartPoint>();

        foreach (var month in monthColumns)
        {
                var total = byMonth.TryGetValue(month, out var monthTotal) ? monthTotal : 0m;

                frequencySeries.Add(new MonthlyDonationChartPoint
                {
                    MonthLabel = GetMonthHeader(month),
                    Total = total
                });
            }

            monthlyDonationSeriesByFrequency[frequencyGroup.Key] = frequencySeries;
        }

        if (!monthlyDonationSeriesByFrequency.ContainsKey("Monthly"))
        {
            monthlyDonationSeriesByFrequency["Monthly"] = BuildZeroMonthlySeries();
        }

        if (!monthlyDonationSeriesByFrequency.ContainsKey("Non Monthly"))
        {
            monthlyDonationSeriesByFrequency["Non Monthly"] = BuildZeroMonthlySeries();
        }

        var ordered = monthlyDonationSeriesByFrequency
            .OrderBy(kv => GetFrequencySeriesOrder(kv.Key))
            .ThenBy(kv => kv.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();

        monthlyDonationSeriesByFrequency.Clear();
        foreach (var item in ordered)
        {
            monthlyDonationSeriesByFrequency[item.Key] = item.Value;
        }

    }

    private string CanonicalFrequencyLabel(string? frequency)
    {
        var trimmed = string.IsNullOrWhiteSpace(frequency) ? "Unspecified" : frequency.Trim();
        var normalized = NormalizeFrequency(trimmed);

        if (normalized is "onetime" or "sporadic")
        {
            return "Non Monthly";
        }

        if (normalized == "monthly")
        {
            return "Monthly";
        }

        return trimmed;
    }

    private List<MonthlyDonationChartPoint> BuildZeroMonthlySeries()
    {
        return monthColumns
            .Select(m => new MonthlyDonationChartPoint
            {
                MonthLabel = GetMonthHeader(m),
                Total = 0m
            })
            .ToList();
    }

    private static string NormalizeFrequency(string value)
    {
        return value
            .Replace(" ", string.Empty, StringComparison.Ordinal)
            .Replace("-", string.Empty, StringComparison.Ordinal)
            .ToLowerInvariant();
    }

    private int GetFrequencySeriesOrder(string key)
    {
        var normalized = NormalizeFrequency(key);
        return normalized switch
        {
            "monthly" => 0,
            "nonmonthly" => 1,
            _ => 2
        };
    }

