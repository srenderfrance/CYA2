    private async Task OnDonorClick(string? donorName)
    {
        if (string.IsNullOrWhiteSpace(donorName) || donorName == Localizer["Unknown"] || donorName == Localizer["Anonymous"])
        {
            return;
        }

        try
        {
            var donorDonations = selectedDonations
                .Where(d => string.Equals(d.Donor?.Trim(), donorName?.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (!donorDonations.Any())
            {
                return;
            }

            var donorTotal = donorDonations.Sum(d => Convert.ToDecimal(d.Amount));
            var donorLastDate = donorDonations.Max(d => d.Date);
            var donationCount = donorDonations.Count;

            var mostRecent = donorDonations.OrderByDescending(d => d.Date).First();

            await DialogService.OpenAsync<DonorDetailsDialog>(
                title: Localizer["ContactInformation"],
                    parameters: new Dictionary<string, object?>
                {
                    { nameof(DonorDetailsDialog.DonorName), donorName },
                    { nameof(DonorDetailsDialog.DonorEmail), mostRecent.Email ?? string.Empty },
                    { nameof(DonorDetailsDialog.DonorPhoneMobile), mostRecent.PhoneMobile ?? string.Empty },
                    { nameof(DonorDetailsDialog.DonorPhoneFixed), mostRecent.PhoneFixed ?? string.Empty },
                    { nameof(DonorDetailsDialog.DonorAddress), mostRecent.Address ?? string.Empty },
                    { nameof(DonorDetailsDialog.DonorCity), mostRecent.City ?? string.Empty },
                    { nameof(DonorDetailsDialog.DonorState), mostRecent.State ?? string.Empty },
                    { nameof(DonorDetailsDialog.DonorPostal), mostRecent.PostalCode ?? string.Empty },
                    { nameof(DonorDetailsDialog.DonorCountry), mostRecent.Country ?? string.Empty }
                },
                options: new DialogOptions
                {
                    Width = "95vw",
                    Height = "auto",
                    Resizable = false,
                    ShowClose = true,
                    Style = "max-width: 600px;"
                }
            );
        }
        catch (Exception ex)
        {
            Debug($"Error opening donor dialog: {ex.Message}");
            Console.WriteLine($"Error in OnDonorClick: {ex.Message}");
        }
    }

