    // Use IDateRangeStateService for centralized date management
    private DateRangeStateDto dateRangeState = new();
    private List<DateRangePresetOptionDto> presetOptions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // Resolve user id
            userId = UserIdResolver.ResolveUserId(user, SessionUserStateService.CurrentUserId);

            // Do not reset session state here. The middleware is responsible for populating per-request
            // selected-account and setting CurrentUserId. Only initialize CurrentUserId when empty so we
            // don't accidentally clear middleware-populated SelectedAccountFund.
            if (string.IsNullOrWhiteSpace(SessionUserStateService.CurrentUserId))
            {
                SessionUserStateService.CurrentUserId = userId;
            }

            // If middleware populated server-side selection (in a separate HTTP request scope) it may be
            // stored in IUserSelectionService (Memory cache). The Blazor circuit's scoped SessionUserStateService
            // can be empty because middleware ran in a different scope. Try to hydrate session from the
            // server-side selection store so the circuit has the same SelectedAccountFund.
            if (string.IsNullOrWhiteSpace(SessionUserStateService.SelectedAccountFund))
            {
                try
                {
                    if (!string.IsNullOrWhiteSpace(userId) && UserSelectionService != null && UserSelectionService.TryGetSelectedAccount(userId, out var svcAcct) && !string.IsNullOrWhiteSpace(svcAcct))
                    {
                        SessionUserStateService.SelectedAccountFund = svcAcct;
                        Debug($"Hydrated session SelectedAccountFund from UserSelectionService: '{svcAcct}'");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to hydrate session SelectedAccountFund from UserSelectionService");
                }
            }

            var authLevel = user.FindFirstValue("AuthLevel") ?? string.Empty;
            isAdminOrViewer = user.IsInRole("Admin") ||
                              string.Equals(authLevel, "Admin", StringComparison.OrdinalIgnoreCase) ||
                              string.Equals(authLevel, "Viewer", StringComparison.OrdinalIgnoreCase);

            presetOptions = GetPresetOptions();

            if ((!SessionUserStateService.SelectedStartDate.HasValue || !SessionUserStateService.SelectedEndDate.HasValue) &&
                !string.IsNullOrWhiteSpace(userId) &&
                DateRangeSelectionService.TryGetDateRange(userId, out var hydratedRange))
            {
                SessionUserStateService.SelectedStartDate = hydratedRange.StartDate;
                SessionUserStateService.SelectedEndDate = hydratedRange.EndDate;
                SessionUserStateService.SelectedDatePreset = string.IsNullOrWhiteSpace(hydratedRange.Preset) ? "ThisMonth" : hydratedRange.Preset;
            }

            dateRangeState = DateRangeStateService.InitializeDateRange(SessionUserStateService);

            // Only use the middleware-populated SelectedAccountFund on initialization. Do NOT fall back to DefaultAccountFund here.
            // If middleware didn't provide a selection, leave selectedAccount empty and do not overwrite session —
            // UI will display server-chosen account from service response but we won't persist it unless the user explicitly selects.
            selectedAccount = SessionUserStateService.SelectedAccountFund ?? string.Empty;

            // Try to use embedded dashboard donation payload from session dashboard cache first
            if (!string.IsNullOrWhiteSpace(selectedAccount) && SessionDashboardDtoCacheService != null && !string.IsNullOrWhiteSpace(userId))
            {
                if (SessionDashboardDtoCacheService.TryGetDashboard(userId, selectedAccount, out var cachedDashboard) &&
                    cachedDashboard.SelectedAccountDonations?.Donations?.Any() == true &&
                    CacheCoversCurrentDateRange(cachedDashboard.SelectedAccountDonations))
                {
                    donationData = cachedDashboard.SelectedAccountDonations;
                    // Ensure UserAccounts are present on donation data for UI binding
                    donationData.UserAccounts = cachedDashboard.UserAccounts.Select(u => new AccountOptionDto
                    {
                        AccountId = u.AccountId,
                        Fund = u.Fund,
                        AccountingClass = u.AccountingClass,
                        AccountNumber = u.AccountNumber,
                        Overhead = u.Overhead
                    }).ToList();

                    donations = donationData.Donations ?? new List<DonationRowDto>();
                    Debug($"Loaded donations from embedded dashboard cache for '{selectedAccount}' rows={donations.Count}");
                }
                else if (SessionDonationDataCacheService != null &&
                         SessionDonationDataCacheService.TryGetDonationData(userId, selectedAccount, out var cachedDto) &&
                         CacheCoversCurrentDateRange(cachedDto))
                {
                    donationData = cachedDto;
                    donations = donationData.Donations ?? new List<DonationRowDto>();
                    Debug($"Loaded donations from session donation cache for '{selectedAccount}' rows={donations.Count}");
                }
                else
                {
                    await LoadDonationsData(selectedAccount, selectedSubAccount);
                }
            }
            else
            {
                await LoadDonationsData(selectedAccount, selectedSubAccount);
            }
            
            if (!SessionUserStateService.SelectedStartDate.HasValue || !SessionUserStateService.SelectedEndDate.HasValue)
            {
                await selectDateRange();
            }
            else
            {
                selectedDonations = DonationPresentationService.FilterByDateRange(donations, dateRangeState.StartDate, dateRangeState.EndDate);
                BuildPivot();
            }

            // If there are donations cached but none match the current date filter, expand to cached range so user sees data immediately
            if ((selectedDonations == null || !selectedDonations.Any()) && donations != null && donations.Any())
            {
                try
                {
                    var minDate = donations.Min(d => d.Date);
                    var maxDate = donations.Max(d => d.Date);

                    // Only adjust if current filter is narrower than cached range
                    if (dateRangeState.StartDate > minDate || dateRangeState.EndDate < maxDate)
                    {
                        Debug($"No donations in current filter; expanding date range to cached span {minDate:yyyy-MM-dd}..{maxDate:yyyy-MM-dd}");

                        dateRangeState.PendingStartDate = minDate;
                        dateRangeState.PendingEndDate = maxDate;
                        dateRangeState.SelectedPreset = DateRangePreset.Custom;

                        DateRangeStateService.ApplyPendingDates(dateRangeState);

                        selectedDonations = DonationPresentationService.FilterByDateRange(donations, dateRangeState.StartDate, dateRangeState.EndDate);
                        BuildPivot();

                        if (currentView == ViewMode.GivingGrid && _givingGridRef is not null)
                        {
                            await _givingGridRef.Reload();
                        }
                        else
                        {
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                }
                catch (Exception ex)
                {
                    Debug($"Failed to expand date range: {ex.Message}");
                }
            }

            isLoading = false;
            Debug($"Initialized. SelectedAccount='{selectedAccount}', UserAccounts={donationData.UserAccounts.Count}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"Error in OnInitializedAsync: {ex.Message}");
            isLoading = false;
        }
    }

    private bool CacheCoversCurrentDateRange(DonationDataDto dto)
    {
        if (dto is null)
        {
            return false;
        }

        if (dto.CachedStartDate == default || dto.CachedEndDate == default)
        {
            return false;
        }

        var rangeStart = dateRangeState.StartDate.Date;
        var rangeEnd = dateRangeState.EndDate.Date;
        var cacheStart = dto.CachedStartDate.Date;
        var cacheEnd = dto.CachedEndDate.Date;

        return cacheStart <= rangeStart && cacheEnd >= rangeEnd;
    }

    private async Task LoadDonationsData(string accountName, string subAccountValue, bool explicitSelection = false)
    {
        try
        {
            isLoading = true;
            Logger.LogInformation("[Donations] LoadDonationsData start: passedAccount='{Account}', subAccount='{Sub}', userId='{UserId}', isAdminOrViewer={IsAdmin}", accountName, subAccountValue, userId, isAdminOrViewer);
            Console.WriteLine($"[Donations] LoadDonationsData start: passedAccount='{accountName}', subAccount='{subAccountValue}', userId='{userId}', isAdminOrViewer={isAdminOrViewer}, Session.SelectedAccountFund='{SessionUserStateService.SelectedAccountFund}', Session.DefaultAccountFund='{SessionUserStateService.DefaultAccountFund}'");

            // Remember what we explicitly passed to the service so we only overwrite session when caller provided an explicit account
            var passedAccount = accountName;

            // If caller did not explicitly select an account, prefer the session-selected account (middleware may have populated it).
            // Also treat a non-explicit call where passedAccount equals the session value as session-preferred.
            if (!explicitSelection)
            {
                if (string.IsNullOrWhiteSpace(passedAccount) && !string.IsNullOrWhiteSpace(SessionUserStateService.SelectedAccountFund))
                {
                    passedAccount = SessionUserStateService.SelectedAccountFund;
                    Logger.LogInformation("[Donations] Using session-selected account when calling service: {Account}", passedAccount);
                    Console.WriteLine($"[Donations] Using session-selected account when calling service: {passedAccount}");
                }
            }

            var dto = await DonationService.GetDonationDataAsync(
                passedAccount ?? string.Empty,
                subAccountValue,
                new DateRange(dateRangeState.StartDate, dateRangeState.EndDate),
                userId,
                isAdminOrViewer,
                forceRefresh: false) ?? new DonationDataDto();

            Logger.LogInformation("[Donations] Service returned SelectedAccount='{SelectedAccount}', UserAccounts={Count}", dto.SelectedAccount, dto.UserAccounts?.Count ?? 0);
            Console.WriteLine($"[Donations] Service returned SelectedAccount='{dto.SelectedAccount}', UserAccountsCount={dto.UserAccounts?.Count ?? 0}");

            var dtoUserAccounts = dto.UserAccounts ?? new List<AccountOptionDto>();
            var dtoDonations = dto.Donations ?? new List<DonationRowDto>();
            dto.UserAccounts = dtoUserAccounts;
            dto.Donations = dtoDonations;

            donationData = dto;

            // Use what the service returned for UI state, but don't overwrite the session unless the user explicitly selected an account.
            // Prefer a non-empty SelectedAccount from the service, otherwise keep any existing selectedAccount (e.g. hydrated from session/middleware).
            if (!string.IsNullOrWhiteSpace(dto.SelectedAccount))
            {
                selectedAccount = dto.SelectedAccount;
            }
            else if (string.IsNullOrWhiteSpace(selectedAccount) && dtoUserAccounts.Count > 0)
            {
                // If we had no session/middleware value, fall back to the first available account from the service (UI-only, not persisted).
                selectedAccount = dtoUserAccounts.First().Fund;
            }
             selectedSubAccount = dto.SelectedSubAccount;
             showSubAccountDropdown = dto.ShowSubAccountDropdown;
             subAccountOptions = dto.SubAccountOptions;
             currentFundNamesForSelection = dto.FundNamesForSelection;
             lastRawDonationFunds = dto.RawDonationFunds;
            currentAccount = dtoUserAccounts.FirstOrDefault(a => a.Fund == selectedAccount);
            donations = dtoDonations;

            Debug($"Service returned donations total={dto.Donations?.Count ?? 0}; currentAccount='{currentAccount?.Fund}'");

            if (string.IsNullOrWhiteSpace(selectedAccount) && dtoUserAccounts.Count > 0)
            {
                // choose a sensible UI fallback but do NOT persist it to session or to server
                selectedAccount = dtoUserAccounts.First().Fund;
            }

            var defaultFundFromDto = !string.IsNullOrWhiteSpace(SessionUserStateService.DefaultAccountFund)
                ? SessionUserStateService.DefaultAccountFund
                : dtoUserAccounts.FirstOrDefault()?.Fund ?? string.Empty;

            // Only persist the selection into session/server when the selection was explicit (user interacted with dropdown).
            if (explicitSelection && !string.IsNullOrWhiteSpace(passedAccount))
            {
                SessionUserStateService.SelectedAccountFund = selectedAccount;
                SessionUserStateService.DefaultAccountFund = defaultFundFromDto;

                try
                {
                    var authState2 = await AuthStateProvider.GetAuthenticationStateAsync();
                    var currentUser = authState2.User;
                    var uId = UserIdResolver.ResolveUserId(currentUser, SessionUserStateService.CurrentUserId);
                    if (UserSelectionService != null && !string.IsNullOrWhiteSpace(uId))
                    {
                        UserSelectionService.SetSelectedAccount(uId, selectedAccount);
                        Logger.LogInformation("[Donations] Persisted server-side selected account for userId={UserId} -> {Account}", uId, selectedAccount);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[Donations] Failed to persist server-side selection after explicit selection");
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(SessionUserStateService.SelectedAccountFund) && !string.IsNullOrWhiteSpace(selectedAccount))
                {
                    SessionUserStateService.SelectedAccountFund = selectedAccount;
                    SessionUserStateService.DefaultAccountFund = defaultFundFromDto;

                    try
                    {
                        var authState2 = await AuthStateProvider.GetAuthenticationStateAsync();
                        var currentUser = authState2.User;
                        var uId = UserIdResolver.ResolveUserId(currentUser, SessionUserStateService.CurrentUserId);
                        if (UserSelectionService != null && !string.IsNullOrWhiteSpace(uId))
                        {
                            UserSelectionService.SetSelectedAccount(uId, selectedAccount);
                        }
                    }
                    catch { }
                }

                Logger.LogInformation("[Donations] Not overwriting session on non-explicit load; Session.SelectedAccountFund='{SessionSel}'", SessionUserStateService.SelectedAccountFund);
                Console.WriteLine($"[Donations] Not overwriting session on non-explicit load; Session.SelectedAccountFund='{SessionUserStateService.SelectedAccountFund}'");
            }

            selectedDonations = DonationPresentationService.FilterByDateRange(donations, dateRangeState.StartDate, dateRangeState.EndDate);
            BuildPivot();

            Debug($"After filtering: donations={donations?.Count ?? 0}, selectedDonations={selectedDonations?.Count ?? 0}, dateRange={dateRangeState.StartDate:yyyy-MM-dd}..{dateRangeState.EndDate:yyyy-MM-dd}");

            // Mark that we need to reload the giving grid once the component has rendered and the grid ref is available
            _needReloadGivingGrid = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading donation data: {ex.Message}";
            Console.WriteLine($"Error in LoadDonationsData: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

