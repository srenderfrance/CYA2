@page "/donations"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Cya2.Shared.Utilities
@using Radzen
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using cya2.Components.Shared
@inject AuthenticationStateProvider AuthStateProvider
@inject Cya2.Application.Interfaces.ISessionUserStateService SessionUserStateService
@inject DialogService DialogService
@inject Cya2.Application.Interfaces.IUserIdResolver UserIdResolver
@rendermode InteractiveServer
@inject IStringLocalizer<Resource> Localizer
@inject ILogger<Donations> Logger
@inject Cya2.Application.Interfaces.IUserSelectionService UserSelectionService
@inject Cya2.Application.Interfaces.IUserDateRangeSelectionService DateRangeSelectionService

@* CLEAN ARCHITECTURE INTEGRATION *@
@using Cya2.Application.Interfaces
@using Cya2.Application.DTOs
@using DateRangePreset = Cya2.Application.DTOs.DateRangePreset
@using Cya2.Core.ValueObjects
@inject Cya2.Application.Interfaces.ISessionDonationDataCacheService SessionDonationDataCacheService
@inject IDonationService DonationService
@inject IDonationPresentationService DonationPresentationService
@inject IUserAccountContextService UserAccountContextService
@inject IDateRangeStateService DateRangeStateService
@inject Cya2.Application.Interfaces.ISessionDashboardDtoCacheService SessionDashboardDtoCacheService

@attribute [StreamRendering]

<PageTitle>@Localizer["Donations"]</PageTitle>

<style>
    /* Stronger overrides to beat Radzen defaults */
    .giving-grid-wrapper { overflow-x: auto; width: 100%; }

    /* Ensure the RadzenCard containing the grid fills width and clips overflow to the wrapper */
    .giving-grid-card,
    .giving-grid-card.rz-card {
        display: block !important;
        width: 100% !important;
        padding: 0.5rem !important; /* keep card padding consistent */
        box-sizing: border-box !important;
        overflow: hidden !important;
    }

    /* Also force the grid container itself to size to content */
    .giving-grid {
        display: inline-block !important;
        width: auto !important;
        table-layout: auto !important;
        vertical-align: top !important;
    }

    /* Target Radzen-generated table inside our giving-grid and force it to size to content */
    .giving-grid .rz-datatable-tablewrapper > table,
    .giving-grid .rz-datatable-scrollable-table-wrapper > table,
    .giving-grid .rz-grid-table {
        width: auto !important;
        table-layout: auto !important;
        display: inline-table !important;
    }

    /* Cap the donor column (first column) so it can't grow to fill the parent */
    .giving-grid .rz-grid-table thead th:first-child .rz-column-title,
    .giving-grid .rz-grid-table tbody td:first-child .rz-cell-data {
        max-width: 480px !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }

    /* Keep existing grid styling (smaller font, padding) */
    .giving-grid .rz-data-grid { font-size: 0.75rem; /* table-layout and width overridden above */ }
    .giving-grid .rz-cell,
    .giving-grid .rz-column-header,
    .giving-grid .rz-column-footer { padding: 2px 4px; line-height: 1.1; overflow: hidden; text-overflow: ellipsis; }
    .giving-grid .rz-column-header { font-size: 0.70rem; font-weight: 600; white-space: nowrap; }

    /* Left-align all headers (column titles) while keeping cell padding consistent */
    .giving-grid .rz-column-header .rz-column-title {
        width: 100%;
        display: block;
        text-align: left;
    }

    /* Donor cell: allow to expand but cap its maximum width so grid doesn't stretch to full container */
    .giving-grid .donor-cell {
        display: inline-block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 480px; /* cap donor width */
        cursor: pointer;
        color: #0a3b6b;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .giving-grid .donor-cell:hover {
        color: #072a47; text-decoration: underline;
    }

    .donation-list .donor-cell {
        cursor: pointer; color: #0a3b6b; text-decoration: none; transition: color 0.2s ease;
    }

    .donation-list .donor-cell:hover {
        color: #072a47; text-decoration: underline;
    }

    .view-mode-buttons .rz-button { padding: 4px 10px; font-size: 0.75rem; }

    /* Vertically center dropdown text */
    .rz-dropdown .rz-inputtext { display: flex; align-items: center; }
    .rz-dropdown .rz-dropdown-label { display: flex; align-items: center; height: 100%; width: 100%; }

    /* Prevent long text from going under the trigger (arrow) and use ellipsis */
    .rz-dropdown .rz-dropdown-label {
        padding-right: 1.75rem; /* reserve space for the trigger button */
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        box-sizing: border-box;
    }
    /* Also ensure items in the panel clip properly */
    .rz-dropdown-panel .rz-dropdown-item {
        display: flex; align-items: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Keep Frequency View switch green in both off + on states */
    .frequency-view-switch.rz-switch .rz-switch-slider {
        background-color: var(--rz-primary) !important;
        border-color: var(--rz-primary) !important;
    }

    .frequency-view-switch.rz-switch .rz-switch-slider::before,
    .frequency-view-switch.rz-switch .rz-switch-slider::after {
        background-color: #fff !important;
    }

    .frequency-view-switch.rz-switch .rz-switch-track,
    .frequency-view-switch.rz-switch.rz-state-checked .rz-switch-track,
    .frequency-view-switch.rz-switch input[type="checkbox"]:checked + .rz-switch-track,
    .frequency-view-switch.rz-switch input[type="checkbox"]:checked + .rz-switch-slider {
        background-color: var(--rz-primary) !important;
        border-color: var(--rz-primary) !important;
    }

    .frequency-view-switch.rz-switch .rz-switch-thumb {
        background-color: #fff !important;
    }

    .frequency-view-switch.rz-switch {
        --rz-switch-checked-background-color: var(--rz-primary);
        --rz-switch-unchecked-background-color: var(--rz-primary);
        --rz-switch-background-color: var(--rz-primary);
    }

    .frequency-view-switch.rz-switch.rz-switch-checked .rz-switch-circle {
        background: var(--rz-primary) !important;
    }

</style>

<RadzenStack Orientation="Orientation.Vertical" Gap="15px" Class="rz-p-4" Style="padding-top:0.5rem;">

    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="2rem"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Start"
                 Wrap="FlexWrap.Wrap"
                 Style="width:100%;">

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.4rem" Style="flex:1;">
            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="0.5rem"
                         AlignItems="AlignItems.Center"
                         Wrap="FlexWrap.Wrap">
                <div class="date-range-toolbar-box" style="display:flex;align-items:center;gap:0.5rem;">
                    <RadzenLabel Text="@Localizer["CommonRanges"]" />
                    <!-- Preset dropdown -->
                <RadzenDropDown TValue="DateRangePreset"
                                Data="@presetOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="@dateRangeState.SelectedPreset"
                                Change="@OnPresetChanged"
                                Style="width: 180px;">
                    <ValueTemplate>
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                            @(presetOptions.FirstOrDefault(o => o.Value == dateRangeState.SelectedPreset)?.Text ?? "")
                        </span>
                    </ValueTemplate>
                    <Template Context="opt">
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%;">
                            @opt.Text
                        </span>
                    </Template>
                </RadzenDropDown>
                </div>
                <div class="date-range-apply-group" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                    <div class="date-range-start-end-row" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:nowrap;">
                    <div style="display:flex;align-items:center;gap:0.5rem;">
                        <RadzenLabel Text="@Localizer["StartDate"]" />
                        <RadzenDatePicker @bind-Value="@dateRangeState.PendingStartDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                                          Change="@OnDatePickerChanged" />
                    </div>
                    <div style="display:flex;align-items:center;gap:0.5rem;">
                        <RadzenLabel Text="@Localizer["EndDate"]" />
                        <RadzenDatePicker @bind-Value="@dateRangeState.PendingEndDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                                          Change="@OnDatePickerChanged" />
                    </div>
                    </div>
                    <RadzenButton Text="@Localizer["Apply"]"
                                  Click="@selectDateRange"
                                  Size="ButtonSize.Small"
                                  Style="height: 38px;"
                                  ButtonStyle="ButtonStyle.Primary" />
                </div>
            </RadzenStack>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.4rem" Style="flex:1; max-width:300px;">
            <div class="date-range-toolbar-box" style="width:360px; max-width:100%; box-sizing:border-box;">
                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:nowrap;">
                    <RadzenLabel Text="@Localizer["Account"]" />
                    <RadzenDropDown TValue="string"
                                Data="@donationData.UserAccounts"
                                TextProperty="Fund"
                                ValueProperty="Fund"
                                Value="@selectedAccount"
                                Change="@OnAccountDropdownChanged"
                                Placeholder="@Localizer["ChooseAccount"]"
                                Style="flex:1; min-width:0; width:auto;">
                    <ValueTemplate>
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                            @DisplayFormatter.FormatFundDisplay(selectedAccount)
                        </span>
                    </ValueTemplate>
                    <Template Context="acct">
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%;">
                            @DisplayFormatter.FormatFundDisplay(acct.Fund)
                        </span>
                    </Template>
                    </RadzenDropDown>
                </div>

                <!-- SubAccount dropdown - only shown for accounts with Separate sub accounts -->
                @if (showSubAccountDropdown && subAccountOptions.Any())
                {
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem" Style="margin-top: 0.5rem;">
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #666; font-size: 0.9rem;">Sub Account</RadzenText>
                        <RadzenDropDown TValue="string"
                                        Data="@subAccountOptions"
                                        TextProperty="DisplayText" 
                                        ValueProperty="Value"
                                        @bind-Value="selectedSubAccount"
                                        Change="@(args => OnSubAccountSelection(args?.ToString() ?? string.Empty))"
                                Class="account-selector-dropdown-inline">
                            <ValueTemplate>
                                <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                                    @(subAccountOptions.FirstOrDefault(o => o.Value == selectedSubAccount)?.DisplayText ?? "")
                                </span>
                            </ValueTemplate>
                            <Template Context="option">
                                <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%;">
                                    @option.DisplayText
                                </span>
                            </Template>
                        </RadzenDropDown>
                    </RadzenStack>
                }
            </div>
        </RadzenStack>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="0.5rem"
                 AlignItems="AlignItems.Center"
                 Class="view-mode-buttons rz-mt-3">
        <RadzenButton Text="@Localizer["Grid"]"
                      ButtonStyle="@(currentView == ViewMode.GivingGrid ? ButtonStyle.Primary : ButtonStyle.Light)"
                      Size="ButtonSize.Small"
                      Click="@(() => SetView(ViewMode.GivingGrid))" />
        <RadzenButton Text="@Localizer["List"]"
                      ButtonStyle="@(currentView == ViewMode.DonationList ? ButtonStyle.Primary : ButtonStyle.Light)"
                      Size="ButtonSize.Small"
                      Click="@(() => SetView(ViewMode.DonationList))" />
        <RadzenButton Text="@Localizer["Graph"]"
                      ButtonStyle="@(currentView == ViewMode.Graphs ? ButtonStyle.Primary : ButtonStyle.Light)"
                      Size="ButtonSize.Small"
                      Click="@(() => SetView(ViewMode.Graphs))" />
    </RadzenStack>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="mt-2">
            @Localizer[errorMessage]
        </RadzenAlert>
    }

    @if (isLoading)
    {
        <div class="mt-3">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p class="text-muted mt-1">@Localizer["LoadingDonations"]</p>
        </div>
    }
    else
    {
        @if (currentView == ViewMode.GivingGrid)
        {
            @* Giving Grid *@
            <RadzenCard Class="giving-grid-card" Style="margin-top:0.75rem;">
                <div class="giving-grid-wrapper">
                <RadzenDataGrid TItem="DonationPivotRowDto"
                                Data="@pivotRows"
                                Class="giving-grid"
                                 AllowPaging="false"
                                 AllowSorting="false"
                                 AllowFiltering="false"
                                 AllowVirtualization="false"
                                 AllowColumnReorder="false"
                                 @ref="_givingGridRef"
                                 CellRender="@OnGivingGridCellRender"
                                 EmptyText="@GetEmptyText()">
                    <Columns>
                        <!-- Donor: header/cell left -->
                        <RadzenDataGridColumn TItem="DonationPivotRowDto"
                                              Title="@(Localizer["Donor"])"
                                              OrderIndex="0"
                                              TextAlign="TextAlign.Left">
                            <Template Context="row">
                                <span class="donor-cell" title="@row.Donor" @onclick="@(() => OnDonorClick(row.Donor))">@row.Donor</span>
                            </Template>
                            <FooterTemplate>
                                <strong>@Localizer["Total"]</strong>
                            </FooterTemplate>
                        </RadzenDataGridColumn>

                        @for (var i = 0; i < monthColumns.Count; i++)
                        {
                            var month = monthColumns[i];
                            <!-- Months: header left, cell will be right via CellRender -->
                            <RadzenDataGridColumn @key="month"
                                                  TItem="DonationPivotRowDto"
                                                  Title="@(GetMonthHeader(month))"
                                                  TextAlign="TextAlign.Left"
                                                  Width="@MonthColumnWidth"
                                                  OrderIndex="@(i + 1)">
                                <Template Context="row">
                                    @{
                                        var has = row.Monthly.TryGetValue(month, out var amt);
                                    }
                                    @(has && amt != 0m ? amt.ToString("C0") : "")
                                </Template>
                                <FooterTemplate>
                                    @{
                                        var mt = monthTotals.TryGetValue(month, out var t) ? t : 0m;
                                    }
                                    <div style="text-align: right; width: 100%;"><strong>@mt.ToString("C0")</strong></div>
                                </FooterTemplate>
                            </RadzenDataGridColumn>
                        }

                        <!-- Total: header left, cell will be right via CellRender -->
                        <RadzenDataGridColumn TItem="DonationPivotRowDto"
                                              Title="@(Localizer["Total"])"
                                              TextAlign="TextAlign.Left"
                                              Width="90px"
                                              OrderIndex="@(monthColumns.Count + 1)">
                            <Template Context="row">
                                <strong>@row.Total.ToString("C0")</strong>
                            </Template>
                            <FooterTemplate>
                                <div style="text-align: right; width: 100%;"><strong>@grandTotal.ToString("C0")</strong></div>
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                </div>
            </RadzenCard>
        }
        else if (currentView == ViewMode.DonationList)
        {
            <!-- Summary cards and list layout -->
            <div class="donation-list-layout">
                <div class="donation-summary-col">
                    <DonationSummaryCard Donations="@selectedDonations" 
                                         StartDate="@dateRangeState.StartDate" 
                                         EndDate="@dateRangeState.EndDate" />
                </div>

                <div class="donation-grid-col" style="margin-top: 0.5rem;">
                    <RadzenDataGrid Data="@selectedDonations"
                                    TItem="DonationRowDto"
                                    AllowFiltering="true"
                                    AllowColumnResize="true"
                                    AllowSorting="true"
                                    AllowPaging="false"
                                    FilterMode="FilterMode.Advanced"
                                    EmptyText="@GetEmptyText()"
                                    Class="donation-list">
                        <Columns>
                            <RadzenDataGridColumn TItem="DonationRowDto" Property="Date" Title="@(Localizer["Date"])" FormatString="{0:MM/dd/yyyy}" Width="110px" />
                            <RadzenDataGridColumn TItem="DonationRowDto" Property="Donor" Title="@(Localizer["Donor"])" Width="200px">
                                <Template Context="donation">
                                    <span class="donor-cell" @onclick="@(() => OnDonorClick(donation.Donor))">@donation.Donor</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DonationRowDto" Property="Amount" Title="@(Localizer["Amount"])" FormatString="{0:C2}" Width="90px" />
                            <RadzenDataGridColumn TItem="DonationRowDto" Property="TransactionType" Title="@(Localizer["TransactionType"])" Width="110px" />
                            <RadzenDataGridColumn TItem="DonationRowDto" Property="Frequency" Title="@(Localizer["Frequency"])" Width="100px">
                                <Template Context="donation">
                                    @if (!string.IsNullOrEmpty(donation.Frequency))
                                    {
                                        <span>@donation.Frequency</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </div>
        }
        else
        {
            <RadzenCard Style="margin-top:0.75rem;">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2">@Localizer["Graphs"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Style="color:#666;">
                        @dateRangeState.StartDate.ToString("MM/dd/yyyy") - @dateRangeState.EndDate.ToString("MM/dd/yyyy")
                    </RadzenText>

                    <RadzenCard Style="padding:0.75rem; background:#fafafa; border:1px solid #e5e7eb;">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <RadzenLabel Text="Graph Type" />
                                <RadzenDropDown TValue="DonationGraphType"
                                                Data="@donationGraphTypeOptions"
                                                TextProperty="Text"
                                                ValueProperty="Value"
                                                @bind-Value="selectedDonationGraphType"
                                                Style="width:180px;" />
                            </div>

                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <RadzenCheckBox TValue="bool" @bind-Value="showGraphLabels" />
                                <RadzenLabel Text="Show Data Labels" />
                            </div>

                            <div style="display:flex; align-items:center; gap:0.5rem; margin-left:auto;">
                                <RadzenSwitch TValue="bool" Class="frequency-view-switch" Value="@showFrequencyPreset" Change="OnFrequencyPresetChanged" />
                                <RadzenLabel Text="Frequency View" />
                                <span style="font-size:0.8rem; color:#666; margin-left:0.5rem;">@Localizer["NonMonthlyIncludesSporadicAndOneTimeDonations"]</span>
                            </div>
                        </RadzenStack>
                    </RadzenCard>

                    @if (totalMonthlyDonationSeries.Any() || monthlyDonationSeriesByFrequency.Any())
                    {
                        <RadzenText TextStyle="TextStyle.Body1" Style="font-weight:600;">Monthly Donations</RadzenText>
                        <div class="donations-main-chart">
                        <RadzenChart Style="height: 360px;">
                            @if (!showFrequencyPreset)
                            {
                                @if (selectedDonationGraphType == DonationGraphType.Line)
                                {
                                    <RadzenLineSeries Data="@totalMonthlyDonationSeries"
                                                      CategoryProperty="MonthLabel"
                                                      ValueProperty="Total"
                                                      Title="Total">
                                        <RadzenSeriesDataLabels Visible="@showGraphLabels" />
                                        <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
                                    </RadzenLineSeries>
                                }
                                else if (selectedDonationGraphType == DonationGraphType.Area)
                                {
                                    <RadzenAreaSeries Data="@totalMonthlyDonationSeries"
                                                      CategoryProperty="MonthLabel"
                                                      ValueProperty="Total"
                                                      Title="Total">
                                        <RadzenSeriesDataLabels Visible="@showGraphLabels" />
                                        <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
                                    </RadzenAreaSeries>
                                }
                                else
                                {
                                    <RadzenColumnSeries Data="@totalMonthlyDonationSeries"
                                                        CategoryProperty="MonthLabel"
                                                        ValueProperty="Total"
                                                        Title="Total">
                                        <RadzenSeriesDataLabels Visible="@showGraphLabels" />
                                    </RadzenColumnSeries>
                                }
                            }

                            @if (showFrequencyPreset)
                            {
                                @foreach (var frequencySeries in monthlyDonationSeriesByFrequency)
                                {
                                    @if (selectedDonationGraphType == DonationGraphType.Line)
                                    {
                                        <RadzenLineSeries Data="@frequencySeries.Value"
                                                          CategoryProperty="MonthLabel"
                                                          ValueProperty="Total"
                                                          Title="@frequencySeries.Key">
                                            <RadzenSeriesDataLabels Visible="@showGraphLabels" />
                                            <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
                                        </RadzenLineSeries>
                                    }
                                    else if (selectedDonationGraphType == DonationGraphType.Area)
                                    {
                                        <RadzenAreaSeries Data="@frequencySeries.Value"
                                                          CategoryProperty="MonthLabel"
                                                          ValueProperty="Total"
                                                          Title="@frequencySeries.Key">
                                            <RadzenSeriesDataLabels Visible="@showGraphLabels" />
                                            <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
                                        </RadzenAreaSeries>
                                    }
                                    else
                                    {
                                        <RadzenColumnSeries Data="@frequencySeries.Value"
                                                            CategoryProperty="MonthLabel"
                                                            ValueProperty="Total"
                                                            Title="@frequencySeries.Key">
                                            <RadzenSeriesDataLabels Visible="@showGraphLabels" />
                                        </RadzenColumnSeries>
                                    }
                                }
                            }
                            <RadzenCategoryAxis />
                            <RadzenValueAxis Formatter="@FormatUsdWholeDollars" />
                            <RadzenLegend Visible="true" />
                        </RadzenChart>
                        </div>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:#666;">X-axis: Month · Y-axis: Total Donations, USD whole dollars</RadzenText>
                    }
                    else
                    {
                        <div class="text-muted">@GetEmptyText()</div>
                    }
                </RadzenStack>
            </RadzenCard>
        }
    }
</RadzenStack>

@code {
    private DonationDataDto donationData = new();
    private List<DonationRowDto> donations = new();
    private List<DonationRowDto> selectedDonations = new();

    private string selectedAccount = string.Empty;
    private string selectedSubAccount = "All";
    private string userId = string.Empty;
    private bool isAdminOrViewer = false;
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    private AccountOptionDto? currentAccount = null;
    private List<string> lastRawDonationFunds = new();

    // SubAccount support
    private bool showSubAccountDropdown = false;
    private List<SubAccountOptionDto> subAccountOptions = new();
    private List<string> currentFundNamesForSelection = new();
    private Dictionary<string, int> subFundToPrimaryAccountId = new(StringComparer.OrdinalIgnoreCase);

    private void Debug(string message)
    {
        var line = $"[{DateTime.Now:HH:mm:ss}] {message}";
        Console.WriteLine($"DONATIONS DEBUG: {line}");
    }

    private enum ViewMode { GivingGrid, DonationList, Graphs }
    private enum DonationGraphType { Line, Area, Column }

    private sealed class DonationGraphTypeOption
    {
        public string Text { get; set; } = string.Empty;
        public DonationGraphType Value { get; set; }
    }

    private ViewMode currentView = ViewMode.GivingGrid;
    private DonationGraphType selectedDonationGraphType = DonationGraphType.Line;
    private bool showGraphLabels = true;
    private bool showFrequencyPreset = false;
    private readonly List<DonationGraphTypeOption> donationGraphTypeOptions =
    [
        new() { Text = "Line", Value = DonationGraphType.Line },
        new() { Text = "Area", Value = DonationGraphType.Area },
        new() { Text = "Column", Value = DonationGraphType.Column }
    ];

    private void SetView(ViewMode mode) => currentView = mode;

    private readonly List<DateTime> monthColumns = new();
    private readonly List<DonationPivotRowDto> pivotRows = new();
    private readonly Dictionary<DateTime, decimal> monthTotals = new();
    private readonly List<MonthlyDonationChartPoint> totalMonthlyDonationSeries = new();
    private readonly Dictionary<string, List<MonthlyDonationChartPoint>> monthlyDonationSeriesByFrequency = new(StringComparer.OrdinalIgnoreCase);
    private decimal grandTotal = 0m;

    private sealed class MonthlyDonationChartPoint
    {
        public string MonthLabel { get; set; } = string.Empty;
        public decimal Total { get; set; }
    }

    private RadzenDataGrid<DonationPivotRowDto>? _givingGridRef;
    private bool _needReloadGivingGrid = false;

    private string MonthColumnWidth => "90px";

    private string GetMonthHeader(DateTime m)
    {
        var singleYear = dateRangeState.StartDate.Year == dateRangeState.EndDate.Year;
        return singleYear ? m.ToString("MMM") : m.ToString("MMM yy");
    }

    private string FormatUsdWholeDollars(object value)
    {
        if (value is decimal dec)
        {
            return dec.ToString("C0");
        }

        if (value is double dbl)
        {
            return dbl.ToString("C0");
        }

        if (value is float flt)
        {
            return flt.ToString("C0");
        }

        if (decimal.TryParse(value?.ToString(), out var parsed))
        {
            return parsed.ToString("C0");
        }

        return "$0";
    }

