@page "/auth-config-required"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IWebHostEnvironment Environment

<PageTitle>Authentication Configuration Required</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3><i class="bi bi-exclamation-triangle me-2"></i>Authentication Configuration Required</h3>
                </div>
                <div class="card-body p-4">
                    @if (Environment.IsDevelopment())
                    {
                        <div class="alert alert-info">
                            <h5>Google OAuth Configuration Missing</h5>
                            <p>To enable user authentication, configure Google OAuth credentials and local development secrets.</p>
                        </div>

                        <h6>How to configure Google OAuth:</h6>
                        <ol class="mt-3">
                            <li><strong>Get Google OAuth Credentials:</strong>
                                <ul>
                                    <li>Go to <a href="https://console.cloud.google.com/" target="_blank">Google Cloud Console</a></li>
                                    <li>Create a new project or select an existing one</li>
                                    <li>Create OAuth 2.0 Client IDs</li>
                                    <li>Set authorized redirect URIs (for example: <code>https://localhost:7191/signin-google</code>)</li>
                                </ul>
                            </li>
                            <li><strong>Set local development secrets:</strong>
                                <ul>
                                    <li>Use <code>dotnet user-secrets</code> for connection string and OAuth credentials</li>
                                    <li>Do not store secrets in <code>appsettings*.json</code></li>
                                </ul>
                            </li>
                            <li><strong>Set up Database:</strong>
                                <ul>
                                    <li>Ensure MySQL/MariaDB is running</li>
                                    <li>Create a user in the <code>Users</code> table with your Google email</li>
                                </ul>
                            </li>
                            <li><strong>Restart the Application</strong></li>
                        </ol>
                    }
                    else
                    {
                        <div class="alert alert-danger mb-0">
                            <h5>Authentication is currently unavailable.</h5>
                            <p class="mb-0">Please contact an administrator.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
