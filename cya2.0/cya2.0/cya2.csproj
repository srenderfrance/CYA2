<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>cya2</RootNamespace>
    <AssemblyName>cya2</AssemblyName>
    <UserSecretsId>53201ee5-e9ff-4a42-b53e-7655ae21f069</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="EPPlus" Version="8.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.16" />
    <PackageReference Include="MySql.Data" Version="9.3.0" />
    <PackageReference Include="Radzen.Blazor" Version="7.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DataLibrary\DataLibrary.csproj" />
    <ProjectReference Include="..\..\ModelsLibrary\ModelsLibrary.csproj" />
    <ProjectReference Include="..\..\UserDataLibrary\UserDataLibrary.csproj" />
    <ProjectReference Include="..\..\UtilityClassLibrary\UtilityClassLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Components\Shared\LanguageResources\Resource.en-US.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.en-US.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Components\Shared\LanguageResources\Resource.en-US.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.en-US.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
