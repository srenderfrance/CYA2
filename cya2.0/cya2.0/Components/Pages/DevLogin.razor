@page "/dev-login"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@attribute [AllowAnonymous]

<PageTitle>Development Login</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3><i class="bi bi-code me-2"></i>Development Login</h3>
                    <small>For development and testing purposes only</small>
                </div>
                <div class="card-body p-4">
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">
                            @errorMessage
                        </div>
                    }
                    
                    <div class="alert alert-info">
                        <h6><i class="bi bi-info-circle me-2"></i>Development Mode</h6>
                        <p class="mb-0">This allows you to test the application without Google OAuth setup.</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Test User</label>
                        <select class="form-select" @bind="selectedUser">
                            <option value="">Select a test user</option>
                            <option value="admin">Admin User (admin@test.com)</option>
                            <option value="user">Regular User (user@test.com)</option>
                            <option value="viewer">Viewer User (viewer@test.com)</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" @onclick="LoginAsTestUser" disabled="@(string.IsNullOrEmpty(selectedUser) || isLoggingIn)">
                            @if (isLoggingIn)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <text>Logging in...</text>
                            }
                            else
                            {
                                <i class="bi bi-person-plus me-2"></i>
                                <text>Login as @selectedUser</text>
                            }
                        </button>
                        
                        <a href="/auth-config-required" class="btn btn-outline-secondary">
                            <i class="bi bi-gear me-2"></i>Setup Google OAuth
                        </a>
                    </div>

                    <div class="mt-4">
                        <h6>What you can test:</h6>
                        <ul class="small">
                            <li><strong>Clean Architecture Integration</strong> - Home page using IFinancialDashboardService</li>
                            <li><strong>Admin Functions</strong> - User and account management (Admin only)</li>
                            <li><strong>Navigation</strong> - All pages and components</li>
                            <li><strong>Database Integration</strong> - Data loading and display</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string selectedUser = "";
    private string errorMessage = "";
    private bool isLoggingIn = false;

    private async Task LoginAsTestUser()
    {
        if (string.IsNullOrEmpty(selectedUser))
            return;

        try
        {
            isLoggingIn = true;
            errorMessage = "";

            // Only allow this in development
            if (!Configuration.GetValue<bool>("Development:BypassGoogleAuth", false))
            {
                errorMessage = "Development login is not enabled. Set Development:BypassGoogleAuth to true in appsettings.";
                return;
            }

            var claims = new List<Claim>();
            
            switch (selectedUser.ToLower())
            {
                case "admin":
                    claims.AddRange(new[]
                    {
                        new Claim(ClaimTypes.Name, "Admin User"),
                        new Claim(ClaimTypes.Email, "admin@test.com"),
                        new Claim("UserName", "Admin User"),
                        new Claim("UserId", "1"),
                        new Claim("AuthLevel", "Admin"),
                        new Claim(ClaimTypes.Role, "Admin"),
                        new Claim("DefaultAccount", "1"),
                        new Claim("Language", "en-US")
                    });
                    break;
                    
                case "user":
                    claims.AddRange(new[]
                    {
                        new Claim(ClaimTypes.Name, "Test User"),
                        new Claim(ClaimTypes.Email, "user@test.com"),
                        new Claim("UserName", "Test User"),
                        new Claim("UserId", "2"),
                        new Claim("AuthLevel", "User"),
                        new Claim(ClaimTypes.Role, "User"),
                        new Claim("DefaultAccount", "1"),
                        new Claim("Language", "en-US")
                    });
                    break;
                    
                case "viewer":
                    claims.AddRange(new[]
                    {
                        new Claim(ClaimTypes.Name, "Viewer User"),
                        new Claim(ClaimTypes.Email, "viewer@test.com"),
                        new Claim("UserName", "Viewer User"),
                        new Claim("UserId", "3"),
                        new Claim("AuthLevel", "Viewer"),
                        new Claim(ClaimTypes.Role, "Viewer"),
                        new Claim("DefaultAccount", "1"),
                        new Claim("Language", "en-US")
                    });
                    break;
                    
                default:
                    errorMessage = "Invalid user selection";
                    return;
            }

            var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
            var principal = new ClaimsPrincipal(identity);

            var properties = new AuthenticationProperties
            {
                IsPersistent = true,
                ExpiresUtc = DateTimeOffset.UtcNow.AddHours(24),
                RedirectUri = selectedUser == "admin" ? "/admin" : "/"
            };

            await HttpContextAccessor.HttpContext!.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme, 
                principal, 
                properties);

            // Redirect based on user type
            NavigationManager.NavigateTo(selectedUser == "admin" ? "/admin" : "/", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            isLoggingIn = false;
        }
    }
}