@page "/__Host/Account/Login"
@using Microsoft.AspNetCore.Authentication // Keep this using, it's still needed for ChallengeAsync
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor // Inject HttpContextAccessor

@{
    // We no longer inject SignInManager

    var provider = Request.Query["provider"];
    if (string.IsNullOrEmpty(provider))
    {
        HttpContextAccessor.HttpContext.Response.Redirect("/"); // Use HttpContextAccessor to access Response
        return;
    }

    // Manually create AuthenticationProperties since we are not using Identity's SignInManager
    var redirectUrl = Url.Page("./Login", pageHandler: "Callback", values: new { returnUrl = "/" }); // Adjust returnUrl as needed
    var properties = new AuthenticationProperties { RedirectUri = redirectUrl };

    // Use HttpContextAccessor to access the HttpContext and call ChallengeAsync
    await HttpContextAccessor.HttpContext.ChallengeAsync(provider.ToString(), properties);
}

