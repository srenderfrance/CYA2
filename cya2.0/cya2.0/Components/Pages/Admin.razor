@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using UserAuth
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@attribute [Authorize(Roles = "Admin")]
@inject UserRepository UserRepository
@inject IDataAccess _data
@inject IConfiguration _config
@inject AppState AppState
@using ModelsLibrary
@using System.ComponentModel.DataAnnotations
@using DataLibrary
@rendermode InteractiveServer

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H3">Admin Panel</RadzenText>
    
    <!-- Staff Members Selection -->
    <RadzenCard>
        <!-- Three-column layout -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Class="rz-mb-2">
            <!-- Left column: Dropdown and Name input -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 30%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">Staff Member</RadzenText>
                <RadzenDropDown TValue="string"
                               Data="@staff"
                               TextProperty="Name"
                               ValueProperty="Name"
                               @bind-Value="staffMember"
                               Change="@(args => staffSelection(args?.ToString()))"
                               Placeholder="Select Staff Member"
                               Style="width: 100%;" />
                
                <RadzenFormField Text="New Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@newName" Placeholder="Enter updated name" />
                </RadzenFormField>
            </RadzenStack>
            
            <!-- Middle column: Current email and Email input -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 30%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">Current Email</RadzenText>
                <div class="rz-p-2 rz-border-radius-1 rz-border-1" style="height: 38px; display: flex; align-items: center; border: var(--rz-input-border); background-color: var(--rz-input-background-color);">
                    <RadzenText TextStyle="TextStyle.Subtitle2">
                        @(string.IsNullOrEmpty(selectedStaffEmail) ? " " : selectedStaffEmail)
                    </RadzenText>
                </div>
                
                <RadzenFormField Text="New Email" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@newEmail" Placeholder="Enter updated email" />
                </RadzenFormField>
            </RadzenStack>
            
            <!-- Right column: Account management -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 30%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">Account Management</RadzenText>
                
                <!-- Add Account section -->
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Add Account Access</RadzenText>
                    <RadzenDropDown TValue="string"
                                    Data="@allAccounts"
                                    TextProperty="Name"
                                    ValueProperty="Name"
                                    @bind-Value="accountToAdd"
                                    Placeholder="Select Account"
                                    Style="width: 100%;" />
                    
                    <RadzenButton 
                        Text="Link Account to Staff" 
                        ButtonStyle="ButtonStyle.Primary" 
                        Click="LinkAccountToStaff" 
                        Disabled="@(string.IsNullOrEmpty(staffMember) || string.IsNullOrEmpty(accountToAdd))"
                        Style="width: fit-content;" />
                </RadzenStack>
                
                <!-- Remove Account section -->
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenText TextStyle="TextStyle.Body2">Remove Account Access</RadzenText>
                    <RadzenDropDown TValue="int"
                                    Data="@userAccounts"
                                    TextProperty="Name"
                                    ValueProperty="AccountId"
                                    @bind-Value="selectedLinkedAccountId"
                                    Placeholder="Select account to remove"
                                    Style="width: 100%;" />
                    
                    <RadzenButton 
                        Text="Remove Account Link" 
                        ButtonStyle="ButtonStyle.Danger" 
                        Click="RemoveAccountLink" 
                        Disabled="@(selectedLinkedAccountId == 0 || string.IsNullOrEmpty(staffMember))"
                        Style="width: fit-content;" />
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
        
        <!-- Staff update error/success messages -->
        @if (!string.IsNullOrEmpty(staffUpdateError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @staffUpdateError
            </RadzenAlert>
        }
        
        @if (!string.IsNullOrEmpty(staffUpdateSuccess))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @staffUpdateSuccess
            </RadzenAlert>
        }
        
        <!-- Account link error/success messages -->
        @if (!string.IsNullOrEmpty(accountLinkError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @accountLinkError
            </RadzenAlert>
        }
        
        @if (!string.IsNullOrEmpty(accountLinkSuccess))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @accountLinkSuccess
            </RadzenAlert>
        }
        
        <!-- Update button -->
        <RadzenButton 
            Text="Update Staff Member" 
            ButtonStyle="ButtonStyle.Primary" 
            Click="UpdateStaffMember" 
            Disabled="@(string.IsNullOrEmpty(staffMember))"
            Style="margin-top: 1rem;" />
    </RadzenCard>
    
    <!-- Create New User Form -->
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H5">Create New User</RadzenText>
        
        <RadzenTemplateForm TItem="UserFormModel" Data="@formModel" Submit="@HandleValidSubmit">
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenFormField Text="Email" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@formModel.Email" Name="Email" />
                    <RadzenRequiredValidator Component="Email" Text="Email is required" />
                    <RadzenEmailValidator Component="Email" Text="Please enter a valid email" />
                </RadzenFormField>
                
                <RadzenFormField Text="Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@formModel.Name" Name="Name" />
                    <RadzenRequiredValidator Component="Name" Text="Name is required" />
                    <RadzenLengthValidator Component="Name" Min="2" Max="100" Text="Name must be between 2 and 100 characters" />
                </RadzenFormField>
                
                <div class="d-flex">
                    <RadzenButton Text="Register New User" 
                                  ButtonType="ButtonType.Submit" 
                                  ButtonStyle="ButtonStyle.Primary" 
                                  Style="width: auto;" />
                </div>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
    
    <!-- COMMENTED OUT: Funds Section 
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
            <RadzenButton Text="Get Distinct Funds" Click="@GetDistinctFunds" ButtonStyle="ButtonStyle.Secondary" />
            <RadzenButton Text="Create Accounts from Funds" Click="@CreateAccountsFromFunds" 
                         ButtonStyle="ButtonStyle.Primary" 
                         Disabled="@(funds == null || !funds.Any())" />
        </RadzenStack>
        
        @if (successMessage != null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @successMessage
            </RadzenAlert>
        }
        
        @if (errorMessage != null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @errorMessage
            </RadzenAlert>
        }
        
        @if (funds != null && funds.Any())
        {
            <RadzenStack Class="rz-mt-4" Orientation="Orientation.Vertical">
                <RadzenText TextStyle="TextStyle.H6">Distinct Funds (@funds.Count)</RadzenText>
                <RadzenList>
                    @foreach (var fund in funds)
                    {
                        <RadzenListItem>@fund</RadzenListItem>
                    }
                </RadzenList>
            </RadzenStack>
        }
        
        @if (createdAccounts != null && createdAccounts.Any())
        {
            <RadzenStack Class="rz-mt-4" Orientation="Orientation.Vertical">
                <RadzenText TextStyle="TextStyle.H6">Created Accounts (@createdAccounts.Count)</RadzenText>
                <RadzenDataGrid Data="@createdAccounts" TItem="(string name, string accountRef, bool success, string errorMessage)">
                    <Columns>
                        <RadzenDataGridColumn TItem="(string name, string accountRef, bool success, string errorMessage)" 
