    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.IsInRole("Admin"))
            {
                Navigation.NavigateTo("/", true);
                return;
            }

            await base.OnInitializedAsync();
            await Task.WhenAll(
                LoadAllAccounts(),
                LoadAllStaff()
            );

            RefreshAccountsOptions();
            
            // Set allFunds to the same data as allAccounts since funds are stored in the Accounts table
            allFunds = allAccounts;

            // Default selection to Add New
            staffMember = AddNewLabel;
            await staffSelection(staffMember);
            
            // Default fund selection to Add New
            selectedFund = AddNewFundLabel;
            await fundSelection(selectedFund);

            // Ensure dropdowns default to 'Select Account'
            accountToAddId = 0;
            selectedLinkedAccountId = 0;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error initializing admin page: {ex.Message}";
        }
    }

    private async Task<List<int>> GetUserOwnedAccountIdsAsync(int userId)
    {
        try
        {
            const string sql = "SELECT AccountId FROM AccountsUsers WHERE UserId = @UserId";
            var ids = await _data.LoadData<int, dynamic>(sql, new { UserId = userId }, _config.GetConnectionString("default") ?? string.Empty);
            return ids?.ToList() ?? new List<int>();
        }
        catch
        {
            return new List<int>();
        }
    }

    private async Task RefreshAccountsOptionsAsync()
    {
        // Build a consistent list with the default first item and no empty names
        var baseList = (allAccounts ?? new List<Account>())
                        .Where(a => !string.IsNullOrWhiteSpace(a.Fund))
                        .OrderBy(a => a.Fund)
                        .ToList();

        // If an existing user is selected, exclude accounts they already have access to
        if (!IsAddNewSelected)
        {
            // Try to get owned ids from the in-memory list first
            List<int> ownedIds = userAccounts?.Where(a => a.AccountId != 0).Select(a => a.AccountId).ToList() ?? new List<int>();

            // If we don't have them loaded yet, query AccountsUsers directly
            var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
            if ((ownedIds == null || ownedIds.Count == 0) && selectedUser != null)
            {
                ownedIds = await GetUserOwnedAccountIdsAsync(selectedUser.Id);
            }

            if (ownedIds != null && ownedIds.Count > 0)
            {
                var ownedSet = ownedIds.ToHashSet();
                baseList = baseList.Where(a => !ownedSet.Contains(a.AccountId)).ToList();
            }
        }

        accountsOptions = new List<Account> { new Account { AccountId = 0, Fund = SelectAccountLabel } };
        accountsOptions.AddRange(baseList);

        if (accountToAddId != 0 && accountsOptions.All(a => a.AccountId != accountToAddId))
        {
            accountToAddId = 0;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void RefreshAccountsOptions()
    {
        // Build a consistent list with the default first item and no empty names
        var baseList = (allAccounts ?? new List<Account>())
                        .Where(a => !string.IsNullOrWhiteSpace(a.Fund))
                        // Order by name only if not adding a new user (to keep default option at the top)
                        .OrderBy(a => !IsAddNewSelected && a.AccountId == 0 ? 1 : 0)
                        .ThenBy(a => a.Fund)
                        .ToList();

        // If an existing user is selected, exclude accounts they already have access to
        if (!IsAddNewSelected && userAccounts != null && userAccounts.Count > 0)
        {
            var ownedIds = userAccounts.Select(a => a.AccountId).ToHashSet();
            baseList = baseList.Where(a => !ownedIds.Contains(a.AccountId)).ToList();
        }

        accountsOptions = new List<Account> { new Account { AccountId = 0, Fund = SelectAccountLabel } };
        accountsOptions.AddRange(baseList);

        // Reset selection if current value is no longer available
        if (accountToAddId != 0 && accountsOptions.All(a => a.AccountId != accountToAddId))
        {
            accountToAddId = 0;
        }
    }

    public async Task staffSelection(string staffName)
    {
        if (string.IsNullOrEmpty(staffName)) return;

        selectedStaff = staffName;

        if (IsAddNewSelected)
        {
            // Prepare UI for adding a new user
            selectedStaffEmail = string.Empty;
            selectedStaffAuthLevel = string.Empty;
            userAccounts.Clear();
            accountsToAssign = Array.Empty<int>();
            accountToAddId = 0;
            selectedLinkedAccountId = 0;

            RefreshAccountsOptions();
            return;
        }

        var selectedUser = staff.FirstOrDefault(u => u.Name == staffName);
        if (selectedUser != null)
        {
            selectedStaffEmail = selectedUser.Email;
            selectedStaffAuthLevel = selectedUser.AuthLevel;

            // Properly await LoadUserAccounts to ensure filtering works correctly
            await LoadUserAccounts(selectedUser.Id);
            // Reset add/remove defaults for existing user
            accountToAddId = 0;
            selectedLinkedAccountId = 0;
        }
    }

    private async Task LoadUserAccounts(int userId)
    {
        try
        {
            string sql = @"
                SELECT a.AccountId, a.Fund, a.AccountingClass, a.CreatedAt
                FROM Accounts a
                INNER JOIN AccountsUsers au ON a.AccountId = au.AccountId
                WHERE au.UserId = @UserId
                ORDER BY a.Fund";

            var userAccountsResult = await _data.LoadData<Account, dynamic>(
                sql,
                new { UserId = userId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            userAccounts.Clear();

            if (userAccountsResult != null && userAccountsResult.Any())
            {
                userAccounts.AddRange(userAccountsResult);
                if (!userAccounts.Any(a => a.AccountId == 0))
                {
                    userAccounts.Insert(0, new Account { AccountId = 0, Fund = SelectAccountLabel });
                }
            }
            else
            {
                userAccounts.Clear();
                userAccounts.Add(new Account { AccountId = 0, Fund = SelectAccountLabel });
            }

            RefreshAccountsOptions();
        }
        catch (Exception ex)
        {
            accountLinkError = $"Error loading user accounts: {ex.Message}";
        }
    }

    private async Task LinkAccountToStaff()
    {
        // Clear previous messages
        accountLinkError = string.Empty;
        accountLinkSuccess = string.Empty;

        if (string.IsNullOrEmpty(staffMember) || IsAddNewSelected)
        {
            accountLinkError = "Please select a user";
            return;
        }

        if (accountToAddId == 0)
        {
            accountLinkError = "Please select an account to add";
            return;
        }

        try
        {
            var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
            if (selectedUser == null)
            {
                accountLinkError = "Selected user not found";
                return;
            }

            // Find account by id
            var account = allAccounts.FirstOrDefault(a => a.AccountId == accountToAddId);
            if (account == null)
            {
                accountLinkError = "Selected account not found";
                return;
            }

            string checkSql = @"
                SELECT COUNT(*) FROM AccountsUsers
                WHERE UserId = @UserId AND AccountId = @AccountId";

            var existingAssociations = await _data.LoadData<int, dynamic>(
                checkSql,
                new { UserId = selectedUser.Id, AccountId = account.AccountId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (existingAssociations != null && existingAssociations.FirstOrDefault() > 0)
            {
                accountLinkError = $"Account '{account.Fund}' is already linked to this user";
                return;
            }

            string insertSql = @"
                INSERT INTO AccountsUsers (UserId, AccountId)
                VALUES (@UserId, @AccountId)";

            int result = await _data.SaveData(
                insertSql,
                new { UserId = selectedUser.Id, AccountId = account.AccountId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (result > 0)
            {
                accountLinkSuccess = $"Successfully linked account '{account.Fund}' to {staffMember}";

                // Reset selection
                accountToAddId = 0;

                await LoadUserAccounts(selectedUser.Id);

                if (userAccounts.Count == 1)
                {
                    string updateDefaultSql = "UPDATE Users SET DefaultAccount = @AccountId WHERE Id = @UserId";
                    await _data.SaveData(
                        updateDefaultSql,
                        new { AccountId = account.AccountId, UserId = selectedUser.Id },
                        _config.GetConnectionString("default") ?? string.Empty
                    );
                }
            }
            else
            {
                accountLinkError = "Failed to link account";
            }
        }
        catch (Exception ex)
        {
            accountLinkError = $"Error linking account: {ex.Message}";
        }
    }

    private async Task RemoveAccountLink()
