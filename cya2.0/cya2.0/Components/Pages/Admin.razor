@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using UserAuth
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@attribute [Authorize(Roles = "Admin")]
@inject UserRepository UserRepository
@inject IDataAccess _data
@inject IConfiguration _config
@inject AppState AppState
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject DialogService DialogService
@using ModelsLibrary
@using System.ComponentModel.DataAnnotations
@using DataLibrary
@inject ILogger<Admin> _logger
@rendermode InteractiveServer
@using Radzen.Blazor
@inject IStringLocalizer<Resource> Localizer

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenText TextStyle="TextStyle.H3">@Localizer["AdminPanel"]</RadzenText>

        <RadzenButton Text="@Localizer["AllBalances"]"
                      ButtonStyle="ButtonStyle.Secondary"
                      Click="@(async () => await OpenAllBalancesDialog())" />

        <RadzenButton Text="@Localizer["AccountSummaries"]"
                      ButtonStyle="ButtonStyle.Secondary"
                      Click="@(async () => await OpenAccountSummariesDialog())" />
    </RadzenStack>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Class="rz-mb-2">
            <!-- Staff -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 30%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["StaffMember"]</RadzenText>
                <RadzenDropDown TValue="string"
                               Data="@staff"
                               TextProperty="Name"
                               ValueProperty="Name"
                               @bind-Value="staffMember"
                               Change="@(args => staffSelection(args?.ToString() ?? string.Empty))"
                               Placeholder="@Localizer["SelectStaffMember"]"
                               Style="width: 100%;" />
                
                <RadzenFormField Text="@Localizer["NewName"]" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@newName" Placeholder="@Localizer["EnterUpdatedName"]" />
                </RadzenFormField>
            </RadzenStack>
            
            <!-- Email -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 30%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["CurrentEmail"]</RadzenText>
                <div class="rz-p-2 rz-border-radius-1 rz-border-1" style="height: 38px; display: flex; align-items: center;">
                    <RadzenText TextStyle="TextStyle.Subtitle2">
                        @(string.IsNullOrEmpty(selectedStaffEmail) ? " " : selectedStaffEmail)
                    </RadzenText>
                </div>
                
                <RadzenFormField Text="@Localizer["NewEmail"]" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@newEmail" Placeholder="@Localizer["EnterUpdatedEmail"]" />
                </RadzenFormField>
            </RadzenStack>
            
            <!-- Auth Level -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 30%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["AuthLevel"]</RadzenText>
                <div class="rz-p-2 rz-border-radius-1 rz-border-1" style="height: 38px; display: flex; align-items: center;">
                    <RadzenText TextStyle="TextStyle.Subtitle2">
                        @(string.IsNullOrEmpty(selectedStaffAuthLevel) ? " " : selectedStaffAuthLevel)
                    </RadzenText>
                </div>
                
                <RadzenFormField Text="@Localizer["NewAuthLevel"]" Variant="Variant.Outlined">
                    <RadzenDropDown TValue="string"
                                   Data="@authLevels"
                                   @bind-Value="@newAuthLevel"
                                   Placeholder="@Localizer["SelectNewAuthLevel"]"
                                   Style="width: 100%;" />
                </RadzenFormField>
            </RadzenStack>
            
            <!-- Account Management -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 30%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["AccountManagement"]</RadzenText>
                
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2">@Localizer["AddAccountAccess"]</RadzenText>
                    <RadzenDropDown TValue="string"
                                    Data="@allAccounts"
                                    TextProperty="Name"
                                    ValueProperty="Name"
                                    @bind-Value="accountToAdd"
                                    Placeholder="@Localizer["SelectAccount"]"
                                    Style="width: 100%;" />
                    
                    <RadzenButton 
                        Text="@Localizer["LinkAccountToStaff"]" 
                        ButtonStyle="ButtonStyle.Primary" 
                        Click="LinkAccountToStaff" 
                        Disabled="@(string.IsNullOrEmpty(staffMember) || string.IsNullOrEmpty(accountToAdd))"
                        Style="width: fit-content;" />
                </RadzenStack>
                
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenText TextStyle="TextStyle.Body2">@Localizer["RemoveAccountAccess"]</RadzenText>
                    <RadzenDropDown TValue="int"
                                    Data="@userAccounts"
                                    TextProperty="Name"
                                    ValueProperty="AccountId"
                                    @bind-Value="selectedLinkedAccountId"
                                    Placeholder="@Localizer["SelectAccountToRemove"]"
                                    Style="width: 100%;" />
                    
                    <RadzenButton 
                        Text="@Localizer["RemoveAccountLink"]" 
                        ButtonStyle="ButtonStyle.Danger" 
                        Click="RemoveAccountLink" 
                        Disabled="@(selectedLinkedAccountId == 0 || string.IsNullOrEmpty(staffMember))"
                        Style="width: fit-content;" />
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
        
        <!-- Staff update error/success messages -->
        @if (!string.IsNullOrEmpty(staffUpdateError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @Localizer[staffUpdateError]
            </RadzenAlert>
        }
        
        @if (!string.IsNullOrEmpty(staffUpdateSuccess))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @staffUpdateSuccess
            </RadzenAlert>
        }
        
        <!-- Account link error/success messages -->
        @if (!string.IsNullOrEmpty(accountLinkError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @accountLinkError
            </RadzenAlert>
        }
        
        @if (!string.IsNullOrEmpty(accountLinkSuccess))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @accountLinkSuccess
            </RadzenAlert>
        }
        
        <!-- Update and Delete buttons -->
        <div style="margin-top: 1rem;">
            <RadzenButton 
                Text="@Localizer["UpdateStaffMember"]" 
                ButtonStyle="ButtonStyle.Primary" 
                Click="UpdateStaffMember" 
                Disabled="@(string.IsNullOrEmpty(staffMember))"
                Style="margin-right: 1rem;" />
                
            <RadzenButton 
                Text="@Localizer["DeleteStaffMember"]" 
                ButtonStyle="ButtonStyle.Danger" 
                Click="@(() => { userToDelete = staffMember ?? string.Empty; showDeleteConfirmation = true; })"
                Disabled="@(string.IsNullOrEmpty(staffMember))"
                Style="width: fit-content;" />
        </div>
    </RadzenCard>
    
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H5">@Localizer["CreateNewUser"]</RadzenText>
        
        <RadzenTemplateForm TItem="UserFormModel" Data="@formModel" Submit="@HandleValidSubmit">
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenFormField Text="@Localizer["Email"]" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@formModel.Email" Name="Email" />
                    <RadzenRequiredValidator Component="Email" Text="@Localizer["EmailRequired"]" />
                    <RadzenEmailValidator Component="Email" Text="@Localizer["ValidEmailRequired"]" />
                </RadzenFormField>
                
                <RadzenFormField Text="@Localizer["Name"]" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@formModel.Name" Name="Name" />
                    <RadzenRequiredValidator Component="Name" Text="@Localizer["NameRequired"]" />
                    <RadzenLengthValidator Component="Name" Min="2" Max="100" Text="@Localizer["NameLength"]" />
                </RadzenFormField>
                
                <div class="d-flex">
                    <RadzenButton Text="@Localizer["RegisterNewUser"]" 
                                  ButtonType="ButtonType.Submit" 
                                  ButtonStyle="ButtonStyle.Primary" />
                </div>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

<ConfirmDialog 
    Show="@showDeleteConfirmation"
    Title="@Localizer["DeleteStaffMember"]"
    Message="@Localizer["ConfirmDeleteStaffMember", userToDelete]"
    OnConfirm="@ConfirmDelete"
    OnCancel="@(() => showDeleteConfirmation = false)" />

<!-- Radzen hosts inside the Admin interactive island -->
<RadzenDialog />
<RadzenNotification />
<RadzenContextMenu />
<RadzenTooltip />

@code {
    private string? staffMember;
    private List<UserData> staff = new List<UserData>();
    private string selectedStaffEmail = string.Empty;
    private string selectedStaffAuthLevel = string.Empty;
    private string newAuthLevel = string.Empty;
    private List<string> authLevels = new List<string> { "User", "Viewer", "Admin" };

    public string selectedStaff = string.Empty;
    public string newName = string.Empty;
    public string newEmail = string.Empty;

    private string staffUpdateError = string.Empty;
    private string staffUpdateSuccess = string.Empty;

    // Account management properties
    private string accountLinkError = string.Empty;
    private string accountLinkSuccess = string.Empty;
    private string? accountToAdd;
    private List<Account> allAccounts = new List<Account>();
    private List<Account> sharedAccounts = new List<Account>();
    private List<SharedAccountBool> sharedAccountsBool = new List<SharedAccountBool>();
    private List<Account> userAccounts = new List<Account>();
    private int selectedLinkedAccountId = 0;

    // User form properties
    [SupplyParameterFromForm]
    private UserFormModel formModel { get; set; } = new UserFormModel();

    // Fund properties
    private string? successMessage;
    private string? errorMessage;
    private List<string>? funds;
    private List<(string name, string accountRef, bool success, string errorMessage)> createdAccounts = new();

    private bool showDeleteConfirmation = false;
    private string userToDelete = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.IsInRole("Admin"))
            {
                Navigation.NavigateTo("/", true);
                return;
            }

            await base.OnInitializedAsync();
            await Task.WhenAll(
                LoadAllAccounts(),
                LoadAllStaff()
            );
        }
        catch (Exception ex)
        {
            errorMessage = $"Error initializing admin page: {ex.Message}";
        }
    }

    public void staffSelection(string staffName)
    {
        if (string.IsNullOrEmpty(staffName)) return;

        selectedStaff = staffName;

        var selectedUser = staff.FirstOrDefault(u => u.Name == staffName);
        if (selectedUser != null)
        {
            selectedStaffEmail = selectedUser.Email;
            selectedStaffAuthLevel = selectedUser.AuthLevel;

            _ = LoadUserAccounts(selectedUser.Id);
        }
    }

    private async Task UpdateStaffMember()
    {
        // Clear previous messages
        staffUpdateError = string.Empty;
        staffUpdateSuccess = string.Empty;

        Console.WriteLine("UpdateStaffMember called");

        if (string.IsNullOrEmpty(staffMember))
        {
            staffUpdateError = "Please select a staff member to update";
            return;
        }

        try
        {
            var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
            if (selectedUser == null)
            {
                staffUpdateError = "Selected staff member not found";
                return;
            }

            // Build update parts based on what the user entered
            bool hasChanges = false;
            string sql = "UPDATE Users SET ";
            var parameters = new Dictionary<string, object>();

            // Add the ID for WHERE clause
            parameters.Add("Id", selectedUser.Id);

            // Check if name should be updated
            if (!string.IsNullOrWhiteSpace(newName))
            {
                sql += "Name = @Name, ";
                parameters.Add("Name", newName);
                hasChanges = true;
            }

            // Check if email should be updated
            if (!string.IsNullOrWhiteSpace(newEmail))
            {
                sql += "Email = @Email, ";
                parameters.Add("Email", newEmail);
                hasChanges = true;
            }

            // Check if auth level should be updated
            if (!string.IsNullOrWhiteSpace(newAuthLevel))
            {
                sql += "AuthLevel = @AuthLevel, ";
                parameters.Add("AuthLevel", newAuthLevel);
                hasChanges = true;
            }

            // If nothing to update, show message
            if (!hasChanges)
            {
                staffUpdateError = "No changes provided for update";
                return;
            }

            // Remove trailing comma and space
            sql = sql.TrimEnd(',', ' ');

            // Add WHERE clause
            sql += " WHERE Id = @Id";

            // Execute update
            Console.WriteLine($"Executing SQL: {sql}");
            Console.WriteLine($"Parameters: {string.Join(", ", parameters.Select(p => $"{p.Key}={p.Value}"))}");

            int result = await _data.SaveData(
                sql,
                parameters,
                _config.GetConnectionString("default") ?? string.Empty
            );

            Console.WriteLine($"Update result: {result}");

            if (result > 0)
            {
                staffUpdateSuccess = "Staff member updated successfully";

                // Clear input fields
                newName = string.Empty;
                newEmail = string.Empty;
                newAuthLevel = string.Empty;

                // Refresh staff list
                await LoadAllStaff();

                // Update the current selection to show updated info
                staffSelection(staffMember);
            }
            else
            {
                staffUpdateError = "Failed to update staff member";
            }
        }
        catch (Exception ex)
        {
            staffUpdateError = $"Error updating staff member: {ex.Message}";
        }
    }

    private async Task DeleteStaffMember()
    {
        try
        {
            _logger.LogInformation("DeleteStaffMember called for staff member: {StaffMember}", staffMember);
            
            if (string.IsNullOrEmpty(staffMember))
            {
                staffUpdateError = "Please select a staff member to delete";
                StateHasChanged();
                return;
            }

            // Use the basic Confirm method without custom options
            var result = await DialogService.Confirm(
                "Are you sure you want to delete this Staff Member?", 
                "Delete Confirmation");

            if (result != true)
            {
                _logger.LogInformation("User cancelled deletion");
                return;
            }

            var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
            if (selectedUser == null)
            {
                staffUpdateError = "Selected staff member not found";
                StateHasChanged();
                return;
            }

            // Delete account associations first
            _logger.LogInformation("Deleting account associations for user {UserId}", selectedUser.Id);
            string deleteAccountsSql = "DELETE FROM AccountsUsers WHERE UserId = @UserId";
            await _data.SaveData(
                deleteAccountsSql,
                new { UserId = selectedUser.Id },
                _config.GetConnectionString("default") ?? string.Empty
            );

            // Then delete the user
            _logger.LogInformation("Deleting user {UserId}", selectedUser.Id);
            string deleteUserSql = "DELETE FROM Users WHERE Id = @Id";
            int deleteResult = await _data.SaveData(
                deleteUserSql,
                new { Id = selectedUser.Id },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (deleteResult > 0)
            {
                _logger.LogInformation("Successfully deleted staff member");
                staffUpdateSuccess = "Staff member deleted successfully";

                // Clear selections
                staffMember = string.Empty;
                selectedStaff = string.Empty;
                selectedStaffEmail = string.Empty;
                selectedStaffAuthLevel = string.Empty;
                newName = string.Empty;
                newEmail = string.Empty;
                newAuthLevel = string.Empty;
                userAccounts.Clear();

                // Refresh staff list
                await LoadAllStaff();
            }
            else
            {
                _logger.LogWarning("Failed to delete staff member");
                staffUpdateError = "Failed to delete staff member";
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error in DeleteStaffMember");
            staffUpdateError = $"Error: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            showDeleteConfirmation = false;
            _logger.LogInformation("Confirming deletion of staff member: {StaffMember}", userToDelete);
            
            var selectedUser = staff.FirstOrDefault(u => u.Name == userToDelete);
            if (selectedUser == null)
            {
                staffUpdateError = "Selected staff member not found";
                return;
            }

            // Delete account associations first
            _logger.LogInformation("Deleting account associations for user {UserId}", selectedUser.Id);
            string deleteAccountsSql = "DELETE FROM AccountsUsers WHERE UserId = @UserId";
            await _data.SaveData(
                deleteAccountsSql,
                new { UserId = selectedUser.Id },
                _config.GetConnectionString("default") ?? string.Empty
            );

            // Then delete the user
            _logger.LogInformation("Deleting user {UserId}", selectedUser.Id);
            string deleteUserSql = "DELETE FROM Users WHERE Id = @Id";
            int deleteResult = await _data.SaveData(
                deleteUserSql,
                new { Id = selectedUser.Id },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (deleteResult > 0)
            {
                _logger.LogInformation("Successfully deleted staff member");
                staffUpdateSuccess = "Staff member deleted successfully";

                // Clear selections
                staffMember = string.Empty;
                selectedStaff = string.Empty;
                selectedStaffEmail = string.Empty;
                selectedStaffAuthLevel = string.Empty;
                newName = string.Empty;
                newEmail = string.Empty;
                newAuthLevel = string.Empty;
                userAccounts.Clear();

                // Refresh staff list
                await LoadAllStaff();
            }
            else
            {
                _logger.LogWarning("Failed to delete staff member");
                staffUpdateError = "Failed to delete staff member";
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error in ConfirmDelete");
            staffUpdateError = $"Error: {ex.Message}";
            StateHasChanged();
        }
    }

    // Loading methods
    private async Task LoadAllStaff()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                string sql = "SELECT Id, Email, Name, Language, AuthLevel, DefaultAccount FROM Users ORDER BY Name";
                var users = await _data.LoadData<User, dynamic>(
                    sql,
                    new { },
                    _config.GetConnectionString("default") ?? string.Empty
                );

                if (users != null)
                {
                    staff = users.Select(u => new UserData(
                        u.Id,                       
                        u.Email ?? string.Empty,
                        u.Name ?? string.Empty,
                        u.Language ?? string.Empty,
                        u.AuthLevel ?? string.Empty,
                        u.DefaultAccount.HasValue ? u.DefaultAccount.Value.ToString() : string.Empty,
                        new List<Account>(),        
                        string.Empty                
                    )).ToList();
                }
                else
                {
                    staff = new List<UserData>();
                }
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading staff members: {ex.Message}";
            staff = new List<UserData>();
        }
    }

    private async Task LoadAllAccounts()
    {
        try
        {
            string sql = "SELECT AccountId, Name, AccountRef, CreatedAt FROM Accounts ORDER BY Name";
            allAccounts = await _data.LoadData<Account, dynamic>(
                sql,
                new { },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (allAccounts == null)
                allAccounts = new List<Account>();

            // Initialize empty list for shared accounts selection
            sharedAccountsBool = new List<SharedAccountBool>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading accounts: {ex.Message}";
            allAccounts = new List<Account>();
        }
    }

    // Account management methods
    public void accountSeletion(string account)
    {
        if (string.IsNullOrEmpty(account)) return;
        Console.WriteLine($"Selected account: {accountToAdd}");
    }

    public void sharedAccountSeletion(string account)
    {
        Console.WriteLine($"Shared account selected: {account}");
    }

    private async Task LinkAccountToStaff()
    {
        // Clear previous messages
        accountLinkError = string.Empty;
        accountLinkSuccess = string.Empty;

        if (string.IsNullOrEmpty(staffMember))
        {
            accountLinkError = "Please select a staff member";
            return;
        }

        if (string.IsNullOrEmpty(accountToAdd))
        {
            accountLinkError = "Please select an account to add";
            return;
        }

        try
        {
            // Get the user ID from the selected staff
            var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
            if (selectedUser == null)
            {
                accountLinkError = "Selected staff member not found";
                return;
            }

            // Get the account ID from the selected account
            var account = allAccounts.FirstOrDefault(a => a.Name == accountToAdd);
            if (account == null)
            {
                accountLinkError = "Selected account not found";
                return;
            }

            // Check if the association already exists
            string checkSql = @"
                SELECT COUNT(*) FROM AccountsUsers
                WHERE UserId = @UserId AND AccountId = @AccountId";

            var existingAssociations = await _data.LoadData<int, dynamic>(
                checkSql,
                new { UserId = selectedUser.Id, AccountId = account.AccountId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (existingAssociations != null && existingAssociations.FirstOrDefault() > 0)
            {
                accountLinkError = $"Account '{accountToAdd}' is already linked to this staff member";
                return;
            }

            // Insert the new association
            string insertSql = @"
                INSERT INTO AccountsUsers (UserId, AccountId)
                VALUES (@UserId, @AccountId)";

            int result = await _data.SaveData(
                insertSql,
                new { UserId = selectedUser.Id, AccountId = account.AccountId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (result > 0)
            {
                accountLinkSuccess = $"Successfully linked account '{accountToAdd}' to {staffMember}";

                // Reset the selected account
                accountToAdd = string.Empty;

                // Refresh the user's accounts list
                await LoadUserAccounts(selectedUser.Id);
                
                // If this is the only account for the user, set it as default and update AppState
                if (userAccounts.Count == 1)
                {
                    string updateDefaultSql = "UPDATE Users SET DefaultAccount = @AccountId WHERE Id = @UserId";
                    await _data.SaveData(
                        updateDefaultSql,
                        new { AccountId = account.AccountId, UserId = selectedUser.Id },
                        _config.GetConnectionString("default") ?? string.Empty
                    );
                    
                    // Update AppState if this is for the current user (would need additional logic to determine)
                    // This would require knowing who the current user is, which might not be available in admin context
                }
            }
            else
            {
                accountLinkError = "Failed to link account";
            }
        }
        catch (Exception ex)
        {
            accountLinkError = $"Error linking account: {ex.Message}";
        }
    }

    private async Task RemoveAccountLink()
    {
        // Clear previous messages
        accountLinkError = string.Empty;
        accountLinkSuccess = string.Empty;

        if (string.IsNullOrEmpty(staffMember))
        {
            accountLinkError = "Please select a staff member";
            return;
        }

        if (selectedLinkedAccountId == 0)
        {
            accountLinkError = "Please select an account to remove";
            return;
        }

        try
        {
            // Get the user ID from the selected staff
            var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
            if (selectedUser == null)
            {
                accountLinkError = "Selected staff member not found";
                return;
            }

            // Get the account name for the success message
            var selectedAccount = userAccounts.FirstOrDefault(a => a.AccountId == selectedLinkedAccountId);
            string accountName = selectedAccount?.Name ?? "Unknown";

            // Delete the association
            string deleteSql = @"
                DELETE FROM AccountsUsers
                WHERE UserId = @UserId AND AccountId = @AccountId";

            int result = await _data.SaveData(
                deleteSql,
                new { UserId = selectedUser.Id, AccountId = selectedLinkedAccountId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (result > 0)
            {
                accountLinkSuccess = $"Successfully removed account '{accountName}' from {staffMember}";

                // Reset the selected account
                selectedLinkedAccountId = 0;

                // Refresh the user's accounts list
                await LoadUserAccounts(selectedUser.Id);
            }
            else
            {
                accountLinkError = "Failed to remove account link";
            }
        }
        catch (Exception ex)
        {
            accountLinkError = $"Error removing account link: {ex.Message}";
        }
    }

    private async Task LoadUserAccounts(int userId)
    {
        try
        {
            string sql = @"
                SELECT a.AccountId, a.Name, a.AccountRef, a.CreatedAt
                FROM Accounts a
                INNER JOIN AccountsUsers au ON a.AccountId = au.AccountId
                WHERE au.UserId = @UserId
                ORDER BY a.Name";

            var userAccountsResult = await _data.LoadData<Account, dynamic>(
                sql,
                new { UserId = userId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            // Clear existing list
            userAccounts.Clear();

            // Populate with user's accounts
            if (userAccountsResult != null && userAccountsResult.Any())
            {
                userAccounts.AddRange(userAccountsResult);
            }
        }
        catch (Exception ex)
        {
            accountLinkError = $"Error loading user accounts: {ex.Message}";
        }
    }

    private async Task SetAccountAsDefault(int userId, int accountId)
    {
        try
        {
            string sql = "UPDATE Users SET DefaultAccount = @AccountId WHERE Id = @UserId";
            
            int result = await _data.SaveData(
                sql,
                new { AccountId = accountId, UserId = userId },
                _config.GetConnectionString("default") ?? string.Empty
            );
            
            if (result > 0)
            {
                // Find the account name
                var account = allAccounts.FirstOrDefault(a => a.AccountId == accountId);
                if (account != null)
                {
                    // If we're updating the default for the current user session, update AppState
                    // We would need a way to determine if this is the current user
                    // AppState.DefaultAccount = account.Name;
                    
                    accountLinkSuccess = $"Set '{account.Name}' as default account for {staffMember}";
                }
            }
            else
            {
                accountLinkError = "Failed to set default account";
            }
        }
        catch (Exception ex)
        {
            accountLinkError = $"Error setting default account: {ex.Message}";
        }
    }

