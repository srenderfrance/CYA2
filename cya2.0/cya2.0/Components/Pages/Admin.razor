@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using UserAuth
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@attribute [Authorize(Roles = "Admin")]
@inject UserRepository UserRepository
@inject IDataAccess _data
@inject IConfiguration _config
@inject AppState AppState
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject DialogService DialogService
@using ModelsLibrary
@using System.ComponentModel.DataAnnotations
@using DataLibrary
@inject ILogger<Admin> _logger
@rendermode InteractiveServer
@using Radzen.Blazor
@using Radzen
@using UtilityClasses
@inject IStringLocalizer<Resource> Localizer
@inject TooltipService tooltipService
@using System.Text.Json
@using cya2.Services.Imports

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">
    <!-- Top row: accounts buttons on the left, upload buttons on the right -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Class="rz-mb-3">
        <!-- Left group: existing account dialogs -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenButton Text="@Localizer["AccountsOverview"]"
                          ButtonStyle="ButtonStyle.Primary"
                          Style="background-color: #0a3b6b; border-color: #0a3b6b;"
                          Click="@(async () => await OpenAccountsOverviewDialog())" />

            <RadzenButton Text="@Localizer["AccountSummaries"]"
                          ButtonStyle="ButtonStyle.Primary"
                          Style="background-color: #0a3b6b; border-color: #0a3b6b;"
                          Click="@(async () => await OpenAccountSummariesDialog())" />
        </RadzenStack>

        <!-- Right group: upload controls -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <!-- NOTE: No size limit for now. TODO: enforce a sensible max file size. -->
            <div style="display:flex; align-items:center; gap:0.5rem;">
                <RadzenUpload Url="/api/upload/donations"
                              Accept=".xlsx"
                              ChooseText="@Localizer["UploadDonationData"]"
                              Complete="OnDonationUploadComplete"
                              Progress="OnUploadProgress"
                              Change="@(async args => await OnUploadStarted())" />
                <RadzenButton Text="Show Donation Status" Click="() => showDonationStatus = !showDonationStatus" />
            </div>

            <div style="display:flex; align-items:center; gap:0.5rem;">
                <RadzenUpload Url="/api/upload/accounting"
                              Accept=".xlsx"
                              ChooseText="@Localizer["UploadAccountingData"]"
                              Complete="OnAccountingUploadComplete"
                              Progress="OnUploadProgress"
                              Change="@(async args => await OnUploadStarted())" />
                <RadzenButton Text="Show Accounting Status" Click="() => showAccountingStatus = !showAccountingStatus" />
            </div>
        </RadzenStack>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <RadzenText TextStyle="TextStyle.H5">@Localizer["ManageUsers"]</RadzenText>
    </RadzenStack>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Class="rz-mb-2">
            <!-- User and Email stacked -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 22.5%;">
                <!-- User -->
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["User"]</RadzenText>
                    <RadzenDropDown TValue="string"
                                   Data="@staffWithAddOption"
                                   TextProperty="Name"
                                   ValueProperty="Name"
                                   @bind-Value="staffMember"
                                   Change="@(async args => await staffSelection(args?.ToString() ?? string.Empty))"
                                   Placeholder="@Localizer["SelectUser"]"
                                   Style="width: 100%;" />
                              
                               <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["NewName"]</RadzenText>
                    <RadzenTextBox @bind-Value="@newName" Placeholder="@Localizer["EnterUpdatedName"]" />
                </RadzenStack>
                </RadzenStack>
                
                <!-- Email -->
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["CurrentEmail"]</RadzenText>
                    <div class="rz-p-2 rz-border-radius-1 rz-border-1" style="height: 38px; display: flex; align-items: center;">
                        <RadzenText TextStyle="TextStyle.Subtitle2">
                            @(string.IsNullOrEmpty(selectedStaffEmail) ? " " : selectedStaffEmail)
                        </RadzenText>
                    </div>
                    
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["NewEmail"]</RadzenText>
                        <RadzenTextBox @bind-Value="@newEmail" Placeholder="@Localizer["EnterUpdatedEmail"]" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenStack>
            
            <!-- Auth Level -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 22.5%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["AuthLevel"]</RadzenText>
                <div class="rz-p-2 rz-border-radius-1 rz-border-1" style="height: 38px; display: flex; align-items: center;">
                    <RadzenText TextStyle="TextStyle.Subtitle2">
                        @(string.IsNullOrEmpty(selectedStaffAuthLevel) ? " " : selectedStaffAuthLevel)
                    </RadzenText>
                </div>
                
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["NewAuthLevel"]</RadzenText>
                    <RadzenDropDown TValue="string"
                                   Data="@authLevels"
                                   @bind-Value="@newAuthLevel"
                                   Placeholder="@Localizer["SelectNewAuthLevel"]"
                                   Style="width: 100%;" />
                </RadzenStack>
            </RadzenStack>
            
            <!-- Account Management -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 22.5%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["FundAccess"]</RadzenText>
                
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2">@Localizer["GrantFundAccess"]</RadzenText>

                    <!-- Single, consistent dropdown for account selection -->
                    <RadzenDropDown TValue="int"
                                    Data="@accountsOptions"
                                    TextProperty="@nameof(Account.Fund)"
                                    ValueProperty="@nameof(Account.AccountId)"
                                    @bind-Value="accountToAddId"
                                    Change="@(args => accountToAddId = (args is int v) ? v : 0)"
                                    Placeholder="@Localizer["SelectFund"]"
                                    Style="width: 100%;" >
                        <Template Context="account">
                            @GetDisplayTextFromAccountingClass(account.AccountingClass)
                        </Template>
                    </RadzenDropDown>
                    
                    <RadzenButton 
                        Text="@Localizer["GrantAccess"]" 
                        ButtonStyle="ButtonStyle.Primary" 
                        Click="LinkAccountToStaff" 
                        Disabled="@(string.IsNullOrEmpty(staffMember) || accountToAddId == 0)"
                        Style="width: fit-content;" />
                </RadzenStack>
                
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Class="rz-mt-3">
                    <RadzenText TextStyle="TextStyle.Body2">@Localizer["RemoveFundAccess"]</RadzenText>
                    <RadzenDropDown TValue="int"
                                    Data="@userAccounts"
                                    TextProperty="@nameof(Account.Fund)"
                                    ValueProperty="@nameof(Account.AccountId)"
                                    @bind-Value="selectedLinkedAccountId"
                                    Change="@(args => selectedLinkedAccountId = (args is int v) ? v : 0)"
                                    Style="width: 100%;" >
                        <Template Context="account">
                            @if (account.AccountId == 0)
                            {
                                @account.Fund
                            }
                            else
                            {
                                @GetDisplayTextFromAccountingClass(account.AccountingClass)
                            }
                        </Template>
                    </RadzenDropDown>
                    
                    <RadzenButton 
                        Text="@Localizer["RemoveAccess"]" 
                        ButtonStyle="ButtonStyle.Danger" 
                        Click="RemoveAccountLink" 
                        Disabled="@(selectedLinkedAccountId == 0 || string.IsNullOrEmpty(staffMember) || IsAddNewSelected)"
                        Style="width: fit-content;" />
                </RadzenStack>
            </RadzenStack>
            
            <!-- User Funds Access -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 22.5%;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["CurrentFundAccess"]</RadzenText>
                <div style="border: 1px solid #ccc; border-radius: 4px; padding: 0.75rem; max-height: 200px; overflow-y: auto; background-color: #f9f9f9; min-height: 120px;">
                    @if (IsAddNewSelected)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #666;">Select a user to view fund access</RadzenText>
                    }
                    else if (selectedStaffAuthLevel == "Admin")
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #28a745; font-weight: 500;">User has admin privileges.</RadzenText>
                    }
                    else if (userAccounts.Any(a => a.AccountId != 0))
                    {
                        <ul style="list-style-type: none; padding: 0; margin: 0;">
                            @foreach (var account in userAccounts.Where(a => a.AccountId != 0))
                            {
                                <li style="padding: 0.25rem 0; border-bottom: 1px solid #eee;">
                                    <RadzenText TextStyle="TextStyle.Body2">@GetDisplayTextFromAccountingClass(account.AccountingClass)</RadzenText>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #666;">None</RadzenText>
                    }
                </div>
            </RadzenStack>
        </RadzenStack>
        
        <!-- Staff update error/success messages -->
        @if (!string.IsNullOrEmpty(staffUpdateError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @Localizer[staffUpdateError]
            </RadzenAlert>
        }
        
        @if (!string.IsNullOrEmpty(staffUpdateSuccess))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @staffUpdateSuccess
            </RadzenAlert>
        }
        
        <!-- Account link error/success messages -->
        @if (!string.IsNullOrEmpty(accountLinkError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @accountLinkError
            </RadzenAlert>
        }
        
        @if (!string.IsNullOrEmpty(accountLinkSuccess))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @accountLinkSuccess
            </RadzenAlert>
        }
        
        <!-- Upload status panels -->
        @if (showDonationStatus)
        {
            <RadzenCard Class="rz-mt-3">
                <RadzenText TextStyle="TextStyle.Subtitle2">Donation Upload Status</RadzenText>
                <div>Progress: @uploadProgressPercent% </div>
                <div>Total rows read: @(donationImportResult?.TotalRows ?? 0)</div>
                <div>Rows inserted: @(donationImportResult?.InsertedRows ?? 0)</div>
                <div>Rows failed: @(donationImportResult?.FailedRows ?? 0)</div>
            </RadzenCard>
        }

        @if (showAccountingStatus)
        {
            <RadzenCard Class="rz-mt-3">
                <RadzenText TextStyle="TextStyle.Subtitle2">Accounting Upload Status</RadzenText>
                <div>Progress: @uploadProgressPercent% </div>
                <div>Total rows read: @(accountingImportResult?.TotalRows ?? 0)</div>
                <div>Rows inserted: @(accountingImportResult?.InsertedRows ?? 0)</div>
                <div>Rows failed: @(accountingImportResult?.FailedRows ?? 0)</div>
            </RadzenCard>
        }
        
        <!-- Update and Add buttons -->
        <div style="margin-top: 1rem;">
            <RadzenButton 
                Text="@Localizer["UpdateUser"]" 
                ButtonStyle="ButtonStyle.Primary" 
                Click="UpdateStaffMember" 
                Disabled="@(string.IsNullOrEmpty(staffMember) || IsAddNewSelected)"
                Style="margin-right: 1rem;" />
                
            <RadzenButton 
                Text="@Localizer["AddNewUser"]" 
                ButtonStyle="ButtonStyle.Primary" 
                Click="@(async () => await AddNewStaffMember())" 
                Disabled="@(!IsAddNewSelected)"
                Style="margin-right: 1rem;" />
                
            <RadzenButton 
                Text="@Localizer["DeleteUser"]" 
                ButtonStyle="ButtonStyle.Danger" 
                Click="@(() => { userToDelete = staffMember ?? string.Empty; showDeleteConfirmation = true; })"
                Disabled="@(string.IsNullOrEmpty(staffMember) || IsAddNewSelected)"
                Style="width: fit-content;" />
        </div>
    </RadzenCard>
    
    <!-- Extra spacing added above Manage Funds -->
    <div style="height: 2rem;"></div>
    
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Class="rz-mt-4">
        <RadzenText TextStyle="TextStyle.H5">@Localizer["ManageFunds"]</RadzenText>
    </RadzenStack>
    
    <RadzenCard Style="overflow: visible;">
        <!-- Single column layout with labels on left, inputs on right -->
        <RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem" Style="max-width: 600px;">
            <!-- Fund Selection -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["Fund"]</RadzenText>
                <RadzenDropDown TValue="string"
                               Data="@fundsWithAddOption"
                               TextProperty="DisplayText"
                               ValueProperty="DisplayText"
                               @bind-Value="selectedFund"
                               Change="@(async args => await fundSelection(args?.ToString() ?? string.Empty))"
                               Placeholder="@Localizer["SelectFund"]"
                               Style="width: 100%;"/>
            </RadzenStack>

            <!-- Fund Number -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width: 150px;">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["AccountNumber"]</RadzenText>
                    <i @ref="accountNumberIcon" class="bi bi-exclamation-circle" style="cursor: help; color: #dc3545;" 
                       @onmouseenter="@(() => ShowAccountNumberTooltip(accountNumberIcon))"
                       @onmouseleave="@(() => tooltipService.Close())"></i>
                </RadzenStack>
                <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                    <RadzenTextBox @bind-Value="@accountNumber" Placeholder="@Localizer["AccountNumber"]" />
                </RadzenFormField>
            </RadzenStack>

            <!-- Fund Name -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width: 150px;">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["Fund"]</RadzenText>
                    <i @ref="fundIcon" class="bi bi-exclamation-circle" style="cursor: help; color: #dc3545;" 
                       @onmouseenter="@(() => ShowFundTooltip(fundIcon))"
                       @onmouseleave="@(() => tooltipService.Close())"></i>
                </RadzenStack>
                <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                    <RadzenTextBox @bind-Value="@newFundName" Placeholder="@Localizer["Fund"]" />
                </RadzenFormField>
            </RadzenStack>

            <!-- Account Reference -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="width: 150px;">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold;">@Localizer["Class"]</RadzenText>
                    <i @ref="classIcon" class="bi bi-exclamation-circle" style="cursor: help; color: #dc3545;" 
                       @onmouseenter="@(() => ShowClassTooltip(classIcon))"
                       @onmouseleave="@(() => tooltipService.Close())"></i>
                </RadzenStack>
                <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                    <RadzenTextBox @bind-Value="@fundClass" Placeholder="@Localizer["Class"]" />
                </RadzenFormField>
            </RadzenStack>

            <!-- Soft Credit -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold; width: 150px;">@Localizer["SoftCredit"]</RadzenText>
                <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                    <RadzenTextBox @bind-Value="@softCredit" Placeholder="@Localizer["SoftCredit"]" />
                </RadzenFormField>
            </RadzenStack>

            <!-- Balance Adjustment -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold; width: 150px;">@Localizer["BalanceAdjustment"]</RadzenText>
                <RadzenFormField Variant="Variant.Outlined" Style="flex: 1;">
                    <RadzenNumeric TValue="decimal?" @bind-Value="@balanceAdjustment" Placeholder="0.00" Format="C" />
                </RadzenFormField>
            </RadzenStack>

            <!-- Other Funds -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight: bold; width: 150px;">@Localizer["OtherFunds"]</RadzenText>
                <div style="width: 40px;">
                    <RadzenCheckBox @bind-Value="@otherFunds" />
                </div>
            </RadzenStack>
        </RadzenStack>
        
        <!-- Fund update/create error/success messages -->
        @if (!string.IsNullOrEmpty(fundUpdateError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @fundUpdateError
            </RadzenAlert>
        }
        
        @if (!string.IsNullOrEmpty(fundUpdateSuccess))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @fundUpdateSuccess
            </RadzenAlert>
        }

        <!-- Fund Management Buttons -->
        <div style="margin-top: 1rem;">
            <RadzenButton 
                Text="@Localizer["UpdateFund"]" 
                ButtonStyle="ButtonStyle.Primary" 
                Click="UpdateFund" 
                Disabled="@(string.IsNullOrEmpty(selectedFund) || IsAddNewFundSelected)"
                Style="margin-right: 1rem;" />
                
            <RadzenButton 
                Text="@Localizer["AddNewFund"]" 
                ButtonStyle="ButtonStyle.Primary" 
                Click="@(async () => await AddNewFund())" 
                Disabled="@(!IsAddNewFundSelected)"
                Style="margin-right: 1rem;" />
                
            <RadzenButton 
                Text="@Localizer["DeleteFund"]" 
                ButtonStyle="ButtonStyle.Danger" 
                Click="@(() => { fundToDelete = selectedFund ?? string.Empty; showDeleteFundConfirmation = true; })"
                Disabled="@(string.IsNullOrEmpty(selectedFund) || IsAddNewFundSelected)"
                Style="width: fit-content;" />
        </div>
        </RadzenCard>
  </RadzenStack>

<ConfirmDialog 
    Show="@showDeleteConfirmation"
    Title="@Localizer["DeleteUser"]"
    Message="@Localizer["ConfirmDeleteUser", userToDelete]"
    OnConfirm="@ConfirmDelete"
    OnCancel="@(() => showDeleteConfirmation = false)" />

<ConfirmDialog 
    Show="@showDeleteFundConfirmation"
    Title="@Localizer["DeleteFund"]"
    Message="@Localizer["ConfirmDeleteFund", fundToDelete]"
    OnConfirm="@ConfirmDeleteFund"
    OnCancel="@(() => showDeleteFundConfirmation = false)" />

<!-- Radzen hosts inside the Admin interactive island -->
<RadzenDialog />
<RadzenNotification />
<RadzenContextMenu />
<RadzenTooltip />

@code {
    // Upload complete handlers
    private async Task OnDonationUploadComplete(UploadCompleteEventArgs args)
    {
        try
        {
            if (args?.RawResponse is string raw && !string.IsNullOrWhiteSpace(raw))
            {
                var res = JsonSerializer.Deserialize<cya2.Services.Imports.ImportResult>(raw, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (res is not null)
                {
                    currentProgressId = res.ProgressId;
                    donationImportResult = new ImportResultTemp { TotalRows = res.TotalRows, InsertedRows = res.InsertedRows, FailedRows = res.FailedRows };
                    uploadProgressPercent = 100;
                    await DialogService.Alert($"Donations import complete. Read: {res.TotalRows}, Inserted: {res.InsertedRows}, Failed: {res.FailedRows}");
                    progressPollTimer?.Dispose();
                    isProgressDialogOpen = false;
                    return;
                }
            }
            await DialogService.Alert("Donations upload finished");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "OnDonationUploadComplete parse failed");
            await DialogService.Alert($"Donation upload failed: {ex.Message}", "Error");
        }
    }

    private async Task OnAccountingUploadComplete(UploadCompleteEventArgs args)
    {
        try
        {
            if (args?.RawResponse is string raw && !string.IsNullOrWhiteSpace(raw))
            {
                var res = JsonSerializer.Deserialize<cya2.Services.Imports.ImportResult>(raw, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (res is not null)
                {
                    currentProgressId = res.ProgressId;
                    accountingImportResult = new ImportResultTemp { TotalRows = res.TotalRows, InsertedRows = res.InsertedRows, FailedRows = res.FailedRows };
                    uploadProgressPercent = 100;
                    await DialogService.Alert($"Accounting import complete. Read: {res.TotalRows}, Inserted: {res.InsertedRows}, Failed: {res.FailedRows}");
                    progressPollTimer?.Dispose();
                    isProgressDialogOpen = false;
                    return;
                }
            }
            await DialogService.Alert("Accounting upload finished");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "OnAccountingUploadComplete parse failed");
            await DialogService.Alert($"Accounting upload failed: {ex.Message}", "Error");
        }
    }

    // temp type for deserialization to avoid internal visibility issues
    private class ImportResultTemp
    {
        public int TotalRows { get; set; }
        public int InsertedRows { get; set; }
        public int FailedRows { get; set; }
    }

    private ImportResultTemp? donationImportResult;
    private ImportResultTemp? accountingImportResult;
    private int uploadProgressPercent = 0;
    private bool showDonationStatus = false;
    private bool showAccountingStatus = false;
    private string? currentProgressId;
    private System.Threading.Timer? progressPollTimer;
    private bool isProgressDialogOpen = false;

    private void OnUploadProgress(UploadProgressArgs args)
    {
        if (args == null)
        {
            uploadProgressPercent = 0;
            return;
        }

        try
        {
            var loaded = args.Loaded;
            var total = args.Total;
            if (total > 0)
            {
                uploadProgressPercent = (int)((loaded * 100L) / total);
            }
            else
            {
                uploadProgressPercent = 0;
            }
        }
        catch
        {
            uploadProgressPercent = 0;
        }
        StateHasChanged();
    }

    private async Task OnUploadStarted()
    {
        // When upload starts, automatically open the progress dialog and poll
        if (!isProgressDialogOpen)
        {
            showDonationStatus = true;
            showAccountingStatus = true;
            isProgressDialogOpen = true;
            // start polling - UI will set currentProgressId when response returns
            StartProgressPolling();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void StartProgressPolling()
    {
        // Poll every 2 seconds
        progressPollTimer?.Dispose();
        progressPollTimer = new System.Threading.Timer(async _ => await PollProgress(), null, 2000, 2000);
    }

    private async Task PollProgress()
    {
        try
        {
            if (string.IsNullOrEmpty(currentProgressId)) return;
            // call endpoint to get progress
            var http = new System.Net.Http.HttpClient();
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var resp = await http.GetAsync($"{baseUrl}/api/import-progress/{currentProgressId}");
            if (!resp.IsSuccessStatusCode) return;
            var json = await resp.Content.ReadAsStringAsync();
            var prog = JsonSerializer.Deserialize<ImportResultTemp>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (prog != null)
            {
                donationImportResult = prog;
                accountingImportResult = prog;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            _logger.LogDebug(ex, "PollProgress failed");
        }
    }

    private string AddNewLabel => Localizer["AddNewUser"];
    private string AddNewFundLabel => Localizer["AddNewFund"];
    private string SelectAccountLabel => Localizer["SelectAccount"];
    private bool IsAddNewSelected => string.Equals(staffMember, AddNewLabel, StringComparison.Ordinal);
    private bool IsAddNewFundSelected => string.Equals(selectedFund, AddNewFundLabel, StringComparison.Ordinal);

    // ElementReference for tooltip icons
    private ElementReference accountNumberIcon;
    private ElementReference fundIcon;
    private ElementReference classIcon;

    private string? staffMember;
    private List<UserData> staff = new List<UserData>();
    private IEnumerable<UserData> staffWithAddOption => staff.Concat(new[] { new UserData(0, string.Empty, AddNewLabel, string.Empty, string.Empty, string.Empty, new List<Account>(), string.Empty) });

    private string selectedStaffEmail = string.Empty;
    private string selectedStaffAuthLevel = string.Empty;
    private string newAuthLevel = string.Empty;
    private List<string> authLevels = new List<string> { "User", "Viewer", "Admin" };

    private string selectedStaff = string.Empty;
    public string newName = string.Empty;
    public string newEmail = string.Empty;

    private string staffUpdateError = string.Empty;
    private string staffUpdateSuccess = string.Empty;

    // Account management properties
    private string accountLinkError = string.Empty;
    private string accountLinkSuccess = string.Empty;
    private int accountToAddId = 0; // selected AccountId
    private List<Account> allAccounts = new List<Account>();
    private List<Account> accountsOptions = new List<Account>(); // unified data source for all account dropdowns
    private List<SharedAccountBool> sharedAccountsBool = new List<SharedAccountBool>();
