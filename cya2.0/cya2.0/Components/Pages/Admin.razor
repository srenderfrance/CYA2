@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using UserAuth
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@attribute [Authorize(Roles = "Admin")]
@inject UserRepository UserRepository
@inject IDataAccess _data
@inject IConfiguration _config
@using ModelsLibrary
@using System.ComponentModel.DataAnnotations
@using DataLibrary
@rendermode InteractiveServer

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H3">Admin Panel</RadzenText>
    
    <!-- Staff Members Selection -->
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenDropDown TValue="string"
                            Data="@staff"
                            TextProperty="Name"
                            ValueProperty="Name"
                            @bind-Value="staffMember"
                            Change="@(args => staffSelection(args?.ToString()))"
                            Placeholder="Select Staff Member"
                            Style="width: 300px;" />
                            
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                <RadzenFormField Text="Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@newName" />
                </RadzenFormField>
                
                <RadzenFormField Text="Email" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@newEmail" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
    
    <!-- Accounts Section -->
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H5">Accounts</RadzenText>
        
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
            @foreach (var sharedAccount in sharedAccountsBool)
            {
                <div class="rz-p-1">
                    <RadzenCheckBox @bind-Value="sharedAccount.IsSelected" 
                                   TValue="bool" 
                                   Name="@($"account-{sharedAccount.Account.AccountId}")" />
                    <RadzenLabel Text="@sharedAccount.Account.Name" 
                               Component="@($"account-{sharedAccount.Account.AccountId}")" 
                               Style="margin-left: 8px;" />
                </div>
            }
        </RadzenStack>
        
        <RadzenDropDown TValue="string"
                        Data="@allAccounts"
                        TextProperty="Name"
                        ValueProperty="Name"
                        @bind-Value="accountToAdd"
                        Change="@(args => accountSeletion(args?.ToString()))"
                        Placeholder="All Accounts"
                        Style="width: 300px; margin-top: 16px;" />
    </RadzenCard>
    
    <!-- Create New User Form -->
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H5">Create New User</RadzenText>
        
        <RadzenTemplateForm TItem="UserFormModel" Data="@formModel" Submit="@HandleValidSubmit">
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenFormField Text="Email" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@formModel.Email" Name="Email" />
                    <RadzenRequiredValidator Component="Email" Text="Email is required" />
                    <RadzenEmailValidator Component="Email" Text="Please enter a valid email" />
                </RadzenFormField>
                
                <RadzenFormField Text="Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@formModel.Name" Name="Name" />
                    <RadzenRequiredValidator Component="Name" Text="Name is required" />
                    <RadzenLengthValidator Component="Name" Min="2" Max="100" Text="Name must be between 2 and 100 characters" />
                </RadzenFormField>
                
                <RadzenButton Text="Register New User" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
    
    <!-- Funds Section -->
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
            <RadzenButton Text="Get Distinct Funds" Click="@GetDistinctFunds" ButtonStyle="ButtonStyle.Secondary" />
            <RadzenButton Text="Create Accounts from Funds" Click="@CreateAccountsFromFunds" 
                         ButtonStyle="ButtonStyle.Primary" 
                         Disabled="@(funds == null || !funds.Any())" />
        </RadzenStack>
        
        @if (successMessage != null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @successMessage
            </RadzenAlert>
        }
        
        @if (errorMessage != null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="rz-mt-3">
                @errorMessage
            </RadzenAlert>
        }
        
        @if (funds != null && funds.Any())
        {
            <RadzenStack Class="rz-mt-4" Orientation="Orientation.Vertical">
                <RadzenText TextStyle="TextStyle.H6">Distinct Funds (@funds.Count)</RadzenText>
                <RadzenList>
                    @foreach (var fund in funds)
                    {
                        <RadzenListItem>@fund</RadzenListItem>
                    }
                </RadzenList>
            </RadzenStack>
        }
        
        @if (createdAccounts != null && createdAccounts.Any())
        {
            <RadzenStack Class="rz-mt-4" Orientation="Orientation.Vertical">
                <RadzenText TextStyle="TextStyle.H6">Created Accounts (@createdAccounts.Count)</RadzenText>
                <RadzenDataGrid Data="@createdAccounts" TItem="(string name, string accountRef, bool success, string errorMessage)">
                    <Columns>
                        <RadzenDataGridColumn TItem="(string name, string accountRef, bool success, string errorMessage)" 
                                             Property="name" Title="Name" />
                        <RadzenDataGridColumn TItem="(string name, string accountRef, bool success, string errorMessage)" 
                                             Property="accountRef" Title="Account Reference" />
                        <RadzenDataGridColumn TItem="(string name, string accountRef, bool success, string errorMessage)" 
                                             Property="success" Title="Result">
                            <Template Context="data">
                                @if (data.success)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Created" />
                                }
                                else
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@data.errorMessage" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        }
    </RadzenCard>
</RadzenStack>

@code {
    private string? staffMember;
    private List<UserData> staff = new List<UserData>();

    public string selectedStaff;
    public string newName = string.Empty;
    public string newEmail = string.Empty;

    public async Task staffSelection(string accountName)
    {
        if (string.IsNullOrEmpty(accountName)) return;
        Console.WriteLine($"TESTING: {selectedStaff}");
    }
    
    private string? accountToAdd;
    private List<Account> allAccounts = new List<Account>();
    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadAllAccounts();
    }

    private async Task LoadAllAccounts()
    {
        try
        {
            string sql = "SELECT AccountId, Name, AccountRef, CreatedAt FROM Accounts ORDER BY Name";
            allAccounts = await _data.LoadData<Account, dynamic>(
                sql,
                new { },
                _config.GetConnectionString("default")
            );

            if (allAccounts == null)
                allAccounts = new List<Account>();

            // Initialize empty list for shared accounts selection
            sharedAccountsBool = new List<SharedAccountBool>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading accounts: {ex.Message}";
            allAccounts = new List<Account>();
        }
    }

    public async Task accountSeletion(string account)
    {
        if (string.IsNullOrEmpty(account)) return;
        Console.WriteLine($"TESTING: {accountToAdd}");
    }
    
    private List<Account>sharedAccounts = new List<Account>();
    private List<SharedAccountBool>sharedAccountsBool = new List<SharedAccountBool>();
    
    public async Task sharedAccountSeletion(string account)
    {
        Console.WriteLine($"TESTING: {sharedAccounts}");
    }

    private class SharedAccountBool    {
        public Account Account { get; set; }
        public bool IsSelected { get; set; }

        public SharedAccountBool(Account account, bool isSelected = false)
        {
            Account = account;
            IsSelected = isSelected;
        }
    }
    
    [SupplyParameterFromForm]
    private UserFormModel formModel { get; set; } = new UserFormModel();

    private string? successMessage;
    private string? errorMessage;
    private List<string>? funds;
    private List<(string name, string accountRef, bool success, string errorMessage)> createdAccounts = new();

    private async Task HandleValidSubmit()
    {
        try
        {
            await UserRepository.CreateUserAsync(formModel.Email, formModel.Name);
            successMessage = $"New user {formModel.Name} registered successfully with email {formModel.Email}";
            errorMessage = null;
            formModel = new UserFormModel();
        }
        catch (Exception ex)
        {
            successMessage = null;
            errorMessage = $"Error: {ex.Message}";
        }
    }

    public class UserFormModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Name is required")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Name must be between 2 and 100 characters")]
        public string Name { get; set; } = string.Empty;
    }

    public async Task GetDistinctFunds()
    {
        try
        {
            successMessage = null;
            errorMessage = null;

            string sql = "SELECT DISTINCT fund FROM etapestry ORDER BY fund";
            funds = await _data.LoadData<string, dynamic>(sql, new { }, _config.GetConnectionString("default"));

            if (funds != null && funds.Any())
            {
                successMessage = $"Found {funds.Count} distinct funds.";
            }
            else
            {
                errorMessage = "No funds found in the database.";
                funds = new List<string>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error retrieving funds: {ex.Message}";
            funds = new List<string>();
        }
    }

    public async Task CreateAccountsFromFunds()
    {
        try
        {
            if (funds == null || !funds.Any())
            {
                errorMessage = "No funds available to create accounts from.";
                return;
            }

            successMessage = null;
            errorMessage = null;
            createdAccounts.Clear();
            int successCount = 0;
            int failCount = 0;

            foreach (var fund in funds)
            {
                string name;
                string accountRef = fund;

                // Process the fund string
                if (fund.Contains(':'))
                {
                    int colonIndex = fund.IndexOf(':');
                    name = fund.Substring(0, colonIndex);
                }
                else
                {
                    name = fund;
                }

                try
                {
                    // Check if the account already exists
                    string checkSql = "SELECT COUNT(*) FROM Accounts WHERE AccountRef = @AccountRef";
                    var accountExists = await _data.LoadData<int, dynamic>(
                        checkSql,
                        new { AccountRef = accountRef },
                        _config.GetConnectionString("default"));

                    if (accountExists != null && accountExists.FirstOrDefault() > 0)
                    {
                        createdAccounts.Add((name, accountRef, false, "Account already exists"));
                        failCount++;
                        continue;
                    }

                    // Insert the account
                    string insertSql = @"
                        INSERT INTO Accounts (Name, AccountRef, CreatedAt)
                        VALUES (@Name, @AccountRef, @DateCreated)";

                    int result = await _data.SaveData(
                        insertSql,
                        new
                        {
                            Name = name,
                            AccountRef = accountRef,
                            DateCreated = DateTime.Now
                        },
                        _config.GetConnectionString("default")
                    );

                    if (result > 0)
                    {
                        createdAccounts.Add((name, accountRef, true, string.Empty));
                        successCount++;
                    }
                    else
                    {
                        createdAccounts.Add((name, accountRef, false, "Insert failed"));
                        failCount++;
                    }
                }
                catch (Exception ex)
                {
                    createdAccounts.Add((name, accountRef, false, ex.Message));
                    failCount++;
                }
            }

            if (successCount > 0)
            {
                successMessage = $"Successfully created {successCount} account(s).";
                if (failCount > 0)
                {
                    successMessage += $" Failed to create {failCount} account(s).";
                }
            }
            else if (failCount > 0)
            {
                errorMessage = $"Failed to create {failCount} account(s). No accounts were created.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating accounts: {ex.Message}";
        }
    }
}