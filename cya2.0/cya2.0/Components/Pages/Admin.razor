        if (string.IsNullOrWhiteSpace(newFundName))
        {
            fundUpdateError = "Fund name is required";
            return;
        }
        if (newFundName.Length < 2 || newFundName.Length > 100)
        {
            fundUpdateError = "Fund name must be between 2 and 100 characters";
            return;
        }
        if (string.IsNullOrWhiteSpace(accountNumber))
        {
            fundUpdateError = "Account number is required";
            return;
        }
        if (string.IsNullOrWhiteSpace(fundClass))
        {
            fundUpdateError = "Account reference (Class) is required";
            return;
        }

        try
        {
            // Trim and sanitize inputs
            var trimmedFundName = newFundName.Trim();
            var trimmedAccountNumber = accountNumber.Trim();
            var trimmedFundClass = fundClass.Trim();
            var trimmedSoftCredit = softCredit?.Trim() ?? string.Empty;
            
            var accountingClass = trimmedFundClass;

            // Set default values (Balance will be 0 by default)
            var adjustment = balanceAdjustment ?? 0.00m;

            // Check if fund with same name already exists
            var existingFund = allFunds.FirstOrDefault(f => 
                string.Equals(f.Fund, trimmedFundName, StringComparison.OrdinalIgnoreCase));
            if (existingFund != null)
            {
                fundUpdateError = $"A fund with the name '{trimmedFundName}' already exists";
                return;
            }

            // Check if account number already exists
            var existingAccountNumber = allFunds.FirstOrDefault(f => 
                string.Equals(f.AccountNumber, trimmedAccountNumber, StringComparison.OrdinalIgnoreCase));
            if (existingAccountNumber != null)
            {
                fundUpdateError = $"A fund with the number '{trimmedAccountNumber}' already exists";
                return;
            }

            // Insert new account record with required fields (Balance will default to 0)
            string sql = @"
                INSERT INTO Accounts (Fund, AccountingClass, AccountNumber, SoftCredit, BalanceAdjustment, OtherFunds, CreatedAt)
                VALUES (@Fund, @AccountingClass, @AccountNumber, @SoftCredit, @BalanceAdjustment, @OtherFunds, @CreatedAt)";

            int result = await _data.SaveData(
                sql,
                new { 
                    Fund = trimmedFundName,
                    AccountingClass = accountingClass,
                    AccountNumber = trimmedAccountNumber,
                    SoftCredit = trimmedSoftCredit,
                    BalanceAdjustment = adjustment,
                    OtherFunds = otherFunds,
                    CreatedAt = DateTime.UtcNow
                },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (result > 0)
            {
                fundUpdateSuccess = $"New fund '{trimmedFundName}' added successfully";

                // Clear inputs
                ClearFundInputFields();

                // Refresh fund list
                await LoadAllAccounts();
                allFunds = allAccounts;

                // Refresh accounts options for fund access dropdowns
                RefreshAccountsOptions();

                // Reset selection to "Add New Fund"
                selectedFund = AddNewFundLabel;
                await fundSelection(selectedFund);
            }
            else
            {
                fundUpdateError = "Failed to add new fund";
            }
        }
        catch (Exception ex)
        {
            fundUpdateError = $"Error adding new fund: {ex.Message}";
            _logger.LogError(ex, "Error adding new fund: {FundName}", newFundName);
        }
    }

    private void ClearFundInputFields()
    {
        newFundName = string.Empty;
        accountNumber = string.Empty;
        overhead = string.Empty;
        fundClass = string.Empty;
        softCredit = string.Empty;
        newAccountingClass = string.Empty;
        balanceAdjustment = 0.00m;
        otherFunds = false;
    }

    public Task fundSelection(string displayText)
    {
        if (string.IsNullOrEmpty(displayText)) return Task.CompletedTask;

        selectedFund = displayText;

        // Clear previous messages
        fundUpdateError = string.Empty;
        fundUpdateSuccess = string.Empty;

        if (string.Equals(displayText, AddNewFundLabel, StringComparison.Ordinal))
        {
            // Clear the selected account when adding new
            selectedFundAccount = null;
            selectedAccountId = null;
            // Clear input fields for new fund entry
            ClearFundInputFields();
            return Task.CompletedTask;
        }

        // Find the FundDisplayItem by matching the display text
        var selectedItem = fundsWithAddOption.FirstOrDefault(f => f.DisplayText == displayText);
        if (selectedItem != null)
        {
            selectedFundAccount = selectedItem.Account;
            selectedAccountId = selectedItem.Account.AccountId;
            
            // Populate form fields with existing account data
            newFundName = selectedItem.Account.Fund;
            accountNumber = selectedItem.Account.AccountNumber;
            softCredit = selectedItem.Account.SoftCredit;
            balanceAdjustment = selectedItem.Account.BalanceAdjustment;
            otherFunds = selectedItem.Account.OtherFunds;
            
            // Populate fundClass from AccountingClass
            fundClass = selectedItem.Account.AccountingClass ?? string.Empty;
        }
        else
        {
            selectedFundAccount = null;
            selectedAccountId = null;
            ClearFundInputFields();
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task LoadAllAccounts()
    {
        try
        {
            string sql = @"SELECT AccountId, Fund, AccountingClass, AccountNumber, CreatedAt, Balance, 
                          SoftCredit, BalanceAdjustment, OtherFunds 
                          FROM Accounts ORDER BY Fund";
            allAccounts = await _data.LoadData<Account, dynamic>(
                sql,
                new { },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (allAccounts == null)
                allAccounts = new List<Account>();

            // Initialize empty list for shared accounts selection
            sharedAccountsBool = new List<SharedAccountBool>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading accounts: {ex.Message}";
            allAccounts = new List<Account>();
            _logger.LogError(ex, "Error loading accounts from database");
        }
    }

    private async Task LoadAllStaff()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                string sql = "SELECT Id, Email, Name, Language, AuthLevel, DefaultAccount FROM Users ORDER BY Name";
                var users = await _data.LoadData<User, dynamic>(
                    sql,
                    new { },
                    _config.GetConnectionString("default") ?? string.Empty
                );

                if (users != null)
                {
                    staff = users.Select(u => new UserData(
                        u.Id,                      
                        u.Email ?? string.Empty,
                        u.Name ?? string.Empty,
                        u.Language ?? string.Empty,
                        u.AuthLevel ?? string.Empty,
                        u.DefaultAccount.HasValue ? u.DefaultAccount.Value.ToString() : string.Empty,
                        new List<Account>(),        
                        string.Empty                
                    )).ToList();
                }
                else
                {
                    staff = new List<UserData>();
                }
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
            staff = new List<UserData>();
        }
    }

    private string GetDisplayTextFromAccountingClass(string AccountingClass)
    {
        if (string.IsNullOrEmpty(AccountingClass))
            return string.Empty;
            
        var colonIndex = AccountingClass.IndexOf(':');
        if (colonIndex >= 0 && colonIndex < AccountingClass.Length - 1)
        {
            return AccountingClass.Substring(colonIndex + 1).Trim();
        }

        return AccountingClass; // Return the whole string if no colon found
    }

    private async Task DeleteFund()
    {
        try
        {
            // Find the FundDisplayItem by matching the display text
            var fundDisplayItem = fundsWithAddOption.FirstOrDefault(f => f.DisplayText == selectedFund);
            if (fundDisplayItem == null || fundDisplayItem.Account.AccountId == 0)
            {
                fundUpdateError = "Selected fund not found";
                StateHasChanged();
                return;
            }

            var fundToDeleteObj = fundDisplayItem.Account;

            _logger.LogInformation("DeleteFund called for fund: {Fund}", fundToDeleteObj.Fund);

            // Use the basic Confirm method without custom options
            var result = await DialogService.Confirm(
                "Are you sure you want to delete this Fund?", 
                "Delete Confirmation");

            if (result != true)
            {
                _logger.LogInformation("User cancelled deletion");
                return;
            }

            // Delete account associations first
            _logger.LogInformation("Deleting account associations for fund {AccountId}", fundToDeleteObj.AccountId);
            string deleteAccountsSql = "DELETE FROM AccountsUsers WHERE AccountId = @AccountId";
            await _data.SaveData(
                deleteAccountsSql,
                new { AccountId = fundToDeleteObj.AccountId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            // Then delete the fund
            string deleteFundSql = "DELETE FROM Accounts WHERE AccountId = @AccountId";
            int deleteResult = await _data.SaveData(
                deleteFundSql,
                new { AccountId = fundToDeleteObj.AccountId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (deleteResult > 0)
            {
                fundUpdateSuccess = "Fund deleted successfully";

                // Clear selections
                selectedFund = string.Empty;
                selectedFundAccount = null;
                selectedAccountId = null;
                ClearFundInputFields();

                // Refresh funds list
                await LoadAllAccounts();
                allFunds = allAccounts;

                // Refresh accounts options for fund access dropdowns
                RefreshAccountsOptions();
            }
            else
            {
                fundUpdateError = "Failed to delete fund";
            }
        }
        catch (Exception ex)
        {
            fundUpdateError = $"Error deleting fund: {ex.Message}";
        }
    }

    private async Task ConfirmDeleteFund()
    {
        try
        {
            showDeleteFundConfirmation = false;
            
            // Find the FundDisplayItem by matching the display text
            var fundDisplayItem = fundsWithAddOption.FirstOrDefault(f => f.DisplayText == this.fundToDelete);
            if (fundDisplayItem == null || fundDisplayItem.Account.AccountId == 0)
            {
                fundUpdateError = "Selected fund not found";
                return;
            }

            var selectedFundToDelete = fundDisplayItem.Account;

            // Delete account associations first
            _logger.LogInformation("Deleting account associations for fund {AccountId}", selectedFundToDelete.AccountId);
            string deleteAccountsSql = "DELETE FROM AccountsUsers WHERE AccountId = @AccountId";
            await _data.SaveData(
                deleteAccountsSql,
                new { AccountId = selectedFundToDelete.AccountId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            // Then delete the fund
            string deleteFundSql = "DELETE FROM Accounts WHERE AccountId = @AccountId";
            int deleteResult = await _data.SaveData(
                deleteFundSql,
                new { AccountId = selectedFundToDelete.AccountId },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (deleteResult > 0)
            {
                _logger.LogInformation("Successfully deleted fund");
                fundUpdateSuccess = "Fund deleted successfully";

                // Clear selections
                selectedFund = string.Empty;
                selectedFundAccount = null;
                selectedAccountId = null;
                ClearFundInputFields();

                // Refresh funds list
                await LoadAllAccounts();
                allFunds = allAccounts;

                // Refresh accounts options for fund access dropdowns
                RefreshAccountsOptions();
            }
            else
            {
                fundUpdateError = "Failed to delete fund";
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error in ConfirmDeleteFund");
            fundUpdateError = $"Error: {ex.Message}";
            StateHasChanged();
        }
    }

