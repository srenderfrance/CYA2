    private async Task UpdateFund()
    {
        // Clear previous messages
        fundUpdateError = string.Empty;
        fundUpdateSuccess = string.Empty;

        if (IsAddNewFundSelected)
        {
            fundUpdateError = "Please use 'Add New Fund' to add a fund";
            return;
        }

        if (string.IsNullOrEmpty(selectedFund))
        {
            fundUpdateError = "Please select a fund to update";
            return;
        }

        try
        {
            var accountToUpdate = allFunds.FirstOrDefault(a => a.AccountId == selectedAccountId);
            if (accountToUpdate == null)
            {
                fundUpdateError = "Selected fund not found";
                return;
            }

            // Build update parts based on what the user entered
            bool hasChanges = false;
            string sql = "UPDATE Accounts SET ";
            var parameters = new Dictionary<string, object>();

            // Add the ID for WHERE clause
            parameters.Add("AccountId", accountToUpdate.AccountId);

            // Check if fund name should be updated
            if (!string.IsNullOrWhiteSpace(newFundName) && newFundName.Trim() != accountToUpdate.Fund)
            {
                sql += "Fund = @Fund, ";
                parameters.Add("Fund", newFundName.Trim());
                hasChanges = true;
            }

            // Check if account number should be updated
            if (!string.IsNullOrWhiteSpace(accountNumber) && accountNumber.Trim() != accountToUpdate.AccountNumber)
            {
                sql += "AccountNumber = @AccountNumber, ";
                parameters.Add("AccountNumber", accountNumber.Trim());
                hasChanges = true;
            }

            // Check if class should be updated (this updates AccountingClass)
            if (!string.IsNullOrWhiteSpace(fundClass))
            {
                var newAccountingClass = fundClass.Trim();
                if (newAccountingClass != accountToUpdate.AccountingClass)
                {
                    sql += "AccountingClass = @AccountingClass, ";
                    parameters.Add("AccountingClass", newAccountingClass);
                    hasChanges = true;
                }
            }

            // Check if soft credit should be updated
            if (!string.IsNullOrWhiteSpace(softCredit) && softCredit.Trim() != accountToUpdate.SoftCredit)
            {
                sql += "SoftCredit = @SoftCredit, ";
                parameters.Add("SoftCredit", softCredit.Trim());
                hasChanges = true;
            }

            // Check if balance adjustment should be updated
            if (balanceAdjustment.HasValue && balanceAdjustment != accountToUpdate.BalanceAdjustment)
            {
                sql += "BalanceAdjustment = @BalanceAdjustment, ";
                parameters.Add("BalanceAdjustment", balanceAdjustment.Value);
                hasChanges = true;
            }

            // If nothing to update, show message
            if (!hasChanges)
            {
                fundUpdateError = "No changes provided for update";
                return;
            }

            // Remove trailing comma and space
            sql = sql.TrimEnd(',', ' ');

            // Add WHERE clause
            sql += " WHERE AccountId = @AccountId";

            // Execute update
            int result = await _data.SaveData(
                sql,
                parameters,
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (result > 0)
            {
                fundUpdateSuccess = "Fund updated successfully";

                // Clear input fields
                ClearFundInputFields();

                // Refresh fund list
                await LoadAllAccounts();
                allFunds = allAccounts;

                // Refresh accounts options for fund access dropdowns
                RefreshAccountsOptions();

                // Reset selection
                selectedFund = string.Empty;
                selectedFundAccount = null;
                selectedAccountId = null;

                StateHasChanged(); // Force re-render to update fund dropdown options
            }
            else
            {
                fundUpdateError = "Failed to update fund";
            }
        }
        catch (Exception ex)
        {
            fundUpdateError = $"Error updating fund: {ex.Message}";
            _logger.LogError(ex, "Error updating fund: {SelectedFund}", selectedFund);
        }
    }

