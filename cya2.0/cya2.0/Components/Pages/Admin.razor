    private async Task AddNewStaffMember()
    {
        // Clear previous messages
        staffUpdateError = string.Empty;
        staffUpdateSuccess = string.Empty;

        if (!IsAddNewSelected)
        {
            staffUpdateError = "Please select 'Add new User' to add a user";
            return;
        }

        if (string.IsNullOrWhiteSpace(newName))
        {
            staffUpdateError = "Name is required";
            return;
        }
        if (newName.Length < 2 || newName.Length > 100)
        {
            staffUpdateError = "Name must be between 2 and 100 characters";
            return;
        }
        if (string.IsNullOrWhiteSpace(newEmail))
        {
            staffUpdateError = "Email is required";
            return;
        }
        try
        {
            // Basic email format check
            var addr = new System.Net.Mail.MailAddress(newEmail);
            if (addr.Address != newEmail)
            {
                staffUpdateError = "Please enter a valid email address";
                return;
            }
        }
        catch
        {
            staffUpdateError = "Please enter a valid email address";
            return;
        }

        try
        {
            await UserRepository.CreateUserAsync(newEmail, newName);

            // Fetch the new user's Id
            var userId = await _data.LoadData<int, dynamic>(
                "SELECT Id FROM Users WHERE Email = @Email",
                new { Email = newEmail },
                _config.GetConnectionString("default") ?? string.Empty
            );
            int newUserId = (userId != null) ? userId.FirstOrDefault() : 0;
            
            // Set AuthLevel (default to User if none chosen)
            var levelToSet = string.IsNullOrWhiteSpace(newAuthLevel) ? "User" : newAuthLevel;
            if (newUserId > 0)
            {
                await _data.SaveData(
                    "UPDATE Users SET AuthLevel = @AuthLevel WHERE Id = @UserId",
                    new { AuthLevel = levelToSet, UserId = newUserId },
                    _config.GetConnectionString("default") ?? string.Empty
                );
            }

            // Assign selected accounts
            if (accountsToAssign != null && accountsToAssign.Any() && newUserId > 0)
            {
                foreach (var accId in accountsToAssign)
                {
                    if (accId == 0) continue; // skip default option
                    await _data.SaveData(
                        "INSERT INTO AccountsUsers (UserId, AccountId) VALUES (@UserId, @AccountId)",
                        new { UserId = newUserId, AccountId = accId },
                        _config.GetConnectionString("default") ?? string.Empty
                    );
                }

                // If only one account assigned (excluding default), set as default
                var assignedRealAccounts = accountsToAssign.Where(id => id != 0).ToList();
                if (assignedRealAccounts.Count == 1)
                {
                    await _data.SaveData(
                        "UPDATE Users SET DefaultAccount = @AccountId WHERE Id = @UserId",
                        new { AccountId = assignedRealAccounts.First(), UserId = newUserId },
                        _config.GetConnectionString("default") ?? string.Empty
                    );
                }
            }

            staffUpdateSuccess = $"New user {newName} registered successfully with email {newEmail}";

            // Clear inputs
            newName = string.Empty;
            newEmail = string.Empty;
            newAuthLevel = string.Empty;
            accountsToAssign = Array.Empty<int>();

            // Refresh staff list and reset selection
            await LoadAllStaff();
            staffMember = AddNewLabel;
            selectedStaff = string.Empty;
            selectedStaffEmail = string.Empty;
            selectedStaffAuthLevel = string.Empty;
        }
        catch (Exception ex)
        {
            staffUpdateError = $"Error: {ex.Message}";
        }
    }

    private async Task UpdateStaffMember()
    {
        // Clear previous messages
        staffUpdateError = string.Empty;
        staffUpdateSuccess = string.Empty;

        Console.WriteLine("UpdateStaffMember called");

        if (IsAddNewSelected)
        {
            staffUpdateError = "Please use 'Add New User' to add a user";
            return;
        }

        if (string.IsNullOrEmpty(staffMember))
        {
            staffUpdateError = "Please select a user to update";
            return;
        }

        try
        {
            var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
            if (selectedUser == null)
            {
                staffUpdateError = "Selected user not found";
                return;
            }

            // Build update parts based on what the user entered
            bool hasChanges = false;
            string sql = "UPDATE Users SET ";
            var parameters = new Dictionary<string, object>();

            // Add the ID for WHERE clause
            parameters.Add("Id", selectedUser.Id);

            // Check if name should be updated
            if (!string.IsNullOrWhiteSpace(newName))
            {
                sql += "Name = @Name, ";
                parameters.Add("Name", newName);
                hasChanges = true;
            }

            // Check if email should be updated
            if (!string.IsNullOrWhiteSpace(newEmail))
            {
                sql += "Email = @Email, ";
                parameters.Add("Email", newEmail);
                hasChanges = true;
            }

            // Check if auth level should be updated
            if (!string.IsNullOrWhiteSpace(newAuthLevel))
            {
                sql += "AuthLevel = @AuthLevel, ";
                parameters.Add("AuthLevel", newAuthLevel);
                hasChanges = true;
            }

            // If nothing to update, show message
            if (!hasChanges)
            {
                staffUpdateError = "No changes provided for update";
                return;
            }

            // Remove trailing comma and space
            sql = sql.TrimEnd(',', ' ');

            // Add WHERE clause
            sql += " WHERE Id = @Id";

            // Execute update
            Console.WriteLine($"Executing SQL: {sql}");
            Console.WriteLine($"Parameters: {string.Join(", ", parameters.Select(p => $"{p.Key}={p.Value}"))}");

            int result = await _data.SaveData(
                sql,
                parameters,
                _config.GetConnectionString("default") ?? string.Empty
            );

            Console.WriteLine($"Update result: {result}");
            if (result > 0)
            {
                staffUpdateSuccess = "User updated successfully";

                // Clear input fields
                newName = string.Empty;
                newEmail = string.Empty;
                newAuthLevel = string.Empty;

                // Refresh staff list
                await LoadAllStaff();

                // Update the current selection to show updated info
                await staffSelection(staffMember);
            }
            else
            {
                staffUpdateError = "Failed to update user";
            }
        }
        catch (Exception ex)
        {
            staffUpdateError = $"Error updating user: {ex.Message}";
        }
    }

    private async Task DeleteStaffMember()
    {
        try
        {
            _logger.LogInformation("DeleteStaffMember called for user: {User}", staffMember);
            
            if (string.IsNullOrEmpty(staffMember) || IsAddNewSelected)
            {
                staffUpdateError = "Please select a user to delete";
                StateHasChanged();
                return;
            }

            // Use the basic Confirm method without custom options
            var result = await DialogService.Confirm(
                "Are you sure you want to delete this User?", 
                "Delete Confirmation");

            if (result != true)
            {
                _logger.LogInformation("User cancelled deletion");
                return;
            }

            var selectedUser = staff.FirstOrDefault(u => u.Name == staffMember);
            if (selectedUser == null)
            {
                staffUpdateError = "Selected user not found";
                StateHasChanged();
                return;
            }

            // Delete account associations first
            _logger.LogInformation("Deleting account associations for user {UserId}", selectedUser.Id);
            string deleteAccountsSql = "DELETE FROM AccountsUsers WHERE UserId = @UserId";
            await _data.SaveData(
                deleteAccountsSql,
                new { UserId = selectedUser.Id },
                _config.GetConnectionString("default") ?? string.Empty
            );

            // Then delete the user
            _logger.LogInformation("Deleting user {UserId}", selectedUser.Id);
            string deleteUserSql = "DELETE FROM Users WHERE Id = @Id";
            int deleteResult = await _data.SaveData(
                deleteUserSql,
                new { Id = selectedUser.Id },
                _config.GetConnectionString("default") ?? string.Empty
            );

            if (deleteResult > 0)
            {
                _logger.LogInformation("Successfully deleted user");
                staffUpdateSuccess = "User deleted successfully";

                // Clear selections
                staffMember = string.Empty;
                selectedStaff = string.Empty;
                selectedStaffEmail = string.Empty;
                selectedStaffAuthLevel = string.Empty;
                newName = string.Empty;
                newEmail = string.Empty;
                newAuthLevel = string.Empty;
                userAccounts.Clear();

                // Refresh staff list
                await LoadAllStaff();
            }
            else
            {
                _logger.LogWarning("Failed to delete user");
                staffUpdateError = "Failed to delete user";
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error in DeleteStaffMember");
            staffUpdateError = $"Error: {ex.Message}";
        }
    }

