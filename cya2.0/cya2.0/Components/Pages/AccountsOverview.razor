@page "/all-balances"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using ModelsLibrary
@using Radzen
@using Radzen.Blazor
@using UtilityClasses
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IStringLocalizer<Resource> Localizer
@inject IDataAccess _data
@inject IConfiguration _config
@inject IJSRuntime JS

<PageTitle>@Localizer["AllBalances"]</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.H5">@Localizer["AllBalances"]</RadzenText>
        <RadzenToggleButton TValue="bool"
                            Value="@showDonations12m"
                            Change="@(v => showDonations12m = v)"
                            OnIcon="switch_left"
                            OffIcon="switch_right"
                            Style="min-width: 280px;">
            <OnText>@Localizer["ShowLast12MonthsDonations"]</OnText>
            <OffText>@Localizer["ShowCurrentBalance"]</OffText>
        </RadzenToggleButton>
        <RadzenButton Text="@Localizer["CopyTable"]"
                      Icon="content_copy"
                      ButtonStyle="ButtonStyle.Secondary"
                      Click="CopyTableAsync" />
    </RadzenStack>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled">
            @errorMessage
        </RadzenAlert>
    }

    @if (isLoading)
    {
        <div class="mt-2">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p class="text-muted mt-1">@Localizer["Loading"]</p>
        </div>
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid TItem="FundBalanceRow"
                            Data="@fundBalances"
                            AllowSorting="true"
                            AllowFiltering="true"
                            AllowPaging="false"
                            EmptyText="@Localizer["NoBalancesFound"]">
                <Columns>
                    <RadzenDataGridColumn TItem="FundBalanceRow" Property="Fund" Title="@Localizer["Account"]" />
                    @if (!showDonations12m)
                    {
                        <RadzenDataGridColumn TItem="FundBalanceRow" Property="CurrentBalance" Title="@Localizer["Amount"]" FormatString="{0:C2}" TextAlign="TextAlign.Right" />
                    }
                    else
                    {
                        <RadzenDataGridColumn TItem="FundBalanceRow" Property="Last12MonthsDonations" Title="@Localizer["Last12MonthsDonations"]" FormatString="{0:C2}" TextAlign="TextAlign.Right" />
                    }
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
        <div class="text-muted mt-2" style="font-size:.85rem">
            @Localizer["LoadedAccounts"]: @fundBalances.Count
        </div>
    }
</RadzenStack>

@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private List<FundBalanceRow> fundBalances = new();
    private bool showDonations12m = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            const string accountsSql = "SELECT AccountId, Name, AccountRef, CreatedAt FROM Accounts ORDER BY Name";
            var accounts = await _data.LoadData<Account, dynamic>(
                accountsSql,
                new { },
                _config.GetConnectionString("default"));

            Console.WriteLine($"AllBalances: fetched {accounts?.Count ?? 0} accounts");

            if (accounts is null || accounts.Count == 0)
            {
                fundBalances.Clear();
                isLoading = false;
                return;
            }

            var rows = new List<FundBalanceRow>();
            var now = DateTime.Now;
            var last12Start = new DateTime(now.Year, now.Month, 1).AddMonths(-12); // start of month 12 months ago
            var last12End = now; // now

            foreach (var account in accounts)
            {
                var designation = ExtractDesignation(account.AccountRef);
                if (string.IsNullOrWhiteSpace(designation))
                {
                    Console.WriteLine($"AllBalances: skipped account '{account.Name}' due to empty designation (AccountRef='{account.AccountRef}')");
                    rows.Add(new FundBalanceRow { Fund = account.Name, CurrentBalance = 0m, Last12MonthsDonations = 0m });
                    continue;
                }

                // Accounting: compute current balance (existing logic)
                const string qbSqlLike = "SELECT * FROM quickbooks WHERE designation LIKE @Designation";
                var qbRows = await _data.LoadData<AccountingDataModel, dynamic>(
                    qbSqlLike,
                    new { Designation = $"%{designation}%" },
                    _config.GetConnectionString("default"));

                if (qbRows is null || qbRows.Count == 0)
                {
                    Console.WriteLine($"AllBalances: no QB rows for '{account.Name}' via LIKE '%{designation}%'. Trying exact AccountRef.");
                    const string qbSqlExact = "SELECT * FROM quickbooks WHERE designation = @Designation";
                    qbRows = await _data.LoadData<AccountingDataModel, dynamic>(
                        qbSqlExact,
                        new { Designation = account.AccountRef },
                        _config.GetConnectionString("default"));
                }

                var count = qbRows?.Count ?? 0;
                Console.WriteLine($"AllBalances: account '{account.Name}' designation '{designation}' -> QB rows: {count}");

                decimal currentBalance = 0m;
                if (qbRows is not null && qbRows.Count > 0)
                {
                    currentBalance = BalanceCalculator.CalculateNetBalanceFromAccounting(
                        qbRows,
                        cutoffDate: DateTime.MinValue,
                        asOfDate: DateTime.MaxValue);
                }

                // Donations: sum last 12 months using etapestry by fund (AccountRef)
                const string donationsSql = "SELECT * FROM etapestry WHERE fund = @Fund AND date >= @Start AND date <= @End";
                var donations = await _data.LoadData<DonationsDataModel, dynamic>(
                    donationsSql,
                    new { Fund = account.AccountRef, Start = last12Start, End = last12End },
                    _config.GetConnectionString("default"));

                decimal last12Total = donations?.Sum(d => Convert.ToDecimal(d.amount)) ?? 0m;

                rows.Add(new FundBalanceRow
                {
                    Fund = account.Name,
                    CurrentBalance = currentBalance,
                    Last12MonthsDonations = last12Total
                });
            }

            fundBalances = rows.OrderBy(r => r.Fund).ToList();
            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading balances: {ex.Message}";
            Console.WriteLine($"AllBalances: {errorMessage}");
            isLoading = false;
        }
    }

    private async Task CopyTableAsync()
    {
        try
        {
            // Build tab-separated values with header matching current view
            var header = showDonations12m ? "Account\tLast 12 Months Donations" : "Account\tCurrent Balance";
            var sb = new System.Text.StringBuilder();
            sb.AppendLine(header);
            foreach (var row in fundBalances)
            {
                var value = showDonations12m ? row.Last12MonthsDonations : row.CurrentBalance;
                sb.AppendLine($"{row.Fund}\t{value}");
            }
            var text = sb.ToString();
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error copying table: {ex.Message}";
        }
    }

    private static string ExtractDesignation(string accountRef)
    {
        if (string.IsNullOrWhiteSpace(accountRef)) return string.Empty;
        var idx = accountRef.IndexOf(':');
        return idx >= 0 ? accountRef[(idx + 1)..].Trim() : accountRef.Trim();
    }

    private sealed class FundBalanceRow
    {
        public string Fund { get; set; } = string.Empty;
        public decimal CurrentBalance { get; set; }
        public decimal Last12MonthsDonations { get; set; }
    }
}
