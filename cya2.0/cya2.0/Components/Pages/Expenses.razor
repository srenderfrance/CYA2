@page "/expenses"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.Extensions.Configuration
@using ModelsLibrary
@using DataLibrary
@using UtilityClassLibrary
@using Radzen
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject IDataAccess _data
@inject IConfiguration _config
@inject AppState AppState
@inject DataLoadingService DataLoader
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Localizer["ExpensesNav"]</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">

    <!-- Top two control sections (match Donations layout) -->
    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="2rem"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Start"
                 Style="width:100%;">

        <!-- Date range section (left) -->
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Style="flex:1;">
            <RadzenText TextStyle="TextStyle.Subtitle2">@Localizer["DateRange"]</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="0.75rem"
                         AlignItems="AlignItems.Center"
                         Wrap="FlexWrap.Wrap">
                <RadzenLabel Text="@Localizer["StartDate"]" />
                <RadzenDatePicker @bind-Value="@startDate" DateFormat="MM/dd/yyyy" Style="max-width:130px" />

                <RadzenLabel Text="@Localizer["EndDate"]" />
                <RadzenDatePicker @bind-Value="@endDate" DateFormat="MM/dd/yyyy" Style="max-width:130px" />

                <RadzenButton Text="@Localizer["ApplyFilter"]"
                              Icon="filter_alt"
                              Click="@selectDateRange"
                              ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenStack>

        <!-- Account selection section (right) -->
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Style="flex:1; max-width:300px;">
            <RadzenText TextStyle="TextStyle.Subtitle2">@Localizer["Account"]</RadzenText>
            <RadzenDropDown TValue="string"
                            Data="@userAccounts"
                            TextProperty="Name"
                            ValueProperty="Name"
                            @bind-Value="selectedAccount"
                            Change="@(args => accountSelection(args?.ToString()))"
                            Placeholder="@Localizer["ChooseAccount"]"
                            Style="width: 250px;" />
        </RadzenStack>

    </RadzenStack>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="mt-3">
            @Localizer[errorMessage]
        </RadzenAlert>
    }

    <RadzenCard>
        <RadzenDataGrid Data="@selectedExpenses"
                        TItem="UserDataExpenses"
                        AllowFiltering="true"
                        AllowColumnResize="true"
                        AllowSorting="true"
                        AllowPaging="false"
                        FilterMode="FilterMode.Advanced"
                        EmptyText="@Localizer["NoExpensesFound"]">
            <Columns>
                <RadzenDataGridColumn TItem="UserDataExpenses" Property="Date" Title="@Localizer["Date"]" FormatString="{0:d}" />
                <RadzenDataGridColumn TItem="UserDataExpenses" Property="Account" Title="@Localizer["Account"]" />
                <RadzenDataGridColumn TItem="UserDataExpenses" Property="Description" Title="@Localizer["Description"]" />
                <RadzenDataGridColumn TItem="UserDataExpenses" Property="StaffAccount" Title="@Localizer["StaffAccount"]" />
                <RadzenDataGridColumn TItem="UserDataExpenses" Property="Amount" Title="@Localizer["Amount"]">
                    <Template Context="data">
                        <span class="@(data.Amount >= 0 ? "text-success" : "text-danger")">
                            @Math.Abs(data.Amount).ToString("C", CultureInfo.CurrentCulture)
                            @(data.Amount < 0 ? $" {Localizer["Deficit"]}" : "")
                        </span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    private List<Account> userAccounts = new List<Account>();
    private List<UserDataExpenses> expenses = new List<UserDataExpenses>();
    private List<UserDataExpenses> selectedExpenses = new List<UserDataExpenses>();
    private string errorMessage = string.Empty;

    private DateTime startDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime endDate = DateTime.Now;
    private string selectedAccount = "No Account Selected";
    private Account? currentAccount = null;

    protected override async Task OnInitializedAsync()
    {
        try {
            userAccounts = new List<Account>();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            await DataLoader.InitializeUserDataAsync(user);

            userAccounts = AppState.UserAccounts.ToList();
            Console.WriteLine($"Loaded {userAccounts.Count} accounts for dropdown");

            if (!string.IsNullOrEmpty(AppState.DefaultAccount))
            {
                selectedAccount = AppState.DefaultAccount;
                currentAccount = userAccounts.FirstOrDefault(a => a.Name == selectedAccount);

                if (currentAccount != null && AppState.IsAccountDataLoaded(currentAccount.Name))
                {
                    var accountingData = AppState.AccountDataCache[currentAccount.Name].AccountingData;
                    await ProcessExpenses(accountingData);
                }
            }
        }
        catch (Exception ex) {
            errorMessage = $"Error initializing data: {ex.Message}";
            Console.WriteLine($"Error in OnInitializedAsync: {ex.Message}");
        }
    }

    public async Task accountSelection(string? accountName)
    {
        if (string.IsNullOrEmpty(accountName)) return;

        selectedAccount = accountName;
        currentAccount = userAccounts.FirstOrDefault(a => a.Name == accountName);
        
        Console.WriteLine($"Selected Account: {selectedAccount}");
        errorMessage = string.Empty;
        
        // Check if data is already loaded
        if (currentAccount != null)
        {
            if (!AppState.IsAccountDataLoaded(accountName))
            {
                // Load data for this account
                await DataLoader.LoadAccountDataAsync(currentAccount);
            }
            
            // Get data from cache
            if (AppState.IsAccountDataLoaded(accountName))
            {
                var accountingData = AppState.AccountDataCache[accountName].AccountingData;
                await ProcessExpenses(accountingData);
            }
        }
    }

    private Task ProcessExpenses(List<AccountingDataModel> accountingData)
    {
        try
        {
            // Clear any previous errors and expenses
            errorMessage = string.Empty;
            expenses.Clear();
            selectedExpenses.Clear();

            // Force UI update
            StateHasChanged();

            // Make sure accounting data is loaded
            if (accountingData == null || !accountingData.Any())
            {
                errorMessage = "No accounting data available for this account.";
                return Task.CompletedTask;
            }

            // Filter for expense records
            var expenseRecords = accountingData
                .Where(a => IsExpense(a.type))
                .ToList();

            Console.WriteLine($"Found {expenseRecords.Count} expense records for account '{selectedAccount}'");

            if (expenseRecords.Count == 0)
            {
                errorMessage = "No expense records found for this account.";
                return Task.CompletedTask;
            }

            // Convert to UserDataExpenses format
            expenses = expenseRecords
                .Where(a => a.date > new DateTime(1900, 1, 1)) // Filter out invalid dates
                .Select(a => new UserDataExpenses(
                    staffAccount: !string.IsNullOrEmpty(a.designation) ? a.designation : selectedAccount,
                    amount: a.amount,
                    date: a.date,
                    description: !string.IsNullOrEmpty(a.account) ? a.account : "Unknown",
                    account: !string.IsNullOrEmpty(a.account) ? a.account : "Unknown",
                    num: !string.IsNullOrEmpty(a.num) ? a.num : string.Empty,
                    accountNumber: !string.IsNullOrEmpty(a.accountnum) ? a.accountnum : string.Empty
                ))
                .ToList();

            Console.WriteLine($"Converted {expenses.Count} records to UserDataExpenses");

            // Apply date filter
            selectDateRange();

            // Force UI update after processing is complete
            StateHasChanged();
            
            return Task.CompletedTask;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing expenses: {ex.Message}";
            Console.WriteLine($"Error processing expenses: {ex.Message}");
            return Task.CompletedTask;
        }
    }

    private bool IsExpense(string type)
    {
        if (string.IsNullOrEmpty(type))
            return false;

        return type.Equals("expense", StringComparison.OrdinalIgnoreCase) ||
               type.Equals("payroll check", StringComparison.OrdinalIgnoreCase);
    }

    private void selectDateRange()
    {
        try
        {
            selectedExpenses = SelectData(expenses, startDate, endDate);
            Console.WriteLine($"Applied date filter - Start: {startDate:MM/dd/yyyy}, End: {endDate:MM/dd/yyyy}");
            Console.WriteLine($"Filtered to {selectedExpenses.Count} expense records");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error applying date filter: {ex.Message}";
            Console.WriteLine($"Error in selectDateRange: {ex.Message}");
        }
    }

    private List<UserDataExpenses> SelectData(List<UserDataExpenses> data, DateTime? start = null, DateTime? end = null)
    {
        if (data == null) return new List<UserDataExpenses>();

        if (start == null && end == null)
        {
            return data;
        }
        else if (start != null && end == null)
        {
            return data.Where(d => d.Date >= start).ToList();
        }
        else if (start == null && end != null)
        {
            return data.Where(d => d.Date <= end).ToList();
        }
        else
        {
            return data.Where(d => d.Date >= start && d.Date <= end).ToList();
        }
    }

    private class UserIdOnly
    {
        public int Id { get; set; }
    }
}