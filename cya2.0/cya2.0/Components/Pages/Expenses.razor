@page "/expenses"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.Extensions.Configuration
@using ModelsLibrary
@using DataLibrary
@using UtilityClasses
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject IDataAccess _data
@inject IConfiguration _config
@inject AppState AppState
@inject DataLoadingService DataLoader
@inject PageAccountCache PageCache
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Localizer["ExpensesNav"]</PageTitle>

<style>
    /* Target the column and its header */
    .rz-data-grid .amount-column-fix .rz-column-header,
    .rz-data-grid th.amount-column-fix {
        text-align: right;
        padding-right: 8px;
    }
    
    .rz-data-grid .amount-column-fix .rz-column-title {
        text-align: right;
        padding-right: 8px;
        justify-content: flex-end;
        display: flex;
        width: 100%;
    }

    /* Narrow and center the expense grids */
    .narrow-expense-grid {
        max-width: 100%;
        margin: 0 auto;
    }

    /* Increase the font size for better readability */
    .txt-h5 {
        font-size: 1.5rem; /* Example: H5 size */
        font-weight: 600;
    }

    .txt-subtitle1 {
        font-size: 1.125rem; /* Example: Subtitle1 size */
        font-weight: 500;
    }
</style>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">

    <!-- Top two control sections -->
    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="2rem"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.End"
                 Style="width:100%;">

        <!-- Left side controls -->
        <RadzenStack Orientation="Orientation.Horizontal"
                     Gap="0.75rem"
                     AlignItems="AlignItems.End"
                     Wrap="FlexWrap.Wrap">
            <!-- Account section -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                <RadzenLabel Text="@Localizer["Account"]" />
                <RadzenDropDown TValue="string"
                                Data="@userAccounts"
                                TextProperty="Fund"
                                ValueProperty="Fund"
                                @bind-Value="selectedAccount"
                                Change="@(args => AccountSelection(args?.ToString()))"
                                Placeholder="@Localizer["ChooseAccount"]"
                                Style="width: 200px;" />
            </RadzenStack>

            <!-- Date Range section -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                <RadzenLabel Text="@Localizer["DateRange"]" />
                <!-- Preset dropdown -->
                <RadzenDropDown TValue="DateRangeManager.DateRangePreset"
                                Data="@presetOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="@dateRangeState.SelectedPreset"
                                Change="@OnPresetChanged"
                                Style="width: 180px;">
                    <ValueTemplate>
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                            @(presetOptions.FirstOrDefault(o => o.Value == dateRangeState.SelectedPreset)?.Text ?? "")
                        </span>
                    </ValueTemplate>
                    <Template Context="opt">
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%;">
                            @opt.Text
                        </span>
                    </Template>
                </RadzenDropDown>
            </RadzenStack>

            <RadzenLabel Text="@Localizer["StartDate"]" />
            <RadzenDatePicker @bind-Value="@dateRangeState.PendingStartDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                              Change="@OnDatePickerChanged" />

            <RadzenLabel Text="@Localizer["EndDate"]" />
            <RadzenDatePicker @bind-Value="@dateRangeState.PendingEndDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                              Change="@OnDatePickerChanged" />

            <RadzenButton Text="@Localizer["ApplyFilter"]"
                          Icon="filter_alt"
                          Click="@ApplyDateFilter"
                          ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>

        <!-- Right side toggle button -->
        <RadzenToggleButton Value="useMinimalView"
                            ValueChanged="OnViewModeChange"
                            Text="@(useMinimalView ? "Show More Details" : "Show Less Details")"
                            ButtonStyle="ButtonStyle.Primary"
                            ToggleButtonStyle="ButtonStyle.Primary"
                            Style="background-color: #0a3b6b; border-color: #0a3b6b; color: white; max-width: 200px;" />
    </RadzenStack>

    <!-- Summary cards and grids layout -->
    <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" AlignItems="AlignItems.Start" Class="rz-mt-4">
        <!-- Summary cards (left side) -->
        <RadzenCard Style="min-width: 250px; margin-top: 8px; background-color: #f8f9fa;">
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight: bold;">Summary of Transactions</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Style="color: #666;">@GetDateRangeDisplay()</RadzenText>
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight: bold;">Total Transfers</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight: bold; color: black;">@transferTotal.ToString("C2")</RadzenText>
                </RadzenStack>
                
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight: bold;">Total Expenses</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight: bold; color: black;">@expenseTotal.ToString("C2")</RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <!-- Grids and messages (right side) -->
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="flex: 1;">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="mt-3">
                    @errorMessage
                </RadzenAlert>
            }

            @if (isLoadingAccountData)
            {
                <div class="mt-3">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    <p class="text-muted mt-1">Loading account data...</p>
                </div>
            }

            <!-- Transfer Transactions Grid -->
            @if (transferTransactions.Any())
            {
                <RadzenCard Class="rz-mt-2 narrow-expense-grid">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight:bold; padding-bottom: 8px;">@Localizer["InternalTransfers"]</RadzenText>
                    </RadzenStack>

                    <RadzenDataGrid Data="@transferTransactions" 
                                    TItem="AccountingDataModel" 
                                    Dense="true" 
                                    ShowPagingSummary="false" 
                                    AllowPaging="false"
                                    AllowColumnResize="true"
                                    AllowColumnReorder="false">
                        <Columns>
                            @RenderTransferColumns()
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            }

            <!-- Expense Transactions Grid -->
            @if (expenseTransactions.Any())
            {
                <RadzenCard Class="rz-mt-2 narrow-expense-grid">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="font-weight:bold; padding-bottom: 8px;">@Localizer["Expenses"]</RadzenText>
                    </RadzenStack>

                    <RadzenDataGrid Data="@expenseTransactions" 
                                    TItem="AccountingDataModel" 
                                    Dense="true" 
                                    ShowPagingSummary="false" 
                                    AllowPaging="false"
                                    AllowColumnResize="true"
                                    AllowColumnReorder="false">
                        <Columns>
                            @RenderExpenseColumns()
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            }

            @if (!transferTransactions.Any() && !expenseTransactions.Any() && !string.IsNullOrEmpty(selectedAccount) && selectedAccount != "No Account Selected" && !isLoadingAccountData)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Filled">
                    @Localizer["NoExpensesFound"]
                </RadzenAlert>
            }

        </RadzenStack> <!-- End grids stack -->
    </RadzenStack> <!-- End main horizontal layout -->

</RadzenStack> <!-- End main vertical stack -->

@code {
    private List<Account> userAccounts = new List<Account>();
    private List<AccountingDataModel> allAccountingData = new List<AccountingDataModel>();
    private List<AccountingDataModel> expenseTransactions = new List<AccountingDataModel>();
    private List<AccountingDataModel> transferTransactions = new List<AccountingDataModel>();
    private string errorMessage = string.Empty;
    
    private string selectedAccount = string.Empty;
    private Account? currentAccount = null;
    private bool isLoadingAccountData = false;

    private decimal expenseTotal = 0.00m;
    private decimal transferTotal = 0.00m;

    // Use DateRangeManager for centralized date management
    private DateRangeManager.DateRangeState dateRangeState = new();
    private List<DateRangeManager.PresetOption> presetOptions = new();

    private bool useMinimalView = true; // Default to minimal view
    private bool refreshTransferGrid = false;
    private bool refreshExpenseGrid = false;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            await DataLoader.InitializeUserDataAsync(user);
            userAccounts = AppState.UserAccounts.ToList();

            // Initialize preset options using the centralized manager
            presetOptions = DateRangeManager.GetPresetOptions(Localizer);

            // Initialize date range state from AppState
            dateRangeState = DateRangeManager.InitializeDateRange(AppState);

            // Use SelectedAccount from AppState for cross-page navigation
            selectedAccount = !string.IsNullOrEmpty(AppState.SelectedAccount) 
                ? AppState.SelectedAccount 
                : AppState.DefaultAccount;

            if (!string.IsNullOrEmpty(selectedAccount))
            {
                currentAccount = userAccounts.FirstOrDefault(a => a.Fund == selectedAccount);
                if (currentAccount != null)
                {
                    await LoadAccountData();
                    await ApplyDateFilter();
                }
            }
        }
        catch (Exception ex) 
        {
            errorMessage = $"Error initializing data: {ex.Message}";
        }
    }

    private void OnPresetChanged(object? args)
    {
        if (args is DateRangeManager.DateRangePreset preset)
        {
            DateRangeManager.ApplyPreset(dateRangeState, preset);
            
            // Automatically apply the filter when a preset is selected
            _ = Task.Run(async () =>
            {
                await InvokeAsync(async () =>
                {
                    await ApplyDateFilter();
                });
            });
        }
    }

    private void OnDatePickerChanged()
    {
        // Check if user manually changed dates
        DateRangeManager.ApplyPendingDates(dateRangeState);
        StateHasChanged();
    }

    public async Task AccountSelection(string? accountName)
    {
        if (string.IsNullOrEmpty(accountName)) return;

        selectedAccount = accountName;
        AppState.SelectedAccount = accountName;
        currentAccount = userAccounts.FirstOrDefault(a => a.Fund == accountName);
        
        errorMessage = string.Empty;
        isLoadingAccountData = true;
        
        // Clear existing data when switching accounts
        allAccountingData = new List<AccountingDataModel>();
        expenseTransactions = new List<AccountingDataModel>();
        transferTransactions = new List<AccountingDataModel>();
        expenseTotal = 0.00m;
        transferTotal = 0.00m;
        
        StateHasChanged(); // Update UI to show loading state
        
        if (currentAccount != null)
        {
            // Apply the same comprehensive filtering logic as the Filter button
            await ApplyDateFilter();
        }
        
        isLoadingAccountData = false;
        StateHasChanged();
    }

    private async Task LoadAccountData()
    {
        try
        {
            if (currentAccount == null) return;

            var pageAccountData = await PageCache.GetAccountDataAsync(currentAccount.Fund);
            
            if (pageAccountData != null)
            {
                allAccountingData = pageAccountData.AccountingData;
                // Data loaded successfully
            }
            else
            {
                allAccountingData = new List<AccountingDataModel>();
                // Don't set error message here - let ProcessTransactions handle it
            }
        }
        catch (Exception ex)
        {
            allAccountingData = new List<AccountingDataModel>();
            errorMessage = $"Error loading account data: {ex.Message}";
        }
    }

    private void ProcessTransactions()
    {
        try
        {
            errorMessage = string.Empty;

            if (selectedAccount == "No Account Selected" || string.IsNullOrEmpty(selectedAccount))
            {
                errorMessage = "Please select an account.";
                return;
            }

            if (allAccountingData == null || !allAccountingData.Any())
            {
                errorMessage = "No accounting data available for this account.";
                return;
            }

            // Filter by date range using the centralized state
            var filteredData = allAccountingData.Where(a => 
                a.Date >= dateRangeState.StartDate && a.Date <= dateRangeState.EndDate).ToList();

            var categorized = TransactionCategorizer.CategorizeTransactions(filteredData);

            expenseTransactions = categorized.ExpenseTransactions;
            transferTransactions = categorized.TransferTransactions;

            expenseTotal = categorized.ExpenseTotal;
            transferTotal = categorized.TransferTotal;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing transactions: {ex.Message}";
        }
    }

    private async Task ApplyDateFilter()
    {
        try
        {
            // Apply pending dates and save to AppState using centralized manager
            DateRangeManager.ApplyPendingDates(dateRangeState);
            DateRangeManager.SaveDateRangeToAppState(AppState, dateRangeState);
            
            // If we don't have data loaded yet for the current account, try to load it
            if ((allAccountingData == null || !allAccountingData.Any()) && currentAccount != null)
            {
                if (!isLoadingAccountData)
                {
                    isLoadingAccountData = true;
                    StateHasChanged();
                }
                
                await LoadAccountData();
                
                isLoadingAccountData = false;
            }
            
            ProcessTransactions();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error applying date filter: {ex.Message}";
            isLoadingAccountData = false;
        }
    }

    private void OnViewModeChange(bool newValue)
    {
        useMinimalView = newValue;
        refreshTransferGrid = true;
        refreshExpenseGrid = true;
        StateHasChanged();
    }

    RenderFragment RenderTransferColumns()
    {
        return __builder =>
        {
            if (refreshTransferGrid)
            {
                refreshTransferGrid = false;
                <text>
                </text>
            }
            else
            {
                <text>
                    <RadzenDataGridColumn TItem="AccountingDataModel" Property="Date" Title="@Localizer["Date"]" FormatString="{0:yyyy-MM-dd}" Width="110px" />
                    <RadzenDataGridColumn TItem="AccountingDataModel" Property="Amount" Title="@Localizer["Amount"]" FormatString="{0:F2}" Width="100px" TextAlign="TextAlign.Right">
                        <HeaderTemplate>
                            <div style="text-align: right; padding-right: 8px; width: 100%;">@Localizer["Amount"]</div>
                        </HeaderTemplate>
                    </RadzenDataGridColumn>
                    @if (!useMinimalView)
                    {
                        <RadzenDataGridColumn TItem="AccountingDataModel" Property="Num" Title="@Localizer["RefNum"]" Width="80px" />
                    }
                    <RadzenDataGridColumn TItem="AccountingDataModel" Property="Account" Title="@Localizer["Description"]">
                        <Template Context="row">
                            @(useMinimalView ? (row.Account.Length > 8 ? row.Account.Substring(8) : row.Account) : row.Account)
                        </Template>
                    </RadzenDataGridColumn>
                </text>
            }
        };
    }

    RenderFragment RenderExpenseColumns()
    {
        return __builder =>
        {
            if (refreshExpenseGrid)
            {
                refreshExpenseGrid = false;
                <text>
                </text>
            }
            else
            {
                <text>
                    <RadzenDataGridColumn TItem="AccountingDataModel" Property="Date" Title="@Localizer["Date"]" FormatString="{0:yyyy-MM-dd}" Width="110px" />
                    <RadzenDataGridColumn TItem="AccountingDataModel" Property="Amount" Title="@Localizer["Amount"]" FormatString="{0:F2}" Width="100px" TextAlign="TextAlign.Right">
                        <HeaderTemplate>
                            <div style="text-align: right; padding-right: 8px; width: 100%;">@Localizer["Amount"]</div>
                        </HeaderTemplate>
                    </RadzenDataGridColumn>
                    @if (!useMinimalView)
                    {
                        <RadzenDataGridColumn TItem="AccountingDataModel" Property="Num" Title="@Localizer["RefNum"]" Width="80px" />
                    }
                    <RadzenDataGridColumn TItem="AccountingDataModel" Property="Account" Title="@Localizer["Description"]">
                        <Template Context="row">
                            @(useMinimalView ? (row.Account.Length > 8 ? row.Account.Substring(8) : row.Account) : row.Account)
                        </Template>
                    </RadzenDataGridColumn>
                </text>
            }
        };
    }

    private string GetDateRangeDisplay()
    {
        try
        {
            var startDate = dateRangeState.StartDate;
            var endDate = dateRangeState.EndDate;
            
            // Format: "Jan 5, 2026" or "Jan 5, 2026 - Feb 15, 2026"
            var startFormatted = startDate.ToString("MMM d, yyyy");
            var endFormatted = endDate.ToString("MMM d, yyyy");
            
            if (startDate.Date == endDate.Date)
            {
                return startFormatted;
            }
            else
            {
                return $"{startFormatted} - {endFormatted}";
            }
        }
        catch
        {
            return "Date Range";
        }
    }
}