@page "/donations"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.Extensions.Configuration
@using ModelsLibrary
@using DataLibrary
@using UtilityClassLibrary
@using UtilityClasses
@using Radzen
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using cya2.Components.Shared
@inject AuthenticationStateProvider AuthStateProvider
@inject IDataAccess _data
@inject IConfiguration _config
@inject AppState AppState
@inject DataLoadingService DataLoader
@inject PageAccountCache PageCache
@inject DialogService DialogService
@rendermode InteractiveServer
@inject IStringLocalizer<Resource> Localizer
@inject SubAccountHelper SubAccountHelper
@inject ILogger<Donations> Logger

@* Clean Architecture Service Injections - TEMPORARILY DISABLED *@
@* TODO: Resolve interface conflicts before enabling
@using Cya2.Application.Interfaces
@inject IDonationService DonationService
@inject IAccountService AccountService
@inject IDonorService DonorService
*@

@attribute [StreamRendering]

<PageTitle>@Localizer["Donations"]</PageTitle>

<style>
    .giving-grid .rz-data-grid { font-size: 0.75rem; }
    .giving-grid .rz-cell,
    .giving-grid .rz-column-header,
    .giving-grid .rz-column-footer { padding: 2px 4px; line-height: 1.1; }
    .giving-grid .rz-column-header { font-size: 0.70rem; font-weight: 600; white-space: nowrap; }

    /* Left-align all headers (column titles) while keeping cell padding consistent */
    .giving-grid .rz-column-header .rz-column-title {
        width: 100%;
        display: block;
        text-align: left;
    }

    .giving-grid .donor-cell {
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 160px; display: inline-block;
        cursor: pointer; color: #0066cc; text-decoration: none; transition: color 0.2s ease;
    }
    
    .giving-grid .donor-cell:hover {
        color: #004499; text-decoration: underline;
    }
    
    .donation-list .donor-cell {
        cursor: pointer; color: #0066cc; text-decoration: none; transition: color 0.2s ease;
    }
    
    .donation-list .donor-cell:hover {
        color: #004499; text-decoration: underline;
    }

    .view-mode-buttons .rz-button { padding: 4px 10px; font-size: 0.75rem; }

    /* Vertically center dropdown text */
    .rz-dropdown .rz-inputtext { display: flex; align-items: center; }
    .rz-dropdown .rz-dropdown-label { display: flex; align-items: center; height: 100%; width: 100%; }

    /* Prevent long text from going under the trigger (arrow) and use ellipsis */
    .rz-dropdown .rz-dropdown-label {
        padding-right: 1.75rem; /* reserve space for the trigger button */
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        box-sizing: border-box;
    }
    /* Also ensure items in the panel clip properly */
    .rz-dropdown-panel .rz-dropdown-item {
        display: flex; align-items: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

<RadzenStack Orientation="Orientation.Vertical" Gap="15px" Class="rz-p-4" Style="padding-top:0.5rem;">

    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="2rem"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Start"
                 Style="width:100%;">

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.4rem" Style="flex:1;">
            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["DateRange"]</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="0.5rem"
                         AlignItems="AlignItems.Center"
                         Wrap="FlexWrap.Wrap">
                <RadzenLabel Text="@Localizer["StartDate"]" />
                <RadzenDatePicker @bind-Value="@dateRangeState.PendingStartDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                                  Change="@OnDatePickerChanged" />
                <RadzenLabel Text="@Localizer["EndDate"]" />
                <RadzenDatePicker @bind-Value="@dateRangeState.PendingEndDate" DateFormat="MM/dd/yyyy" Style="max-width:130px"
                                  Change="@OnDatePickerChanged" />

                <!-- Preset dropdown -->
                <RadzenDropDown TValue="DateRangeManager.DateRangePreset"
                                Data="@presetOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="@dateRangeState.SelectedPreset"
                                Change="@OnPresetChanged"
                                Style="width: 180px;">
                    <ValueTemplate>
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                            @(presetOptions.FirstOrDefault(o => o.Value == dateRangeState.SelectedPreset)?.Text ?? "")
                        </span>
                    </ValueTemplate>
                    <Template Context="opt">
                        <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%;">
                            @opt.Text
                        </span>
                    </Template>
                </RadzenDropDown>

                <RadzenButton Text="@Localizer["ApplyFilter"]"
                              Icon="filter_alt"
                              Click="@selectDateRange"
                              Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.4rem" Style="flex:1; max-width:300px;">
            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["Account"]</RadzenText>
            <RadzenDropDown TValue="string"
                            Data="@AppState.UserAccounts"
                            TextProperty="Fund"
                            ValueProperty="Fund"
                            @bind-Value="selectedAccount"
                            Change="@(args => accountSelection(args?.ToString() ?? string.Empty))"
                            Placeholder="@Localizer["ChooseAccount"]"
                            Style="width: 300px;">
                <ValueTemplate>
                    <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                        @FundDisplayHelper.GetDisplay(selectedAccount)
                    </span>
                </ValueTemplate>
                <Template Context="acct">
                    <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width=100%;">
                        @FundDisplayHelper.GetDisplay(acct.Fund)
                    </span>
                </Template>
            </RadzenDropDown>

            <!-- SubAccount dropdown - only shown for accounts with Separate sub accounts -->
            @if (showSubAccountDropdown && subAccountOptions.Any())
            {
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem" Style="margin-top: 0.5rem;">
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: #666; font-size: 0.9rem;">Sub Account</RadzenText>
                    <RadzenDropDown TValue="string"
                                    Data="@subAccountOptions"
                                    TextProperty="DisplayText" 
                                    ValueProperty="Value"
                                    @bind-Value="selectedSubAccount"
                                    Change="@(args => OnSubAccountSelection(args?.ToString() ?? string.Empty))"
                                    Style="width: 300px;">
                        <ValueTemplate>
                            <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:1.75rem;width:100%;">
                                @(subAccountOptions.FirstOrDefault(o => o.Value == selectedSubAccount)?.DisplayText ?? "")
                            </span>
                        </ValueTemplate>
                        <Template Context="option">
                            <span style="display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width=100%;">
                                @option.DisplayText
                            </span>
                        </Template>
                    </RadzenDropDown>
                </RadzenStack>
            }
        </RadzenStack>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="0.5rem"
                 AlignItems="AlignItems.Center"
                 Class="view-mode-buttons rz-mt-3">
        <RadzenButton Text="@Localizer["Grid"]"
                      ButtonStyle="@(currentView == ViewMode.GivingGrid ? ButtonStyle.Primary : ButtonStyle.Light)"
                      Size="ButtonSize.Small"
                      Click="@(() => SetView(ViewMode.GivingGrid))" />
        <RadzenButton Text="@Localizer["List"]"
                      ButtonStyle="@(currentView == ViewMode.DonationList ? ButtonStyle.Primary : ButtonStyle.Light)"
                      Size="ButtonSize.Small"
                      Click="@(() => SetView(ViewMode.DonationList))" />
        <RadzenButton Text="@Localizer["Graph"]"
                      ButtonStyle="@(currentView == ViewMode.Graphs ? ButtonStyle.Primary : ButtonStyle.Light)"
                      Size="ButtonSize.Small"
                      Click="@(() => SetView(ViewMode.Graphs))" />
    </RadzenStack>

    @if (showDebug)
    {
        <RadzenCard Class="rz-mt-2">
            <RadzenText TextStyle="TextStyle.Subtitle2">Debug Info</RadzenText>
            <div>
                <div>SelectedAccount: @selectedAccount</div>
                <div>SelectedSubAccount: @selectedSubAccount</div>
                <div>CurrentAccount: @(currentAccount?.Fund) | Id: @(currentAccount?.AccountId) | Class: @(currentAccount?.AccountingClass)</div>
                <div>SubFund map keys (@subFundToPrimaryAccountId.Count): @string.Join(", ", subFundToPrimaryAccountId.Keys)</div>
                <div>Current fund names for selection (@currentFundNamesForSelection.Count): @string.Join(", ", currentFundNamesForSelection)</div>
                <div>Raw distinct funds loaded (@lastRawDonationFunds.Count): @string.Join(", ", lastRawDonationFunds)</div>
            </div>
            <hr />
            <div style="max-height:200px; overflow:auto; font-family:monospace; font-size: 0.8rem;">
                @foreach (var line in debugLogs)
                {
                    <div>@line</div>
                }
            </div>
        </RadzenCard>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="mt-2">
            @Localizer[errorMessage]
        </RadzenAlert>
    }

    @if (isLoading)
    {
        <div class="mt-3">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p class="text-muted mt-1">@Localizer["LoadingDonations"]</p>
        </div>
    }
    else
    {
        @if (currentView == ViewMode.GivingGrid)
        {
            @* Giving Grid *@
            <RadzenCard Style="padding:0.5rem; margin-top:0.75rem;">
                <RadzenDataGrid TItem="DonationPivotRow"
                                Data="@pivotRows"
                                Class="giving-grid"
                                AllowPaging="false"
                                AllowSorting="false"
                                AllowFiltering="false"
                                AllowVirtualization="false"
                                AllowColumnReorder="false"
                                @ref="givingGridRef"
                                CellRender="@OnGivingGridCellRender"
                                EmptyText="@GetEmptyText()">
                    <Columns>
                        <!-- Donor: header/cell left -->
                        <RadzenDataGridColumn TItem="DonationPivotRow"
                                              Title="@(Localizer["Donor"])"
                                              Width="160px"
                                              OrderIndex="0"
                                              TextAlign="TextAlign.Left">
                            <Template Context="row">
                                <span class="donor-cell" title="@row.Donor" @onclick="@(() => OnDonorClick(row.Donor))">@row.Donor</span>
                            </Template>
                            <FooterTemplate>
                                <strong>@Localizer["Total"]</strong>
                            </FooterTemplate>
                        </RadzenDataGridColumn>

                        @for (var i = 0; i < monthColumns.Count; i++)
                        {
                            var month = monthColumns[i];
                            <!-- Months: header left, cell will be right via CellRender -->
                            <RadzenDataGridColumn @key="month"
                                                  TItem="DonationPivotRow"
                                                  Title="@(GetMonthHeader(month))"
                                                  TextAlign="TextAlign.Left"
                                                  Width="@MonthColumnWidth"
                                                  OrderIndex="@(i + 1)">
                                <Template Context="row">
                                    @{
                                        var has = row.Monthly.TryGetValue(month, out var amt);
                                    }
                                    @(has && amt != 0m ? amt.ToString("C0") : "")
                                </Template>
                                <FooterTemplate>
                                    @{
                                        var mt = monthTotals.TryGetValue(month, out var t) ? t : 0m;
                                    }
                                    <strong>@mt.ToString("C0")</strong>
                                </FooterTemplate>
                            </RadzenDataGridColumn>
                        }

                        <!-- Total: header left, cell will be right via CellRender -->
                        <RadzenDataGridColumn TItem="DonationPivotRow"
                                              Title="@(Localizer["Total"])"
                                              TextAlign="TextAlign.Left"
                                              Width="85px"
                                              OrderIndex="@(monthColumns.Count + 1)">
                            <Template Context="row">
                                <strong>@row.Total.ToString("C0")</strong>
                            </Template>
                            <FooterTemplate>
                                <strong>@grandTotal.ToString("C0")</strong>
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        }
        else if (currentView == ViewMode.DonationList)
        {
            <!-- Summary cards and list layout -->
            <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" AlignItems="AlignItems.Start">
                <!-- Summary card (left side) - fixed width at 20% -->
                <div style="flex:0 0 20%; min-width:260px;">
                    <DonationSummaryCard Donations="@selectedDonations" 
                                         StartDate="@dateRangeState.StartDate" 
                                         EndDate="@dateRangeState.EndDate" />
                </div>

                <!-- Donation list (right side) -->
                <div style="flex: 1;">
                    <RadzenCard>
                        <RadzenDataGrid Data="@selectedDonations"
                                        TItem="UserDataDonations"
                                        AllowFiltering="true"
                                        AllowColumnResize="true"
                                        AllowSorting="true"
                                        AllowPaging="false"
                                        FilterMode="FilterMode.Advanced"
                                        EmptyText="@GetEmptyText()"
                                        Class="donation-list">
                            <Columns>
                                <RadzenDataGridColumn TItem="UserDataDonations" Property="Date" Title="@(Localizer["Date"])" FormatString="{0:MM/dd/yyyy}" />
                                <RadzenDataGridColumn TItem="UserDataDonations" Property="Donor" Title="@(Localizer["Donor"])">
                                    <Template Context="donation">
                                        <span class="donor-cell" @onclick="@(() => OnDonorClick(donation.Donor))">@donation.Donor</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="UserDataDonations" Property="Amount" Title="@(Localizer["Amount"])" FormatString="{0:C2}" />
                                <RadzenDataGridColumn TItem="UserDataDonations" Property="TransactionType" Title="@(Localizer["TransactionType"])" />
                                <RadzenDataGridColumn TItem="UserDataDonations" Title="@(Localizer["Frequency"])">
                                    <Template Context="donation">
                                        <!-- Leave blank for now - no frequency data available yet -->
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenCard>
                </div>
            </RadzenStack>
        }
        else
        {
            <!-- Graphs placeholder -->
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Subtitle2">@Localizer["Graphs"]</RadzenText>
                <div class="text-muted">@Localizer["ComingSoon"]</div>
            </RadzenCard>
        }
    }
</RadzenStack>

@code {
    private List<UserDataDonations> donations = new();
    private List<UserDataDonations> selectedDonations = new();

    private string selectedAccount = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    private Account? currentAccount = null;
    private Dictionary<string, int> subFundToPrimaryAccountId = new(StringComparer.OrdinalIgnoreCase);
    private bool showDebug = false;
    private List<string> debugLogs = new();
    private List<string> lastRawDonationFunds = new();
    
    // New SubAccount support
    private bool showSubAccountDropdown = false;
    private string selectedSubAccount = "All"; // Default to "All"
    private List<SubAccountOption> subAccountOptions = new();
    private List<string> currentFundNamesForSelection = new();
    
    private void Debug(string message)
    {
        var line = $"[{DateTime.Now:HH:mm:ss}] {message}";
        debugLogs.Add(line);
        Console.WriteLine($"DONATIONS DEBUG: {line}");
    }

    private enum ViewMode { GivingGrid, DonationList, Graphs }
    private ViewMode currentView = ViewMode.GivingGrid;
    private void SetView(ViewMode mode) => currentView = mode;

    private readonly List<DateTime> monthColumns = new();
    private readonly List<DonationPivotRow> pivotRows = new();
    private readonly Dictionary<DateTime, decimal> monthTotals = new();
    private decimal grandTotal = 0m;

    private RadzenDataGrid<DonationPivotRow>? givingGridRef;

    private string MonthColumnWidth => monthColumns.Count <= 12 ? "70px" : "55px";

    private string GetMonthHeader(DateTime m)
    {
        var singleYear = dateRangeState.StartDate.Year == dateRangeState.EndDate.Year;
        return singleYear ? m.ToString("MMM") : m.ToString("MMM yy");
    }

    // Use DateRangeManager for centralized date management
    private DateRangeManager.DateRangeState dateRangeState = new();
    private List<DateRangeManager.PresetOption> presetOptions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await DataLoader.InitializeUserDataAsync(authState.User);

            // Initialize preset options using the centralized manager
            presetOptions = DateRangeManager.GetPresetOptions(Localizer);

            // Initialize date range state from AppState
            dateRangeState = DateRangeManager.InitializeDateRange(AppState);

            // Use SelectedAccount from AppState for cross-page navigation
            selectedAccount = !string.IsNullOrEmpty(AppState.SelectedAccount) 
                ? AppState.SelectedAccount 
                : AppState.DefaultAccount;

            if (AppState.UserAccounts.Any())
            {
                if (!string.IsNullOrEmpty(selectedAccount))
                {
                    currentAccount = AppState.UserAccounts.FirstOrDefault(a => a.Fund == selectedAccount);
                }

                if (currentAccount != null)
                {
                    await LoadDonationsForAccount(currentAccount);
                }
            }

            // Only apply date range if we're not loading from AppState
            // If we loaded dates from AppState, they're already set and data is ready
            if (!AppState.SelectedStartDate.HasValue || !AppState.SelectedEndDate.HasValue)
            {
                await selectDateRange(); // Only apply default dates
            }
            else
            {
                // We loaded from AppState, just apply the filtering without saving back to AppState
                selectedDonations = SelectData(donations, dateRangeState.StartDate, dateRangeState.EndDate);
                BuildPivot();
            }

            isLoading = false;
            Debug($"Initialized. SelectedAccount='{selectedAccount}', UserAccounts={AppState.UserAccounts.Count}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"Error in OnInitializedAsync: {ex.Message}");
            isLoading = false;
        }
    }

    private void OnPresetChanged(object? args)
    {
        if (args is DateRangeManager.DateRangePreset preset)
        {
            DateRangeManager.ApplyPreset(dateRangeState, preset);
            StateHasChanged();
        }
    }

    private void OnDatePickerChanged()
    {
        // Check if user manually changed dates
        DateRangeManager.ApplyPendingDates(dateRangeState);
        StateHasChanged();
    }

    private async Task OnSubAccountSelection(string value)
    {
        selectedSubAccount = value;
        Debug($"SubAccount selected: '{selectedSubAccount}'");
        
        if (currentAccount != null)
        {
            // Get the fund names for this selection
            currentFundNamesForSelection = await SubAccountHelper.GetFundNamesForSelectionAsync(currentAccount, selectedSubAccount);
            Debug($"Fund names for selection: {string.Join(", ", currentFundNamesForSelection)}");
            
            // Rebuild the data with new filtering
            await LoadDonationsForAccount(currentAccount, true);
            await selectDateRange(); // Apply date filtering
        }
        
        StateHasChanged();
    }

    public async Task accountSelection(string accountName)
    {
        if (string.IsNullOrEmpty(accountName)) return;

        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            donations.Clear();
            selectedDonations.Clear();

            StateHasChanged();

            selectedAccount = accountName;
            AppState.SelectedAccount = accountName; // Update AppState for cross-page navigation

            currentAccount = AppState.UserAccounts.FirstOrDefault(a => a.Fund == selectedAccount);

            Debug($"Account selected: '{selectedAccount}'. CurrentAccountId={(currentAccount?.AccountId.ToString() ?? "null")}");
            
            // Reset sub account selection when changing accounts
            selectedSubAccount = "All";
            showSubAccountDropdown = false;
            subAccountOptions.Clear();
            currentFundNamesForSelection.Clear();
            
            if (currentAccount != null)
            {
                // Check if account has separate sub accounts and setup dropdown if needed
                var hasSeparateSubAccounts = await SubAccountHelper.HasSeparateSubAccountsAsync(currentAccount.AccountId);
                if (hasSeparateSubAccounts)
                {
                    subAccountOptions = await SubAccountHelper.GetSubAccountOptionsAsync(currentAccount);
                    showSubAccountDropdown = true;
                    selectedSubAccount = "All"; // Default to "All"
                    Debug($"Account has {subAccountOptions.Count} sub account options");
                }

                await LoadDonationsForAccount(currentAccount);
                await selectDateRange(); // Refresh the display with current date range
            }

            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error selecting account: {ex.Message}";
            Console.WriteLine($"Error in accountSelection: {ex.Message}");
            isLoading = false;
        }
    }

    private async Task LoadDonationsForAccount(Account account, bool isSubAccountChange = false)
    {
        try
        {
            if (account == null)
            {
                errorMessage = "No account selected";
                return;
            }

            // If this is not a sub account change, rebuild the sub fund mapping
            if (!isSubAccountChange)
            {
                // Load subfund -> primary AccountId mapping for this primary account (Merged only)
                subFundToPrimaryAccountId = await LoadSubFundAccountMapAsync(account);
                Debug($"Loaded subfund map for AccountId={account.AccountId}, keys={subFundToPrimaryAccountId.Count}: {string.Join(", ", subFundToPrimaryAccountId.Keys)}");
            }

            // Get fund names for current sub account selection
            if (showSubAccountDropdown)
            {
                currentFundNamesForSelection = await SubAccountHelper.GetFundNamesForSelectionAsync(account, selectedSubAccount);
                Debug($"Using fund names for selection ({selectedSubAccount}): {string.Join(", ", currentFundNamesForSelection)}");
            }
            else
            {
                // For accounts without separate sub accounts, use existing logic
                currentFundNamesForSelection = new List<string> { account.Fund };
                // Also include any merged sub account fund names in the map
                currentFundNamesForSelection.AddRange(subFundToPrimaryAccountId.Keys.Where(k => k != account.Fund));
                Debug($"Using default fund names (no sub accounts): {string.Join(", ", currentFundNamesForSelection)}");
            }

            // NEW: Load data for all relevant fund names if we have separate sub accounts
            List<DonationsDataModel> allDonationData;
            
            if (showSubAccountDropdown)
            {
                // For accounts with separate sub accounts, we need to load data directly from database
                allDonationData = new List<DonationsDataModel>();
                
                // Get all fund names we might need (for "All" selection)
                var allRelevantFundNames = await SubAccountHelper.GetFundNamesForSelectionAsync(account, "All");
                Debug($"Loading separate sub account data for fund names: {string.Join(", ", allRelevantFundNames)}");
                
                // Load data directly from database for each fund name
                foreach (var fundName in allRelevantFundNames)
                {
                    try
                    {
                        Debug($"Querying database for Fund = '{fundName}'");
                        const string donationSql = "SELECT * FROM DonationData WHERE Fund = @Fund";
                        var fundDonationData = await _data.LoadData<DonationsDataModel, dynamic>(
                            donationSql,
                            new { Fund = fundName },
                            _config.GetConnectionString("default") ?? string.Empty
                        );
                        
                        if (fundDonationData != null && fundDonationData.Any())
                        {
                            allDonationData.AddRange(fundDonationData);
                            Debug($"Found {fundDonationData.Count()} records for Fund = '{fundName}'");
                        }
                        else
                        {
                            Debug($"No records found for Fund = '{fundName}'");
                        }
                    }
                    catch (Exception ex)
                    {
                        Debug($"Error loading data for fund '{fundName}': {ex.Message}");
                    }
                }
                
                Debug($"Loaded donation data for separate sub accounts from {allRelevantFundNames.Count} fund names, total records: {allDonationData.Count}");
            }
            else
            {
                // Use existing logic for accounts without separate sub accounts
                var pageAccountData = await PageCache.GetAccountDataAsync(account.Fund);
                allDonationData = pageAccountData?.DonationData ?? new List<DonationsDataModel>();
                Debug($"Loaded donation data for primary account: {account.Fund}");
            }

            if (allDonationData.Any())
            {
                var totalRows = allDonationData.Count;
                lastRawDonationFunds = allDonationData.Select(d => d.Fund)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(s => s)
                    .ToList();
                Debug($"Total donation data loaded: rows={totalRows}, distinctFunds={lastRawDonationFunds.Count}: {string.Join(", ", lastRawDonationFunds)}");
                ProcessDonationData(allDonationData);
            }
            else
            {
                errorMessage = "No donation data found for this account";
                Debug("No donation data found for this account.");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading donation data: {ex.Message}";
            Console.WriteLine($"Error in LoadDonationsForAccount: {ex.Message}");
        }
    }

    private async Task<Dictionary<string, int>> LoadSubFundAccountMapAsync(Account primary)
    {
        try
        {
            const string sql = "SELECT SubFund, Kind FROM SubAccounts WHERE AccountId = @AccountId";
            var subRows = await _data.LoadData<(string SubFund, string Kind), dynamic>(sql, new { AccountId = primary.AccountId }, _config.GetConnectionString("default") ?? string.Empty) 
                            ?? new List<(string SubFund, string Kind)>();
            var map = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            // Map each merged subfund name to the primary AccountId (only Merged, not Separate)
            foreach (var row in subRows)
            {
                if (string.Equals(row.Kind, "Merged", StringComparison.OrdinalIgnoreCase))
                {
                    var name = row.SubFund;
                    if (!string.IsNullOrWhiteSpace(name) && !map.ContainsKey(name))
                        map[name] = primary.AccountId;
                }
            }
            // Also map the primary fund name to its own AccountId
            if (!string.IsNullOrWhiteSpace(primary.Fund) && !map.ContainsKey(primary.Fund))
            {
                map[primary.Fund] = primary.AccountId;
            }
            return map;
        }
        catch
        {
            // Fallback to at least include the primary fund name
            var map = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            if (!string.IsNullOrWhiteSpace(primary.Fund)) map[primary.Fund] = primary.AccountId;
            return map;
        }
    }

    private void ProcessDonationData(List<DonationsDataModel> donationData)
    {
        try
        {
            donations.Clear();

            int included = 0, skipped = 0;
            double includedTotal = 0, skippedTotal = 0;
            var includedFunds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var skippedFunds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            
            foreach (var donation in donationData)
            {
                if (currentAccount == null) continue;

                bool shouldInclude = false;
                string displayAccountName = currentAccount.Fund; // Default display name

                if (showSubAccountDropdown && currentFundNamesForSelection.Any())
                {
                    // Use Sub Account filtering for accounts with Separate sub accounts
                    if (currentFundNamesForSelection.Contains(donation.Fund, StringComparer.OrdinalIgnoreCase))
                    {
                        shouldInclude = true;
                        // For separate sub accounts, show the actual fund name
                        if (selectedSubAccount != "All" && selectedSubAccount != "Primary")
                        {
                            displayAccountName = FundDisplayHelper.GetDisplay(donation.Fund);
                        }
                        else
                        {
                            displayAccountName = FundDisplayHelper.GetDisplay(currentAccount.Fund);
                        }
                    }
                }
                else
                {
                    // Use existing logic for accounts without separate sub accounts (Merged logic)
                    // Determine the primary AccountId for this donation via fund->AccountId mapping
                    int mappedPrimaryId;
                    if (!subFundToPrimaryAccountId.TryGetValue(donation.Fund, out mappedPrimaryId))
                    {
                        // Unknown fund name for this selection -> skip
                        skipped++;
                        skippedTotal += donation.Amount;
                        skippedFunds.Add(donation.Fund);
                        continue;
                    }
                    if (mappedPrimaryId != currentAccount.AccountId)
                    {
                        skipped++;
                        skippedTotal += donation.Amount;
                        skippedFunds.Add(donation.Fund);
                        continue;
                    }
                    shouldInclude = true;
                    // Display under the primary account name
                    displayAccountName = FundDisplayHelper.GetDisplay(currentAccount.Fund);
                }

                if (!shouldInclude)
                {
                    skipped++;
                    skippedTotal += donation.Amount;
                    skippedFunds.Add(donation.Fund);
                    continue;
                }

                var donorDisplay = donation.IsAnonymous ? Localizer["Anonymous"] : donation.AccountName;

                // Personal fields - blank them out when anonymous
                var email = donation.IsAnonymous ? string.Empty : (donation.Email ?? string.Empty);
                var phoneFixed = donation.IsAnonymous ? string.Empty : (donation.PhoneFixed ?? string.Empty);
                var phoneMobile = donation.IsAnonymous ? string.Empty : (donation.PhoneMobile ?? string.Empty);
                var addr = donation.IsAnonymous ? string.Empty : (donation.Address ?? string.Empty);
                var city = donation.IsAnonymous ? string.Empty : (donation.City ?? string.Empty);
                var state = donation.IsAnonymous ? string.Empty : (donation.State ?? string.Empty);
                var postal = donation.IsAnonymous ? string.Empty : (donation.PostalCode ?? string.Empty);
                var country = donation.IsAnonymous ? string.Empty : (donation.Country ?? string.Empty);
                var soft = donation.IsAnonymous ? string.Empty : (donation.SoftCreditName ?? string.Empty);

                var newDonation = new UserDataDonations(
                    displayAccountName,
                    donorDisplay,
                    donation.Date,
                    donation.Amount,
                    donation.PaymentMethod,
                    donation.GiftType,
                    email,
                    phoneFixed,
                    phoneMobile,
                    addr,
                    city,
                    state,
                    postal,
                    country,
                    soft,
                    donation.IsAnonymous);

                donations.Add(newDonation);
                included++;
                includedTotal += donation.Amount;
                includedFunds.Add(donation.Fund);
            }

            // IMPORTANT: Sort all donations by date (newest first) after processing
            // This ensures that separate sub account data is properly mixed with primary account data
            if (donations.Any())
            {
                donations = donations.OrderByDescending(d => d.Date).ToList();
                Debug($"Sorted {donations.Count} donations by date (newest first)");
            }

            Debug($"ProcessDonationData: included={included} (total={includedTotal:F2}) from funds: {string.Join(", ", includedFunds)}; " +
                  $"skipped={skipped} (total={skippedTotal:F2}) from funds: {string.Join(", ", skippedFunds)}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing donation data: {ex.Message}";
            Console.WriteLine($"Error in ProcessDonationData: {ex.Message}");
        }
    }

    private List<UserDataDonations> SelectData(List<UserDataDonations> data, DateTime? start = null, DateTime? end = null)
    {
        if (data == null) return new List<UserDataDonations>();
        if (start == null && end == null) return data;
        if (start != null && end == null) return data.Where(d => d.Date >= start).ToList();
        if (start == null && end != null) return data.Where(d => d.Date <= end).ToList();
        return data.Where(d => d.Date >= start && d.Date <= end).ToList();
    }

    private async Task selectDateRange()
    {
        try
        {
            // Apply pending dates and save to AppState using centralized manager
            DateRangeManager.ApplyPendingDates(dateRangeState);
            DateRangeManager.SaveDateRangeToAppState(AppState, dateRangeState);

            selectedDonations = SelectData(donations, dateRangeState.StartDate, dateRangeState.EndDate);
            Debug($"Apply date filter: {dateRangeState.StartDate:yyyy-MM-dd} to {dateRangeState.EndDate:yyyy-MM-dd}; filteredCount={selectedDonations.Count}");
            BuildPivot();

            if (currentView == ViewMode.GivingGrid && givingGridRef is not null)
            {
                await givingGridRef.Reload();
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error applying date filter: {ex.Message}";
            Console.WriteLine($"Error in selectDateRange: {ex.Message}");
        }
    }

    private void BuildPivot()
    {
        monthColumns.Clear();
        pivotRows.Clear();
        monthTotals.Clear();
        grandTotal = 0m;

        var start = new DateTime(dateRangeState.StartDate.Year, dateRangeState.StartDate.Month, 1);
        var end = new DateTime(dateRangeState.EndDate.Year, dateRangeState.EndDate.Month, 1);

        for (var cursor = start; cursor <= end; cursor = cursor.AddMonths(1))
        {
            monthColumns.Add(cursor);
        }

        if (!selectedDonations.Any()) return;

        var byDonor = selectedDonations.GroupBy(d => d.Donor).OrderBy(g => g.Key ?? string.Empty);

        foreach (var g in byDonor)
        {
            var row = new DonationPivotRow { Donor = g.Key ?? Localizer["Unknown"] };

            foreach (var donation in g)
            {
                var monthKey = new DateTime(donation.Date.Year, donation.Date.Month, 1);
                if (!row.Monthly.ContainsKey(monthKey))
                {
                    row.Monthly[monthKey] = 0m;
                }
                row.Monthly[monthKey] += Convert.ToDecimal(donation.Amount);
            }

            pivotRows.Add(row);
        }

        foreach (var month in monthColumns)
        {
            decimal total = 0m;
            foreach (var row in pivotRows)
            {
                if (row.Monthly.TryGetValue(month, out var amt))
                {
                    total += amt;
                }
            }
            monthTotals[month] = total;
        }

        grandTotal = monthTotals.Values.Sum();
    }

    private sealed class DonationPivotRow
    {
        public string Donor { get; set; } = string.Empty;
        public Dictionary<DateTime, decimal> Monthly { get; } = new();
        public decimal Total => Monthly.Values.Sum();
    }

    private void OnGivingGridCellRender(DataGridCellRenderEventArgs<DonationPivotRow> args)
    {
        if (args.Column?.OrderIndex is int idx && idx >= 1)
        {
            var style = "text-align: right !important;";
            if (args.Attributes.TryGetValue("style", out var existing) && existing is string s && !string.IsNullOrWhiteSpace(s))
            {
                args.Attributes["style"] = s.EndsWith(";") ? s + style : s + ";" + style;
            }
            else
            {
                args.Attributes["style"] = style;
            }
        }
    }

