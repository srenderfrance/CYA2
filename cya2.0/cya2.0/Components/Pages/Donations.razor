@page "/donations"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.Extensions.Configuration
@using ModelsLibrary
@using DataLibrary
@using UtilityClassLibrary
@using Radzen
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject IDataAccess _data
@inject IConfiguration _config
@inject AppState AppState
@inject DataLoadingService DataLoader
@rendermode InteractiveServer
@inject IStringLocalizer<Resource> Localizer
@attribute [StreamRendering]

<PageTitle>@Localizer["DonationsNav"]</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">
    <div class="d-flex justify-content-between align-items-center">
        <RadzenText TextStyle="TextStyle.H3">@Localizer["Account"]: @selectedAccount</RadzenText>
        <RadzenDropDown TValue="string"
                        Data="@AppState.UserAccounts"
                        TextProperty="Name"
                        ValueProperty="Name"
                        @bind-Value="selectedAccount"
                        Change="@(args => accountSelection(args?.ToString()))"
                        Placeholder="@Localizer["ChooseAccount"]"
                        Style="width: 250px;" />
    </div>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.Subtitle2">@Localizer["DateRange"]</RadzenText>
        <RadzenLabel Text="@Localizer["StartDate"]" />
        <RadzenDatePicker @bind-Value="@startDate" DateFormat="MM/dd/yyyy" />

        <RadzenLabel Text="@Localizer["EndDate"]" />
        <RadzenDatePicker @bind-Value="@endDate" DateFormat="MM/dd/yyyy" />

        <RadzenButton Text="@Localizer["ApplyFilter"]" Icon="filter_alt" Click="@selectDateRange" ButtonStyle="ButtonStyle.Primary" />
    </RadzenStack>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="mt-3">
            @Localizer[errorMessage]
        </RadzenAlert>
    }

    @if (isLoading)
    {
        <div class="mt-4">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <p class="text-muted mt-2">@Localizer["LoadingDonations"]</p>
        </div>
    }
    else
    {
        <RadzenCard>
            <RadzenDataGrid Data="@selectedDonations"
                            TItem="UserDataDonations"
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            AllowSorting="true"
                            AllowPaging="false"
                            FilterMode="FilterMode.Advanced"
                            EmptyText="@Localizer["NoDonationsFound"]">
                <Columns>
                    <RadzenDataGridColumn TItem="UserDataDonations" Property="Account" Title="@Localizer["Account"]" />
                    <RadzenDataGridColumn TItem="UserDataDonations" Property="Donor" Title="@Localizer["Donor"]" />
                    <RadzenDataGridColumn TItem="UserDataDonations" Property="Date" Title="@Localizer["Date"]" FormatString="{0:MM/dd/yyyy}" />
                    <RadzenDataGridColumn TItem="UserDataDonations" Property="Amount" Title="@Localizer["Amount"]" FormatString="{0:C2}" />
                    <RadzenDataGridColumn TItem="UserDataDonations" Property="Frequency" Title="@Localizer["Frequency"]" />
                    <RadzenDataGridColumn TItem="UserDataDonations" Property="TransactionType" Title="@Localizer["TransactionType"]" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private List<UserDataDonations> donations = new List<UserDataDonations>();
    private List<UserDataDonations> selectedDonations = new List<UserDataDonations>();

    private DateTime startDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1, 0, 0, 0);
    private DateTime endDate = DateTime.Now;
    private string selectedAccount = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    private Account currentAccount = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Initialize user data
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await DataLoader.InitializeUserDataAsync(authState.User);

            // Check if we have accounts
            if (AppState.UserAccounts.Any())
            {
                // Set default account if available
                if (!string.IsNullOrEmpty(AppState.DefaultAccount))
                {
                    selectedAccount = AppState.DefaultAccount;
                    currentAccount = AppState.UserAccounts.FirstOrDefault(a => a.Name == selectedAccount);

                    // Load donations data for the default account
                    await LoadDonationsForAccount(currentAccount);
                }
                else if (AppState.UserAccounts.Any())
                {
                    // Use first account as default if no default set
                    selectedAccount = AppState.UserAccounts.First().Name;
                    currentAccount = AppState.UserAccounts.First();
                    await LoadDonationsForAccount(currentAccount);
                }
            }

            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"Error in OnInitializedAsync: {ex.Message}");
            isLoading = false;
        }
    }

    public async Task accountSelection(string accountName)
    {
        if (string.IsNullOrEmpty(accountName)) return;

        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            // Clear existing data
            donations.Clear();
            selectedDonations.Clear();

            // Update UI
            StateHasChanged();

            selectedAccount = accountName;

            // Update AppState with the selected account
            AppState.DefaultAccount = accountName;

            // Find account in UserAccounts
            currentAccount = AppState.UserAccounts.FirstOrDefault(a => a.Name == selectedAccount);

            if (currentAccount != null)
            {
                await LoadDonationsForAccount(currentAccount);
            }

            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error selecting account: {ex.Message}";
            Console.WriteLine($"Error in accountSelection: {ex.Message}");
            isLoading = false;
        }
    }

    private async Task LoadDonationsForAccount(Account account)
    {
        try
        {
            if (account == null)
            {
                errorMessage = "No account selected";
                return;
            }

            // Check if data is already in AppState
            if (AppState.IsAccountDataLoaded(account.Name))
            {
                var accountData = AppState.AccountDataCache[account.Name];
                ProcessDonationData(accountData.DonationData);
            }
            else
            {
                // Load from database if not in cache
                await DataLoader.LoadAccountDataAsync(account);

                // Check if loading was successful
                if (AppState.IsAccountDataLoaded(account.Name))
                {
                    var accountData = AppState.AccountDataCache[account.Name];
                    ProcessDonationData(accountData.DonationData);
                }
                else
                {
                    // Fallback to direct database query if something went wrong with DataLoader
                    string sql = "SELECT * FROM etapestry WHERE fund = @Fund";
                    var donationData = await _data.LoadData<DonationsDataModel, dynamic>(
                        sql,
                        new { Fund = account.AccountRef },
                        _config.GetConnectionString("default")
                    );

                    if (donationData != null)
                    {
                        ProcessDonationData(donationData);
                    }
                    else
                    {
                        errorMessage = "No donation data found for this account";
                    }
                }
            }

            // Apply date filter
            selectDateRange();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading donation data: {ex.Message}";
            Console.WriteLine($"Error in LoadDonationsForAccount: {ex.Message}");
        }
    }

    private void ProcessDonationData(List<DonationsDataModel> donationData)
    {
        try
        {
            donations.Clear();

            foreach (var donation in donationData)
            {
                int separatorIndex = donation.fund.IndexOf(":");

                if (separatorIndex > 0)
                {
                    var newDonation = new UserDataDonations(
                        donation.fund.Remove(separatorIndex, donation.fund.Length - separatorIndex),
                        donation.accountname,
                        donation.date,
                        donation.amount,
                        donation.recurring,
                        donation.gifttype);
                    donations.Add(newDonation);
                }
                else
                {
                    var newDonation = new UserDataDonations(
                        donation.fund,
                        donation.accountname,
                        donation.date,
                        donation.amount,
                        donation.recurring,
                        donation.gifttype);
                    donations.Add(newDonation);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing donation data: {ex.Message}";
            Console.WriteLine($"Error in ProcessDonationData: {ex.Message}");
        }
    }

    private List<UserDataDonations> SelectData(List<UserDataDonations> data, DateTime? start = null, DateTime? end = null)
    {
        if (data == null) return new List<UserDataDonations>();

        if (start == null && end == null)
        {
            return data;
        }
        else if (start != null && end == null)
        {
            return data.Where(d => d.Date >= start).ToList();
        }
        else if (start == null && end != null)
        {
            return data.Where(d => d.Date <= end).ToList();
        }
        else
        {
            return data.Where(d => d.Date >= start && d.Date <= end).ToList();
        }
    }

    private void selectDateRange()
    {
        try
        {
            selectedDonations = SelectData(donations, startDate, endDate);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error applying date filter: {ex.Message}";
            Console.WriteLine($"Error in selectDateRange: {ex.Message}");
        }
    }
}
