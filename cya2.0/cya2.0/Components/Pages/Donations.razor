@page "/donations"

@using Microsoft.Extensions.Configuration
@using ModelsLibrary
@using DataLibrary
@using UtilityClassLibrary
@inject IDataAccess _data
@inject IConfiguration _config
@rendermode InteractiveServer

<PageTitle>DONATIONS</PageTitle>
<h1>Donations</h1>
<div class="d-flex justify-content-between">
	<h2>Account Name: @selectedAccount</h2>
	<Dropdown Color="DropdownColor.Secondary">
		<DropdownToggleButton>Choose Account</DropdownToggleButton>
		<DropdownMenu @bind-value="@selectedAccount">
			@foreach (var account in userAccounts)
			{
				<DropdownItem Type=DropdownItemType.Button @onclick="() => accountSelection(account.Name)">@account.Name</DropdownItem>
			}
		</DropdownMenu>
	</Dropdown>
</div>
<div> 
	<Grid 
	TItem="UserDataDonations"
	Class="table table-hover table-bordered table-striped"
	Data="@selectedDonations"
	AllowFiltering="true"
	AllowPaging="true"
	PageSize="10"
	AllowSorting="true"
	AllowSelection="false"
	SelectionMode="GridSelectionMode.Multiple"
	Responsive="true">

		<GridColumns>
			<GridColumn TItem="UserDataDonations" HeaderText="Account" PropertyName="Account">@context.Account</GridColumn>
			<GridColumn TItem="UserDataDonations" HeaderText="Donor" PropertyName="Donor">@context.Donor</GridColumn>
			<GridColumn TItem="UserDataDonations" HeaderText="Date" PropertyName="Date">@context.Date</GridColumn>
			<GridColumn TItem="UserDataDonations" HeaderText="Amount" PropertyName="Amount">@context.Amount</GridColumn>	
			<GridColumn TItem="UserDataDonations" HeaderText="Frequency" PropertyName="Frequency">@context.Frequency</GridColumn>
			<GridColumn TItem="UserDataDonations" HeaderText="Transaction Type" PropertyName="TransactionType">@context.TransactionType</GridColumn>		
		</GridColumns>
	</Grid>

	<div class="d-flex">
		<label class="labels" for="startDate">Start Date</label>
		<div class="mb-3">
			<DateInput class="form-control" name="startDate" TValue="DateTime" @bind-Value="@startDate" Placeholder="Enter Date" />
		</div>
		<label class=" labels" for="endDate">End Date</label>
		<div class="mb-3">
			<DateInput TValue="DateTime" @bind-Value="@endDate" Placeholder="Enter Date" />
		</div>
		<Button Color="ButtonColor.Primary" @onclick="selectDateRange" class="btn btn-primary">Select Date Range</Button>
	</div>
</div>

