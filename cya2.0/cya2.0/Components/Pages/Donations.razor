@page "/donations"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.Extensions.Configuration
@using ModelsLibrary
@using DataLibrary
@using UtilityClassLibrary
@using Radzen
@inject IDataAccess _data
@inject IConfiguration _config
@rendermode InteractiveServer
@attribute [StreamRendering]

<PageTitle>DONATIONS</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-4">
    <div class="d-flex justify-content-between align-items-center">
        <RadzenText TextStyle="TextStyle.H3">Account: @selectedAccount</RadzenText>
        <RadzenDropDown TValue="string"
                        Data="@userAccounts"
                        TextProperty="Name"
                        ValueProperty="Name"
                        Change="@(args => accountSelection(args?.ToString()))"
                        Placeholder="Choose Account"
                        Style="width: 250px;" />
    </div>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.Subtitle2">Date Range:</RadzenText>
        <RadzenLabel Text="Start Date" />
        <RadzenDatePicker @bind-Value="@startDate" DateFormat="MM/dd/yyyy" />
        
        <RadzenLabel Text="End Date" />
        <RadzenDatePicker @bind-Value="@endDate" DateFormat="MM/dd/yyyy" />
        
        <RadzenButton Text="Apply Filter" Icon="filter_alt" Click="@selectDateRange" ButtonStyle="ButtonStyle.Primary" />
    </RadzenStack>

    <RadzenCard>
        <RadzenDataGrid Data="@selectedDonations" 
                        TItem="UserDataDonations" 
                        AllowFiltering="true"
                        AllowColumnResize="true" 
                        AllowSorting="true" 
                        PageSize="10"
                        AllowPaging="true"
                        FilterMode="FilterMode.Advanced" 
                        EmptyText="No donations found">
            <Columns>
                <RadzenDataGridColumn TItem="UserDataDonations" Property="Account" Title="Account" />
                <RadzenDataGridColumn TItem="UserDataDonations" Property="Donor" Title="Donor" />
                <RadzenDataGridColumn TItem="UserDataDonations" Property="Date" Title="Date" FormatString="{0:MM/dd/yyyy}" />
                <RadzenDataGridColumn TItem="UserDataDonations" Property="Amount" Title="Amount" FormatString="{0:C2}" />
                <RadzenDataGridColumn TItem="UserDataDonations" Property="Frequency" Title="Frequency" />
                <RadzenDataGridColumn TItem="UserDataDonations" Property="TransactionType" Title="Transaction Type" />
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenStack>

@code {
    List<DonationsDataModel> donationData;
    List<string> userAccountsSimple = new List<string>();
    List<UserDataDonations> donations = new List<UserDataDonations>();
    List<UserDataDonations> selectedDonations = new List<UserDataDonations>();
    List<AccountNameOptions> userAccounts = new List<AccountNameOptions>();
    List<DonationsDataModel> accountDonationsData = new List<DonationsDataModel>();
    public DateTime startDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1, 0, 0, 0);
    public DateTime endDate = DateTime.Now;

    public string selectedAccount;
    private string? staffMember;
    private List<UserData> staff = new List<UserData>();

    string selection = "";
    public async Task accountSelection(string accountName)
    {
        if (string.IsNullOrEmpty(accountName)) return;
        
        selectedAccount = accountName;
        Console.WriteLine($"TESTING: {selectedAccount}");
        await getAccount();
    }

    public async Task getAccount()
    {
        Console.WriteLine($"GET ACCOUNT Selected Account: {selectedAccount}"); 
        foreach (var account in userAccounts)
        {
            if (account.Name == selectedAccount)
            {
                selection = account.WholeString;
                Console.WriteLine($"SELECTION BEFORE BREAK: {selection}");
                break;
            }
        }
        string sql = $"select * from etapestry where fund = @Fund";
        donationData = await _data.LoadData<DonationsDataModel, dynamic>(sql, new {Fund = selection}, _config.GetConnectionString("default"));
        if (donationData != null)
        {
            Console.WriteLine($"Total donationData records: {donationData.Count}");
            proccessDonations();
        }
        else
        {
            Console.WriteLine("No data returned from the SQL query.");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        string sql3 = "select distinct fund from etapestry";

        userAccountsSimple = await _data.LoadData<string, dynamic>(sql3, new { }, _config.GetConnectionString("default"));
        if (userAccountsSimple != null)
        {
            foreach (var account in userAccountsSimple)
            {
                if (account.Contains(":"))
                {
                    string[] accountSplit = account.Split(":");
                    var accountOptions = new AccountNameOptions(account, accountSplit[0], accountSplit[1]);
                    userAccounts.Add(accountOptions);
                }
                else
                {
                    var accountOptions = new AccountNameOptions(account, account, account);
                    userAccounts.Add(accountOptions);
                }
            }
        }
    }

    public void proccessDonations()
    {
        Console.WriteLine($"About to Process: Donations: {donations.Count}");
        donations.Clear(); // Clear the list to avoid duplicate entries
        Console.WriteLine($"Second Count: {donations.Count}"); 
        Console.WriteLine($"Processing donations..."); 
        foreach (var donation in donationData)
        {
            int seperator = donation.fund.IndexOf(":");
            
            if (seperator > 0)
            {
                var newDonation = new UserDataDonations(
                    donation.fund.Remove(seperator, donation.fund.Length - seperator), 
                    donation.accountname, 
                    donation.date, 
                    donation.amount, 
                    donation.recurring, 
                    donation.gifttype);
                donations.Add(newDonation);
            }
            else
            {
                var newDonation = new UserDataDonations(
                    donation.fund,
                    donation.accountname,
                    donation.date,
                    donation.amount,
                    donation.recurring,
                    donation.gifttype);
                donations.Add(newDonation);
            }
        }
        Console.WriteLine($"Total donations processed: {donations.Count}");
        selectDateRange();
    }

    List<UserDataDonations> selectedData = new List<UserDataDonations>();
    List<DateTime> selectedDates = new List<DateTime>();
    
    public List<UserDataDonations> SelectData(List<UserDataDonations> data, DateTime? start = null, DateTime? end = null)
    {
        if (start == null && end == null)
        {
            return data;
        }
        else if (start != null && end == null)
        {
            return data.Where(d => d.Date >= start).ToList();
        }
        else if (start == null && end != null)
        {
            return data.Where(d => d.Date <= end).ToList();
        }
        else
        {
            return data.Where(d => d.Date >= start && d.Date <= end).ToList();
        }
    }
    
    public void selectDateRange()
    {
        selectedDonations = SelectData(donations, startDate, endDate);
        Console.WriteLine("DATA SELECTED");
        Console.WriteLine($"Start: {startDate} End: {endDate}");
    }
}
