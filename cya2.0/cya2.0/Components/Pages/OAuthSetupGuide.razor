@page "/oauth-setup-guide"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Google OAuth Setup Guide</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3><i class="bi bi-gear me-2"></i>Google OAuth Configuration Guide</h3>
                </div>
                <div class="card-body p-4">
                    
                    <div class="alert alert-info">
                        <h5><i class="bi bi-info-circle me-2"></i>Current Status</h5>
                        <p>Your application is configured to use User Secrets for Google OAuth. Follow these steps to complete the setup.</p>
                    </div>
                    
                    <h4>Step 1: Get Google OAuth Credentials</h4>
                    <ol class="mt-3">
                        <li><strong>Go to Google Cloud Console:</strong>
                            <ul>
                                <li>Visit <a href="https://console.cloud.google.com/" target="_blank">Google Cloud Console</a></li>
                                <li>Create a new project or select an existing one</li>
                            </ul>
                        </li>
                        <li><strong>Enable Google+ API:</strong>
                            <ul>
                                <li>Go to "APIs & Services" → "Library"</li>
                                <li>Search for "Google+ API" and enable it</li>
                                <li>Also enable "Google Identity Services API" if available</li>
                            </ul>
                        </li>
                        <li><strong>Create OAuth 2.0 Credentials:</strong>
                            <ul>
                                <li>Go to "APIs & Services" → "Credentials"</li>
                                <li>Click "Create Credentials" → "OAuth 2.0 Client IDs"</li>
                                <li>Application type: "Web application"</li>
                                <li>Name: "CYA Application"</li>
                            </ul>
                        </li>
                        <li><strong>Configure Redirect URIs:</strong>
                            <p>Add these authorized redirect URIs:</p>
                            <div class="bg-light p-3 rounded">
                                <code>https://localhost:7243/signin-google</code><br>
                                <code>http://localhost:5211/signin-google</code><br>
                                <small class="text-muted">Add your production domain when deploying</small>
                            </div>
                        </li>
                        <li><strong>Get Your Credentials:</strong>
                            <ul>
                                <li>Copy the <strong>Client ID</strong> (ends with .apps.googleusercontent.com)</li>
                                <li>Copy the <strong>Client Secret</strong></li>
                            </ul>
                        </li>
                    </ol>

                    <h4 class="mt-4">Step 2: Update User Secrets</h4>
                    <p>Run these commands in your terminal from the project root:</p>
                    
                    <div class="bg-dark text-light p-3 rounded mb-3">
                        <div class="mb-2">
                            <strong># Set your actual Google Client ID</strong><br>
                            <code>dotnet user-secrets set "Authentication:Google:ClientId" "YOUR_ACTUAL_CLIENT_ID.apps.googleusercontent.com" --project .\cya2.0</code>
                        </div>
                        <div>
                            <strong># Set your actual Google Client Secret</strong><br>
                            <code>dotnet user-secrets set "Authentication:Google:ClientSecret" "YOUR_ACTUAL_CLIENT_SECRET" --project .\cya2.0</code>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <h6><i class="bi bi-exclamation-triangle me-2"></i>Important Notes</h6>
                        <ul class="mb-0">
                            <li>Replace <code>YOUR_ACTUAL_CLIENT_ID</code> and <code>YOUR_ACTUAL_CLIENT_SECRET</code> with your real Google OAuth credentials</li>
                            <li>User Secrets are stored locally on your machine and are not committed to version control</li>
                            <li>For production deployment, use environment variables or Azure Key Vault</li>
                        </ul>
                    </div>

                    <h4 class="mt-4">Step 3: Database Setup</h4>
                    <div class="alert alert-success">
                        <h6><i class="bi bi-database me-2"></i>Database Requirements</h6>
                        <p>Ensure you have:</p>
                        <ul class="mb-0">
                            <li>MySQL/MariaDB running and accessible</li>
                            <li>Database named "cya" created</li>
                            <li>Users table with your Google email pre-registered</li>
                            <li>Proper AuthLevel set (Admin, Viewer, or User)</li>
                        </ul>
                    </div>

                    <h4 class="mt-4">Step 4: Testing</h4>
                    <ol>
                        <li>Restart your application after updating User Secrets</li>
                        <li>Navigate to the home page</li>
                        <li>You should be redirected to Google OAuth</li>
                        <li>After successful authentication, you'll be redirected back to your app</li>
                    </ol>

                    <h4 class="mt-4">Current Configuration Status</h4>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-body">
                                    <h6 class="card-title">User Secrets Configured</h6>
                                    <p class="card-text text-success"><i class="bi bi-check-circle me-1"></i>Ready for your OAuth credentials</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-body">
                                    <h6 class="card-title">Application Configuration</h6>
                                    <p class="card-text text-success"><i class="bi bi-check-circle me-1"></i>OAuth integration configured</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-center">
                        <a href="/api/auth-status" class="btn btn-info me-3" target="_blank">
                            <i class="bi bi-info-circle me-1"></i>Check Auth Status
                        </a>
                        <a href="/dev-login" class="btn btn-secondary">
                            <i class="bi bi-code me-1"></i>Development Login
                        </a>
                    </div>

                    <div class="mt-4 p-3 bg-light rounded">
                        <h6><i class="bi bi-question-circle me-2"></i>Need Help?</h6>
                        <p class="mb-0">
                            If you encounter issues:
                        </p>
                        <ul class="mt-2 mb-0">
                            <li>Check the console logs for detailed error messages</li>
                            <li>Verify your redirect URIs exactly match what's in Google Cloud Console</li>
                            <li>Ensure your database connection is working</li>
                            <li>Make sure your email is pre-registered in the Users table</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>