{
    <RadzenCard class="mt-4">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.H5">@Localizer["Account"]</RadzenText>
            
            <RadzenDropDown TValue="string"
                            Data="@dashboardData.UserAccounts"
                            TextProperty="DisplayName"
                            ValueProperty="Fund"
                            Value="@selectedAccount"
                            Change="@accountSelection"
                            Placeholder="@Localizer["ChooseAccount"]"
                            Style="width: 250px;">
                <ValueTemplate>
                    @(dashboardData.UserAccounts.FirstOrDefault(a => a.Fund == selectedAccount)?.DisplayName ?? selectedAccount)
                </ValueTemplate>
                <Template Context="acct">
                    @acct.DisplayName
                </Template>
            </RadzenDropDown>
        </RadzenStack>
    </RadzenCard>

    @if (dashboardData.HasAccountData)
    {
        <!-- Financial summaries cards -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Class="mt-4" JustifyContent="JustifyContent.SpaceBetween" Style="overflow-x: auto;">
            <!-- Current Month -->
            <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                <RadzenCard Style="height: 100%;">
                    <RadzenText TextStyle="TextStyle.H5">@Localizer["CurrentMonth"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@dashboardData.CurrentMonth.Period</RadzenText>
                    
                    <RadzenStack Gap="0.5rem" Class="mt-3">
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@dashboardData.CurrentMonth.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@dashboardData.CurrentMonth.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@dashboardData.CurrentMonth.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@dashboardData.CurrentMonth.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["Balance"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle1">
                                <span class="fw-bold" style="font-size:1.1em;">
                                    @Math.Abs(dashboardData.CurrentMonth.Balance).ToString("C", CultureInfo.CurrentCulture)
                                    @(dashboardData.CurrentMonth.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                </span>
                            </RadzenText>
                        </div>
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
            
            <!-- Prior Month -->
