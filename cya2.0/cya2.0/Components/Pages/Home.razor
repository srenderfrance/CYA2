                                        @(dashboardData.PriorMonth.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                    </span>
                                </RadzenText>
                            </div>
                        </div>
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>

            <!-- Year Summary (Current) -->
