    private void DebugBalanceCalculation()
    {
        var now = DateTime.Now;
        DateTime targetDate = new DateTime(2024, 12, 31);
        decimal expectedBalance = 9709.88m;
        
        // Hardcoded adjustment values
        decimal startingBalance = 7812.65m;
        decimal missingDonations = 9000.00m;
        decimal actualOverhead = -24065.88m;
        
        // Calculate with adjusted logic
        decimal calculatedBalance = CalculateBalanceAsOfDate(targetDate, startingBalance);
        decimal discrepancy = calculatedBalance - expectedBalance;
        
        // Get detailed breakdowns by year
        var yearlyDonations = donations
            .GroupBy(d => d.Date.Year)
            .OrderBy(g => g.Key)
            .Select(g => new { Year = g.Key, Amount = g.Sum(d => d.Amount), Count = g.Count() })
            .ToList();
        
        var yearlyExpenses = accountingData
            .Where(a => TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a))
            .GroupBy(a => a.date.Year)
            .OrderBy(g => g.Key)
            .Select(g => new { Year = g.Key, Amount = g.Sum(a => Math.Abs((decimal)a.amount)), Count = g.Count() })
            .ToList();
        
        var yearlyOtherExpenses = accountingData
            .Where(a => TransactionCategorizer.IsOtherExpense(a) && !TransactionCategorizer.IsFundraising(a))
            .GroupBy(a => a.date.Year)
            .OrderBy(g => g.Key)
            .Select(g => new { Year = g.Key, Amount = g.Sum(a => Math.Abs((decimal)a.amount)), Count = g.Count() })
            .ToList();
        
        var yearlyInternalTransfers = accountingData
            .Where(a => TransactionCategorizer.IsInternalTransfer(a))
            .GroupBy(a => a.date.Year)
            .OrderBy(g => g.Key)
            .Select(g => new { Year = g.Key, Amount = g.Sum(a => Math.Abs((decimal)a.amount)), Count = g.Count() })
            .ToList();
        
        var yearlyFundraising = accountingData
            .Where(a => TransactionCategorizer.IsFundraising(a))
            .GroupBy(a => a.date.Year)
            .OrderBy(g => g.Key)
            .Select(g => new { Year = g.Key, Amount = g.Sum(a => Math.Abs((decimal)a.amount)), Count = g.Count() })
            .ToList();
        
        // Generate report
        Console.WriteLine("\n===== DETAILED BALANCE ANALYSIS =====");
        Console.WriteLine($"Analysis Date: {now.ToShortDateString()}");
        Console.WriteLine($"Target Date: {targetDate.ToShortDateString()}");
        Console.WriteLine($"Expected Balance: ${expectedBalance:N2}");
        Console.WriteLine($"Calculated Balance: ${calculatedBalance:N2}");
        Console.WriteLine($"Discrepancy: ${discrepancy:N2} ({(discrepancy/expectedBalance)*100:N2}%)");
        
        Console.WriteLine("\n----- SUMMARY OF CALCULATIONS -----");
        Console.WriteLine($"Starting Balance: ${startingBalance:N2}");
        
        // Total donations up to target date
        decimal totalDonations = donations.Where(d => d.Date <= targetDate).Sum(d => d.Amount);
        Console.WriteLine($"+ Adjusted Donations (with +${missingDonations:N2} missing): ${totalDonations + missingDonations:N2}");
        
        // Total expenses up to target date
        decimal totalExpenses = accountingData
            .Where(a => a.date <= targetDate && 
                      TransactionCategorizer.IsExpense(a) && 
                      !TransactionCategorizer.IsFundraising(a))
            .Sum(a => Math.Abs((decimal)a.amount));
        Console.WriteLine($"- Expenses (2020 onwards only): ${totalExpenses:N2}");
        
        // Total other expenses up to target date
        decimal totalOtherExpenses = accountingData
            .Where(a => a.date <= targetDate && 
                      TransactionCategorizer.IsOtherExpense(a) && 
                      !TransactionCategorizer.IsFundraising(a))
            .Sum(a => Math.Abs((decimal)a.amount));
        Console.WriteLine($"+ Other Expenses (fees, 2020 onwards): ${totalOtherExpenses:N2}");
        
        // Total internal transfers up to target date
        decimal totalInternalTransfers = accountingData
            .Where(a => a.date <= targetDate && TransactionCategorizer.IsInternalTransfer(a))
            .Sum(a => Math.Abs((decimal)a.amount));
        Console.WriteLine($"+ Internal Transfers (2020 onwards): ${totalInternalTransfers:N2}");
        
        Console.WriteLine($"+ Overhead Adjustment: ${actualOverhead:N2}");
        Console.WriteLine($"= Corrected Balance: ${calculatedBalance:N2}");
        
        Console.WriteLine("\n----- YEARLY BREAKDOWN -----");
        
        Console.WriteLine("\nDONATIONS BY YEAR:");
        foreach (var year in yearlyDonations)
        {
            Console.WriteLine($"  {year.Year}: ${year.Amount:N2} ({year.Count} transactions)");
        }
        
        Console.WriteLine("\nEXPENSES BY YEAR:");
        foreach (var year in yearlyExpenses)
        {
            Console.WriteLine($"  {year.Year}: ${year.Amount:N2} ({year.Count} transactions)");
        }
        
        Console.WriteLine("\nOTHER EXPENSES BY YEAR:");
        foreach (var year in yearlyOtherExpenses)
        {
            Console.WriteLine($"  {year.Year}: ${year.Amount:N2} ({year.Count} transactions)");
        }
        
        Console.WriteLine("\nINTERNAL TRANSFERS BY YEAR:");
        foreach (var year in yearlyInternalTransfers)
        {
            Console.WriteLine($"  {year.Year}: ${year.Amount:N2} ({year.Count} transactions)");
        }
        
        Console.WriteLine("\nFUNDRAISING BY YEAR:");
        foreach (var year in yearlyFundraising)
        {
            Console.WriteLine($"  {year.Year}: ${year.Amount:N2} ({year.Count} transactions)");
        }
        
        // Let's check for any unusually large transactions
        Console.WriteLine("\n----- LARGEST TRANSACTIONS -----");
        
        Console.WriteLine("\nLARGEST DONATIONS (TOP 5):");
        foreach (var donation in donations.OrderByDescending(d => d.Amount).Take(5))
        {
            Console.WriteLine($"  {donation.Date:MM/dd/yyyy}: ${donation.Amount:N2} - Fund: {donation.Fund}");
        }
        
        Console.WriteLine("\nLARGEST EXPENSES (TOP 5):");
        foreach (var expense in accountingData
            .Where(a => TransactionCategorizer.IsExpense(a))
            .OrderByDescending(a => Math.Abs((decimal)a.amount))
            .Take(5))
        {
            Console.WriteLine($"  {expense.date:MM/dd/yyyy}: ${Math.Abs((decimal)expense.amount):N2} - Account: {expense.account}");
        }
        
        Console.WriteLine("\nLARGEST INTERNAL TRANSFERS (TOP 5):");
        foreach (var transfer in accountingData
            .Where(a => TransactionCategorizer.IsInternalTransfer(a))
            .OrderByDescending(a => Math.Abs((decimal)a.amount))
            .Take(5))
        {
            Console.WriteLine($"  {transfer.date:MM/dd/yyyy}: ${Math.Abs((decimal)transfer.amount):N2} - Account: {transfer.account}");
        }
        
        // Calculate running balance at various points to see where discrepancy occurs
        Console.WriteLine("\n----- RUNNING BALANCE CHECKPOINTS -----");
        int[] checkpointYears = { 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024 };
        
        foreach (int year in checkpointYears)
        {
            DateTime checkpointDate = new DateTime(year, 12, 31);
            decimal checkpointBalance = CalculateBalanceAsOfDate(checkpointDate, startingBalance);
            Console.WriteLine($"Balance as of {checkpointDate:MM/dd/yyyy}: ${checkpointBalance:N2}");
        }
    }
