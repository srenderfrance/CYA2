}

@code {
    // Clean Architecture Pattern - Component uses only service abstractions
    private string userName = string.Empty;
    private bool isLoading = true;
    private string selectedAccount = string.Empty;
    private bool isAdminUser = false;
    
    // Single source of truth from clean architecture service
    private FinancialDashboardDto dashboardData = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                // Extract user info from claims
                var authLevel = user.FindFirstValue("AuthLevel") ?? string.Empty;
                isAdminUser = user.IsInRole("Admin") || string.Equals(authLevel, "Admin", StringComparison.OrdinalIgnoreCase);
                userName = user.FindFirstValue("UserName") ??
                    user.FindFirstValue(ClaimTypes.GivenName) ?? 
                    user.FindFirstValue(ClaimTypes.Name) ?? 
                    user.Identity?.Name ?? 
                    user.FindFirstValue(ClaimTypes.Email) ?? 
                    "User";

                // Get user identifier for service calls
                var userId = user.FindFirstValue(ClaimTypes.Email) ?? 
                            user.FindFirstValue("UserId") ?? 
                            user.Identity.Name ?? 
                            string.Empty;

                // Load dashboard data through clean architecture service
                dashboardData = await DashboardService.GetDashboardDataAsync("", userId);
                
                // Set initial selected account
                selectedAccount = dashboardData.SelectedAccount;
            }

            isLoading = false;
        }
        catch (Exception ex)
        {
            // Clean error handling - no console logs in production
            isLoading = false;
            // Could inject ILogger here for proper logging
        }
    }

    private async Task accountSelection(object args)
    {
        try
        {
            var accountName = args?.ToString() ?? string.Empty;
            if (string.IsNullOrEmpty(accountName) || accountName == selectedAccount) return;

            isLoading = true;
            StateHasChanged();

            selectedAccount = accountName;
            
            // Get user identifier
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirstValue(ClaimTypes.Email) ?? 
                        user.FindFirstValue("UserId") ?? 
                        user.Identity?.Name ?? 
                        string.Empty;

            // Reload dashboard data through clean architecture service
            dashboardData = await DashboardService.GetDashboardDataAsync(selectedAccount, userId);

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            isLoading = false;
            StateHasChanged();
            // Could inject ILogger here for proper logging
        }
    }
}}