                                </RadzenText>
                            </div>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                            <div class="text-end">
                                <RadzenText TextStyle="TextStyle.Body1">
                                    <span class="fw-bold">@dashboardData.PriorMonth.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span>
                                </RadzenText>
                            </div>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["Balance"]</RadzenText>
                            <div class="text-end">
