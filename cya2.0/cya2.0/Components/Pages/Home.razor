@page "/"
@page "/account-summaries"
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@rendermode InteractiveServer
@attribute [StreamRendering]
@using System.Security.Claims
@using System.Threading
@using System.Globalization
@inject IDataAccess _data
@inject IConfiguration _config
@using ModelsLibrary
@inject AppState AppState
@inject DataLoadingService DataLoader
@inject PageAccountCache PageCache
@inject AuthenticationStateProvider AuthStateProvider
@using UtilityClasses
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<Resource> Localizer

<PageTitle>@Localizer["CYAHome"]</PageTitle>

<h1 class="h3">
    @Localizer["WelcomeUser", userName]
    @if (AppState.IsAdmin)
    {
        <span class="badge bg-danger ms-2">@Localizer["AdminMode"]</span>
    }
</h1>

@if (isLoading)
{
    <div class="mt-4">
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <p class="text-muted mt-2">@Localizer["Loading"]</p>
    </div>
}
else if (userAccounts.Count == 0)
{
    <div class="alert alert-info mt-4">
        <h4>@Localizer["NoAccountFound"]</h4>
        <p>@Localizer["NoAccountMessage"]</p>
        <p>@Localizer["ContactAdmin"]</p>
    </div>
}
else
{
    <RadzenCard class="mt-4">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.H5">@Localizer["Account"]</RadzenText>
            
            <RadzenDropDown TValue="string"
                            Data="@userAccounts"
                            TextProperty="Fund"
                            ValueProperty="Fund"
                            Value="@selectedAccount"
                            Change="@(args => accountSelection(args?.ToString() ?? string.Empty))"
                            Placeholder="@Localizer["ChooseAccount"]"
                            Style="width: 250px;" />
        </RadzenStack>
    </RadzenCard>

    @if (hasAccountData)
    {
        <!-- Financial summaries cards -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Class="mt-4" JustifyContent="JustifyContent.SpaceBetween" Style="overflow-x: auto;">
            <!-- Current Month -->
            <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                <RadzenCard Style="height: 100%;">
                    <RadzenText TextStyle="TextStyle.H5">@Localizer["CurrentMonth"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@currentMonthSummary.Period</RadzenText>
                    
                    <RadzenStack Gap="0.5rem" Class="mt-3">
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@currentMonthSummary.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@currentMonthSummary.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@currentMonthSummary.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@currentMonthSummary.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["Balance"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle1">
                                <span class="fw-bold" style="font-size:1.1em;">
                                    @Math.Abs(currentMonthSummary.Balance).ToString("C", CultureInfo.CurrentCulture)
                                    @(currentMonthSummary.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                </span>
                            </RadzenText>
                        </div>
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
            
            <!-- Prior Month -->
            <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                <RadzenCard Style="height: 100%;">
                    <RadzenText TextStyle="TextStyle.H5">@Localizer["PriorMonth"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@priorMonthSummary.Period</RadzenText>
                    
                    <RadzenStack Gap="0.5rem" Class="mt-3">
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                            <div class="text-end">
                                <RadzenText TextStyle="TextStyle.Body1">
                                    <span class="fw-bold">@priorMonthSummary.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span>
                                </RadzenText>
                            </div>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                            <div class="text-end">
                                <RadzenText TextStyle="TextStyle.Body1">
                                    <span class="fw-bold">@priorMonthSummary.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span>
                                </RadzenText>
                            </div>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@priorMonthSummary.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                <span class="fw-bold">@priorMonthSummary.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span>
                            </RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["EndBalance"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle1">
                                <span class="fw-bold" style="font-size:1.1em;">
                                    @Math.Abs(priorMonthSummary.Balance).ToString("C", CultureInfo.CurrentCulture)
                                    @(priorMonthSummary.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                </span>
                            </RadzenText>
                        </div>
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
            
            <!-- Current Year -->
            <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                <RadzenCard Style="height: 100%;">
                    <RadzenText TextStyle="TextStyle.H5">@Localizer["CurrentYear"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@currentYearSummary.Period</RadzenText>
                    
                    <RadzenStack Gap="0.75rem" Class="mt-3">
                        <div>
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                            <div class="text-end">
                                <div>
                                    <span>@Localizer["Total"]:</span>
                                    <span class="fw-bold ms-1">@currentYearSummary.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span>
                                </div>
                                <div class="text-muted" style="font-size: .85em;">
                                    <span>@Localizer["MonthlyAverage"]:</span>
                                    <span class="fw-bold ms-1">@currentYearSummary.AvgMonthlyDonations.ToString("C", CultureInfo.CurrentCulture)</span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-2" />
                        
                        <div>
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                            <div class="text-end">
                                <div>
                                    <span>@Localizer["Total"]:</span>
                                    <span class="fw-bold ms-1">@currentYearSummary.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span>
                                </div>
                                <div class="text-muted" style="font-size: .85em;">
                                    <span>@Localizer["MonthlyAverage"]:</span>
                                    <span class="fw-bold ms-1">@currentYearSummary.AvgMonthlyExpenses.ToString("C", CultureInfo.CurrentCulture)</span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@currentYearSummary.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@currentYearSummary.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["CurrentBalance"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle1">
                                <span class="fw-bold" style="font-size:1.1em;">
                                    @Math.Abs(currentYearSummary.Balance).ToString("C", CultureInfo.CurrentCulture)
                                    @(currentYearSummary.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                </span>
                            </RadzenText>
                        </div>
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
            
            <!-- Prior Year -->
            <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                <RadzenCard Style="height: 100%;">
                    <RadzenText TextStyle="TextStyle.H5">@Localizer["PriorYear"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@priorYearSummary.Period</RadzenText>
                    
                    <RadzenStack Gap="0.75rem" Class="mt-3">
                        <div>
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                            <div class="text-end">
                                <div>
                                    <span>@Localizer["Total"]:</span>
                                    <span class="fw-bold ms-1">@priorYearSummary.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span>
                                </div>
                                <div class="text-muted" style="font-size: .85em;">
                                    <span>@Localizer["MonthlyAverage"]:</span>
                                    <span class="fw-bold ms-1">@priorYearSummary.AvgMonthlyDonations.ToString("C", CultureInfo.CurrentCulture)</span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-2" />
                        
                        <div>
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                            <div class="text-end">
                                <div>
                                    <span>@Localizer["Total"]:</span>
                                    <span class="fw-bold ms-1">@priorYearSummary.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span>
                                </div>
                                <div class="text-muted" style="font-size: .85em;">
                                    <span>@Localizer["MonthlyAverage"]:</span>
                                    <span class="fw-bold ms-1">@priorYearSummary.AvgMonthlyExpenses.ToString("C", CultureInfo.CurrentCulture)</span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@priorYearSummary.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between">
                            <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@priorYearSummary.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                        </div>

                        <hr class="my-2" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["EndOfYearBalance"]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Subtitle1">
                                <span class="fw-bold" style="font-size:1.1em;">
                                    @Math.Abs(priorYearSummary.Balance).ToString("C", CultureInfo.CurrentCulture)
                                    @(priorYearSummary.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                </span>
                            </RadzenText>
                        </div>
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
        </RadzenStack>
    }
    else if (!string.IsNullOrEmpty(selectedAccount))
    {
        <div class="alert alert-info mt-4">
            <h4>@Localizer["Loading"]</h4>
            <p>Loading account data...</p>
        </div>
    }
}

@code {
    private string userName = string.Empty;
    private bool isLoading = true;
    private bool hasAccountData = false;
    private List<Account> userAccounts = new();
    private string selectedAccount = string.Empty;
    private List<DonationData> donations = new List<DonationData>();
    private List<AccountingDataModel> accountingData = new List<AccountingDataModel>();
    private FinancialSummary currentMonthSummary = new FinancialSummary();
    private FinancialSummary priorMonthSummary = new FinancialSummary();
    private FinancialSummary currentYearSummary = new FinancialSummary();
    private FinancialSummary priorYearSummary = new FinancialSummary();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                userName = user.FindFirstValue("UserName") ??
                    user.FindFirstValue(ClaimTypes.GivenName) ?? 
                    user.FindFirstValue(ClaimTypes.Name) ?? 
                    user.Identity?.Name ?? 
                    user.FindFirstValue(ClaimTypes.Email) ?? 
                    "User";

                // Only initialize if not already loaded (first time login)
                if (!AppState.UserAccountsLoaded)
                {
                    await DataLoader.InitializeUserDataAsync(user);
                }
                
                userAccounts = AppState.UserAccounts;
                
                // Use SelectedAccount from AppState (preserves cross-page navigation)
                // Fall back to DefaultAccount if no selection has been made
                selectedAccount = !string.IsNullOrEmpty(AppState.SelectedAccount) 
                    ? AppState.SelectedAccount 
                    : AppState.DefaultAccount;

                if (!string.IsNullOrEmpty(selectedAccount))
                {
                    await LoadAccountData(selectedAccount);
                }
            }

            isLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"HOME DEBUG: Error in OnInitializedAsync: {ex.Message}");
            Console.WriteLine($"HOME DEBUG: Stack trace: {ex.StackTrace}");
            isLoading = false;
        }
    }

    private async Task LoadAccountData(string accountFund)
    {
        try
        {
            hasAccountData = false;
            
            // Check if data is already in AppState cache first
            if (AppState.IsAccountDataLoaded(accountFund))
            {
                var cachedData = AppState.AccountDataCache[accountFund];
                accountingData = cachedData.AccountingData;
                donations = cachedData.DonationData.Select(d => new DonationData
                {
                    Id = d.Id,
                    Date = d.Date,
                    Amount = (decimal)d.Amount,
                    Fund = d.Fund
                }).ToList();

                hasAccountData = true;
                CalculateStatisticsFromCache();
                return;
            }
            
            // Fallback to PageCache if not in AppState
            var pageAccountData = await PageCache.GetAccountDataAsync(accountFund);
            
            if (pageAccountData != null)
            {
                accountingData = pageAccountData.AccountingData;
                donations = pageAccountData.DonationData.Select(d => new DonationData
                {
                    Id = d.Id,
                    Date = d.Date,
                    Amount = (decimal)d.Amount,
                    Fund = d.Fund
                }).ToList();

                hasAccountData = true;
                CalculateStatisticsFromCache();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"HOME DEBUG: Error loading account data: {ex.Message}");
        }
    }

    public async Task accountSelection(string accountName)
    {
        if (string.IsNullOrEmpty(accountName) || accountName == selectedAccount) return;

        isLoading = true;
        hasAccountData = false;
        StateHasChanged();

        selectedAccount = accountName;
        AppState.SelectedAccount = accountName; // Update AppState for cross-page navigation

        await LoadAccountData(accountName);

        isLoading = false;
        StateHasChanged();
    }

    private void CalculateStatisticsFromCache()
    {
        try
        {
            DateTime now = DateTime.Now;
            
            // Get current balance from Account model in AppState (persisted balance)
            var account = userAccounts.FirstOrDefault(a => a.Fund == selectedAccount);
            decimal currentBalance = account?.Balance ?? 0m;
            
            // Calculate other balances using cached data instead of database calls
            DateTime priorMonthEnd = new DateTime(now.Year, now.Month, 1).AddDays(-1);
            decimal priorMonthBalance = CalculateBalanceFromCachedData(priorMonthEnd);
            
            DateTime priorYearEnd = new DateTime(now.Year - 1, 12, 31);
            decimal priorYearBalance = CalculateBalanceFromCachedData(priorYearEnd);

            CalculateCurrentMonthSummary(now, currentBalance);
            CalculatePriorMonthSummary(now, priorMonthBalance);
            CalculateCurrentYearSummary(now, currentBalance);
            CalculatePriorYearSummary(now, priorYearBalance);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating statistics: {ex.Message}");
        }
    }

    private decimal CalculateBalanceFromCachedData(DateTime asOfDate)
    {
        try
        {
            // Get the account's persisted balance
            var account = userAccounts.FirstOrDefault(a => a.Fund == selectedAccount);
            if (account == null) return 0m;
            
            // Calculate balance by taking all transactions up to the date
            // This is a simplified calculation using cached data
            var transactionsUpToDate = accountingData
                .Where(t => t.Date <= asOfDate)
                .OrderBy(t => t.Date)
                .ToList();
            
            decimal calculatedBalance = 0m;
            foreach (var transaction in transactionsUpToDate)
            {
                calculatedBalance += (decimal)transaction.Amount;
            }
            
            return calculatedBalance;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating balance from cached data: {ex.Message}");
            return 0m;
        }
    }

    private void CalculateCurrentMonthSummary(DateTime now, decimal currentBalance)
    {
        var monthlyAccountingData = accountingData
            .Where(a => a.Date.Year == now.Year && a.Date.Month == now.Month)
            .ToList();

        var categorized = TransactionCategorizer.CategorizeTransactions(monthlyAccountingData);
        
        decimal monthlyExpenses = categorized.ExpenseTotal;
        decimal monthlyInternalTransfers = categorized.TransferTotal;
        decimal monthlyOther = categorized.OtherTotal;

        decimal monthlyIncome = monthlyOther;

        currentMonthSummary = new FinancialSummary
        {
            TotalDonations = monthlyIncome,
            TotalExpenses = monthlyExpenses,
            TotalOverhead = monthlyIncome - monthlyExpenses,
            InternalTransfers = monthlyInternalTransfers,
            Period = now.ToString("MMMM yyyy"),
            Balance = currentBalance
        };
    }

    private void CalculatePriorMonthSummary(DateTime now, decimal priorMonthBalance)
    {
        DateTime priorMonth = now.AddMonths(-1);

        var monthlyAccountingData = accountingData
            .Where(a => a.Date.Year == priorMonth.Year && a.Date.Month == priorMonth.Month)
            .ToList();

        var categorized = TransactionCategorizer.CategorizeTransactions(monthlyAccountingData);
        
        decimal monthlyExpenses = categorized.ExpenseTotal;
        decimal monthlyInternalTransfers = categorized.TransferTotal;
        decimal monthlyIncome = categorized.OtherTotal;

        priorMonthSummary = new FinancialSummary
        {
            TotalDonations = monthlyIncome,
            TotalExpenses = monthlyExpenses,
            TotalOverhead = monthlyIncome - monthlyExpenses,
            InternalTransfers = monthlyInternalTransfers,
            AvgMonthlyDonations = monthlyIncome,
            AvgMonthlyExpenses = monthlyExpenses,
            Period = priorMonth.ToString("MMMM yyyy"),
            Balance = priorMonthBalance
        };
    }

    private void CalculateCurrentYearSummary(DateTime now, decimal currentBalance)
    {
        var yearlyAccountingData = accountingData
            .Where(a => a.Date.Year == now.Year)
            .ToList();

        var categorized = TransactionCategorizer.CategorizeTransactions(yearlyAccountingData);
        
        decimal yearlyExpenses = categorized.ExpenseTotal;
        decimal yearlyInternalTransfers = categorized.TransferTotal;
        decimal yearlyIncome = categorized.OtherTotal;

        int monthsInYear = Math.Min(now.Month, 12);
        decimal avgMonthlyDonations = monthsInYear > 0 ? yearlyIncome / monthsInYear : 0;
        decimal avgMonthlyExpenses = monthsInYear > 0 ? yearlyExpenses / monthsInYear : 0;

        currentYearSummary = new FinancialSummary
        {
            TotalDonations = yearlyIncome,
            TotalExpenses = yearlyExpenses,
            TotalOverhead = yearlyIncome - yearlyExpenses,
            InternalTransfers = yearlyInternalTransfers,
            AvgMonthlyDonations = avgMonthlyDonations,
            AvgMonthlyExpenses = avgMonthlyExpenses,
            Period = now.ToString("yyyy"),
            Balance = currentBalance
        };
    }

    private void CalculatePriorYearSummary(DateTime now, decimal priorYearBalance)
    {
        int priorYear = now.Year - 1;

        var yearlyAccountingData = accountingData
            .Where(a => a.Date.Year == priorYear)
            .ToList();

        var categorized = TransactionCategorizer.CategorizeTransactions(yearlyAccountingData);
        
        decimal yearlyExpenses = categorized.ExpenseTotal;
        decimal yearlyInternalTransfers = categorized.TransferTotal;
        decimal yearlyIncome = categorized.OtherTotal;

        decimal avgMonthlyDonations = yearlyIncome / 12;
        decimal avgMonthlyExpenses = yearlyExpenses / 12;

        priorYearSummary = new FinancialSummary
        {
            TotalDonations = yearlyIncome,
            TotalExpenses = yearlyExpenses,
            TotalOverhead = yearlyIncome - yearlyExpenses,
            InternalTransfers = yearlyInternalTransfers,
            AvgMonthlyDonations = avgMonthlyDonations,
            AvgMonthlyExpenses = avgMonthlyExpenses,
            Period = priorYear.ToString(),
            Balance = priorYearBalance
        };
    }

    private class FinancialSummary
    {
        public decimal TotalDonations { get; set; }
        public decimal TotalExpenses { get; set; }
        public decimal TotalOverhead { get; set; }
        public decimal InternalTransfers { get; set; }
        public decimal AvgMonthlyDonations { get; set; }
        public decimal AvgMonthlyExpenses { get; set; }
        public decimal Balance { get; set; }
        public string Period { get; set; } = string.Empty;
    }

    private class DonationData
    {
        public int Id { get; set; }
        public DateTime Date { get; set; }
        public decimal Amount { get; set; }
        public string Fund { get; set; } = string.Empty;
    }
}