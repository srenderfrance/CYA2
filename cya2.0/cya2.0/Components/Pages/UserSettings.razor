@page "/usersettings"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject AuthenticationStateProvider AuthStateProvider
@inject IDataAccess _data
@inject IConfiguration _config
@inject NavigationManager NavigationManager
@inject AppState AppState
@using ModelsLibrary
@rendermode InteractiveServer
@inject IStringLocalizer<Resource> Localizer
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Localizer["UserSettings"]</PageTitle>

<div class="container mt-4">
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H3">@Localizer["UserSettings"]</RadzenText>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled" Class="mt-3 mb-3">
                @Localizer[errorMessage]
            </RadzenAlert>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Filled" Class="mt-3 mb-3">
                @Localizer[successMessage]
            </RadzenAlert>
        }

        <!-- Use RadzenStack with Horizontal orientation instead of Bootstrap row/col -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Class="mt-4">
            <!-- Default Account Column -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 48%;">
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["DefaultAccount"]</RadzenText>
                        
                        <RadzenText TextStyle="TextStyle.Body2">
                            @Localizer["CurrentDefault"]: <strong>@GetAccountDisplayName(currentDefaultAccountId)</strong>
                        </RadzenText>
                        
                        <RadzenDropDown TValue="string"
                                        Data="@userAccounts"
                                        TextProperty="Name"
                                        ValueProperty="AccountRef"
                                        @bind-Value="selectedAccountRef"
                                        Placeholder="@Localizer["SelectDefaultAccount"]"
                                        Style="width: 100%;"
                                        Disabled="@(userAccounts == null || userAccounts.Count == 0)" />
                        
                        <RadzenButton Text="@Localizer["UpdateAccount"]"
                                      Click="SaveAccountSetting"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Medium"
                                      Style="width: fit-content;"
                                      Disabled="@(isSavingAccount || !HasAccountChanges())" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
            
            <!-- Language Preference Column -->
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 48%;">
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["LanguagePreference"]</RadzenText>
                        
                        <RadzenText TextStyle="TextStyle.Body2">
                            @Localizer["CurrentLanguage"]: <strong>@GetLanguageDisplayName(currentLanguage)</strong>
                        </RadzenText>
                        
                        <RadzenDropDown TValue="string"
                                        Data="@languageOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        @bind-Value="selectedLanguage"
                                        Style="width: 100%;" />
                        
                        <RadzenButton Text="@Localizer["UpdateLanguage"]"
                                      Click="SaveLanguageSetting"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Medium"
                                      Style="width: fit-content;"
                                      Disabled="@(isSavingLanguage || !HasLanguageChanges())" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
</div>

@if (showLogoutButton)
{
    <a href="/logout" class="btn btn-outline-danger">Logout</a>
}

@code {
    private int userId;
    private int? currentDefaultAccountId;
    private List<Account> userAccounts = new List<Account>();
    private List<LanguageOption> languageOptions = new List<LanguageOption>
    {
        new LanguageOption { Value = "en-US", Text = "English" },
        new LanguageOption { Value = "es-US", Text = "Spanish" }
    };
    private string errorMessage;
    private string successMessage;
    private bool isSavingAccount = false;
    private bool isSavingLanguage = false;
    private bool showLogoutButton = true;
    private string currentLanguage = "en-US";
    private string selectedAccountRef;
    private string selectedLanguage = "en-US";

    protected override async Task OnInitializedAsync()
    {
        // Language options already set above
        await LoadUserData();
    }

    private async Task LoadUserData()
    {
        try
        {
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity.IsAuthenticated)
            {
                // Get user ID from claims
                var userIdClaim = user.FindFirstValue("UserId");
                if (!string.IsNullOrEmpty(userIdClaim) && int.TryParse(userIdClaim, out int id))
                {
                    userId = id;
                    Console.WriteLine($"[DEBUG] User ID from claims: {userId}");
                }
                else
                {
                    var email = user.FindFirstValue(ClaimTypes.Email);
                    Console.WriteLine($"[DEBUG] User ID claim not found, using email: {email} for DB lookup");

                    string userSql = "SELECT Id FROM Users WHERE Email = @Email";
                    var userResults = await _data.LoadData<UserIdOnly, dynamic>(
                        userSql,
                        new { Email = email },
                        _config.GetConnectionString("default")
                    );

                    if (userResults != null && userResults.Any())
                    {
                        userId = userResults.First().Id;
                        Console.WriteLine($"[DEBUG] User ID from database: {userId}");
                    }
                    else
                    {
                        errorMessage = "Unable to find user information.";
                        return;
                    }
                }

                // Get language from claims or use default
                var lang = GetCurrentCultureFromCookie();
                currentLanguage = lang;
                selectedLanguage = currentLanguage;

                Console.WriteLine($"[DEBUG] currentLanguage: {currentLanguage}");
                Console.WriteLine($"[DEBUG] selectedLanguage: {selectedLanguage}");

                // Log language options
                foreach (var opt in languageOptions)
                {
                    Console.WriteLine($"[DEBUG] languageOptions: Value={opt.Value}, Text={opt.Text}");
                }

                // Log what GetLanguageDisplayName returns
                Console.WriteLine($"[DEBUG] GetLanguageDisplayName(currentLanguage): {GetLanguageDisplayName(currentLanguage)}");

                // Get default account ID from claims (stored as an integer)
                var defaultAccountClaim = user.FindFirstValue("DefaultAccount");
                currentDefaultAccountId = null;

                if (!string.IsNullOrEmpty(defaultAccountClaim) && int.TryParse(defaultAccountClaim, out int parsedId))
                {
                    currentDefaultAccountId = parsedId;
                }

                await LoadUserAccounts();

                if (currentDefaultAccountId.HasValue)
                {
                    var defaultAccount = userAccounts.FirstOrDefault(a => a.AccountId == currentDefaultAccountId.Value);
                    if (defaultAccount != null)
                    {
                        selectedAccountRef = defaultAccount.AccountRef;
                        AppState.DefaultAccount = defaultAccount.Name;
                    }
                }
            }
            else
            {
                NavigationManager.NavigateTo("/", true);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading user data: {ex.Message}";
            Console.WriteLine($"[DEBUG] Exception in LoadUserData: {ex}");
        }
    }

    private async Task LoadUserAccounts()
    {
        try
        {
            // Query for accounts the user has access to
            string sql = @"
                SELECT a.AccountId, a.Name, a.AccountRef, a.CreatedAt
                FROM Accounts a
                INNER JOIN AccountsUsers au ON a.AccountId = au.AccountId
                WHERE au.UserId = @UserId
                ORDER BY a.Name";

            var accounts = await _data.LoadData<Account, dynamic>(
                sql,
                new { UserId = userId },
                _config.GetConnectionString("default")
            );

            if (accounts != null && accounts.Any())
            {
                userAccounts = accounts;

                // Validate that current default account exists in user's accounts
                if (currentDefaultAccountId.HasValue &&
                    !userAccounts.Any(a => a.AccountId == currentDefaultAccountId.Value))
                {
                    errorMessage = "Your currently set default account is no longer accessible. Please select a new one.";
                    currentDefaultAccountId = null;
                    selectedAccountRef = null;
                }
            }
            else
            {
                userAccounts = new List<Account>();
                errorMessage = "You don't have access to any accounts. Please contact an administrator.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading accounts: {ex.Message}";
        }
    }

    private bool HasAccountChanges()
    {
        // Compare AccountRef for current default and selection
        var currentAccountRef = userAccounts
            .FirstOrDefault(a => a.AccountId == currentDefaultAccountId)?.AccountRef;

        return selectedAccountRef != currentAccountRef;
    }

    private bool HasLanguageChanges()
    {
        return selectedLanguage != currentLanguage;
    }

    private async Task SaveAccountSetting()
    {
        try
        {
            isSavingAccount = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            Console.WriteLine($"Saving account setting for user ID: {userId}");
            Console.WriteLine($"Current default account ID: {currentDefaultAccountId}, Selected account ref: {selectedAccountRef}");

            // Find the AccountId that corresponds to the selected AccountRef
            int? newAccountId = null;
            string newAccountName = null;
            if (!string.IsNullOrEmpty(selectedAccountRef))
            {
                var selectedAccountObj = userAccounts.FirstOrDefault(a => a.AccountRef == selectedAccountRef);
                if (selectedAccountObj != null)
                {
                    newAccountId = selectedAccountObj.AccountId;
                    newAccountName = selectedAccountObj.Name;
                }
            }

            if (newAccountId == currentDefaultAccountId)
            {
                successMessage = "No changes were made to your default account.";
                return;
            }

            string sql = "UPDATE Users SET DefaultAccount = ";
            var parameters = new Dictionary<string, object>();

            // Add the ID for WHERE clause
            parameters.Add("Id", userId);

            if (newAccountId.HasValue)
            {
                sql += "@DefaultAccount WHERE Id = @Id";
                parameters.Add("DefaultAccount", newAccountId.Value);
            }
            else
            {
                sql += "NULL WHERE Id = @Id";
            }

            Console.WriteLine($"SQL Query: {sql}");
            foreach (var param in parameters)
            {
                Console.WriteLine($"Parameter: {param.Key} = {param.Value}");
            }

            // Execute update
            int result = await _data.SaveData(
                sql,
                parameters,
                _config.GetConnectionString("default")
            );

            Console.WriteLine($"Update result: {result}");

            if (result > 0)
            {
                // Update AppState with the new default account
                if (!string.IsNullOrEmpty(newAccountName))
                {
                    AppState.DefaultAccount = newAccountName;
                }
                else
                {
                    AppState.DefaultAccount = string.Empty;
                }

                successMessage = "Default account updated successfully. Changes applied immediately.";
                currentDefaultAccountId = newAccountId;
            }
            else
            {
                errorMessage = $"Failed to update default account: {_data.LastError}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving account setting: {ex.Message}";
            Console.WriteLine($"Exception in SaveAccountSetting: {ex}");
        }
        finally
        {
            isSavingAccount = false;
        }
    }

    private async Task SaveLanguageSetting()
    {
        try
        {
            isSavingLanguage = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            // Only allow "en-US" or "es-US"
            var langToSave = selectedLanguage == "es-US" ? "es-US" : "en-US";

            if (langToSave == currentLanguage)
            {
                successMessage = Localizer["NoLanguageChange"];
                return;
            }

            string sql = "UPDATE Users SET Language = @Language WHERE Id = @Id";
            var parameters = new Dictionary<string, object>
            {
                { "Id", userId },
                { "Language", langToSave }
            };

            int result = await _data.SaveData(
                sql,
                parameters,
                _config.GetConnectionString("default")
            );

            if (result > 0)
            {
                // Update AppState (if you store language there)
                // AppState.Language = langToSave; // Add this property if needed

                // Set the culture cookie so the new language takes effect immediately
                await JS.InvokeVoidAsync("blazorCulture.set", langToSave);

                // Optionally, update currentLanguage and show a message
                currentLanguage = langToSave;
                successMessage = Localizer["LanguageUpdated"];
                // Refresh the browser to apply the new culture
                NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
            }
            else
            {
                errorMessage = Localizer["LanguageUpdateFailed"];
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{Localizer["ErrorSavingLanguage"]} {ex.Message}";
        }
        finally
        {
            isSavingLanguage = false;
        }
    }

    private void LogoutUser()
    {
        NavigationManager.NavigateTo("/logout", true);
    }

    private string GetLanguageDisplayName(string code)
    {
        var language = languageOptions.FirstOrDefault(l => l.Value == code);
        Console.WriteLine($"[DEBUG] GetLanguageDisplayName input: {code}, found: {language?.Text}");
        return language?.Text ?? code;
    }

    private string GetAccountDisplayName(int? accountId)
    {
        if (!accountId.HasValue)
            return "None";

        var account = userAccounts.FirstOrDefault(a => a.AccountId == accountId.Value);
        return account?.Name ?? "Unknown Account";
    }

    private class LanguageOption
    {
        public string Value { get; set; }
        public string Text { get; set; }
    }

    // Simple class just for ID retrieval
    private class UserIdOnly
    {
        public int Id { get; set; }
    }

    private string GetCurrentCultureFromCookie()
    {
        var cookie = HttpContextAccessor.HttpContext?.Request?.Cookies[".AspNetCore.Culture"];
        if (string.IsNullOrEmpty(cookie))
            return "en-US";
        var match = System.Text.RegularExpressions.Regex.Match(cookie, @"c=([a-zA-Z\-]+)");
        return match.Success ? match.Groups[1].Value : "en-US";
    }
}