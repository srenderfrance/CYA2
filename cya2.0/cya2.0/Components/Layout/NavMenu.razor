@inject NavigationManager NavigationManager
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IDataAccess DataAccess
@inject IConfiguration Config
@rendermode InteractiveServer

<CascadingAuthenticationState>
    <!-- Increase the spacing between nav items -->
    <div class="navbar">
        <div class="nav-item px-4">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> CYA Home
            </NavLink>
        </div>

        <div class="nav-item px-3 d-flex navbar-group">
            <div class="nav-item px-5 nav-link-block">
                <NavLink class="nav-link" href="donations">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Donations
                </NavLink>
            </div>
            <div class="nav-item px-5 nav-link-block">
                <NavLink class="nav-link" href="expenses">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Expenses
                </NavLink>
            </div>
            <div class="nav-item px-5 nav-link-block">
                <NavLink class="nav-link" href="donors">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Donors
                </NavLink>
            </div>
        </div>

        <div class="nav-item px-3 d-flex navbar-group">
            <div class="nav-item px-5 nav-link-block">
                <NavLink class="nav-link" href="usersettings">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Settings
                </NavLink>
            </div>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="nav-item px-5 nav-link-block">
                        <NavLink class="nav-link" href="/admin" Match="NavLinkMatch.All">
                            <span class="bi bi-shield-lock-nav-menu" aria-hidden="true"></span> Admin
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="nav-item px-4">
            <a href="/logout" class="nav-link">
                <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Logout
            </a>
        </div>
    </div>

    @if (_showConnectionError)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Class="rz-m-2">
            <RadzenText TextStyle="TextStyle.Subtitle1">Database connection issues detected.</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">Some features may be unavailable until connection is restored.</RadzenText>
        </RadzenAlert>
    }
</CascadingAuthenticationState>

@code {
    private bool _showConnectionError = false;
    private ErrorBoundary _errorBoundary;
    
    protected override void OnInitialized()
    {
        // Initialize error boundary
        _errorBoundary = new ErrorBoundary();
    }
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check database connection but don't throw if it fails
            var connectionString = Config.GetConnectionString("default");
            if (!string.IsNullOrEmpty(connectionString))
            {
                _showConnectionError = !(await DataAccess.CheckConnection(connectionString));
            }
        }
        catch (Exception)
        {
            _showConnectionError = true;
        }
    }
    
    // Reset error boundary when parameters change
    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }
}
