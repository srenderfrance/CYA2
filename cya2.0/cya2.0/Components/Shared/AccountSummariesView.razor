@using ModelsLibrary
@using UtilityClasses
@using System.Globalization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<Resource> Localizer
@* CLEAN ARCHITECTURE INTEGRATION - Migrated from legacy DataAccess patterns *@
@using Cya2.Application.Interfaces
@using Cya2.Application.DTOs
@inject IFinancialDashboardService DashboardService

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-3" Style="height:100%; overflow:auto;">
    @if (_loading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText TextStyle="TextStyle.Body2">@Localizer["Loading"]</RadzenText>
    }
    else if (!_dashboardData.UserAccounts.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Filled">@Localizer["NoAccountFound"]</RadzenAlert>
    }
    else
    {
        <RadzenCard class="mt-2">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.H5">@Localizer["Account"]</RadzenText>

                <RadzenDropDown TValue="string"
                                Data="@_dashboardData.UserAccounts"
                                TextProperty="DisplayName"
                                ValueProperty="Fund"
                                @bind-Value="_selectedAccountName"
                                @bind-Value:after="OnAccountChangedAsync"
                                Placeholder="@Localizer["ChooseAccount"]"
                                Style="width: 250px;">
                    <ValueTemplate>
                        @(_dashboardData.UserAccounts.FirstOrDefault(a => a.Fund == _selectedAccountName)?.DisplayName ?? _selectedAccountName)
                    </ValueTemplate>
                    <Template Context="acct">
                        @acct.DisplayName
                    </Template>
                </RadzenDropDown>

            </RadzenStack>
        </RadzenCard>

        @if (_dashboardData.HasAccountData)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Class="mt-4" JustifyContent="JustifyContent.SpaceBetween" Style="overflow-x: auto;">
                <!-- Current Month -->
                <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["CurrentMonth"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Subtitle2">@_dashboardData.CurrentMonth.Period</RadzenText>

                        <RadzenStack Gap="0.5rem" Class="mt-3">
                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.CurrentMonth.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.CurrentMonth.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.CurrentMonth.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.CurrentMonth.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between align-items-center">
                                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["Balance"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <span class="fw-bold" style="font-size:1.1em;">
                                        @Math.Abs(_dashboardData.CurrentMonth.Balance).ToString("C", CultureInfo.CurrentCulture)
                                        @(_dashboardData.CurrentMonth.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                    </span>
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>

                <!-- Prior Month -->
                <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["PriorMonth"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Subtitle2">@_dashboardData.PriorMonth.Period</RadzenText>

                        <RadzenStack Gap="0.5rem" Class="mt-3">
                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                                <div class="text-end">
                                    <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.PriorMonth.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                                <div class="text-end">
                                    <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.PriorMonth.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.PriorMonth.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.PriorMonth.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between align-items-center">
                                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["EndBalance"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <span class="fw-bold" style="font-size:1.1em;">
                                        @Math.Abs(_dashboardData.PriorMonth.Balance).ToString("C", CultureInfo.CurrentCulture)
                                        @(_dashboardData.PriorMonth.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                    </span>
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>

                <!-- Current Year -->
                <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["CurrentYear"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Subtitle2">@_dashboardData.CurrentYear.Period</RadzenText>

                        <RadzenStack Gap="0.75rem" Class="mt-3">
                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                                <div class="text-end">
                                    <div><span>@Localizer["Total"]:</span><span class="fw-bold ms-1">@_dashboardData.CurrentYear.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                    <div class="text-muted" style="font-size: .85em;"><span>@Localizer["MonthlyAverage"]:</span><span class="fw-bold ms-1">@_dashboardData.CurrentYear.AvgMonthlyDonations.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                                <div class="text-end">
                                    <div><span>@Localizer["Total"]:</span><span class="fw-bold ms-1">@_dashboardData.CurrentYear.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                    <div class="text-muted" style="font-size: .85em;"><span>@Localizer["MonthlyAverage"]:</span><span class="fw-bold ms-1">@_dashboardData.CurrentYear.AvgMonthlyExpenses.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.CurrentYear.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.CurrentYear.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between align-items-center">
                                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["CurrentBalance"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <span class="fw-bold" style="font-size:1.1em;">
                                        @Math.Abs(_dashboardData.CurrentYear.Balance).ToString("C", CultureInfo.CurrentCulture)
                                        @(_dashboardData.CurrentYear.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                    </span>
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>

                <!-- Prior Year -->
                <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["PriorYear"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Subtitle2">@_dashboardData.PriorYear.Period</RadzenText>

                        <RadzenStack Gap="0.75rem" Class="mt-3">
                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                                <div class="text-end">
                                    <div><span>@Localizer["Total"]:</span><span class="fw-bold ms-1">@_dashboardData.PriorYear.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                    <div class="text-muted" style="font-size: .85em;"><span>@Localizer["MonthlyAverage"]:</span><span class="fw-bold ms-1">@_dashboardData.PriorYear.AvgMonthlyDonations.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                                <div class="text-end">
                                    <div><span>@Localizer["Total"]:</span><span class="fw-bold ms-1">@_dashboardData.PriorYear.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                    <div class="text-muted" style="font-size: .85em;"><span>@Localizer["MonthlyAverage"]:</span><span class="fw-bold ms-1">@_dashboardData.PriorYear.AvgMonthlyExpenses.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.PriorYear.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_dashboardData.PriorYear.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between align-items-center">
                                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["EndOfYearBalance"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <span class="fw-bold" style="font-size:1.1em;">
                                        @Math.Abs(_dashboardData.PriorYear.Balance).ToString("C", CultureInfo.CurrentCulture)
                                        @(_dashboardData.PriorYear.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                    </span>
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenStack>
        }
    }
</RadzenStack>

@code {
    // Clean Architecture Pattern - Component uses only service abstractions
    private bool _loading = true;
    private string? _selectedAccountName;
    
    // Single source of truth from clean architecture service
    private FinancialDashboardDto _dashboardData = new();

    [Parameter] public string? DefaultAccountName { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                // Get user identifier for service calls
                var userId = user.FindFirstValue(ClaimTypes.Email) ?? 
                            user.FindFirstValue("UserId") ?? 
                            user.Identity.Name ?? 
                            string.Empty;

                // Load dashboard data through clean architecture service
                var initialAccount = DefaultAccountName ?? string.Empty;
                _dashboardData = await DashboardService.GetDashboardDataAsync(initialAccount, userId);
                
                // Set initial selected account
                _selectedAccountName = !string.IsNullOrEmpty(DefaultAccountName) ? DefaultAccountName : _dashboardData.SelectedAccount;
            }

            _loading = false;
        }
        catch (Exception ex)
        {
            // Clean error handling - no console logs in production
            _loading = false;
        }
    }

    private async Task OnAccountChangedAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(_selectedAccountName)) return;

            _loading = true;
            StateHasChanged();

            // Get user identifier
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirstValue(ClaimTypes.Email) ?? 
                        user.FindFirstValue("UserId") ?? 
                        user.Identity?.Name ?? 
                        string.Empty;

            // Reload dashboard data through clean architecture service
            _dashboardData = await DashboardService.GetDashboardDataAsync(_selectedAccountName, userId);

            _loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _loading = false;
            StateHasChanged();
        }
    }
}