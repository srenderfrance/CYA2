@using ModelsLibrary
@using UtilityClasses
@inject AppState AppState
@inject DataLoadingService DataLoader
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<Resource> Localizer

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-3"
             Style="height:100%; overflow:auto;">
    <RadzenText TextStyle="TextStyle.H5">@Localizer["AccountSummaries"]</RadzenText>

    @if (_loading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText TextStyle="TextStyle.Body2">@Localizer["Loading"]</RadzenText>
    }
    else if (!_accounts.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Filled">
            @Localizer["NoAccountFound"]
        </RadzenAlert>
    }
    else
    {
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.H6">@Localizer["Account"]</RadzenText>
                <RadzenDropDown TValue="string"
                                Data="@_accounts"
                                TextProperty="Name"
                                ValueProperty="Name"
                                Value="@_selectedAccountName"
                                Change="@(args => OnAccountSelection(args?.ToString()))"
                                Placeholder="@Localizer["ChooseAccount"]"
                                Style="width: 280px;" />
            </RadzenStack>
        </RadzenCard>

        @if (_selectedAccount != null)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Class="mt-4" Style="overflow-x:auto;">
                <!-- Current Month -->
                <RadzenCard Style="min-width: 260px;">
                    <RadzenText TextStyle="TextStyle.H5">@Localizer["CurrentMonth"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@_currentMonth.Period</RadzenText>
                    @SummaryRows(_currentMonth, Localizer["Balance"])
                </RadzenCard>

                <!-- Prior Month -->
                <RadzenCard Style="min-width: 260px;">
                    <RadzenText TextStyle="TextStyle.H5">@Localizer["PriorMonth"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@_priorMonth.Period</RadzenText>
                    @SummaryRows(_priorMonth, Localizer["EndBalance"])
                </RadzenCard>

                <!-- Current Year -->
                <RadzenCard Style="min-width: 260px;">
                    <RadzenText TextStyle="TextStyle.H5">@Localizer["CurrentYear"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@_currentYear.Period</RadzenText>
                    @SummaryRows(_currentYear, Localizer["CurrentBalance"])
                </RadzenCard>

                <!-- Prior Year -->
                <RadzenCard Style="min-width: 260px;">
                    <RadzenText TextStyle="TextStyle.H5">@Localizer["PriorYear"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2">@_priorYear.Period</RadzenText>
                    @SummaryRows(_priorYear, Localizer["EndOfYearBalance"])
                </RadzenCard>
            </RadzenStack>
        }
    }
</RadzenStack>

@code {
    private bool _loading = true;
    private List<Account> _accounts = new();
    private string? _selectedAccountName;
    private Account? _selectedAccount;

    // data sources
    private List<AccountingDataModel> _accounting = new();
    private List<DonationData> _donations = new();

    // summaries
    private FinancialSummary _currentMonth = new();
    private FinancialSummary _priorMonth = new();
    private FinancialSummary _currentYear = new();
    private FinancialSummary _priorYear = new();

    [Parameter] public string? DefaultAccountName { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!user.Identity?.IsAuthenticated ?? true)
        {
            _loading = false;
            return;
        }

        // Initialize user data (same as Home)
        await DataLoader.InitializeUserDataAsync(user);

        _accounts = AppState.UserAccounts ?? new List<Account>();

        // choose default
        _selectedAccountName = DefaultAccountName ?? AppState.DefaultAccount ?? _accounts.FirstOrDefault()?.Name;

        if (!string.IsNullOrEmpty(_selectedAccountName))
        {
            await LoadAccountAndCompute(_selectedAccountName);
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task OnAccountSelection(string? accountName)
    {
        if (string.IsNullOrEmpty(accountName)) return;
        _loading = true;
        StateHasChanged();

        await LoadAccountAndCompute(accountName);

        _loading = false;
        StateHasChanged();
    }

    private async Task LoadAccountAndCompute(string accountName)
    {
        _selectedAccountName = accountName;
        _selectedAccount = _accounts.FirstOrDefault(a => a.Name == accountName);
        AppState.DefaultAccount = accountName;

        if (_selectedAccount != null && !AppState.IsAccountDataLoaded(accountName))
        {
            await DataLoader.LoadAccountDataAsync(_selectedAccount);
        }

        if (_selectedAccount != null && AppState.IsAccountDataLoaded(accountName))
        {
            var cache = AppState.AccountDataCache[accountName];
            _accounting = cache.AccountingData;
            _donations = cache.DonationData?.Select(d => new DonationData
            {
                Id = d.id,
                Date = d.date,
                Amount = (decimal)d.amount,
                Fund = d.fund
            }).ToList() ?? new List<DonationData>();

            ComputeSummaries();
        }
    }

    private void ComputeSummaries()
    {
        // You already have mature summary code in Home.razor.
        // For brevity, replicate the same logic patterns here.
        DateTime now = DateTime.Now;

        decimal startingBalance = 7812.65m;
        decimal currentBalance = CalculateBalanceAsOfDate(now, startingBalance);
        DateTime priorMonthEnd = new DateTime(now.Year, now.Month, 1).AddDays(-1);
        decimal priorMonthBalance = CalculateBalanceAsOfDate(priorMonthEnd, startingBalance);
        DateTime priorYearEnd = new DateTime(now.Year - 1, 12, 31);
        decimal priorYearBalance = CalculateBalanceAsOfDate(priorYearEnd, startingBalance);

        CalculateCurrentMonthSummary(now, currentBalance);
        CalculatePriorMonthSummary(now, priorMonthBalance);
        CalculateCurrentYearSummary(now, currentBalance);
        CalculatePriorYearSummary(now, priorYearBalance);
    }

    private decimal CalculateBalanceAsOfDate(DateTime asOfDate, decimal originalStartingBalance)
    {
        // mirror Home.razor
        decimal startingBalance = 7812.65m;
        decimal missingDonations = 9000.00m;
        decimal actualOverhead = -24065.88m;
        var cutoffDate = new DateTime(2020, 1, 1);
        if (asOfDate < cutoffDate) return startingBalance;

        decimal totalDonations = _donations.Where(d => d.Date <= asOfDate && d.Date >= cutoffDate).Sum(d => d.Amount);
        totalDonations += missingDonations;

        decimal totalExpenses = _accounting.Where(a => a.date <= asOfDate && a.date >= cutoffDate && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal totalOtherExpenses = _accounting.Where(a => a.date <= asOfDate && a.date >= cutoffDate && TransactionCategorizer.IsOtherExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal totalInternalTransfers = _accounting.Where(a => a.date <= asOfDate && a.date >= cutoffDate && TransactionCategorizer.IsInternalTransfer(a) && !TransactionCategorizer.IsOtherExpense(a)).Sum(a => Math.Abs((decimal)a.amount));

        decimal calculatedBalance = startingBalance + totalDonations - totalExpenses + totalOtherExpenses + totalInternalTransfers + actualOverhead;
        return calculatedBalance;
    }

    private void CalculateCurrentMonthSummary(DateTime now, decimal currentBalance)
    {
        decimal monthlyDonations = _donations.Where(d => d.Date.Year == now.Year && d.Date.Month == now.Month).Sum(d => d.Amount);
        decimal monthlyFundraising = _accounting.Where(a => a.date.Year == now.Year && a.date.Month == now.Month && TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal monthlyExpenses = _accounting.Where(a => a.date.Year == now.Year && a.date.Month == now.Month && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal monthlyInternalTransfers = _accounting.Where(a => a.date.Year == now.Year && a.date.Month == now.Month && TransactionCategorizer.IsInternalTransfer(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal overhead = monthlyDonations - monthlyFundraising;

        _currentMonth = new FinancialSummary
        {
            TotalDonations = monthlyDonations,
            TotalExpenses = monthlyExpenses,
            TotalOverhead = overhead,
            InternalTransfers = monthlyInternalTransfers,
            Period = now.ToString("MMMM yyyy"),
            Balance = currentBalance
        };
    }

    private void CalculatePriorMonthSummary(DateTime now, decimal priorMonthBalance)
    {
        DateTime priorMonth = now.AddMonths(-1);
        decimal monthlyDonations = _donations.Where(d => d.Date.Year == priorMonth.Year && d.Date.Month == priorMonth.Month).Sum(d => d.Amount);
        decimal monthlyFundraising = _accounting.Where(a => a.date.Year == priorMonth.Year && a.date.Month == priorMonth.Month && TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal monthlyExpenses = _accounting.Where(a => a.date.Year == priorMonth.Year && a.date.Month == priorMonth.Month && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal monthlyInternalTransfers = _accounting.Where(a => a.date.Year == priorMonth.Year && a.date.Month == priorMonth.Month && TransactionCategorizer.IsInternalTransfer(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal overhead = monthlyDonations - monthlyFundraising;

        _priorMonth = new FinancialSummary
        {
            TotalDonations = monthlyDonations,
            TotalExpenses = monthlyExpenses,
            TotalOverhead = overhead,
            InternalTransfers = monthlyInternalTransfers,
            AvgMonthlyDonations = monthlyDonations,
            AvgMonthlyExpenses = monthlyExpenses,
            Period = priorMonth.ToString("MMMM yyyy"),
            Balance = priorMonthBalance
        };
    }

    private void CalculateCurrentYearSummary(DateTime now, decimal currentBalance)
    {
        int monthsInYear = Math.Min(now.Month, 12);
        decimal yearlyDonations = _donations.Where(d => d.Date.Year == now.Year).Sum(d => d.Amount);
        decimal yearlyFundraising = _accounting.Where(a => a.date.Year == now.Year && TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal yearlyExpenses = _accounting.Where(a => a.date.Year == now.Year && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal yearlyInternalTransfers = _accounting.Where(a => a.date.Year == now.Year && TransactionCategorizer.IsInternalTransfer(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal overhead = yearlyDonations - yearlyFundraising;
        decimal avgMonthlyDonations = monthsInYear > 0 ? yearlyDonations / monthsInYear : 0;
        decimal avgMonthlyExpenses = monthsInYear > 0 ? yearlyExpenses / monthsInYear : 0;

        _currentYear = new FinancialSummary
        {
            TotalDonations = yearlyDonations,
            TotalExpenses = yearlyExpenses,
            TotalOverhead = overhead,
            InternalTransfers = yearlyInternalTransfers,
            AvgMonthlyDonations = avgMonthlyDonations,
            AvgMonthlyExpenses = avgMonthlyExpenses,
            Period = now.ToString("yyyy"),
            Balance = currentBalance
        };
    }

    private void CalculatePriorYearSummary(DateTime now, decimal priorYearBalance)
    {
        int priorYear = now.Year - 1;
        decimal yearlyDonations = _donations.Where(d => d.Date.Year == priorYear).Sum(d => d.Amount);
        decimal yearlyFundraising = _accounting.Where(a => a.date.Year == priorYear && TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal yearlyExpenses = _accounting.Where(a => a.date.Year == priorYear && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal yearlyInternalTransfers = _accounting.Where(a => a.date.Year == priorYear && TransactionCategorizer.IsInternalTransfer(a)).Sum(a => Math.Abs((decimal)a.amount));
        decimal overhead = yearlyDonations - yearlyFundraising;

        _priorYear = new FinancialSummary
        {
            TotalDonations = yearlyDonations,
            TotalExpenses = yearlyExpenses,
            TotalOverhead = overhead,
            InternalTransfers = yearlyInternalTransfers,
            AvgMonthlyDonations = yearlyDonations / 12,
            AvgMonthlyExpenses = yearlyExpenses / 12,
            Period = priorYear.ToString(),
            Balance = priorYearBalance
        };
    }

    private RenderFragment SummaryRows(FinancialSummary s, string balanceLabel) => builder =>
    {
        void Row(string label, string value)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "d-flex justify-content-between");
            builder.OpenComponent<RadzenText>(2);
            builder.AddAttribute(3, "TextStyle", TextStyle.Body1);
            builder.AddContent(4, label);
            builder.CloseComponent();
            builder.OpenComponent<RadzenText>(5);
            builder.AddAttribute(6, "TextStyle", TextStyle.Body1);
            builder.AddContent(7, value);
            builder.CloseComponent();
            builder.CloseElement();
        }

        Row(Localizer["Donations"], s.TotalDonations.ToString("N2"));
        Row(Localizer["Expenses"], s.TotalExpenses.ToString("N2"));
        Row(Localizer["Overhead"], s.TotalOverhead.ToString("N2"));
        Row(Localizer["InternalTransfers"], s.InternalTransfers.ToString("N2"));
        Row(balanceLabel, Math.Abs(s.Balance).ToString("C"));
    };

    private class FinancialSummary
    {
        public decimal TotalDonations { get; set; }
        public decimal TotalExpenses { get; set; }
        public decimal TotalOverhead { get; set; }
        public decimal InternalTransfers { get; set; }
        public decimal AvgMonthlyDonations { get; set; }
        public decimal AvgMonthlyExpenses { get; set; }
        public decimal Balance { get; set; }
        public string Period { get; set; } = string.Empty;
    }

    private class DonationData
    {
        public int Id { get; set; }
        public DateTime Date { get; set; }
        public decimal Amount { get; set; }
        public string Fund { get; set; } = string.Empty;
    }
}