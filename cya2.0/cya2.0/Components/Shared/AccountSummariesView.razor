@using ModelsLibrary
@using UtilityClasses
@using System.Globalization
@inject AppState AppState
@inject DataLoadingService DataLoader
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<Resource> Localizer

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-3" Style="height:100%; overflow:auto;">
    @if (_loading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText TextStyle="TextStyle.Body2">@Localizer["Loading"]</RadzenText>
    }
    else if (!_accounts.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Filled">@Localizer["NoAccountFound"]</RadzenAlert>
    }
    else
    {
        <RadzenCard class="mt-2">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.H5">@Localizer["Account"]</RadzenText>

                <RadzenDropDown TValue="string"
                                Data="@_accounts"
                                TextProperty="Fund"
                                ValueProperty="Fund"
                                @bind-Value="_selectedAccountName"
                                @bind-Value:after="OnAccountChangedAsync"
                                Placeholder="@Localizer["ChooseAccount"]"
                                Style="width: 250px;" />

            </RadzenStack>
        </RadzenCard>

        @if (_selectedAccount != null)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Class="mt-4" JustifyContent="JustifyContent.SpaceBetween" Style="overflow-x: auto;">
                <!-- Current Month -->
                <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["CurrentMonth"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Subtitle2">@_currentMonth.Period</RadzenText>

                        <RadzenStack Gap="0.5rem" Class="mt-3">
                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_currentMonth.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_currentMonth.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_currentMonth.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_currentMonth.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between align-items-center">
                                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["Balance"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <span class="fw-bold" style="font-size:1.1em;">
                                        @Math.Abs(_currentMonth.Balance).ToString("C", CultureInfo.CurrentCulture)
                                        @(_currentMonth.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                    </span>
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>

                <!-- Prior Month -->
                <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["PriorMonth"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Subtitle2">@_priorMonth.Period</RadzenText>

                        <RadzenStack Gap="0.5rem" Class="mt-3">
                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                                <div class="text-end">
                                    <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_priorMonth.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                                <div class="text-end">
                                    <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_priorMonth.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_priorMonth.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_priorMonth.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between align-items-center">
                                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["EndBalance"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <span class="fw-bold" style="font-size:1.1em;">
                                        @Math.Abs(_priorMonth.Balance).ToString("C", CultureInfo.CurrentCulture)
                                        @(_priorMonth.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                    </span>
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>

                <!-- Current Year -->
                <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["CurrentYear"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Subtitle2">@_currentYear.Period</RadzenText>

                        <RadzenStack Gap="0.75rem" Class="mt-3">
                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                                <div class="text-end">
                                    <div><span>@Localizer["Total"]:</span><span class="fw-bold ms-1">@_currentYear.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                    <div class="text-muted" style="font-size: .85em;"><span>@Localizer["MonthlyAverage"]:</span><span class="fw-bold ms-1">@_currentYear.AvgMonthlyDonations.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                                <div class="text-end">
                                    <div><span>@Localizer["Total"]:</span><span class="fw-bold ms-1">@_currentYear.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                    <div class="text-muted" style="font-size: .85em;"><span>@Localizer["MonthlyAverage"]:</span><span class="fw-bold ms-1">@_currentYear.AvgMonthlyExpenses.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_currentYear.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_currentYear.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between align-items-center">
                                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["CurrentBalance"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <span class="fw-bold" style="font-size:1.1em;">
                                        @Math.Abs(_currentYear.Balance).ToString("C", CultureInfo.CurrentCulture)
                                        @(_currentYear.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                    </span>
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>

                <!-- Prior Year -->
                <RadzenStack Orientation="Orientation.Vertical" Style="width: 24%; min-width: 260px;">
                    <RadzenCard Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">@Localizer["PriorYear"]</RadzenText>
                        <RadzenText TextStyle="TextStyle.Subtitle2">@_priorYear.Period</RadzenText>

                        <RadzenStack Gap="0.75rem" Class="mt-3">
                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Donations"]</RadzenText>
                                <div class="text-end">
                                    <div><span>@Localizer["Total"]:</span><span class="fw-bold ms-1">@_priorYear.TotalDonations.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                    <div class="text-muted" style="font-size: .85em;"><span>@Localizer["MonthlyAverage"]:</span><span class="fw-bold ms-1">@_priorYear.AvgMonthlyDonations.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Expenses"]</RadzenText>
                                <div class="text-end">
                                    <div><span>@Localizer["Total"]:</span><span class="fw-bold ms-1">@_priorYear.TotalExpenses.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                    <div class="text-muted" style="font-size: .85em;"><span>@Localizer["MonthlyAverage"]:</span><span class="fw-bold ms-1">@_priorYear.AvgMonthlyExpenses.ToString("C", CultureInfo.CurrentCulture)</span></div>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["Overhead"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_priorYear.TotalOverhead.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between">
                                <RadzenText TextStyle="TextStyle.Body1">@Localizer["InternalTransfers"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1"><span class="fw-bold">@_priorYear.InternalTransfers.ToString("C", CultureInfo.CurrentCulture)</span></RadzenText>
                            </div>

                            <hr class="my-2" />

                            <div class="d-flex justify-content-between align-items-center">
                                <RadzenText TextStyle="TextStyle.Subtitle1">@Localizer["EndOfYearBalance"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <span class="fw-bold" style="font-size:1.1em;">
                                        @Math.Abs(_priorYear.Balance).ToString("C", CultureInfo.CurrentCulture)
                                        @(_priorYear.Balance < 0 ? $" {Localizer["Deficit"]}" : "")
                                    </span>
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenStack>
        }
    }
</RadzenStack>

@code {
    private bool _loading = true;
    private List<Account> _accounts = new();
    private string? _selectedAccountName;
    private Account? _selectedAccount;

    private List<AccountingDataModel> _accounting = new();
    private List<DonationData> _donations = new();

    private FinancialSummary _currentMonth = new();
    private FinancialSummary _priorMonth = new();
    private FinancialSummary _currentYear = new();
    private FinancialSummary _priorYear = new();

    [Parameter] public string? DefaultAccountName { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!user.Identity?.IsAuthenticated ?? true) { _loading = false; return; }

        await DataLoader.InitializeUserDataAsync(user);
        _accounts = AppState.UserAccounts ?? new List<Account>();

        _selectedAccountName = new[] { DefaultAccountName, AppState.DefaultAccount, _accounts.FirstOrDefault()?.Fund }
            .FirstOrDefault(s => !string.IsNullOrWhiteSpace(s));

        if (!string.IsNullOrWhiteSpace(_selectedAccountName))
        {
            await LoadAccountAndCompute(_selectedAccountName);
        }

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnAccountChangedAsync()
    {
        var accountName = _selectedAccountName;
        if (string.IsNullOrWhiteSpace(accountName)) return;

        _loading = true;
        await InvokeAsync(StateHasChanged);

        await LoadAccountAndCompute(accountName);

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAccountAndCompute(string accountName)
    {
        _selectedAccountName = accountName;
        _selectedAccount = _accounts.FirstOrDefault(a => a.Fund == accountName);
        AppState.DefaultAccount = accountName;

        if (_selectedAccount == null) return;

        if (!AppState.IsAccountDataLoaded(accountName))
        {
            await DataLoader.LoadAccountDataAsync(_selectedAccount);
        }

        if (AppState.IsAccountDataLoaded(accountName) &&
            AppState.AccountDataCache.TryGetValue(accountName, out var cache))
        {
            _accounting = cache.AccountingData ?? new List<AccountingDataModel>();
            _donations = cache.DonationData?.Select(d => new DonationData
            {
                Id = d.Id,
                Date = d.Date,
                Amount = (decimal)d.Amount,
                Fund = d.Fund
            }).ToList() ?? new List<DonationData>();

            ComputeSummaries();
        }
        else
        {
            _currentMonth = new FinancialSummary { Period = Localizer["Loading"] };
        }
    }

    private void ComputeSummaries()
    {
        var now = DateTime.Now;
        var startingBalance = 7812.65m;

        var currentBalance = CalculateBalanceAsOfDate(now, startingBalance);
        var priorMonthEnd = new DateTime(now.Year, now.Month, 1).AddDays(-1);
        var priorMonthBalance = CalculateBalanceAsOfDate(priorMonthEnd, startingBalance);
        var priorYearEnd = new DateTime(now.Year - 1, 12, 31);
        var priorYearBalance = CalculateBalanceAsOfDate(priorYearEnd, startingBalance);

        CalculateCurrentMonthSummary(now, currentBalance);
        CalculatePriorMonthSummary(now, priorMonthBalance);
        CalculateCurrentYearSummary(now, currentBalance);
        CalculatePriorYearSummary(now, priorYearBalance);
    }

    private decimal CalculateBalanceAsOfDate(DateTime asOfDate, decimal originalStartingBalance)
    {
        decimal startingBalance = 7812.65m;
        decimal missingDonations = 9000.00m;
        decimal actualOverhead = -24065.88m;
        var cutoffDate = new DateTime(2020, 1, 1);
        if (asOfDate < cutoffDate) return startingBalance;

        decimal totalDonations = _donations.Where(d => d.Date <= asOfDate && d.Date >= cutoffDate).Sum(d => d.Amount);
        totalDonations += missingDonations;

        decimal totalExpenses = _accounting.Where(a => a.Date <= asOfDate && a.Date >= cutoffDate && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal totalOtherExpenses = _accounting.Where(a => a.Date <= asOfDate && a.Date >= cutoffDate && TransactionCategorizer.IsOtherExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal totalInternalTransfers = _accounting.Where(a => a.Date <= asOfDate && a.Date >= cutoffDate && TransactionCategorizer.IsInternalTransfer(a) && !TransactionCategorizer.IsOtherExpense(a)).Sum(a => Math.Abs((decimal)a.Amount));

        decimal calculatedBalance = startingBalance + totalDonations - totalExpenses + totalOtherExpenses + totalInternalTransfers + actualOverhead;
        return calculatedBalance;
    }

    private void CalculateCurrentMonthSummary(DateTime now, decimal currentBalance)
    {
        decimal monthlyDonations = _donations.Where(d => d.Date.Year == now.Year && d.Date.Month == now.Month).Sum(d => d.Amount);
        decimal monthlyFundraising = _accounting.Where(a => a.Date.Year == now.Year && a.Date.Month == now.Month && TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal monthlyExpenses = _accounting.Where(a => a.Date.Year == now.Year && a.Date.Month == now.Month && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal monthlyInternalTransfers = _accounting.Where(a => a.Date.Year == now.Year && a.Date.Month == now.Month && TransactionCategorizer.IsInternalTransfer(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal overhead = monthlyDonations - monthlyFundraising;

        _currentMonth = new FinancialSummary
        {
            TotalDonations = monthlyDonations,
            TotalExpenses = monthlyExpenses,
            TotalOverhead = overhead,
            InternalTransfers = monthlyInternalTransfers,
            Period = now.ToString("MMMM yyyy"),
            Balance = currentBalance
        };
    }

    private void CalculatePriorMonthSummary(DateTime now, decimal priorMonthBalance)
    {
        DateTime priorMonth = now.AddMonths(-1);
        decimal monthlyDonations = _donations.Where(d => d.Date.Year == priorMonth.Year && d.Date.Month == priorMonth.Month).Sum(d => d.Amount);
        decimal monthlyFundraising = _accounting.Where(a => a.Date.Year == priorMonth.Year && a.Date.Month == priorMonth.Month && TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal monthlyExpenses = _accounting.Where(a => a.Date.Year == priorMonth.Year && a.Date.Month == priorMonth.Month && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal monthlyInternalTransfers = _accounting.Where(a => a.Date.Year == priorMonth.Year && a.Date.Month == priorMonth.Month && TransactionCategorizer.IsInternalTransfer(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal overhead = monthlyDonations - monthlyFundraising;

        _priorMonth = new FinancialSummary
        {
            TotalDonations = monthlyDonations,
            TotalExpenses = monthlyExpenses,
            TotalOverhead = overhead,
            InternalTransfers = monthlyInternalTransfers,
            AvgMonthlyDonations = monthlyDonations,
            AvgMonthlyExpenses = monthlyExpenses,
            Period = priorMonth.ToString("MMMM yyyy"),
            Balance = priorMonthBalance
        };
    }

    private void CalculateCurrentYearSummary(DateTime now, decimal currentBalance)
    {
        int monthsInYear = Math.Min(now.Month, 12);
        decimal yearlyDonations = _donations.Where(d => d.Date.Year == now.Year).Sum(d => d.Amount);
        decimal yearlyFundraising = _accounting.Where(a => a.Date.Year == now.Year && TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal yearlyExpenses = _accounting.Where(a => a.Date.Year == now.Year && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal yearlyInternalTransfers = _accounting.Where(a => a.Date.Year == now.Year && TransactionCategorizer.IsInternalTransfer(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal overhead = yearlyDonations - yearlyFundraising;
        decimal avgMonthlyDonations = monthsInYear > 0 ? yearlyDonations / monthsInYear : 0;
        decimal avgMonthlyExpenses = monthsInYear > 0 ? yearlyExpenses / monthsInYear : 0;

        _currentYear = new FinancialSummary
        {
            TotalDonations = yearlyDonations,
            TotalExpenses = yearlyExpenses,
            TotalOverhead = overhead,
            InternalTransfers = yearlyInternalTransfers,
            AvgMonthlyDonations = avgMonthlyDonations,
            AvgMonthlyExpenses = avgMonthlyExpenses,
            Period = now.ToString("yyyy"),
            Balance = currentBalance
        };
    }

    private void CalculatePriorYearSummary(DateTime now, decimal priorYearBalance)
    {
        int priorYear = now.Year - 1;
        decimal yearlyDonations = _donations.Where(d => d.Date.Year == priorYear).Sum(d => d.Amount);
        decimal yearlyFundraising = _accounting.Where(a => a.Date.Year == priorYear && TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal yearlyExpenses = _accounting.Where(a => a.Date.Year == priorYear && TransactionCategorizer.IsExpense(a) && !TransactionCategorizer.IsFundraising(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal yearlyInternalTransfers = _accounting.Where(a => a.Date.Year == priorYear && TransactionCategorizer.IsInternalTransfer(a)).Sum(a => Math.Abs((decimal)a.Amount));
        decimal overhead = yearlyDonations - yearlyFundraising;

        _priorYear = new FinancialSummary
        {
            TotalDonations = yearlyDonations,
            TotalExpenses = yearlyExpenses,
            TotalOverhead = overhead,
            InternalTransfers = yearlyInternalTransfers,
            AvgMonthlyDonations = yearlyDonations / 12,
            AvgMonthlyExpenses = yearlyExpenses / 12,
            Period = priorYear.ToString(),
            Balance = priorYearBalance
        };
    }

    private class FinancialSummary
    {
        public decimal TotalDonations { get; set; }
        public decimal TotalExpenses { get; set; }
        public decimal TotalOverhead { get; set; }
        public decimal InternalTransfers { get; set; }
        public decimal AvgMonthlyDonations { get; set; }
        public decimal AvgMonthlyExpenses { get; set; }
        public decimal Balance { get; set; }
        public string Period { get; set; } = string.Empty;
    }

    private class DonationData
    {
        public int Id { get; set; }
        public DateTime Date { get; set; }
        public decimal Amount { get; set; }
        public string Fund { get; set; } = string.Empty;
    }
}