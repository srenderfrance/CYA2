@* Components/Shared/ConfirmDialog.razor *@
<div class="modal-overlay @(Show ? "show" : "")">
    <div class="modal-content">
        <h3>@Title</h3>
        <p>@Message</p>
        <div class="button-row">
            <RadzenButton Text="@CancelText"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@OnCancel"
                          Style="margin-right: 1rem;" />
            <RadzenButton Text="@ConfirmText"
                          ButtonStyle="@ConfirmButtonStyle"
                          Click="@OnConfirm" />
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmText { get; set; } = "Yes";
    [Parameter] public string CancelText { get; set; } = "No";
    [Parameter] public ButtonStyle ConfirmButtonStyle { get; set; } = ButtonStyle.Danger;
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
