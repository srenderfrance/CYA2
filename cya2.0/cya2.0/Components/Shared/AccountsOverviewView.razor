@using Radzen.Blazor
@using ModelsLibrary
@using UtilityClasses
@using DataLibrary
@inject IStringLocalizer<Resource> Localizer
@inject IDataAccess _data
@inject IConfiguration _config
@inject IJSRuntime JS

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Class="rz-p-3" Style="height:100%; overflow:auto;">
    <RadzenStack Orientation="Orientation.Horizontal"
                 Gap="1rem"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween">
        <!-- Left: current view label -->
        <RadzenText TextStyle="TextStyle.Subtitle1">
            @(showDonations12m ? Localizer["TotalDonationsLTM"] : Localizer["CurrentBalance"])
        </RadzenText>

        <!-- Right: actions -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <RadzenButton Text="@Localizer["CopyTable"]"
                          Icon="content_copy"
                          ButtonStyle="ButtonStyle.Primary"
                          Style="background-color: #0a3b6b; border-color: #0a3b6b;"
                          Click="CopyTableAsync" />
            <RadzenButton Text="@(showDonations12m ? Localizer["CurrentBalance"] : Localizer["TotalDonationsLTM"])"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => { showDonations12m = !showDonations12m; })" />
        </RadzenStack>
    </RadzenStack>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Filled">
            @errorMessage
        </RadzenAlert>
    }

    <RadzenCard>
        <RadzenDataGrid TItem="FundBalanceRow"
                        Data="@fundBalances"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="false"
                        EmptyText="@Localizer["NoBalancesFound"]">
            <Columns>
                <RadzenDataGridColumn TItem="FundBalanceRow" Property="Fund" Title="@Localizer["Account"]" />
                @if (!showDonations12m)
                {
                    <RadzenDataGridColumn TItem="FundBalanceRow" Property="CurrentBalance" Title="@Localizer["CurrentBalance"]" FormatString="{0:C2}" TextAlign="TextAlign.Right" />
                }
                else
                {
                    <RadzenDataGridColumn TItem="FundBalanceRow" Property="Last12MonthsDonations" Title="@Localizer["TotalDonationsLTM"]" FormatString="{0:C2}" TextAlign="TextAlign.Right" />
                }
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
    <div class="text-muted mt-2" style="font-size:.85rem">
        @Localizer["LoadedAccounts"]: @fundBalances.Count
        @if (!donationsLoaded)
        {
            <span class="ms-2">@Localizer["CalculatingDonations"]…</span>
        }
    </div>
</RadzenStack>

@code {
    private string errorMessage = string.Empty;
    private List<FundBalanceRow> fundBalances = new();
    private bool showDonations12m = false; // default to balance view
    private bool donationsLoaded = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            const string accountsSql = "SELECT AccountId, Fund, AccountingClass, AccountNumber, CreatedAt, Overhead, BalanceAdjustment FROM Accounts ORDER BY Fund";
            var accounts = await _data.LoadData<Account, dynamic>(
                accountsSql,
                new { },
                _config.GetConnectionString("default"));

            var rows = new List<FundBalanceRow>();
            foreach (var account in accounts ?? Enumerable.Empty<Account>())
            {
                try
                {
                    rows.Add(new FundBalanceRow
                    {
                        Fund = account.Fund,
                        Overhead = account.Overhead,
                        CurrentBalance = 0m,
                        Last12MonthsDonations = 0m
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading account row for {account.Fund}: {ex.Message}");
                    rows.Add(new FundBalanceRow
                    {
                        Fund = account.Fund,
                        Overhead = 0m,
                        CurrentBalance = 0m,
                        Last12MonthsDonations = 0m
                    });
                }
            }

            fundBalances = rows.OrderBy(r => r.Fund).ToList();

            // Load donations and balances in background
            _ = Task.Run(async () => await LoadDonationsAsync(accounts ?? new List<Account>()));
            _ = Task.Run(async () => await LoadBalancesAsync(accounts ?? new List<Account>()));
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading balances: {ex.Message}";
        }
    }

    private async Task LoadBalancesAsync(List<Account> accounts)
    {
        try
        {
            var conn = _config.GetConnectionString("default");
            foreach (var account in accounts ?? Enumerable.Empty<Account>())
            {
                try
                {
                    if (account == null) continue;

                    // Use BalanceCalculator same as Home/AccountSummaries to compute current balance as of now
                    var result = await BalanceCalculator.CalculateBalanceFromDatabaseAsync(account, _data, conn, null, DateTime.Now);
                    var balance = result?.TotalBalance ?? 0m;

                    var row = fundBalances.FirstOrDefault(r => r.Fund == account.Fund);
                    if (row != null)
                    {
                        row.CurrentBalance = balance;
                    }

                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error computing balance for {account?.Fund}: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading balances: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadDonationsAsync(List<Account> accounts)
    {
        try
        {
            var now = DateTime.Now;
            var last12Start = new DateTime(now.Year, now.Month, 1).AddMonths(-12);
            var last12End = now;

            // Use DonationsTotalsCalculator to calculate totals consistently with Donations.razor
            var calculator = new DonationsTotalsCalculator(_data, _config);

            var map = accounts?.ToDictionary(a => a.Fund, a => a) ?? new Dictionary<string, Account>(StringComparer.OrdinalIgnoreCase);

            foreach (var row in fundBalances)
            {
                if (!map.TryGetValue(row.Fund, out var account) || account == null)
                {
                    continue;
                }

                try
                {
                    var totals = await calculator.CalculateAsync(account, last12Start, last12End);
                    row.Last12MonthsDonations = totals?.TotalDonations ?? 0m;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading donations for {row.Fund}: {ex.Message}");
                }

                await InvokeAsync(StateHasChanged);
            }

            donationsLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading donations: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CopyTableAsync()
    {
        try
        {
            var header = showDonations12m ? Localizer["TotalDonationsLTM"] : Localizer["CurrentBalance"];
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"{Localizer["Account"]}\t{header}");
            foreach (var row in fundBalances)
            {
                var value = showDonations12m ? row.Last12MonthsDonations : row.CurrentBalance;
                sb.AppendLine($"{row.Fund}\t{value}");
            }
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        }
        catch (Exception ex)
        {
            errorMessage = $"Error copying table: {ex.Message}";
        }
    }

    private sealed class FundBalanceRow
    {
        public string Fund { get; set; } = string.Empty;
        public decimal Overhead { get; set; }
        public decimal CurrentBalance { get; set; }
        public decimal Last12MonthsDonations { get; set; }
    }
}
