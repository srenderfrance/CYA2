@inject IDataAccess DataAccess
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using MySql.Data.MySqlClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject DatabaseMonitorService DbMonitorService
@rendermode InteractiveServer
@implements IDisposable

@if (!IsConnected && IsVisible)
{
    <div class="database-error @(IsVisible ? "visible" : "hidden")">
        <div class="alert alert-danger d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>
                <strong>Database Connection Error</strong> 
                <p class="mb-0">@LastError</p>
                <div class="mt-2">
                    <button class="btn btn-sm btn-outline-danger me-2" @onclick="RetryConnection">Retry Connection</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DismissError">Dismiss</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsConnected = true;
    private string LastError = "";
    private bool IsVisible = true;
    private string _connectionString;
    
    private int _reconnectAttempts = 0;
    private const int MaxReconnectAttempts = 3;

    [Parameter]
    public string ConnectionString { get; set; }
    
    protected override void OnInitialized()
    {
        try
        {
            _connectionString = ConnectionString;
            
            // Get current status from monitor service
            IsConnected = DbMonitorService.IsConnected;
            LastError = DbMonitorService.LastError;
            
            // Subscribe to connection status changes
            DbMonitorService.ConnectionStatusChanged += OnConnectionStatusChanged;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error initializing DatabaseStatus component: {ex.Message}");
            IsConnected = false;
            LastError = "Error initializing component";
        }
    }
    
    private void OnConnectionStatusChanged(object sender, bool isConnected)
    {
        try
        {
            IsConnected = isConnected;
            LastError = DbMonitorService.LastError;
            IsVisible = !isConnected;
            
            InvokeAsync(StateHasChanged).ContinueWith(t => 
            {
                if (t.IsFaulted)
                {
                    Console.Error.WriteLine($"UI update error: {t.Exception?.Message}");
                }
            });
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error in connection status handler: {ex.Message}");
        }
    }

    private async Task RetryConnection()
    {
        try
        {
            _reconnectAttempts++;
            IsConnected = await DataAccess.CheckConnection(_connectionString);
            LastError = DataAccess.LastError;
            
            if (IsConnected)
            {
                _reconnectAttempts = 0;
                IsVisible = false;
            }
            else if (_reconnectAttempts >= 3)
            {
                // After 3 failed retries, redirect to database error page
                NavigationManager.NavigateTo("/database-error", true);  // Force load
                return;
            }
            
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            IsConnected = false;
            LastError = $"Retry failed: {ex.Message}";
            
            _reconnectAttempts++;
            if (_reconnectAttempts >= 3)
            {
                NavigationManager.NavigateTo("/database-error", true);  // Force load
                return;
            }
            
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DismissError()
    {
        IsVisible = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        try
        {
            // Unsubscribe from events
            DbMonitorService.ConnectionStatusChanged -= OnConnectionStatusChanged;
        }
        catch
        {
            // Ignore disposal errors
        }
    }
}

<style>
    .database-error {
        position: fixed;
        bottom: 20px;
        right: 20px;
        max-width: 400px;
        z-index: 1050;
        transition: opacity 0.5s ease;
    }
    
    .database-error.hidden {
        opacity: 0;
        pointer-events: none;
    }
    
    .database-error.visible {
        opacity: 1;
    }
</style>