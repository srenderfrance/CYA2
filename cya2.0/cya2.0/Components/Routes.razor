<CascadingAuthenticationState>
    @inject IDataAccess DataAccess
    @inject IConfiguration Configuration
    @inject ILogger<Routes> Logger
    @inject DatabaseMonitorService DbMonitor

    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            @{
                bool isErrorPage = routeData.PageType.Name.Contains("Error") || 
                                  routeData.PageType.Name.Contains("DatabaseError") ||
                                  routeData.PageType.Name.Contains("NotAuthorized") || 
                                  routeData.PageType.Name.Contains("LoggedOut");
            }
            
            @if (isErrorPage)
            {
                <RouteView RouteData="@routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            }
            else
            {
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        @if (context.User?.Identity?.IsAuthenticated != true)
                        {
                            <div class="container mt-5">
                                <div class="row justify-content-center">
                                    <div class="col-md-6">
                                        <div class="card">
                                            <div class="card-body text-center">
                                                <h3>Login Required</h3>
                                                <p>Please sign in to access this resource.</p>
                                                <a href="/api/login" class="btn btn-primary">
                                                    <i class="bi bi-google me-2"></i> Sign in with Google
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="alert alert-danger">Not authorized to access this resource.</p>
                        }
                    </NotAuthorized>
                    <Authorizing>
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p>Authorizing...</p>
                        </div>
                    </Authorizing>
                </AuthorizeRouteView>
            }
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <div class="alert alert-danger">
                <p>Sorry, there's nothing at this address.</p>
            </div>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    // Subscribe to connection status changes from the monitor
    protected override void OnInitialized()
    {
        try 
        {
            // Set up event handler to update the UI when connection status changes
            DbMonitor.ConnectionStatusChanged += OnConnectionStatusChanged;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error setting up DB monitor event handler in Routes.razor");
        }
    }
    
    private void OnConnectionStatusChanged(object sender, bool isConnected)
    {
        try
        {
            // Request UI update when connection status changes
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in connection status changed handler");
        }
    }
    
    public void Dispose()
    {
        try
        {
            // Remove event handler when component is disposed
            DbMonitor.ConnectionStatusChanged -= OnConnectionStatusChanged;
        }
        catch
        {
            // Ignore disposal errors
        }
    }
}

